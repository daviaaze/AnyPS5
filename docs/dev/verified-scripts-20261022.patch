+    def _wait_for_perf_split(self, existing_names):
+        output = self.identity.paths['perf_data']
+        prefix = output.name + '.'
+        deadline = time.monotonic() + PERF_FINALIZATION_TIMEOUT_SECONDS
+        observed = {}
+        while time.monotonic() < deadline:
+            now = time.monotonic()
+            for path in sorted(self.run_dir.iterdir(), key=lambda item: item.name):
+                if not path.name.startswith(prefix) or path.name in existing_names:
+                    continue
+                try:
+                    info = path.lstat()
+                except FileNotFoundError:
+                    continue
+                if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid():
+                    raise ObserverError(f'new perf split is not a regular owned file: {path}')
+                signature = (info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns)
+                previous = observed.get(path.name)
+                if (info.st_size > 0 and previous is not None and previous[0] == signature
+                        and now - previous[1] >= 0.2):
+                    try:
+                        digest = sha256_file(path)
+                        final_info = path.lstat()
+                    except FileNotFoundError:
+                        continue
+                    final_signature = (final_info.st_dev, final_info.st_ino,
+                                       final_info.st_size, final_info.st_mtime_ns)
+                    if (stat.S_ISREG(final_info.st_mode) and final_info.st_uid == os.geteuid()
+                            and final_signature == signature and time.monotonic() <= deadline):
+                        return {'path': str(path), 'size_bytes': final_info.st_size,
+                                'sha256': digest, 'device': final_info.st_dev,
+                                'inode': final_info.st_ino, 'finalized_at': clock_pair()}
+                if previous is None or previous[0] != signature:
+                    observed[path.name] = (signature, now)
+            time.sleep(min(0.1, max(0.0, deadline - time.monotonic())))
+        raise ObserverError(
+            f'no new stable, non-empty {output.name}.* split appeared within '
+            f'{PERF_FINALIZATION_TIMEOUT_SECONDS:.1f}s after SIGUSR2')
+
+    def _verify_perf_samples(self, finalization):
+        splits = finalization.get('new_finalized_paths')
+        if not isinstance(splits, list) or len(splits) != 1 or not isinstance(splits[0], dict):
+            raise ObserverError('perf finalization does not identify exactly one finalized sample split')
+        split = splits[0]
+        perf_cli = finalization.get('final_perf_cli_path')
