+#include "IdleDelay.hpp"
+#include <cerrno>
+#include <climits>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <link.h>
+#include <sys/mman.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+#if !defined(__linux__) || !defined(__x86_64__)
+#error This opt-in experiment requires Linux x86-64.
+#endif
+
+namespace {
+using Wait = void (*)(void*);
+Wait original_wait;
+thread_local __attribute__((tls_model("initial-exec"))) bool entered;
+[[noreturn]] void fail(const char* message) {
+    std::fprintf(stderr,"[wait-idle-backoff] refusing installation: %s\n",message);
+    _exit(125);
+}
+struct Scope {
+    IdleState state;
+    explicit Scope(void* object) {
+        state.previous=active_idle_state;
+        state.object=object;
+        active_idle_state=&state;
+    }
+    ~Scope() { active_idle_state=state.previous; }
+};
+__attribute__((noinline)) void wait_with_idle(void* object) {
+    if (!entered) {
+        entered=true;
+        // One receipt per worker; raw write is not a deferred cancellation point
+        // and does not change libc errno. No lock or allocation on this path.
+        static constexpr char receipt[]="[wait-idle-backoff] entered WaitForJobs (first invocation on worker)\n";
+        long result=SYS_write;
+        asm volatile("syscall" : "+a"(result)
+            : "D"(2L), "S"(receipt), "d"(sizeof(receipt)-1)
+            : "rcx","r11","memory");
+    }
+    Scope scope(object);
+    original_wait(object);
+}
+struct Image {
+    std::uintptr_t base{},end{};
+    const ElfW(Phdr)* headers{};
+    std::size_t count{};
+};
+int main_image(dl_phdr_info* info,std::size_t,void* output) {
+    if(info->dlpi_name && info->dlpi_name[0]) return 0;
+    auto& image=*static_cast<Image*>(output);
+    image.base=info->dlpi_addr; image.headers=info->dlpi_phdr; image.count=info->dlpi_phnum;
+    for(std::size_t i=0;i<image.count;++i) if(image.headers[i].p_type==PT_LOAD) {
+        const auto end=image.base+image.headers[i].p_vaddr+image.headers[i].p_memsz;
+        if(end>image.end) image.end=end;
+    }
+    return 1;
+}
+bool executable(const Image& image,std::uintptr_t address,std::size_t size) {
+    for(std::size_t i=0;i<image.count;++i) {
+        const auto& h=image.headers[i]; const auto start=image.base+h.p_vaddr;
+        if(h.p_type==PT_LOAD && h.p_flags==(PF_R|PF_X) && address>=start &&
+           address-start<=h.p_filesz && size<=h.p_filesz-(address-start)) return true;
+    }
+    return false;
+}
+std::uint64_t fingerprint(const unsigned char* bytes,std::size_t size) {
+    std::uint64_t hash=14695981039346656037ULL;
+    for(std::size_t i=0;i<size;++i) hash=(hash^bytes[i])*1099511628211ULL;
+    return hash;
+}
+struct Code {
+    unsigned char* start;
+    std::size_t size{};
+    void byte(unsigned char value) { if(size>=512) fail("veneer capacity"); start[size++]=value; }
+    void bytes(const unsigned char* data,std::size_t count) { for(std::size_t i=0;i<count;++i) byte(data[i]); }
+    void word(std::uint32_t value) { for(unsigned i=0;i<4;++i) byte(static_cast<unsigned char>(value>>(8*i))); }
+    void address(std::uintptr_t value) { for(unsigned i=0;i<8;++i) byte(static_cast<unsigned char>(value>>(8*i))); }
+    void jump(std::uintptr_t target) { const unsigned char prefix[]{0xff,0x25,0,0,0,0}; bytes(prefix,6); address(target); }
+    std::size_t conditional(unsigned value) {
+        byte(0x83); byte(0xf8); byte(static_cast<unsigned char>(value)); byte(0x0f); byte(0x84);
+        const auto offset=size; word(0); return offset;
+    }
+    void branch_here(std::size_t offset) {
+        const auto relative=static_cast<std::int32_t>(size-offset-4);
+        std::memcpy(start+offset,&relative,4);
+    }
+    void restore() {
+        const unsigned char pop[]{0x41,0x5b,0x41,0x5a,0x41,0x59,0x41,0x58,0x5f,0x5e,0x5a,0x59,0x58,0x9d};
+        bytes(pop,sizeof pop);
+    }
+};
+std::int32_t relative(std::uintptr_t destination,std::uintptr_t next) {
+    const auto delta=static_cast<std::int64_t>(destination)-static_cast<std::int64_t>(next);
+    if(delta<INT32_MIN || delta>INT32_MAX) fail("veneer outside rel32 range");
+    return static_cast<std::int32_t>(delta);
+}
+__attribute__((constructor)) void install() {
+    Image image;
+    if(!dl_iterate_phdr(main_image,&image) || !image.headers) fail("main executable missing");
+    const auto call=image.base+0x83b583, function=image.base+0x83b640, pause=image.base+0x83b6fd;
+    constexpr unsigned char caller[]{0x48,0x89,0xdf,0xe8,0xb8,0,0,0,0x80,0x3b,0};
+    constexpr unsigned char displaced[]{0xf3,0x90,0x4e,0x8b,0xbc,0xf3,0x10,0x0e,0,0};
