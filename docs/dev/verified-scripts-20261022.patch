+        if type(value) is not kind:
+            raise ObserverError(
+                f'cannot query owned systemd unit: {name} has type {type(value).__name__}, expected {kind.__name__}')
+        props[name] = value
+    if 'ControlGroup' in unit_props:
+        try:
+            unit_control_group = unit_props['ControlGroup']['data']
+        except (KeyError, TypeError) as error:
+            raise ObserverError('cannot query owned systemd unit: invalid unit ControlGroup') from error
+        if type(unit_control_group) is not str or unit_control_group != props['ControlGroup']:
+            raise ObserverError('unit and service ControlGroup properties differ')
+    if props['LoadState'] != 'loaded':
+        raise ObserverError(f"owned unit query failed: LoadState={props['LoadState']!r}, properties={props}")
+    return props
