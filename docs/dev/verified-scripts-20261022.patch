+                or initial_info.st_size <= 0 or initial_info.st_size != split.get('size_bytes')
+                or (initial_info.st_dev, initial_info.st_ino)
+                != (split.get('device'), split.get('inode'))
+                or not isinstance(expected_digest, str) or initial_digest != expected_digest):
+            raise ObserverError('finalized perf split identity/hash differs from its stable finalization record')
