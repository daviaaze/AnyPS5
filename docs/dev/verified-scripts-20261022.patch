+        mode, unit, profile_name, runtime_seconds, identity, causal_trace,
+        privileged_kernel, until_stopped, pipeline_dispatch, wait_idle_backoff)
+    sampling = (causal_sampling(
+        authorization['output_dir'], authorization['trace_environment'],
+        trace_waits, trace_label, runtime_seconds, profile_name, until_stopped)
+        if causal_trace else None)
+    output_dir = Path(authorization['output_dir']) if authorization.get('output_dir') else None
+    ack_path = Path(os.environ.get('APS5_PAD_INPUT_ACK_FILE', ''))
+    pad_input_ack_enabled = (
+        mode == 'game' and output_dir is not None
+        and ack_path.resolve() == (output_dir / 'pad_input_ack').resolve()
+    )
+    if mode == 'game' and not pad_input_ack_enabled:
+        raise RuntimeError('Game mode requires the parent-owned per-run pad input ACK file.')
+    dump_path = Path(os.environ.get('APS5_DUMP_SUBMITS', ''))
+    dump_submits_enabled = (
+        mode == 'game' and output_dir is not None
+        and dump_path.resolve() == (output_dir / 'aps5-submits').resolve()
+    )
+    if dump_submits != dump_submits_enabled:
+        raise RuntimeError('Submission dump setting/path differs from the parent-owned run directory.')
+    record = {
+        'identity': identity,
+        'profile': authorization['profile'],
+        'condition': authorization['condition'],
+        'trace_environment': authorization['trace_environment'],
+        'until_stopped': until_stopped,
+        'pipeline_dispatch': pipeline_dispatch,
+        'mangohud': mangohud,
+        'wait_idle_backoff': wait_idle_backoff,
+        'debug_segv': debug_segv,
+        'pipeline_drain_fills': pipeline_drain_fills,
+        'submit_outside_gpu_mutex': submit_outside_gpu_mutex,
+        'no_lazy_shader_prepare': no_lazy_shader_prepare,
+        'pad_input_ack_enabled': pad_input_ack_enabled,
