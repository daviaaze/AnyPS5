+def selected_cpus(profile_name):
+    count = 8 if profile_name == 'ps5-like' else None
+    if count is None:
+        return None
+    allowed = set(os.sched_getaffinity(0))
+    complete = [cpus for _, cpus in sorted(cpu_topology().items())
+                if len(cpus) == 2 and cpus <= allowed]
+    if len(complete) < count:
+        raise RuntimeError('Eight complete SMT core pairs are unavailable; refusing a smaller or partial-core fallback.')
+    return sorted(set().union(*complete[-count:]))
+
+
+def affinity_limits(profile_name):
+    actual = set(os.sched_getaffinity(0))
+    if profile_name != 'ps5-like':
+        return {'cpu_ids': sorted(actual), 'physical_cores': None,
+                'control': 'No affinity restriction requested'}
+    count = 8
+    groups = [cpus for cpus in cpu_topology().values() if cpus & actual]
+    if (len(actual) != count * 2 or len(groups) != count
+            or any(len(cpus) != 2 or not cpus <= actual for cpus in groups)):
+        raise RuntimeError('The requested eight-core/sixteen-thread affinity is not active; refusing execution.')
+    return {'cpu_ids': sorted(actual), 'physical_cores': count,
+            'logical_threads': len(actual),
+            'control': 'Initial process affinity; not an exclusive or hardened cpuset'}
+
