+EXPECTED_ELF_SHA256 = '3f084ba61619366d1137f65e57d3c638ca920c0664dff3e32519340e9a55cd2d'
+BACKOFF_LIBRARY = WORKBENCH / 'evidence' / 'thread-dependency-investigation' / 'job-backoff' / 'libjob-backoff.so'
