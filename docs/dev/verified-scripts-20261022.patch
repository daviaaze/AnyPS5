+CPU_PERIOD_USEC = 100_000
+TRACE_ENVIRONMENT = ('APS5_TRACE_FRAMES', 'APS5_TRACE_SECONDS', 'APS5_TRACE_DIR',
+                     'APS5_TRACE_SUMMARY_EVERY', 'APS5_TRACE_EVENTS')
+DISPLAY_ENVIRONMENT = ('PATH', 'DISPLAY', 'WAYLAND_DISPLAY', 'XDG_RUNTIME_DIR',
+                       'DBUS_SESSION_BUS_ADDRESS', 'XAUTHORITY')
+SERVICE_PROPERTIES = (
+    'Type', 'ControlGroup', 'RuntimeMaxUSec', 'RuntimeRandomizedExtraUSec',
+    'TimeoutStopUSec', 'TimeoutAbortUSec', 'TimeoutStopFailureMode', 'KillMode',
+    'KillSignal', 'FinalKillSignal', 'SendSIGKILL', 'Restart', 'NotifyAccess',
+    'WatchdogUSec', 'ExecStop', 'ExecStopPost', 'OOMPolicy', 'LimitCORE',
+)
+UNIT_PROPERTIES = (
+    'LoadState', 'ActiveState', 'SubState', 'ControlGroup', 'Result',
+    'ExecMainCode', 'ExecMainStatus', 'CPUUsageNSec', 'MemoryPeak',
+)
+
+CAUSAL_SAMPLE_SECONDS = 180
+CAUSAL_SAMPLE_MAX_SECONDS = 900
+CAUSAL_SAMPLE_FREQUENCY_HZ = 5
+CAUSAL_SAMPLE_STACK_BYTES = 4096
+CAUSAL_TARGET_TIMEOUT_SECONDS = 30
+CAUSAL_OBSERVER_READY_TIMEOUT_SECONDS = 10
+CAUSAL_OBSERVER_STOP_TIMEOUT_SECONDS = STOP_SECONDS + 3
+CAUSAL_ACK_TIMEOUT_SECONDS = 5
+CAUSAL_PERF_FINALIZATION_TIMEOUT_SECONDS = 3
+PRIVILEGED_KERNEL_READY_TIMEOUT_SECONDS = 15
+
+
+def causal_stop_margin_seconds(runtime_seconds):
+    if type(runtime_seconds) is not int or runtime_seconds < 1:
+        raise RuntimeError('Causal service runtime must be a positive integer number of seconds.')
+    return min(30, max(1, runtime_seconds - 1))
+
+
+def privileged_kernel_window(runtime_seconds):
+    if type(runtime_seconds) is not int:
+        raise RuntimeError('Privileged kernel duration must be an exact integer.')
+    if 2 <= runtime_seconds <= 60:
+        return {'delay_seconds': 0, 'max_seconds': runtime_seconds}
+    if runtime_seconds == 180:
+        return {'delay_seconds': 30, 'max_seconds': 60}
+    raise RuntimeError('Privileged kernel duration must be 2..60 seconds or exactly 180 seconds.')
+
+
+def _sampling_configuration(run_dir, sample_seconds=CAUSAL_SAMPLE_SECONDS):
+    run_dir = Path(run_dir).resolve()
+    if type(sample_seconds) is not int or not 1 <= sample_seconds <= CAUSAL_SAMPLE_MAX_SECONDS:
+        raise RuntimeError('Causal sampling duration must be a positive bounded integer.')
+    return {
+        'enabled': True,
+        'perf_data': str(run_dir / 'perf.data'),
+        'control_fifo': str(run_dir / 'perf-control.fifo'),
+        'ack_fifo': str(run_dir / 'perf-ack.fifo'),
+        'frequency_hz': CAUSAL_SAMPLE_FREQUENCY_HZ,
+        'nominal_period_ns': 1_000_000_000 // CAUSAL_SAMPLE_FREQUENCY_HZ,
+        'clock': 'mono',
+        'callgraph': f'dwarf,{CAUSAL_SAMPLE_STACK_BYTES}',
+        'max_size': '256M',
+        'sample_seconds': sample_seconds,
+        'controller_stop_margin_seconds': causal_stop_margin_seconds(sample_seconds),
+        'perf_enabled_at_launch': False,
+        'initial_perf_state': 'disabled_until_enable_ack',
+        'activation_acknowledged': False,
+        'usable_cpu_samples': False,
+    }
+
+
+
+
+def _perf_record_command(sampling, target, perf='perf'):
+    return [
+        perf, 'record', '-D', '-1', '--user-callchains', '--switch-output=signal',
+        f'--control=fifo:{sampling["control_fifo"]},{sampling["ack_fifo"]}',
+        '-e', 'cpu-clock:u', '-F', str(sampling['frequency_hz']), '-P',
+        '-k', sampling['clock'], '--call-graph', sampling['callgraph'],
+        '-m', '128', '-T', '--sample-cpu', '--no-buildid-cache',
+        '--max-size', sampling['max_size'], '-o', sampling['perf_data'], '--', *target,
+    ]
+
+
+def sha256_file(path):
+    with Path(path).open('rb') as stream:
+        return hashlib.file_digest(stream, 'sha256').hexdigest()
+
+
+def candidate_identity(program=CANDIDATE):
+    try:
+        expected_path = CANDIDATE.resolve(strict=True)
+        actual_path = Path(program).resolve(strict=True)
+        before = actual_path.stat()
+    except OSError as error:
+        raise RuntimeError(f'The pinned candidate executable is unavailable: {error}') from error
+    if actual_path != expected_path or not actual_path.is_file():
+        raise RuntimeError(f'Only the canonical candidate executable is accepted: {expected_path}')
+    digest = sha256_file(actual_path)
+    after = actual_path.stat()
+    if (before.st_dev, before.st_ino, before.st_size) != (after.st_dev, after.st_ino, after.st_size):
+        raise RuntimeError('Candidate executable changed while its identity was being read; refusing launch.')
+    if digest != EXPECTED_ELF_SHA256:
+        raise RuntimeError(f'Candidate SHA-256 mismatch: expected {EXPECTED_ELF_SHA256}, got {digest}')
+    return {'path': str(actual_path), 'sha256': digest, 'device': before.st_dev,
+            'inode': before.st_ino, 'size': before.st_size}
+
+
+def treatment_identity(requested=False):
+    if not requested:
+        return None
+    try:
+        library_path = BACKOFF_LIBRARY.resolve(strict=True)
+        source_path = BACKOFF_SOURCE.resolve(strict=True)
+        manifest_path = VERIFIED_BUILD.resolve(strict=True)
+        if library_path != BACKOFF_LIBRARY.resolve() or source_path != BACKOFF_SOURCE.resolve():
+            raise RuntimeError('The optional preload must use the canonical reviewed library and source paths.')
+        manifest = json.loads(manifest_path.read_text())
+        library_sha256 = sha256_file(library_path)
+        source_sha256 = sha256_file(source_path)
+        elf_sha256 = candidate_identity()['sha256']
+    except (OSError, ValueError, KeyError, TypeError) as error:
+        raise RuntimeError(f'Optional preload has no valid verified-build manifest; refusing treatment: {error}') from error
+    expected = {
+        'elf_sha256': elf_sha256,
+        'library_path': str(library_path),
+        'library_sha256': library_sha256,
+        'source_sha256': source_sha256,
+    }
+    if not isinstance(manifest, dict) or any(manifest.get(key) != value for key, value in expected.items()):
+        raise RuntimeError('Optional preload library/source/ELF differs from the parent verified-build manifest; refusing treatment.')
+    return {'library_path': str(library_path), 'library_sha256': library_sha256,
+            'source_path': str(source_path), 'source_sha256': source_sha256,
+            'manifest_path': str(manifest_path), 'elf_sha256': elf_sha256}
+
