+            deadline = data['start']['monotonic_ns'] / 1e9 + args.seconds
+            while proc.poll() is None:
+                now = time.monotonic()
+                if interrupted:
+                    data['interrupted_signal'] = interrupted[0]
+                    stop('parent signal')
+                    break
+                if now >= deadline:
+                    data['timed_out'] = True
+                    stop('outer deadline')
+                    break
+                elapsed = now - data['start']['monotonic_ns'] / 1e9
+                while schedule and elapsed >= schedule[0]:
+                    requested = schedule.pop(0)
+                    send(signal.SIGUSR2, f'capture-at {requested:g}s')
+                collect_screenshots()
+                time.sleep(min(0.05, max(0, deadline - now)))
+            data['unsent_capture_at'] = schedule
+    except Exception as error:
+        data['error'] = f'{type(error).__name__}: {error}'
+        if proc is not None and proc.poll() is None:
+            stop('helper error')
+    finally:
+        for fd in (ready_read, ready_write):
+            if fd is not None:
+                os.close(fd)
+        data['finish'] = stamp()
+        data['compositor_returncode'] = proc.poll() if proc is not None else None
+        status = evidence / 'command-status.json'
+        if status.exists():
+            try:
+                data['command_returncode'] = json.loads(status.read_text())['returncode']
+            except (OSError, ValueError, KeyError) as error:
+                data['status_error'] = str(error)
+        bridge_receipt = evidence / 'bridge-ownership.json'
+        if args.desktop_unit:
+            data['bridge_ownership_receipt_present'] = bridge_receipt.exists()
+            if bridge_receipt.exists():
+                try:
+                    data['bridge_ownership'] = json.loads(bridge_receipt.read_text())
+                except (OSError, ValueError) as error:
+                    data['bridge_ownership_error'] = str(error)
+        collect_screenshots()
+        if log_reader is not None:
+            log_reader.close()
+        code = data.get('command_returncode', data['compositor_returncode'])
+        if data.get('error') or data.get('cleanup_incomplete'):
+            code = 1
+        elif interrupted:
+            code = 128 + interrupted[0]
+        elif data['timed_out']:
+            code = 124
+        elif data['compositor_returncode'] and not code:
+            code = data['compositor_returncode']
+        code = 1 if code is None else (128 - code if code < 0 else code)
+        data['helper_returncode'] = code
+        save(evidence / 'result.json', data)
+        for sig, handler in old_handlers.items():
+            signal.signal(sig, handler)
+    return code
+
+
+if __name__ == '__main__':
+    sys.exit(main())
