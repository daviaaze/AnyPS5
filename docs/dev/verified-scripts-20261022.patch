+    def prepare(path):
+        if path is not None:
+            envelope = {'identity': identity, 'kind': kind, 'unit': unit,
+                        'policy': {'profile': 'probe', 'runtime_seconds': args.timeout_seconds}}
+            with (path / 'envelope.json').open('x') as stream:
+                json.dump(envelope, stream, indent=2)
+                stream.write('\n')
+
+    result = launch_guard.run_supervised(
+        kind=kind, unit_name=unit, worker_command=worker_command,
+        profile_name='probe', runtime_seconds=args.timeout_seconds, identity=identity,
+        working_directory=program.parent, output_dir=output_dir,
+        prepare=prepare if output_dir else None,
+    )
+    if not result['controller_success']:
+        print('Probe controller outcome or teardown is unknown/unsuccessful; inspect controller-result.json.', file=sys.stderr)
+        code = result['client']['code']
+        return code if type(code) is int and code != 0 else 1
+    code = result['client']['code']
+    return code if type(code) is int else 1
+
+
+if __name__ == '__main__':
+    try:
+        raise SystemExit(main())
+    except (OSError, RuntimeError, TimeoutError, ValueError) as error:
+        print(f'Probe refused/failed: {error}', file=sys.stderr)
+        raise SystemExit(1)
