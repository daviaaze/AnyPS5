+        disable = self.window.get('disable')
+        requested_seconds = self.window.get('requested_seconds')
+        enable_ack = enable.get('ack_observed') if isinstance(enable, dict) else None
+        disable_ack = disable.get('ack_observed') if isinstance(disable, dict) else None
+        start = enable.get('request', {}).get('monotonic_ns') if isinstance(enable, dict) else None
+        end = disable_ack.get('monotonic_ns') if isinstance(disable_ack, dict) else None
+        ack_start = enable_ack.get('monotonic_ns') if isinstance(enable_ack, dict) else None
