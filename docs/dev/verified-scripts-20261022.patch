+    unit = f'anyps5-dependency-{identifier}.service'
+    worker_command = [
+        sys.executable, str(Path(__file__).resolve()), '--program', str(program),
+        '--timeout-seconds', str(args.timeout_seconds), '--observe-seconds', str(args.observe_seconds),
+        '--worker', worker_mode,
+    ]
