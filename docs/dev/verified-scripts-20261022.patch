+def validate_sampling(record, run_dir):
+    sampling = record.get('sampling')
+    if not isinstance(sampling, dict):
+        raise ObserverError('worker-result or fixture manifest has no sampling object')
+    expected = {
+        'enabled': True,
+        'frequency_hz': native_launch_guard.CAUSAL_SAMPLE_FREQUENCY_HZ,
+        'nominal_period_ns': 1_000_000_000 // native_launch_guard.CAUSAL_SAMPLE_FREQUENCY_HZ,
+        'clock': 'mono',
+        'callgraph': f'dwarf,{native_launch_guard.CAUSAL_SAMPLE_STACK_BYTES}',
+        'max_size': '256M',
+        'perf_enabled_at_launch': False,
+        'initial_perf_state': 'disabled_until_enable_ack',
+        'activation_acknowledged': False,
+        'usable_cpu_samples': False,
+    }
+    for key, value in expected.items():
+        if sampling.get(key) != value:
+            raise ObserverError(f'sampling.{key} must be {value!r}')
+    sample_seconds = sampling.get('sample_seconds')
+    if type(sample_seconds) is not int or not 1 <= sample_seconds <= MAX_SAMPLE_SECONDS:
+        raise ObserverError(f'sampling.sample_seconds must be an integer in 1..{MAX_SAMPLE_SECONDS}')
+    if sampling.get('controller_stop_margin_seconds') != (
+            native_launch_guard.causal_stop_margin_seconds(sample_seconds)):
+        raise ObserverError('sampling.controller_stop_margin_seconds differs from the shared runtime policy')
+    profile = record.get('profile')
+    profile_name = profile.get('profile') if isinstance(profile, dict) else None
+    runtime_seconds = profile.get('runtime_seconds') if isinstance(profile, dict) else None
+    normal_max_seconds = MAX_SAMPLE_SECONDS if record.get('until_stopped') is True else 360
+    if profile_name == 'normal' and not (
+            type(runtime_seconds) is int and 1 <= runtime_seconds <= normal_max_seconds):
+        raise ObserverError(f'normal profile sample duration must be an exact integer in 1..{normal_max_seconds} seconds')
+    if profile_name == 'bounded' and not (
+            type(runtime_seconds) is int and 1 <= runtime_seconds <= 180):
+        raise ObserverError('bounded profile sample duration must be an exact integer in 1..180 seconds')
+    if profile_name == 'capture24' and runtime_seconds != 900:
+        raise ObserverError('capture24 sample duration must be exactly 900 seconds')
+    if profile_name in ('capture24', 'normal', 'bounded'):
+        until_stopped = record.get('until_stopped')
+        pipeline_dispatch = record.get('pipeline_dispatch')
+        if (type(until_stopped) is not bool or type(pipeline_dispatch) is not bool
+                or profile.get('until_stopped') is not until_stopped
+                or profile.get('pipeline_dispatch') is not pipeline_dispatch
+                or until_stopped and profile_name != 'normal'):
+            raise ObserverError('game worker result lacks an exact runtime/treatment policy')
+        if sample_seconds != runtime_seconds:
+            raise ObserverError('game sampling duration differs from its authenticated sample window')
+    if profile_name is not None and profile_name not in ('capture24', 'normal', 'bounded'):
+        raise ObserverError('game sampling profile is not an authorized causal-capture profile')
+    if profile_name is None and sample_seconds > native_launch_guard.CAUSAL_SAMPLE_SECONDS:
+        raise ObserverError('fixture sample duration exceeds the bounded no-game acceptance maximum')
+    paths = {}
+    for key, name in (('perf_data', None), ('control_fifo', 'perf-control.fifo'),
+                      ('ack_fifo', 'perf-ack.fifo')):
+        value = sampling.get(key)
+        if not isinstance(value, str) or not Path(value).is_absolute():
+            raise ObserverError(f'sampling.{key} must be an absolute path')
+        path = Path(value)
+        if path.parent.resolve(strict=True) != run_dir or (name is not None and path.name != name):
+            raise ObserverError(f'sampling.{key} must be an absolute path within {run_dir}')
+        if key == 'perf_data' and path.name in ('', '.', '..'):
+            raise ObserverError('sampling.perf_data has no safe file name')
+        paths[key] = path
+    for key in ('control_fifo', 'ack_fifo'):
+        path = paths[key]
+        info = path.lstat()
+        if not stat.S_ISFIFO(info.st_mode) or info.st_uid != os.geteuid():
+            raise ObserverError(f'{key} is not a FIFO owned by this user')
+    return sampling, paths
