+       std::memcmp(reinterpret_cast<void*>(call-3),caller,sizeof caller) ||
+       std::memcmp(reinterpret_cast<void*>(pause),displaced,sizeof displaced) ||
+       fingerprint(reinterpret_cast<unsigned char*>(function),0x23e)!=0xf64393c101118d08ULL)
+        fail("pinned worker/wait instruction signature mismatch");
+    std::int32_t original_displacement;
+    std::memcpy(&original_displacement,reinterpret_cast<void*>(call+1),4);
+    if(call+5+original_displacement!=function) fail("unexpected WaitForJobs target");
+    original_wait=reinterpret_cast<Wait>(function);
+    const auto page=static_cast<std::uintptr_t>(sysconf(_SC_PAGESIZE));
+    if(page!=4096 || call/page!=(pause+9)/page) fail("unsupported code page layout");
+    unsigned char* veneer=nullptr;
+    const auto first=(image.end+page-1)&~(page-1);
+    for(unsigned i=0;i<256;++i) {
+        const auto address=first+i*65536;
+        relative(address,call+5); relative(address+64,pause+5);
+        void* mapping=mmap(reinterpret_cast<void*>(address),page,PROT_READ|PROT_WRITE,
+            MAP_PRIVATE|MAP_ANONYMOUS|MAP_FIXED_NOREPLACE,-1,0);
+        if(mapping==MAP_FAILED) { if(errno!=EEXIST) fail("near veneer allocation"); continue; }
+        if(reinterpret_cast<std::uintptr_t>(mapping)!=address) fail("fixed-noreplace placement ignored");
+        veneer=static_cast<unsigned char*>(mapping); break;
+    }
+    if(!veneer) fail("no free near veneer page");
+    Code entry{veneer}; entry.jump(reinterpret_cast<std::uintptr_t>(&wait_with_idle));
+    Code idle{veneer+64};
+    // Actual PAUSE-site RSP%16==0. Save flags plus nine volatile GPRs (80B).
+    // The helper is separately compiled general-register-only/no-red-zone and
+    // uses direct initial-exec TLS: it cannot touch SIMD/MXCSR/x87 state.
+    const unsigned char push[]{0x9c,0x50,0x51,0x52,0x56,0x57,0x41,0x50,0x41,0x51,0x41,0x52,0x41,0x53,
+        0x48,0x89,0xdf,0x48,0xb8};
+    idle.bytes(push,sizeof push); idle.address(reinterpret_cast<std::uintptr_t>(&idle_delay));
+    idle.byte(0xff); idle.byte(0xd0);
+    const auto rescan=idle.conditional(1),stop=idle.conditional(2);
+    idle.restore(); idle.bytes(displaced,sizeof displaced); idle.jump(image.base+0x83b707);
+    idle.branch_here(rescan); idle.restore(); idle.jump(image.base+0x83b6ba);
+    // Before replaying the displaced load, R15 is still the guard pointer.
+    idle.branch_here(stop); idle.restore(); idle.jump(image.base+0x83b67a);
+    if(mprotect(veneer,page,PROT_READ|PROT_EXEC)) fail("veneer RX protection");
+    auto call_delta=relative(reinterpret_cast<std::uintptr_t>(veneer),call+5);
+    auto pause_delta=relative(reinterpret_cast<std::uintptr_t>(veneer+64),pause+5);
+    void* code_page=reinterpret_cast<void*>(call&~(page-1));
+    if(mprotect(code_page,page,PROT_READ|PROT_WRITE)) fail("temporary code page write");
+    std::memcpy(reinterpret_cast<void*>(call+1),&call_delta,4);
+    *reinterpret_cast<unsigned char*>(pause)=0xe9;
+    std::memcpy(reinterpret_cast<void*>(pause+1),&pause_delta,4);
+    std::memset(reinterpret_cast<void*>(pause+5),0x90,5);
+    __builtin___clear_cache(reinterpret_cast<char*>(call),reinterpret_cast<char*>(pause+10));
+    if(mprotect(code_page,page,PROT_READ|PROT_EXEC)) fail("restoring code RX protection");
+    std::fprintf(stderr,"[wait-idle-backoff] installed call=%p pause=%p veneer=%p fast=32 delay_us=25,50,100 rescan_then_watchdog=1\n",
+        reinterpret_cast<void*>(call),reinterpret_cast<void*>(pause),veneer);
+}
+}
