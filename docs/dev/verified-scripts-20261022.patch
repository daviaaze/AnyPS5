+    }
+    if sampling is not None:
+        record['sampling'] = sampling
+    launch_guard.write_worker_result(record, authorization['output_dir'])
+    if sampling is not None:
+        print('CAUSAL_SAMPLER_CONFIG=' + json.dumps(sampling, sort_keys=True), flush=True)
+    if mode == 'check':
+        return 0
+    if not (RUNTIME / 'app.elf').is_file() or not (WORKBENCH / 'shell.nix').is_file():
+        raise RuntimeError('Prepared candidate runtime or Nix shell is missing.')
+    nix_shell = shutil.which('nix-shell')
+    if nix_shell is None:
+        raise RuntimeError('nix-shell is unavailable; refusing a fallback launch.')
+    environment = os.environ.copy()
+    for name in (
+        'LD_PRELOAD', 'DS_DEPENDENCY_PRELOAD', 'NIX_CFLAGS_LINK', 'NIX_LDFLAGS',
+        'NIX_CFLAGS_COMPILE', 'RADV_DEBUG', 'APS5_SYNC_DISPATCH', 'APS5_PROFILE_GPU',
+        'APS5_PROFILE_DRAW', 'APS5_DUMP_SHADERS', 'ANYPS5_NO_SHADER_CACHE',
+        'APS5_DUMP_SUBMITS',
+        'APS5_THREAD_PRIORITY', *launch_guard.TRACE_ENVIRONMENT,
+        'APS5_PIPELINE_DRAIN_FILLS', 'APS5_SUBMIT_OUTSIDE_GPU_MUTEX',
+        *launch_guard.TRACE_WAIT_ENVIRONMENT,
+        *launch_guard.TRACE_LABEL_ENVIRONMENT,
+        *launch_guard.TRACE_SLOW_IMAGE_ENVIRONMENT,
+        *launch_guard.TRACE_SLOW_VULKAN_ENVIRONMENT,
+        *launch_guard.TRACE_CAUSAL_ENVIRONMENT,
+    ):
+        environment.pop(name, None)
+    if pipeline_drain_fills:
+        environment['APS5_PIPELINE_DRAIN_FILLS'] = '1'
+        print('Synchronous fill diagnosis enabled: APS5_PIPELINE_DRAIN_FILLS=1', flush=True)
+    if submit_outside_gpu_mutex:
+        environment['APS5_SUBMIT_OUTSIDE_GPU_MUTEX'] = '1'
+        print('Ordered submit lane enabled: APS5_SUBMIT_OUTSIDE_GPU_MUTEX=1', flush=True)
+    if no_lazy_shader_prepare:
+        print('Shader registration preparation enabled; APS5_LAZY_SHADER_PREPARE is unset.', flush=True)
+    for name, value in authorization['trace_environment'].items():
+        if value:
+            environment[name] = value
+    pad = Path(environment.get('APS5_PAD_INPUT_FILE', ''))
+    output_dir = Path(authorization['output_dir'])
+    if not pad.is_file() or pad.resolve() != (output_dir / 'pad_input').resolve():
+        raise RuntimeError('The per-run released/explicit pad input is missing or not parent-owned.')
+    ack_path = Path(environment.get('APS5_PAD_INPUT_ACK_FILE', ''))
+    if mode == 'game' and (
+            not pad_input_ack_enabled
+            or ack_path.resolve() != (output_dir / 'pad_input_ack').resolve()):
+        raise RuntimeError('Controller input ACK file differs from the parent-owned run directory.')
+    if mode == 'game':
+        environment['APS5_PAD_INPUT_ACK_FILE'] = str(ack_path)
+    else:
+        environment.pop('APS5_PAD_INPUT_ACK_FILE', None)
+    if dump_submits:
+        environment['APS5_DUMP_SUBMITS'] = str(dump_path)
+        print(f'Accepted AGC submissions will be captured in {dump_path}.', flush=True)
+    game_command = ['./app.elf']
+    mangohud_wrapper = None
+    if mangohud:
+        mangohud_wrapper = shutil.which('mangohud')
+        if mangohud_wrapper is None:
+            raise RuntimeError('MangoHud was requested but its wrapper is unavailable.')
+        game_command = [mangohud_wrapper, *game_command]
+        print(f'MangoHud wrapper: {mangohud_wrapper}; applied to the candidate executable only.', flush=True)
+    game_target = game_command
+    preloads = []
+    for key, label in (('preload', 'Optional failed-scan backoff'),
+                       ('wait_idle_preload', 'Wait-idle backoff experiment')):
+        treatment = identity[key]
+        if treatment is not None:
+            preloads.append(treatment['library_path'])
+            print(f'{label}: {treatment["library_path"]}; preload is set for the game executable only.', flush=True)
+    if preloads:
+        game_target = ['env', f'LD_PRELOAD={":".join(preloads)}', *game_command]
+    if debug_segv:
+        debugger_log = Path(authorization['output_dir']) / 'gdb-segv.log'
+        debugger_command = [
+            'gdb', '-q', '-nx', '--batch',
+            '-ex', 'set pagination off',
+            '-ex', 'set confirm off',
+            '-ex', 'set print thread-events off',
+            '-ex', 'set debuginfod enabled off',
+            '-ex', 'set disable-randomization off',
+            '-ex', f'set logging file {debugger_log}',
+            '-ex', 'set logging enabled on',
+            '-ex', 'handle SIGSEGV stop print nopass',
+            '-ex', 'run',
+            '-ex', 'info registers',
+            '-ex', 'thread apply all bt 32',
+            '-ex', 'x/16i $pc-16',
+            '-ex', 'quit',
+            '--args', './app.elf',
+        ]
+        game_target = (
+            [mangohud_wrapper, *debugger_command] if mangohud else debugger_command
+        )
+        print(f'GDB SIGSEGV capture enabled: {debugger_log}', flush=True)
+    target = game_target
+    if causal_trace:
+        target = launch_guard._perf_record_command(sampling, game_target)
+    target = ['steam-run', *target]
+    if mode == 'capture':
+        capture = WORKBENCH / 'capture-null-list.py'
+        config = WORKBENCH / 'null-list-capture.json'
+        if not capture.is_file() or not config.is_file():
+            raise RuntimeError('Pinned capture script or configuration is missing.')
+        directory = Path(environment['ANYPS5_NULL_CAPTURE_DIR'])
+        if directory.resolve() != output_dir.resolve():
+            raise RuntimeError('Capture output directory differs from the parent-owned run directory.')
+        environment['ANYPS5_NULL_CAPTURE_CONFIG'] = str(config)
+        environment['APS5_DUMP_SHADERS'] = '1'
+        target = ['steam-run', 'gdb', '-q', '-nx', '--batch', '-x', str(capture), '--args', './app.elf']
+        print(f'Capture directory: {directory}; pad input: {pad}', flush=True)
+    dispatch_policy = (
+        ('APS5_PIPELINE_DISPATCH=1',) if pipeline_dispatch
+        else ('-u', 'APS5_PIPELINE_DISPATCH') if mode == 'game' and profile_name in ('normal', 'bounded')
+        else ('APS5_PIPELINE_DISPATCH=1',)
+    )
+    shader_prepare_policy = (
+        ('-u', 'APS5_LAZY_SHADER_PREPARE') if no_lazy_shader_prepare
+        else ('APS5_LAZY_SHADER_PREPARE=1',)
+    )
+    command = shlex.join([
+        'env', *dispatch_policy, *shader_prepare_policy, 'DISABLE_LSFGVK=1',
+        f'ANYPS5_SHADER_CACHE_DIR={RUNTIME}/shader_cache',
+        *target,
