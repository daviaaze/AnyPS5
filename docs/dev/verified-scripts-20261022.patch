+                error = RuntimeError('Causal game exited before its ordered capture shutdown.')
+                causal_capture._fail('shutdown_finalization', error)
+                termination_request = causal_capture.abort_before_unit_stop(
+                    systemctl, 'controller_failure', error)
+                causal_abort_requested = True
+        for thread in client_threads:
+            if thread.ident is not None:
+                thread.join(timeout=STOP_SECONDS + 3)
+        client_output_complete = (all(thread.ident is not None and not thread.is_alive()
+                                      for thread in client_threads)
+                                  and not stdout_errors and not stderr_errors)
+        if not client_output_complete and not stdout_errors and not stderr_errors:
+            stderr_errors.append('systemd client output streams did not close')
+        stdout_path = output_path / 'systemd-client.stdout' if output_path else None
+        stderr_path = output_path / 'systemd-client.stderr' if output_path else None
+        stdout_raw = _summarize_client_output(stdout_file, stdout_path)
+        stderr_raw = _summarize_client_output(stderr_file, stderr_path)
+        client_output_complete = (client_output_complete and stdout_raw['complete']
+                                  and stderr_raw['complete'])
+        client_code = 130 if interrupt else (124 if client_timeout else process.returncode)
+        unit = _unit_snapshot(systemctl, unit_name)
+        worker_record = _collect_worker_result(output_path, stdout_raw['preview'])
+        recorded_cgroup = ((worker_record.get('profile') or {}).get('cgroup')
+                           if isinstance(worker_record, dict) else None)
+        if not recorded_cgroup:
+            recorded_cgroup = ((unit.get('properties') or {}).get('ControlGroup')
+                               or _owner_cgroup(lease.record))
+        teardown = _wait_for_drain(systemctl, unit_name, recorded_cgroup, identity)
+        if not teardown.get('confirmed'):
+            termination_request = _stop_unit(systemctl, unit_name)
+            teardown = _wait_for_drain(systemctl, unit_name, recorded_cgroup, identity)
+        causal_result = (causal_capture.finish(teardown)
+                         if causal_capture is not None else None)
+        unit = _unit_snapshot(systemctl, unit_name)
+        unit['classification'] = _unit_classification(unit)
+        unit_journal = _unit_journal(unit_name)
+        guard_verified = _guard_verified(
+            worker_record, identity, profile_name, runtime_seconds, privileged_kernel,
+            until_stopped, pipeline_dispatch, wait_idle_backoff)
+        result = {
+            'version': 1, 'kind': kind, 'unit': unit_name,
+            'client': {'code': client_code if client_code is not None else 'unknown',
+                       'timed_out': client_timeout, 'interrupted': interrupt,
+                       'output_complete': client_output_complete,
+                       'output_errors': {'stdout': stdout_errors, 'stderr': stderr_errors},
+                       'stdout': stdout_raw['preview'], 'stderr': stderr_raw['preview'],
+                       'raw_stdout': stdout_raw, 'raw_stderr': stderr_raw},
+            'unit_final': unit,
+            'privileged_kernel_capture': (
+                causal_result.get('privileged_kernel_capture')
+                if isinstance(causal_result, dict) else
+                {'status': 'not_requested'} if not privileged_kernel else
+                {'status': 'not_started'}),
+            'user_journal': unit_journal,
+            'identity': identity,
+            'condition': {'worker': worker_record,
+                          'guard_outcome': 'verified' if guard_verified else 'unknown',
+                          'requested_profile': profile_name,
+                          'requested_runtime_seconds': runtime_seconds,
+                          'requested_privileged_kernel': privileged_kernel,
+                          'requested_systemd_properties': properties,
+                          'verified_policy': ((worker_record.get('profile') or {})
+                                              if isinstance(worker_record, dict) else 'unknown')},
+            'inferior': _collect_inferior(output_path),
+            'teardown': {**teardown, 'request': termination_request},
+            'controller_success': (client_code == 0
+                                   and guard_verified
+                                   and teardown.get('confirmed') is True
+                                   and client_output_complete
+                                   and (causal_result is None
+                                        or causal_result.get('outcome') == 'success')),
+            'started_at': lease.record.get('started_at'), 'finished_at': time.time(),
+        }
+        if causal_result is not None:
+            result['causal_capture'] = causal_result
+        ownership_update = {'state': 'draining', 'last_unit_snapshot': unit}
+        if recorded_cgroup:
+            ownership_update['cgroup'] = recorded_cgroup
+        lease.update(**ownership_update)
+        if output_path:
+            _atomic_json(output_path / 'controller-result.json', result, replace=False)
+        lease.finish(teardown)
+        return result
+    except BaseException as error:
+        if causal_capture is not None:
+            try:
+                causal_capture._fail('controller_failure', error)
+            except BaseException:
+                pass
+        termination_request = {'requested': False}
+        if causal_capture is not None:
+            try:
+                termination_request = causal_capture.abort_before_unit_stop(
+                    systemctl, 'controller_failure', error)
+            except BaseException as cleanup_error:
+                try:
+                    causal_capture._stop_privileged_kernel('controller_failure')
+                except BaseException:
+                    pass
+                try:
+                    termination_request = _stop_unit(systemctl, unit_name)
+                except BaseException as stop_error:
+                    termination_request = {
+                        'requested': False,
+                        'error': f'{type(stop_error).__name__}: {stop_error}',
+                    }
+                termination_request['abort_cleanup_failure'] = str(cleanup_error)
+        else:
+            termination_request = _stop_unit(systemctl, unit_name)
+        if process is not None and process.poll() is None:
+            try:
+                process.kill()
+                process.wait(timeout=3)
+            except (OSError, subprocess.SubprocessError):
+                pass
+        recorded_cgroup = _owner_cgroup(lease.record)
+        if not recorded_cgroup:
+            active_unit = _unit_snapshot(systemctl, unit_name)
+            recorded_cgroup = (active_unit.get('properties') or {}).get('ControlGroup')
+        try:
+            teardown = _wait_for_drain(systemctl, unit_name, recorded_cgroup, identity)
+            if not teardown.get('confirmed'):
+                termination_request = _stop_unit(systemctl, unit_name)
+                teardown = _wait_for_drain(systemctl, unit_name, recorded_cgroup, identity)
+        except (OSError, RuntimeError, ValueError) as cleanup_error:
+            teardown = {'confirmed': False, 'condition': 'drain verification failed',
+                        'error': str(cleanup_error)}
+        if causal_capture is not None:
+            causal_result = causal_capture.finish(teardown)
+        elif causal_trace:
+            causal_result = {
+                'state': 'failed', 'outcome': 'failed', 'usable_cpu_samples': False,
+                'failure': {'stage': 'controller_startup', 'detail': str(error)},
+                'privileged_kernel_capture': (
+                    {'status': 'not_started'} if privileged_kernel
+                    else {'status': 'not_requested'}),
+                'teardown': {'systemd_unit_drain_confirmed': teardown.get('confirmed') is True,
+                             'unit_drain': teardown},
+            }
+            if output_path and created:
+                _atomic_json(output_path / 'causal-capture-status.json', causal_result)
+        else:
+            causal_result = None
+        for thread in client_threads:
+            if thread.ident is not None:
+                thread.join(timeout=STOP_SECONDS + 3)
+        client_output_complete = (all(thread.ident is not None and not thread.is_alive()
+                                      for thread in client_threads)
+                                  and not stdout_errors and not stderr_errors)
+        if not client_output_complete and not stdout_errors and not stderr_errors:
+            stderr_errors.append('systemd client output streams did not close after teardown')
+        if output_path and created and not (output_path / 'controller-result.json').exists():
+            stdout_path = output_path / 'systemd-client.stdout'
+            stderr_path = output_path / 'systemd-client.stderr'
+            stdout_raw = _summarize_client_output(stdout_file, stdout_path)
+            stderr_raw = _summarize_client_output(stderr_file, stderr_path)
+            client_output_complete = (client_output_complete and stdout_raw['complete']
+                                      and stderr_raw['complete'])
+            unit = _unit_snapshot(systemctl, unit_name)
+            unit['classification'] = _unit_classification(unit)
+            worker_record = _collect_worker_result(output_path, stdout_raw['preview'])
+            failure = {
+                'version': 1, 'kind': kind, 'unit': unit_name,
+                'client': {'code': process.returncode if process is not None
+                           and process.returncode is not None else 'unknown',
+                           'timed_out': client_timeout, 'interrupted': interrupt,
+                           'output_complete': client_output_complete,
+                           'output_errors': {'stdout': stdout_errors, 'stderr': stderr_errors},
+                           'stdout': stdout_raw['preview'], 'stderr': stderr_raw['preview'],
+                           'raw_stdout': stdout_raw, 'raw_stderr': stderr_raw},
+                'privileged_kernel_capture': (
+                    causal_result.get('privileged_kernel_capture')
+                    if isinstance(causal_result, dict) else
+                    {'status': 'not_requested'} if not privileged_kernel else
+                    {'status': 'not_started'}),
+                'unit_final': unit, 'user_journal': _unit_journal(unit_name),
+                'identity': identity, 'condition': {'worker': worker_record},
+                'inferior': _collect_inferior(output_path),
