+    monitor.add_argument('--fixture', action='store_true',
+                         help='Use only the canonical CPU-fixture binaries/manifest and bounded owned unit.')
+    monitor.add_argument('--external-kernel', action='store_true',
+                         help='Use the authenticated privileged helper as the kernel evidence route; do not start the observer kernel collector.')
+    monitor.add_argument('--fixture-timer-failure', action='store_true',
+                         help=argparse.SUPPRESS)
