+#!/usr/bin/env python3
+"""Exercise the owned SDK fixture, real perf FIFO ACKs and resource snapshots; never a game.
+
+Run in a bounded NoNewPrivileges user service with control-group teardown.
+"""
+import argparse
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+import select
+import shutil
+import signal
+import subprocess
+import sys
+import threading
+import time
+
+BASE = Path(__file__).resolve().parent
+spec = importlib.util.spec_from_file_location('sdk_smoke_observer', BASE / 'causal-observer.py')
+observer = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(observer)
+
+
+def save(path, value):
+    temporary = path.with_suffix('.tmp')
+    temporary.write_text(json.dumps(value, indent=2) + '\n')
+    temporary.replace(path)
+
+
+def digest(path):
+    with path.open('rb') as stream:
+        return hashlib.file_digest(stream, 'sha256').hexdigest()
+
+
+class Target:
+    def __init__(self, pid, birth, binary, cgroup):
+        self.pid, self.birth, self.binary, self.cgroup = pid, birth, binary, cgroup
+        self.verify_process()
+
+    def verify_process(self):
+        value = observer.proc_stat(self.pid)
+        if value['starttime_ticks'] != self.birth:
+            raise RuntimeError('SDK fixture PID was reused')
+        if Path(os.readlink(f'/proc/{self.pid}/exe')) != self.binary:
+            raise RuntimeError('SDK fixture executable identity changed')
+        if observer.proc_cgroup(self.pid) != self.cgroup:
+            raise RuntimeError('SDK fixture escaped its owned service cgroup')
+        return value
+
+
+def wait_until(predicate, deadline, description):
+    while time.monotonic() < deadline:
+        value = predicate()
+        if value:
+            return value
+        time.sleep(0.01)
+    raise TimeoutError(description)
+
+
+def command(control_fd, ack_fd, name, deadline):
+    if select.select([ack_fd], [], [], 0)[0]:
+        raise RuntimeError('Unexpected stale perf ACK before command')
+    request = observer.clock_pair()
+    payload = (name + '\n').encode()
+    if os.write(control_fd, payload) != len(payload):
+        raise RuntimeError('Short perf control write')
+    written = observer.clock_pair()
+    raw = bytearray()
+    while time.monotonic() < deadline:
+        if not select.select([ack_fd], [], [], min(0.1, deadline - time.monotonic()))[0]:
+            continue
+        raw.extend(os.read(ack_fd, 4096))
+        if len(raw) > 4096:
+            raise RuntimeError('Oversized perf ACK')
+        if b'\x00' in raw:
+            if bytes(raw).replace(b'\x00', b'').strip() != b'ack':
+                raise RuntimeError(f'Unexpected perf ACK {bytes(raw)!r}')
+            return {'command': name, 'request': request, 'write_returned': written,
+                    'ack_observed': observer.clock_pair(), 'ack_line': 'ack',
+                    'ack_raw_hex': bytes(raw).hex(), 'ack_protocol_terminator': 'nul'}
+    raise TimeoutError(f'No real perf {name} ACK')
+
+
+def split_closed(perf_pid, path):
+    try:
+        info = path.stat()
+        for entry in Path(f'/proc/{perf_pid}/fd').iterdir():
+            try:
+                opened = entry.stat()
+                if (opened.st_dev, opened.st_ino) == (info.st_dev, info.st_ino):
+                    return False
+            except FileNotFoundError:
+                continue
+        return info if info.st_size else False
+    except FileNotFoundError:
+        return False
+
+
+def capture(args):
+    binary = args.binary.resolve(strict=True)
+    expected = (BASE / 'AnyPS5-pad-ack/build-padack/tests/agc_gpu_mutex_causality_tests').resolve(strict=True)
+    if binary != expected or not os.access(binary, os.X_OK):
+        raise RuntimeError('Only the explicitly built SDK no-game fixture may be launched')
+    perf_name = args.perf or shutil.which('perf')
+    if not perf_name:
+        raise RuntimeError('A trusted perf CLI is required in PATH or --perf')
+    perf = Path(perf_name).resolve(strict=True)
+    if not perf.is_file() or not os.access(perf, os.X_OK):
+        raise RuntimeError('Selected perf CLI is not an executable regular file')
+    run = args.run_dir.absolute()
+    if run != run.resolve() or not run.is_relative_to(BASE / 'evidence'):
+        raise RuntimeError('Use a canonical fresh workbench evidence directory')
+    run.mkdir(mode=0o700, parents=True, exist_ok=False)
+    (run / 'aps5-trace').mkdir(mode=0o700)
+    control, ack = run / 'perf-control.fifo', run / 'perf-ack.fifo'
+    os.mkfifo(control, 0o600)
+    os.mkfifo(ack, 0o600)
+    control_fd = os.open(control, os.O_RDWR | os.O_NONBLOCK)
+    ack_fd = os.open(ack, os.O_RDWR | os.O_NONBLOCK)
+    started = time.monotonic()
+    deadline = started + 25
+    process = None
+    target = None
+    target_fd = None
+    stop_snapshots = threading.Event()
+    snapshot_thread = None
+    snapshot_errors = []
+    receipt = {'schema': 1, 'kind': 'owned-sdk-no-game-fixture',
+               'scope': 'SDK instrumentation/CPU/wait correlation only; not game loading or FPS proof',
+               'binary': str(binary), 'binary_sha256': digest(binary), 'perf_cli': str(perf),
+               'status': 'starting'}
+    environment = os.environ.copy()
+    environment.update(APS5_TRACE_CAUSAL='1', APS5_TRACE_FRAMES='0:1',
+                       APS5_TRACE_EVENTS='65536', APS5_TRACE_DIR=str(run / 'aps5-trace'))
+    environment.pop('APS5_TRACE_SECONDS', None)
+    environment.pop('LD_PRELOAD', None)
+    argv = [str(perf), 'record', '-D', '-1', '--user-callchains', '--switch-output=signal',
+            f'--control=fifo:{control},{ack}', '-e', 'cpu-clock:u', '-F', '5', '-P', '-k', 'mono',
+            '--call-graph', 'dwarf,4096', '-m', '128', '--no-buildid-cache', '--max-size', '16M',
+            '-o', str(run / 'perf.data'), '--', str(binary), '--capture-smoke', str(run)]
+    receipt['command'] = argv
+    try:
+        with (run / 'process.log').open('xb') as log:
+            process = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=log,
+                                       stderr=subprocess.STDOUT, env=environment)
+        def ready():
+            if process.poll() is not None:
+                raise RuntimeError('perf/SDK fixture exited before readiness; see process.log')
+            path = run / 'ready.json'
+            if not path.exists():
+                return None
+            return json.loads(path.read_text())
+        identity = wait_until(ready, min(deadline, started + 6), 'SDK fixture did not become ready')
+        pid, birth = identity['pid'], identity['starttime_ticks']
+        if type(pid) is not int or pid <= 1 or type(birth) is not int or birth < 0:
+            raise RuntimeError('SDK fixture did not provide a real PID/birth identity')
+        cgroup = observer.proc_cgroup(os.getpid())
+        target = Target(pid, birth, binary, cgroup)
+        target_fd = os.pidfd_open(pid)
+        receipt['target'] = {'pid': pid, 'starttime_ticks': birth, 'cgroup': cgroup}
+        window = {'state': 'waiting', 'requested_seconds': 20,
+                  'coverage_status': 'partial', 'source': receipt['kind']}
+        def sampling_record():
+            save(run / 'sample-window.json', {'pid': pid, 'state': window['state'],
+                 'unit': 'owned-sdk-no-game-fixture', 'cgroup': cgroup,
+                 'updated': observer.clock_pair(), 'window': window})
+        window['enable'] = command(control_fd, ack_fd, 'enable', min(deadline, time.monotonic() + 3))
+        window['state'] = 'enabled'
+        sampling_record()
+        def snapshots():
+            previous = {}
+            number = 0
+            try:
+                with (run / 'resources.jsonl').open('x') as output:
+                    while not stop_snapshots.is_set():
+                        value, previous = observer.snapshot(target, previous)
+                        number += 1
+                        value['snapshot_number'] = number
+                        output.write(json.dumps(value) + '\n')
+                        output.flush()
+                        stop_snapshots.wait(0.1)
+            except Exception as error:
+                snapshot_errors.append(f'{type(error).__name__}: {error}')
+        snapshot_thread = threading.Thread(target=snapshots)
+        snapshot_thread.start()
+        (run / 'start').touch(exist_ok=False)
+        def completed():
+            if process.poll() is not None:
+                raise RuntimeError('SDK fixture exited before controlled finalization')
+            path = run / 'finished.json'
+            return json.loads(path.read_text()) if path.exists() else None
+        finished = wait_until(completed, min(deadline, time.monotonic() + 8), 'SDK CPU/block/CPU phases did not complete')
+        if finished.get('status') != 'completed':
+            raise RuntimeError('SDK fixture did not report completed phases')
+        phases = [json.loads(line) for line in (run / 'phases.jsonl').read_text().splitlines() if line.strip()]
+        if [phase.get('phase') for phase in phases] != ['cpu_before', 'gpu_mutex_wait', 'cpu_after']:
+            raise RuntimeError('SDK fixture did not emit the real ordered CPU/block/CPU phases')
+        target.verify_process()
+        window['disable'] = command(control_fd, ack_fd, 'disable', min(deadline, time.monotonic() + 3))
+        window['state'] = 'disabled'
+        window['disabled_reason'] = 'fixture_phases_completed'
+        window['actual_duration_ns'] = (window['disable']['ack_observed']['monotonic_ns'] -
+                                        window['enable']['ack_observed']['monotonic_ns'])
+        stop_snapshots.set()
+        snapshot_thread.join(timeout=2)
+        if snapshot_thread.is_alive() or snapshot_errors:
+            raise RuntimeError(f'Resource snapshot collection incomplete: {snapshot_errors}')
+        if process.poll() is not None:
+            raise RuntimeError('perf exited before split request')
+        os.kill(process.pid, signal.SIGUSR2)  # Unreaped direct child, never a process group.
+        def finalized():
+            paths = list(run.glob('perf.data.*'))
+            if len(paths) > 1:
+                raise RuntimeError('More than one finalized sample split')
+            if len(paths) != 1:
+                return None
+            info = split_closed(process.pid, paths[0])
+            return (paths[0], info) if info else None
+        path, info = wait_until(finalized, min(deadline, time.monotonic() + 3), 'No closed perf split after signal')
+        sha = digest(path)
+        decoded = subprocess.run([str(perf), 'script', '-i', str(path), '--ns', '-F',
+                                  'pid,tid,time,event,period'], capture_output=True, text=True,
+                                 timeout=min(6, max(0.1, deadline-time.monotonic())))
+        if decoded.returncode or len(decoded.stdout.encode()) > 8 * 1024 * 1024:
+            raise RuntimeError(f'Perf sample decoding failed or exceeded bounded fixture output: {decoded.stderr}')
+        verification = observer.parse_perf_sample_lines(decoded.stdout.splitlines(), pid,
+            window['enable']['ack_observed']['monotonic_ns'], window['disable']['ack_observed']['monotonic_ns'])
+        if not verification['usable_cpu_samples']:
+            raise RuntimeError('No actual matching-PID CPU samples inside acknowledged window')
+        verification.update(perf_data_sha256=sha, perf_data_path=str(path), perf_script_returncode=0,
+                            actual_duration_ns=window['actual_duration_ns'], coverage_status='partial',
+                            requested_seconds=20, parser_format='--ns -F pid,tid,time,event,period',
+                            window_start_monotonic_ns=window['enable']['ack_observed']['monotonic_ns'],
+                            window_end_monotonic_ns=window['disable']['ack_observed']['monotonic_ns'])
+        window['perf_finalization'] = {'state': 'finalized', 'target_pid': pid,
+            'target_starttime_ticks': birth, 'perf_argv': argv[0:argv.index('--')],
+            'signal_ack_status': 'SIGUSR2 syscall returned; no kernel-delivery ACK',
+            'new_finalized_paths': [{'path': str(path), 'device': info.st_dev, 'inode': info.st_ino,
+                                    'size_bytes': info.st_size, 'sha256': sha}],
+            'sample_data_verification': verification}
+        sampling_record()
+        target.verify_process()
+        (run / 'finish').touch(exist_ok=False)
+        code = process.wait(timeout=min(5, max(0.1, deadline-time.monotonic())))
+        if code:
+            raise RuntimeError(f'perf/SDK fixture exited {code}; see process.log')
+        if not select.select([target_fd], [], [], 2)[0]:
+            raise RuntimeError('SDK fixture identity remains alive after completion')
+        receipt.update(status='verified', process_exit=code, phases=phases, finished=finished,
+                       cpu_sampling=verification, target_identity_gone=True,
+                       elapsed_seconds=time.monotonic()-started)
+        save(run / 'result.json', receipt)
+        return receipt
+    except Exception as error:
+        receipt.update(status='failed', error=f'{type(error).__name__}: {error}',
+                       elapsed_seconds=time.monotonic()-started)
+        save(run / 'result.json', receipt)
+        raise
+    finally:
+        stop_snapshots.set()
+        if snapshot_thread is not None:
+            snapshot_thread.join(timeout=2)
+        if target_fd is not None:
+            if not select.select([target_fd], [], [], 0)[0]:
+                signal.pidfd_send_signal(target_fd, signal.SIGTERM)
+            os.close(target_fd)
+        if process is not None and process.poll() is None:
+            process.terminate()
+            try:
+                process.wait(timeout=2)
+            except subprocess.TimeoutExpired:
+                process.kill()
+                process.wait(timeout=2)
+        os.close(control_fd)
+        os.close(ack_fd)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('run_dir', type=Path)
+    parser.add_argument('--binary', type=Path, default=BASE / 'AnyPS5-pad-ack/build-padack/tests/agc_gpu_mutex_causality_tests')
+    parser.add_argument('--perf', help='Trusted perf executable; never read from an artifact')
+    args = parser.parse_args()
+    try:
+        value = capture(args)
+    except Exception as error:
+        print(f'{type(error).__name__}: {error}', file=sys.stderr)
+        return 1
+    print(json.dumps(value, indent=2))
+    return 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
