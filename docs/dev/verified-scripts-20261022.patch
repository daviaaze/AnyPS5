+    def _read_debugger_parent(self, pid):
+        process = Path('/proc') / str(pid)
+        try:
+            initial = proc_stat(pid)
+            cgroup = proc_cgroup(pid)
+            raw_cmdline = (process / 'cmdline').read_bytes()
+            current = proc_stat(pid)
+            current_cgroup = proc_cgroup(pid)
+            status = (process / 'status').read_text().splitlines()
+            uid_line = next(line for line in status if line.startswith('Uid:'))
+            effective_uid = int(uid_line.split()[2])
+            comm = (process / 'comm').read_text().strip()
+            executable_path = Path(os.readlink(process / 'exe')).resolve(strict=True)
+            executable_info = os.stat(process / 'exe')
+        except (OSError, StopIteration, ValueError, IndexError) as error:
+            raise ObserverError(f'cannot verify GDB parent PID {pid}: {error}') from error
+        if initial['starttime_ticks'] != current['starttime_ticks']:
+            raise ObserverError(f'GDB parent PID {pid} changed during identity verification')
+        if cgroup != self.identity.cgroup or current_cgroup != self.identity.cgroup:
+            raise ObserverError(f'GDB parent PID {pid} is not in the exact owned cgroup')
+        if effective_uid != os.geteuid() or comm != 'gdb':
+            raise ObserverError(f'GDB parent PID {pid} has an unexpected effective UID or comm')
+        if (executable_path.name != 'gdb' or executable_path.parent.name != 'bin'
+                or Path('/nix/store') not in executable_path.parents
+                or not stat.S_ISREG(executable_info.st_mode)
+                or not os.access(executable_path, os.X_OK)):
+            raise ObserverError(f'GDB parent PID {pid} executable is not a canonical Nix-store GDB')
+        argv = [os.fsdecode(argument) for argument in raw_cmdline.split(bytes(1)) if argument]
+        expected_argv = [
+            'gdb', '-q', '-nx', '--batch',
+            '-ex', 'set pagination off',
+            '-ex', 'set confirm off',
+            '-ex', 'set print thread-events off',
+            '-ex', 'set debuginfod enabled off',
+            '-ex', 'set disable-randomization off',
+            '-ex', f'set logging file {self.run_dir / "gdb-segv.log"}',
+            '-ex', 'set logging enabled on',
+            '-ex', 'handle SIGSEGV stop print nopass',
+            '-ex', 'run',
+            '-ex', 'info registers',
+            '-ex', 'thread apply all bt 32',
+            '-ex', 'x/16i $pc-16',
+            '-ex', 'quit',
+            '--args', './app.elf',
+        ]
+        if (len(argv) != len(expected_argv)
+                or argv[1:] != expected_argv[1:]
+                or argv[0] not in ('gdb', str(executable_path))):
+            raise ObserverError(f'GDB parent PID {pid} command line differs from the pinned SIGSEGV wrapper')
+        return {
+            'pid': pid, 'ppid': current['ppid'],
+            'starttime_ticks': current['starttime_ticks'],
+            'cgroup': current_cgroup, 'effective_uid': effective_uid,
+            'comm': comm, 'executable_path': str(executable_path),
+            'executable_device': executable_info.st_dev,
+            'executable_inode': executable_info.st_ino,
+            'argv': argv, 'argv_sha256': hashlib.sha256(raw_cmdline).hexdigest(),
+        }
+
+    def _read_perf_parent(self, pid):
+        process = Path('/proc') / str(pid)
+        try:
+            initial = proc_stat(pid)
+            cgroup = proc_cgroup(pid)
+            raw_cmdline = (process / 'cmdline').read_bytes()
+            current = proc_stat(pid)
+            current_cgroup = proc_cgroup(pid)
+            status = (process / 'status').read_text().splitlines()
+            uid_line = next(line for line in status if line.startswith('Uid:'))
+            effective_uid = int(uid_line.split()[2])
+            comm = (process / 'comm').read_text().strip()
+        except (OSError, StopIteration, ValueError, IndexError) as error:
+            raise ObserverError(f'cannot verify direct perf parent PID {pid}: {error}') from error
+        if initial['starttime_ticks'] != current['starttime_ticks']:
+            raise ObserverError(f'direct parent PID {pid} changed during perf identity verification')
+        if cgroup != self.identity.cgroup or current_cgroup != self.identity.cgroup:
+            raise ObserverError(f'direct parent PID {pid} is not in the exact owned cgroup')
+        if effective_uid != os.geteuid():
+            raise ObserverError(f'direct parent PID {pid} effective UID differs from the observer')
+        argv = [os.fsdecode(argument) for argument in raw_cmdline.split(bytes(1)) if argument]
+        switch_arguments = [argument for argument in argv
+                            if argument.startswith('--switch-output=')]
+        if (len(argv) < 3 or argv[1] != 'record'
+                or switch_arguments != ['--switch-output=signal'] or argv.count('-o') != 1):
+            raise ObserverError(
+                f'direct parent PID {pid} command line is not the exact controlled perf record')
+        output_index = argv.index('-o')
+        if (output_index + 1 >= len(argv)
+                or argv[output_index + 1] != str(self.identity.paths['perf_data'])):
+            raise ObserverError(f'direct parent PID {pid} does not target the exact perf output path')
+        control_argument = (
+            f'--control=fifo:{self.identity.paths["control_fifo"]},'
+            f'{self.identity.paths["ack_fifo"]}')
+        control_arguments = [argument for argument in argv
+                             if argument.startswith('--control=fifo:')]
+        if control_arguments != [control_argument]:
+            raise ObserverError(f'direct parent PID {pid} does not use the exact perf control FIFOs')
+        expected_values = {
+            '-D': '-1',
+            '-e': 'cpu-clock:u',
+            '-F': str(self.identity.sampling['frequency_hz']),
+            '-k': self.identity.sampling['clock'],
+            '--call-graph': self.identity.sampling['callgraph'],
+            '--max-size': self.identity.sampling['max_size'],
+        }
+        for option, expected in expected_values.items():
+            positions = [index for index, value in enumerate(argv) if value == option]
+            if (len(positions) != 1 or positions[0] + 1 >= len(argv)
+                    or argv[positions[0] + 1] != expected):
+                raise ObserverError(f'direct parent PID {pid} perf option {option} differs from authenticated sampling policy')
+        for option in ('-P', '-T', '--sample-cpu', '--no-buildid-cache'):
+            if argv.count(option) != 1:
+                raise ObserverError(f'direct parent PID {pid} perf option {option} is missing or duplicated')
+        wrapper = self._verify_nix_perf_script(argv[0], pid)
+        if comm not in ('.perf-wrapped', 'perf'):
+            raise ObserverError(f'direct parent PID {pid} comm is not a perf recorder: {comm!r}')
