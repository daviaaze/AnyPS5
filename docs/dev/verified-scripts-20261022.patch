+    except (OSError, ObserverError, ValueError, subprocess.SubprocessError) as error:
+        print(f'causal-observer: {type(error).__name__}: {error}', file=sys.stderr, flush=True)
+        return 1
+    return 2
+
+
+if __name__ == '__main__':
+    raise SystemExit(cli())
