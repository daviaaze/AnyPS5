+        if (active.get('query') != 'ok' or properties.get('ActiveState') != 'active'
+                or not isinstance(group, str)
+                or _normalized_cgroup(group)
+                != _normalized_cgroup(self.record['target'].get('cgroup'))):
+            raise RuntimeError('Owned unit identity changed or ceased being active before its ordered stop.')
+        owner = _read_owner()
+        worker = _collect_worker_result(self.run_dir, '')
+        if (owner is None or owner.get('state') != 'running'
+                or owner.get('unit') != self.unit_name or owner.get('kind') != 'game'
+                or owner.get('profile_name') != self.profile_name
+                or owner.get('runtime_seconds') != self.runtime_seconds
+                or owner.get('privileged_kernel') is not self.privileged_kernel_requested
+                or owner.get('output_dir') != str(self.run_dir)
+                or owner.get('identity') != self.identity
+                or owner.get('until_stopped', False) is not self.until_stopped
+                or owner.get('pipeline_dispatch', False) is not self.pipeline_dispatch
+                or owner.get('wait_idle_backoff', False) is not self.wait_idle_backoff
+                or not _guard_verified(worker, self.identity, self.profile_name,
+                                       self.runtime_seconds, self.privileged_kernel_requested,
+                                       self.until_stopped, self.pipeline_dispatch,
+                                       self.wait_idle_backoff)):
+            raise RuntimeError('Authenticated launch lease or worker identity changed before ordered unit stop.')
+        service_limits(Path('/sys/fs/cgroup') / group.lstrip('/'),
+                       self.runtime_seconds, self.unit_name, self.until_stopped)
+        current = _candidate_in_cgroup(self.identity, group)
+        if (current is None or current.get('pid') != self.record['target'].get('pid')
+                or current.get('starttime_ticks') != self.record['target'].get('starttime_ticks')):
+            raise RuntimeError('Pinned candidate identity changed before ordered owned-unit stop.')
+        if request is not None and self.read_stop_request() != request:
+            raise RuntimeError('Approved stop request changed before the owned-unit action.')
+        self.orderly_stop['steps'].append({
+            'step': 'owned_unit_stop_requested',
+            'at': {'monotonic_ns': time.monotonic_ns(), 'wall_time_ns': time.time_ns()},
+            'unit': self.unit_name, 'cgroup': group,
+            'target': current,
+        })
+        stop = _stop_unit(systemctl, self.unit_name)
+        self.orderly_stop['unit_stop'] = stop
+        if stop.get('returncode') != 0:
+            raise RuntimeError(f"Owned unit stop failed after orderly perf/observer shutdown: {stop}")
+        self.orderly_stop['status'] = 'unit_stop_requested'
+        self.record['shutdown'] = {'status': 'unit_stop_requested',
+                                   'orderly_stop': self.orderly_stop}
+        self._persist()
+        return self.orderly_stop
+
+    def _signal_observer(self, signum):
+        if self.observer is None or self.observer.poll() is not None:
+            return False
+        if self.observer_pidfd is None:
+            return False
+        signal.pidfd_send_signal(self.observer_pidfd, signum, None, 0)
+        return True
+
+    def finish_target(self, expected_stop_reason=None):
+        if self.observer is None:
+            return
+        try:
+            self.observer.wait(timeout=min(
+                CAUSAL_OBSERVER_STOP_TIMEOUT_SECONDS, self.stop_margin_seconds))
+        except subprocess.TimeoutExpired:
+            try:
+                self._signal_observer(signal.SIGTERM)
+                self.observer.wait(timeout=min(3, max(1, self.stop_margin_seconds // 3)))
+            except (OSError, subprocess.SubprocessError):
+                pass
+            if self.observer.poll() is None:
+                try:
+                    self._signal_observer(signal.SIGKILL)
+                    self.observer.wait(timeout=min(3, max(1, self.stop_margin_seconds // 3)))
+                except (OSError, subprocess.SubprocessError):
+                    pass
+        self._refresh(force=True)
+        self.record['observer']['returncode'] = self.observer.returncode
+        expected = expected_stop_reason or (
+            self.orderly_stop.get('reason') if self.orderly_stop else None)
+        stop_request = self.observer_status.get('stop_request') if self.observer_status else None
+        if (self.observer.returncode != 0 or not self.observer_status
+                or self.observer_status.get('state') != 'stopped_after_sample'
+                or expected is None or not isinstance(stop_request, dict)
+                or stop_request.get('reason') != expected
+                or not self.record['sample'].get('data_valid')
+                or not self.record['sample'].get('usable_cpu_samples')):
+            raise RuntimeError('Observer did not close cleanly after the matching ordered stop and usable CPU-data finalization.')
+
+    def abort_before_unit_stop(self, systemctl, reason, error):
+        cleanup = {'reason': reason, 'original_error': str(error), 'steps': []}
+        expected_reason = self.orderly_stop.get('reason') if self.orderly_stop else reason
+        try:
+            if self.observer is not None:
+                if self.observer.poll() is None:
+                    finished = self.finish_sample_before_shutdown(expected_reason)
+                    cleanup['steps'].append({
+                        'step': 'observer_sample_finalization_attempted',
+                        'result': finished,
+                    })
+                self.finish_target(expected_stop_reason=expected_reason)
+                cleanup['steps'].append({'step': 'observer_bounded_drain', 'verified': True})
+        except BaseException as observer_error:
+            cleanup['steps'].append({
+                'step': 'observer_bounded_drain', 'verified': False,
+                'error': f'{type(observer_error).__name__}: {observer_error}',
+            })
+            try:
+                self._fail('observer_teardown', observer_error)
+            except BaseException as persist_error:
+                cleanup['steps'].append({
+                    'step': 'observer_failure_status_persisted',
+                    'verified': False,
+                    'error': f'{type(persist_error).__name__}: {persist_error}',
+                })
+        try:
+            report = self._stop_privileged_kernel(reason)
+        except BaseException as helper_error:
+            report = {
+                'status': 'failed',
+                'failure': {'type': type(helper_error).__name__, 'detail': str(helper_error)},
+            }
+            self.record['privileged_kernel_capture'] = report
+            self._persist()
+        cleanup['steps'].append({
+            'step': 'privileged_kernel_stop_requested',
+            'report': report,
+        })
+        try:
+            termination = _stop_unit(systemctl, self.unit_name)
+        except BaseException as stop_error:
+            termination = {
+                'requested': False,
+                'error': f'{type(stop_error).__name__}: {stop_error}',
+            }
+        cleanup['steps'].append({
+            'step': 'owned_unit_stop_requested',
+            'result': termination,
+        })
+        self.record['abort_cleanup'] = cleanup
+        self._persist()
+        return {
+            'requested': termination.get('requested', False),
+            'ordered_stop_failure': str(error),
+            'abort_cleanup': cleanup,
+        }
+
+    def finish(self, unit_teardown):
+        observer_exited = self.observer is None or self.observer.poll() is not None
+        privileged_report = self.record['privileged_kernel_capture']
+        privileged_teardown = (
+            privileged_report.get('teardown')
+            if isinstance(privileged_report, dict) else None)
+        privileged_drained = (
+            not self.privileged_kernel_requested
+            or not self.privileged_kernel_start_attempted
+            or (isinstance(privileged_teardown, dict)
+                and privileged_teardown.get('verified') is True))
+        privileged_success = (
+            privileged_drained and (
+                not self.privileged_kernel_requested
+                or (isinstance(privileged_report, dict)
+                    and (self._privileged_kernel_report_evidence(privileged_report)[0]
+                         or self._bounded_kernel_window_finalized(privileged_report)
+                         or self._parser_limited_kernel_capture(privileged_report)))))
+        self.record['teardown'] = {
+            'observer_process_exited': observer_exited,
+            'observer_returncode': self.observer.returncode if self.observer else None,
+            'perf_recorder_cgroup_drained': unit_teardown.get('confirmed') is True,
+            'observer_process_drained': observer_exited,
+            'systemd_unit_drain_confirmed': unit_teardown.get('confirmed') is True,
+            'unit_drain': unit_teardown,
+            'privileged_kernel_helper_drained': privileged_drained
+            if self.privileged_kernel_requested else None,
+            'privileged_kernel_capture': privileged_report,
+        }
+        sample_valid = self.record['sample'].get('usable_cpu_samples') is True
+        stop_request = self.observer_status.get('stop_request') if self.observer_status else None
+        shutdown_success = (
+            self.orderly_stop is not None
+            and self.orderly_stop.get('status') == 'unit_stop_requested'
+            and self.observer_status is not None
+            and self.observer_status.get('state') == 'stopped_after_sample'
+            and isinstance(stop_request, dict)
+            and stop_request.get('reason') == self.orderly_stop.get('reason')
+            and observer_exited and self.observer is not None
+            and self.observer.returncode == 0
+            and self.orderly_stop.get('unit_stop', {}).get('returncode') == 0
+            and unit_teardown.get('confirmed') is True
+            and privileged_drained
+        )
+        stop_policy = self.record['runtime_stop_policy']
+        hard_deadline_ns = None
+        anchor_ns = stop_policy.get('anchor_monotonic_ns')
+        if not self.until_stopped and type(anchor_ns) is int:
+            hard_deadline_ns = anchor_ns + self.runtime_seconds * 1_000_000_000
+        stop_step = next((item for item in (self.orderly_stop or {}).get('steps', [])
+                          if item.get('step') == 'owned_unit_stop_requested'), None)
+        unit_stop_at = ((stop_step or {}).get('at') or {}).get('monotonic_ns')
+        deadline_respected = (
+            type(unit_stop_at) is int if self.until_stopped else
+            type(hard_deadline_ns) is int and type(unit_stop_at) is int
+            and unit_stop_at < hard_deadline_ns
+        )
+        stop_policy.update({
+            'hard_deadline_monotonic_ns': hard_deadline_ns,
+            'unit_stop_requested_monotonic_ns': unit_stop_at,
+            'deadline_respected': deadline_respected,
+            'status': (
+                'ordered_manual_stop' if shutdown_success and self.until_stopped else
+                'ordered_stop_before_hard_deadline' if shutdown_success and deadline_respected else
+                'ordered_shutdown_failed_or_deadline_unverified'
+            ),
+        })
+        shutdown_success = shutdown_success and deadline_respected
+        if self.orderly_stop is not None:
+            self.orderly_stop['steps'].append({
+                'step': 'owned_unit_drain_verified' if unit_teardown.get('confirmed') is True
+                else 'owned_unit_drain_unverified',
+                'at': {'monotonic_ns': time.monotonic_ns(), 'wall_time_ns': time.time_ns()},
+                'unit_drain': unit_teardown,
+            })
+            self.orderly_stop['status'] = 'complete' if shutdown_success else 'failed'
+        self.record['shutdown'] = {
+            'status': 'complete' if shutdown_success else 'failed',
+            'orderly_stop': self.orderly_stop,
+            'unit_drain': unit_teardown,
+            'privileged_kernel_capture': privileged_report,
+        }
+        success = (
+            self.record['outcome'] != 'failed'
+            and sample_valid
+            and self.record['finalization'].get('status') == 'finalized'
+            and shutdown_success
+            and privileged_success
+        )
+        self.record['outcome'] = 'success' if success else 'failed'
+        self.record['state'] = 'complete' if success else 'failed'
+        self.record['usable_cpu_samples'] = sample_valid
+        if not success and 'failures' not in self.record:
+            self.record['failures'] = [{
+                'stage': 'final_outcome',
+                'type': 'RuntimeError',
+                'detail': 'CPU sample validity and ordered observer/unit shutdown are reported separately; one or both were not verified.',
+                'at': time.time(),
+            }]
+        self.record['finished_at'] = time.time()
+        self._persist()
+        try:
+            request = self.read_stop_request()
+        except (OSError, RuntimeError, ValueError) as error:
+            request = None
+            self.record['failures'].append({
+                'stage': 'stop_request_receipt',
+                'type': type(error).__name__, 'detail': str(error), 'at': time.time(),
+            })
+            self._persist()
+        if request is not None:
+            receipt = {
+                'version': 1,
+                'status': 'complete' if shutdown_success else 'failed',
+                'unit': self.unit_name,
+                'target': {
+                    'pid': self.record['target'].get('pid'),
+                    'starttime_ticks': self.record['target'].get('starttime_ticks'),
+                    'cgroup': self.record['target'].get('cgroup'),
+                },
+                'requested_at': request['requested_at'],
+                'cpu_data': {
+                    'usable_cpu_samples': sample_valid,
+                    'coverage_status': self.record['sample'].get('coverage_status'),
+                },
+                'privileged_kernel_capture': privileged_report,
+                'shutdown': self.record['shutdown'],
+            }
+            _atomic_json(self.stop_result_path, receipt, replace=False)
+        for fd_name in ('observer_pidfd',):
+            fd = getattr(self, fd_name)
+            if fd is not None:
+                os.close(fd)
+                setattr(self, fd_name, None)
+        for stream_name in ('observer_stdout', 'observer_stderr'):
+            stream = getattr(self, stream_name)
+            if stream is not None:
+                stream.close()
+                setattr(self, stream_name, None)
+        return self.record
+
+
+def request_causal_stop(run_dir):
+    raw = Path(run_dir)
+    if not raw.is_absolute():
+        raw = Path.cwd() / raw
+    resolved = raw.resolve(strict=True)
+    evidence = (WORKBENCH / 'evidence').resolve(strict=True)
+    if (raw != resolved or resolved.parent != evidence
+            or not resolved.name.startswith('native-game-')):
+        raise RuntimeError('Early stop requires an exact, non-symlink native-game evidence run directory.')
+
+    def read_owned_json(path, limit):
+        info = path.lstat()
+        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid()
+                or info.st_size > limit):
+            raise RuntimeError(f'Owned stop-control record is not a bounded regular file: {path.name}')
+        value = json.loads(path.read_text())
+        if not isinstance(value, dict):
+            raise RuntimeError(f'Owned stop-control record is not a JSON object: {path.name}')
+        return value
+
+    capture = read_owned_json(resolved / 'causal-capture-status.json', 1024 * 1024)
+    if capture.get('target', {}).get('status') != 'verified':
+        raise RuntimeError('Cannot stop a causal capture before the target identity is verified.')
+    target = capture['target']
+    unit = capture.get('unit')
+    cgroup = target.get('cgroup')
+    pid = target.get('pid')
+    starttime = target.get('starttime_ticks')
+    if (not isinstance(unit, str) or type(pid) is not int or pid <= 1
+            or type(starttime) is not int or starttime <= 0
+            or not isinstance(cgroup, str)):
+        raise RuntimeError('Causal capture status lacks a pinned unit/PID/starttime/cgroup.')
+    requested_at = {'monotonic_ns': time.monotonic_ns(), 'wall_time_ns': time.time_ns()}
+    request_path = resolved / 'causal-stop-request.json'
+    result_path = resolved / 'causal-stop-result.json'
+    request = {
+        'version': 1, 'source': 'bounded-diagnostic.py', 'unit': unit,
+        'target': {'pid': pid, 'starttime_ticks': starttime, 'cgroup': cgroup},
+        'requested_at': requested_at,
+    }
+    try:
+        existing = read_owned_json(request_path, 4096)
+    except FileNotFoundError:
+        existing = None
+    if existing is not None:
+        if any(existing.get(key) != value for key, value in request.items() if key != 'requested_at'):
+            raise RuntimeError('Existing early-stop request names a different target or launch unit.')
+        request = existing
+    try:
+        receipt = read_owned_json(result_path, 1024 * 1024)
+    except FileNotFoundError:
+        receipt = None
+    if receipt is None and existing is None:
+        owner = _read_owner()
+        if (owner is None or owner.get('state') != 'running'
+                or owner.get('kind') != 'game' or owner.get('unit') != unit
+                or owner.get('output_dir') != str(resolved)
+                or _normalized_cgroup(owner.get('cgroup')) != _normalized_cgroup(cgroup)):
+            raise RuntimeError('No matching active native-game launch lease owns this run directory.')
+        _atomic_json(request_path, request, replace=False)
+    deadline = time.monotonic() + 60
+    while receipt is None and time.monotonic() < deadline:
+        try:
+            receipt = read_owned_json(result_path, 1024 * 1024)
+        except FileNotFoundError:
+            time.sleep(0.1)
+    if receipt is None:
+        raise RuntimeError('Early-stop request remains pending; the authenticated controller did not publish its bounded drain receipt.')
+    if (receipt.get('unit') != unit or receipt.get('target') != request['target']
+            or receipt.get('requested_at') != request['requested_at']):
+        raise RuntimeError('Early-stop completion receipt differs from the submitted request identity.')
+    if receipt.get('status') != 'complete':
+        raise RuntimeError(f"Early stop did not complete its ordered observer/unit drain: {receipt}")
+    return receipt
+
+
+def run_supervised(*, kind, unit_name, worker_command, profile_name, runtime_seconds,
+                   identity, working_directory, output_dir=None, extra_environment=None,
+                   cpus=None, prepare=None, causal_trace=False, privileged_kernel=False,
+                   until_stopped=False, pipeline_dispatch=False, wait_idle_backoff=False):
+    if type(runtime_seconds) is not int or runtime_seconds < 1:
+        raise RuntimeError('Service sample duration must be a positive integer number of seconds.')
+    if type(until_stopped) is not bool or until_stopped and not (
+            kind == 'game' and profile_name == 'normal' and causal_trace):
+        raise RuntimeError('Manual-stop mode requires a normal-profile causal game capture.')
+    if type(pipeline_dispatch) is not bool or pipeline_dispatch and not (
+            kind == 'game' and profile_name in ('normal', 'bounded')):
+        raise RuntimeError('Pipeline dispatch treatment requires a normal or bounded-profile game.')
+    if (type(wait_idle_backoff) is not bool
+            or wait_idle_backoff != (identity.get('wait_idle_preload') is not None)
+            or wait_idle_backoff and kind != 'game'):
+        raise RuntimeError('Wait-idle backoff requires its verified identity and explicit game launch.')
+    if profile_name == 'normal' and runtime_seconds > 360 and not until_stopped:
+        raise RuntimeError('Bounded normal-profile runtime cannot exceed 360 seconds.')
+    if profile_name == 'bounded' and runtime_seconds > 180:
+        raise RuntimeError('Bounded-profile runtime cannot exceed 180 seconds.')
+    if causal_trace and (kind != 'game' or profile_name not in ('capture24', 'normal', 'bounded')):
+        raise RuntimeError('Causal tracing is restricted to capture24, normal, or bounded game profiles.')
+    if causal_trace and profile_name == 'capture24' and runtime_seconds != 900:
+        raise RuntimeError('capture24 causal tracing requires its exact 900-second sample duration.')
+    if causal_trace and not output_dir:
+        raise RuntimeError('Causal tracing requires a parent-owned run directory.')
+    if type(privileged_kernel) is not bool:
+        raise RuntimeError('Privileged kernel request must be a boolean.')
+    if privileged_kernel:
+        if (not causal_trace or kind != 'game' or profile_name != 'normal'
+                or until_stopped):
+            raise RuntimeError('Privileged kernel capture requires a bounded normal game trace.')
+        privileged_kernel_window(runtime_seconds)
+    systemd_run = shutil.which('systemd-run')
+    systemctl = shutil.which('systemctl')
+    if systemd_run is None or systemctl is None:
+        raise RuntimeError('User systemd resource controls are required; no unbounded fallback is provided.')
+    lease = acquire_launch(
+        kind, unit_name, identity, output_dir, causal_trace, extra_environment,
+        profile_name=profile_name, runtime_seconds=runtime_seconds,
+        privileged_kernel=privileged_kernel, until_stopped=until_stopped,
+        pipeline_dispatch=pipeline_dispatch, wait_idle_backoff=wait_idle_backoff)
+    created = False
+    process = None
+    client_timeout = False
+    interrupt = False
+    termination_request = {'requested': False}
+    stdout_file = stderr_file = None
+    client_threads = []
+    stdout_errors = []
+    stderr_errors = []
+    client_output_complete = True
+    output_path = Path(output_dir).resolve() if output_dir else None
+    causal_capture = None
+    causal_abort_requested = False
+    try:
+        if output_path:
+            output_path.parent.mkdir(parents=False, exist_ok=True)
+            output_path.mkdir(exist_ok=False)
+            created = True
+            if prepare:
+                prepare(output_path)
+        elif prepare:
+            prepare(None)
+        if causal_trace:
+            causal_capture = CausalCapture(
+                output_path, unit_name, identity, profile_name, runtime_seconds,
+                privileged_kernel=privileged_kernel, until_stopped=until_stopped,
+                pipeline_dispatch=pipeline_dispatch, wait_idle_backoff=wait_idle_backoff)
+        lease.update(state='prepared')
+        command = [systemd_run, '--user', '--wait', '--pipe', '--service-type=exec',
+                   f'--unit={unit_name}', f'--working-directory={working_directory}']
+        properties = systemd_properties(profile_name, runtime_seconds, cpus, until_stopped)
+        command.extend(f'--property={name}={value}' for name, value in properties.items())
+        environment_values = _systemd_environment(lease.token, kind, unit_name, output_path,
+                                                   extra_environment, causal_trace)
+        command.extend(f'--setenv={name}={value}' for name, value in environment_values.items())
+        command.extend(['--', *worker_command])
+        if output_path:
+            stdout_file = (output_path / 'systemd-client.stdout').open('x+b')
+            stderr_file = (output_path / 'systemd-client.stderr').open('x+b')
+        else:
+            stdout_file = tempfile.TemporaryFile(mode='w+b')
+            stderr_file = tempfile.TemporaryFile(mode='w+b')
+        client_environment = os.environ.copy()
+        client_environment.pop('LD_PRELOAD', None)
+        client_environment.pop('DS_DEPENDENCY_PRELOAD', None)
+        launch_anchor_ns = time.monotonic_ns()
+        stop_margin_seconds = causal_stop_margin_seconds(runtime_seconds)
+        causal_stop_deadline_ns = (
+            None if until_stopped else
+            launch_anchor_ns + max(1, runtime_seconds - stop_margin_seconds) * 1_000_000_000
+            if causal_trace else None)
+        causal_stop_deadline = (
+            causal_stop_deadline_ns / 1_000_000_000 if causal_stop_deadline_ns is not None else None)
+        process = subprocess.Popen(command, cwd=working_directory, env=client_environment,
+                                   stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                                   bufsize=0, close_fds=True)
+        client_threads = [
+            threading.Thread(target=_pump_client_output,
+                             args=(process.stdout, stdout_file, sys.stdout, stdout_errors), daemon=True),
+            threading.Thread(target=_pump_client_output,
+                             args=(process.stderr, stderr_file, sys.stderr, stderr_errors), daemon=True),
+        ]
+        if causal_capture is not None:
+            causal_capture.record['runtime_stop_policy'] = {
+                'status': 'manual_stop_only' if until_stopped else 'controller_deadline_armed',
+                'hard_runtime_seconds': None if until_stopped else runtime_seconds,
+                'margin_seconds': causal_stop_margin_seconds(runtime_seconds),
+                'anchor_monotonic_ns': launch_anchor_ns,
+                'stop_deadline_monotonic_ns': causal_stop_deadline_ns,
+                'anchor': 'immediately before systemd-run client start; no later than service activation',
+            }
+            causal_capture._persist()
+        for thread in client_threads:
+            thread.start()
+        lease.update(state='running', client_pid=process.pid,
+                     requested_limits={'profile': profile_name, 'runtime_seconds': runtime_seconds,
+                                       'until_stopped': until_stopped, 'properties': properties})
+        causal_stop_handled = False
+        try:
+            deadline = None if until_stopped else time.monotonic() + runtime_seconds + STOP_SECONDS + 30
+            next_unit_check = 0.0
+            next_causal_check = 0.0
+            active_unit = {'query': 'unknown', 'properties': {}}
+            while process.poll() is None:
+                now = time.monotonic()
+                if deadline is not None and now >= deadline:
+                    raise subprocess.TimeoutExpired(command, runtime_seconds + STOP_SECONDS + 30)
+                if now >= next_unit_check:
+                    active_unit = _unit_snapshot(systemctl, unit_name)
+                    control_group = (active_unit.get('properties') or {}).get('ControlGroup')
+                    if active_unit['query'] == 'ok' and control_group:
+                        lease.update(state='running', cgroup=control_group,
+                                     active_unit_snapshot=active_unit)
+                    next_unit_check = now + 1
+                if causal_capture is not None and not causal_abort_requested:
+                    try:
+                        if now >= next_causal_check:
+                            worker = _collect_worker_result(output_path, '')
+                            causal_capture.start_if_ready(worker, active_unit)
+                            next_causal_check = now + 0.5
+                        causal_capture.poll()
+                        if causal_capture is not None and not causal_abort_requested and not causal_stop_handled:
+                            stop_request = causal_capture.read_stop_request()
+                            kernel_finalized = (
+                                privileged_kernel
+                                and runtime_seconds != 180
+                                and causal_capture._privileged_kernel_report_evidence(
+                                    causal_capture.record['privileged_kernel_capture'])[0])
+                            deadline_reached = causal_stop_deadline is not None and now >= causal_stop_deadline
+                            if stop_request is not None or deadline_reached or kernel_finalized:
+                                causal_capture.record['runtime_stop_policy']['trigger'] = (
+                                    'approved_request' if stop_request is not None else
+                                    'privileged_capture_finished' if kernel_finalized else
+                                    'controller_capture_deadline')
+                                reason = 'approved_early_stop' if stop_request is not None else 'controller_deadline'
+                                try:
+                                    ordered_stop = causal_capture.stop_orderly(
+                                        systemctl, reason, request=stop_request)
+                                    termination_request = {
+                                        'requested': True, 'ordered_causal_stop': ordered_stop,
+                                    }
+                                except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as error:
+                                    causal_capture._fail('shutdown_finalization', error)
+                                    termination_request = causal_capture.abort_before_unit_stop(
+                                        systemctl, 'controller_failure', error)
+                                    causal_abort_requested = True
+                                causal_stop_handled = True
+                    except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as error:
+                        stage = ('target_discovery'
+                                 if causal_capture.record['target'].get('status') == 'pending'
+                                 else 'activation_or_sampling')
+                        causal_capture._fail(stage, error)
+                        termination_request = causal_capture.abort_before_unit_stop(
+                            systemctl, 'controller_failure', error)
+                        causal_abort_requested = True
+                time.sleep(0.1 if deadline is None else min(0.1, max(0.0, deadline - time.monotonic())))
+            process.wait()
+        except subprocess.TimeoutExpired:
+            client_timeout = True
+            if causal_capture is not None:
+                try:
+                    ordered_stop = causal_capture.stop_orderly(systemctl, 'controller_timeout')
+                    termination_request = {'requested': True, 'ordered_causal_stop': ordered_stop}
+                except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as stop_error:
+                    causal_capture._fail('shutdown_finalization', stop_error)
+                    termination_request = causal_capture.abort_before_unit_stop(
+                        systemctl, 'controller_timeout', stop_error)
+            else:
+                termination_request = _stop_unit(systemctl, unit_name)
+            if process.poll() is None:
+                process.kill()
+                process.wait()
+        except KeyboardInterrupt:
+            interrupt = True
+            if causal_capture is not None:
+                try:
+                    ordered_stop = causal_capture.stop_orderly(systemctl, 'shutdown_interrupt')
+                    termination_request = {'requested': True, 'ordered_causal_stop': ordered_stop}
+                except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as stop_error:
+                    causal_capture._fail('shutdown_finalization', stop_error)
+                    termination_request = causal_capture.abort_before_unit_stop(
+                        systemctl, 'shutdown_interrupt', stop_error)
+            else:
+                termination_request = _stop_unit(systemctl, unit_name)
+            if process.poll() is None:
+                process.terminate()
+                try:
+                    process.wait(timeout=3)
+                except subprocess.TimeoutExpired:
+                    process.kill()
+                    process.wait()
+        if causal_capture is not None:
+            if causal_capture.observer is None and causal_capture.record['outcome'] != 'failed':
+                try:
+                    final_worker = _collect_worker_result(output_path, '')
+                    final_unit = _unit_snapshot(systemctl, unit_name)
+                    causal_capture.start_if_ready(final_worker, final_unit, client_finished=True)
+                except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as error:
+                    causal_capture._fail('target_discovery', error)
+                    termination_request = causal_capture.abort_before_unit_stop(
+                        systemctl, 'controller_failure', error)
+                    causal_abort_requested = True
