+            result = subprocess.run(
+                [perf_cli, 'script', '--ns', '-F', 'pid,tid,time,event,period',
+                 '-i', str(split_path)],
+                capture_output=True, text=True, encoding='utf-8', errors='replace',
+                timeout=15, check=False)
