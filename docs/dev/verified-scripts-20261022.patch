+    unit = f'anyps5-target-discovery-{identifier}.service'
+    run_dir.mkdir(parents=True, exist_ok=False)
+    stdout = (run_dir / 'service.stdout').open('xb')
+    stderr = (run_dir / 'service.stderr').open('xb')
+    command = [
+        systemd_run, '--user', '--wait', '--pipe', '--service-type=exec',
+        f'--unit={unit}', f'--working-directory={FIXTURE_DIR}',
+        '--property=RuntimeMaxSec=25s', '--property=TimeoutStopSec=2s',
+        '--property=KillMode=control-group', '--property=KillSignal=SIGTERM',
+        '--property=FinalKillSignal=SIGKILL', '--property=SendSIGKILL=yes',
+        '--property=Restart=no', '--property=TasksMax=64',
+        '--property=CPUQuota=100%', '--property=MemoryMax=1073741824',
+        f'--setenv=PATH={os.environ.get("PATH", "")}',
+        '--setenv=LD_PRELOAD=', '--setenv=DS_DEPENDENCY_PRELOAD=',
+        '--', sys.executable, '-c', DISCOVERY_WORKER, mode,
+        str(WORKLOAD.resolve()), str(run_dir),
+    ]
+    try:
+        process = subprocess.Popen(command, cwd=WORKBENCH, stdin=subprocess.DEVNULL,
+                                   stdout=stdout, stderr=stderr, close_fds=True)
+    except BaseException:
+        stdout.close()
+        stderr.close()
+        raise
+    return {'unit': unit, 'process': process, 'run_dir': run_dir,
+            'stdout': stdout, 'stderr': stderr, 'cgroup': None,
+            'unit_started': True, 'stopped': False}
