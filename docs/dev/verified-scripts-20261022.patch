+        'LD_PRELOAD', 'DS_DEPENDENCY_PRELOAD', 'APS5_DUMP_SHADERS',
+        'APS5_PAD_INPUT_FILE', 'RADV_DEBUG', 'APS5_SYNC_DISPATCH', 'APS5_PROFILE_DRAW',
+        'ANYPS5_NO_SHADER_CACHE', 'APS5_THREAD_PRIORITY', 'APS5_LAZY_SHADER_PREPARE',
