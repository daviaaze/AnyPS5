+    start.add_argument('--run-dir', required=True)
+    start.add_argument('--fixture', action='store_true',
+                       help='Require the canonical CPU-fixture manifest and owned unit.')
+    start.add_argument('--seconds', type=int, help='Optional shorter fixture-only duration.')
+    orderly = commands.add_parser('orderly-stop', help='Finalize perf and exit the observer before the controller stops its owned unit.')
+    orderly.add_argument('--run-dir', required=True)
+    orderly.add_argument('--fixture', action='store_true')
+    orderly.add_argument('--reason', required=True,
+                         choices=('approved_early_stop', 'controller_deadline',
+                                  'controller_timeout', 'controller_failure',
+                                  'shutdown_interrupt', 'fixture_early_stop'))
+    mark = commands.add_parser('mark', help='Record a caller scene label with emitted and received timestamps.')
+    mark.add_argument('--run-dir', required=True)
+    mark.add_argument('--name', required=True, choices=sorted(SCENE_MARKERS))
+    args = parser.parse_args()
+    try:
+        if args.command == 'parser-fixture':
+            result = _perf_parser_fixture()
+            print(json.dumps(result, sort_keys=True), flush=True)
+            return 0
+        if args.command == 'timer-failure-fixture':
+            result = _timer_failure_fixture()
+            print(json.dumps(result, sort_keys=True), flush=True)
+            return 0
+        run_dir = resolve_run_dir(args.run_dir)
+        if args.command == 'monitor':
+            if args.pid <= 1:
+                raise ObserverError('PID must be greater than 1')
+            if args.sample_seconds < 1 or args.sample_seconds > MAX_SAMPLE_SECONDS:
+                raise ObserverError(f'--sample-seconds must be 1..{MAX_SAMPLE_SECONDS}')
+            if args.fixture:
+                if args.expected_starttime is not None:
+                    raise ObserverError('--expected-starttime is not used with fixture manifests')
+                validate_fixture_run_dir(run_dir)
+            if args.fixture_timer_failure and not args.fixture:
+                raise ObserverError('--fixture-timer-failure requires --fixture')
+            if args.expected_starttime is not None and args.expected_starttime <= 0:
+                raise ObserverError('--expected-starttime must be positive')
+            signal.signal(signal.SIGTERM, request_shutdown)
+            signal.signal(signal.SIGINT, request_shutdown)
+            observer = Monitor(
+                run_dir, args.pid, args.sample_seconds, fixture=args.fixture,
+                expected_starttime_ticks=args.expected_starttime,
+                fixture_timer_failure=args.fixture_timer_failure,
+                external_kernel=args.external_kernel)
+            observer.run()
+            return 0
+        if args.command == 'orderly-stop':
+            if args.fixture:
+                validate_fixture_run_dir(run_dir)
+                manifest = read_json_regular(run_dir / 'fixture-manifest.json')
+                pid = manifest.get('pid')
+                if type(pid) is not int:
+                    raise ObserverError('fixture manifest has no integer PID')
+                FixtureIdentity(run_dir, pid)
+            result = request_monitor(
+                run_dir, {'command': 'orderly-stop', 'reason': args.reason},
+                fixture=args.fixture)
+            window = result.get('sample_window')
+            disable = window.get('disable') if isinstance(window, dict) else None
+            finalization = window.get('perf_finalization') if isinstance(window, dict) else None
+            verification = (finalization.get('sample_data_verification')
+                            if isinstance(finalization, dict) else None)
+            stop_request = result.get('stop_request')
+            if (result.get('ready') is not True or result.get('observer_will_exit') is not True
+                    or not isinstance(stop_request, dict)
+                    or stop_request.get('reason') != args.reason
+                    or not isinstance(disable, dict)
+                    or disable.get('command') != 'disable' or disable.get('ack_line') != 'ack'
+                    or not isinstance(finalization, dict)
+                    or finalization.get('state') != 'finalized'
+                    or not isinstance(verification, dict)
+                    or verification.get('usable_cpu_samples') is not True):
+                raise ObserverError('orderly-stop response lacks its reason, real disable ACK, and parsed finalized CPU data')
+            print(json.dumps(result, sort_keys=True), flush=True)
+            return 0
+        if args.command == 'start-sample':
+            if args.fixture:
+                validate_fixture_run_dir(run_dir)
+                manifest = read_json_regular(run_dir / 'fixture-manifest.json')
+                pid = manifest.get('pid')
+                if type(pid) is not int:
+                    raise ObserverError('fixture manifest has no integer PID')
+                FixtureIdentity(run_dir, pid)
+            elif args.seconds is not None:
+                raise ObserverError('shorter --seconds overrides are restricted to --fixture mode')
+            request = {'command': 'start-sample'}
+            if args.seconds is not None:
+                request['seconds'] = args.seconds
+            result = request_monitor(run_dir, request, fixture=args.fixture)
+            window = result.get('sample_window')
+            enable_ack = window.get('enable') if isinstance(window, dict) else None
+            observed_ack = enable_ack.get('ack_observed') if isinstance(enable_ack, dict) else None
+            if (result.get('ready') is not True or not isinstance(enable_ack, dict)
+                    or enable_ack.get('command') != 'enable' or enable_ack.get('ack_line') != 'ack'
+                    or not isinstance(observed_ack, dict)
+                    or type(observed_ack.get('monotonic_ns')) is not int
+                    or type(observed_ack.get('wall_time_ns')) is not int):
+                raise ObserverError('observer response is not backed by an observed enable FIFO ACK')
+            print(json.dumps(result, sort_keys=True), flush=True)
+            return 0
+        if args.command == 'mark':
+            result = request_monitor(run_dir, {'command': 'mark', 'name': args.name})
+            print(json.dumps(result, sort_keys=True), flush=True)
