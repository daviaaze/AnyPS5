+            raise ObserverError(f'perf script could not parse the finalized sample split: {error}') from error
+        if result.returncode != 0:
+            raise ObserverError(
+                f'perf script failed to parse finalized sample data (exit {result.returncode}): '
+                f'{result.stderr[-4096:]}')
