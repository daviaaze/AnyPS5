+def _collect_worker_result(output_dir, stdout):
+    if output_dir:
+        path = Path(output_dir) / 'worker-result.json'
+        try:
+            return json.loads(path.read_text())
+        except FileNotFoundError:
+            pass
+        except (OSError, ValueError) as error:
+            return {'classification': 'unknown', 'error': f'worker result unreadable: {error}'}
+    for line in stdout.splitlines():
+        if line.startswith('NATIVE_WORKER_RESULT='):
+            try:
+                return json.loads(line.split('=', 1)[1])
+            except (ValueError, TypeError):
+                return {'classification': 'unknown', 'error': 'worker result line malformed'}
+    return {'classification': 'unknown', 'reason': 'worker result unavailable'}
+
+
+def _collect_inferior(output_dir):
+    unknown = {'kind': 'unknown', 'exit_code': None, 'exit_signal': None,
+               'signal_name': None, 'cause': 'unknown'}
+    unknown_collector = {'kind': 'unknown', 'exit_code': None, 'exit_signal': None,
+                         'signal_name': None, 'cause': 'unknown'}
+    unknown_teardown = {'requested': 'unknown', 'reason': 'unknown'}
+    if not output_dir:
+        return {**unknown, 'source': None, 'collector_outcome': 'unknown',
+                'collector_termination': unknown_collector,
+                'collector_teardown': unknown_teardown}
+    for filename in ('capture.json', 'report.json', 'error.json'):
+        path = Path(output_dir) / filename
+        try:
+            data = json.loads(path.read_text())
+        except FileNotFoundError:
+            continue
+        except (OSError, ValueError) as error:
+            return {**unknown, 'source': filename, 'error': str(error),
+                    'collector_outcome': 'unknown',
+                    'collector_termination': unknown_collector,
+                    'collector_teardown': unknown_teardown}
+        collector_termination = data.get('collector_termination')
+        if not isinstance(collector_termination, dict):
+            collector_termination = unknown_collector
+        collector_teardown = data.get('collector_teardown')
+        if not isinstance(collector_teardown, dict):
+            collector_teardown = unknown_teardown
+        collector = {'source': filename,
+                     'collector_outcome': data.get('outcome') or 'unknown',
+                     'collector_termination': collector_termination,
+                     'collector_teardown': collector_teardown}
+        termination = data.get('inferior_termination')
+        if isinstance(termination, dict):
+            result = {key: termination.get(key) for key in
+                      ('kind', 'exit_code', 'exit_signal', 'signal_name', 'cause')}
+            result.update(collector)
+            for key in ('kind', 'cause'):
+                if not result[key]:
+                    result[key] = 'unknown'
+            return result
+        return {**unknown, **collector,
+                'reason': 'collector has not supplied typed inferior_termination fields'}
+    return {**unknown, 'source': None, 'collector_outcome': 'unknown',
+            'collector_termination': unknown_collector,
+            'collector_teardown': unknown_teardown,
+            'reason': 'no collector inferior classification available'}
+
+
+def _stop_unit(systemctl, unit_name):
+    try:
+        result = subprocess.run([systemctl, '--user', 'stop', unit_name], capture_output=True,
+                                text=True, timeout=STOP_SECONDS + 3, check=False)
+        return {'requested': True, 'returncode': result.returncode,
+                'stdout': result.stdout, 'stderr': result.stderr}
+    except (OSError, subprocess.SubprocessError) as error:
+        return {'requested': True, 'returncode': None, 'error': str(error)}
+
+
+def _drain_state(systemctl, unit_name, recorded_cgroup, identity):
+    unit = _unit_snapshot(systemctl, unit_name)
+    properties = unit.get('properties', {})
+    group = properties.get('ControlGroup') or recorded_cgroup
+    cgroup = (_cgroup_state(group) if group else
+              {'path': None, 'exists': False, 'populated': False}
+              if unit['query'] == 'not_found' else
+              {'path': None, 'exists': None, 'populated': None, 'error': 'control group unknown'})
+    active = unit['query'] == 'ok' and properties.get('ActiveState') not in ('inactive', 'failed')
+    matches = candidate_processes(identity)
+    confirmed = (not active and unit['query'] in ('ok', 'not_found')
+                 and cgroup['populated'] is False and not matches)
+    return {'confirmed': confirmed, 'unit': unit, 'cgroup': cgroup,
+            'candidate_processes': matches,
+            'condition': 'unit inactive/not found, cgroup empty or absent, and no pinned candidate process'
+                         if confirmed else 'unit/cgroup/process drain is not fully verified'}
+
+
+def _wait_for_drain(systemctl, unit_name, recorded_cgroup, identity):
+    latest = None
+    for _ in range(STOP_SECONDS + 3):
+        try:
+            latest = _drain_state(systemctl, unit_name, recorded_cgroup, identity)
+        except (OSError, RuntimeError, ValueError) as error:
+            latest = {'confirmed': False, 'error': str(error),
+                      'condition': 'drain verification failed; state remains unknown'}
+        if latest.get('confirmed'):
+            return latest
+        time.sleep(1)
+    return latest or {'confirmed': False, 'condition': 'drain verification unavailable'}
+
+
+def _unit_classification(unit):
+    properties = unit.get('properties', {})
+    return {
+        'result': properties.get('Result') or 'unknown',
+        'exec_main_code': properties.get('ExecMainCode') or 'unknown',
+        'exit_status': properties.get('ExecMainStatus') or 'unknown',
+        'cpu_usage_nsec': properties.get('CPUUsageNSec') or 'unknown',
+        'memory_peak_bytes': properties.get('MemoryPeak') or 'unknown',
+    }
+
+def _guard_verified(worker, identity, profile_name, runtime_seconds,
+                    privileged_kernel=False, until_stopped=False, pipeline_dispatch=False,
+                    wait_idle_backoff=False):
+    if not isinstance(worker, dict):
+        return False
+    profile = worker.get('profile')
+    if not isinstance(profile, dict):
+        return False
+    kernel = profile.get('kernel_limits')
+    service = profile.get('service_limits')
+    return (
+        worker.get('identity') == identity
+        and worker.get('condition') == 'authenticated parent lease; exact candidate and systemd/cgroup policies verified'
+        and worker.get('privileged_kernel_requested') is privileged_kernel
+        and worker.get('until_stopped') is until_stopped
+        and worker.get('pipeline_dispatch') is pipeline_dispatch
+        and worker.get('wait_idle_backoff') is wait_idle_backoff
+        and profile.get('profile') == profile_name
+        and profile.get('runtime_seconds') == runtime_seconds
+        and profile.get('until_stopped') is until_stopped
+        and profile.get('pipeline_dispatch') is pipeline_dispatch
+        and isinstance(profile.get('cgroup'), str) and bool(profile['cgroup'])
+        and isinstance(kernel, dict) and set(('cpu.max', 'memory.high', 'memory.max',
+                                               'memory.swap.max', 'pids.max')) <= kernel.keys()
+        and isinstance(service, dict) and set(SERVICE_PROPERTIES) <= service.keys()
+    )
+
+
+def _summarize_client_output(stream, path=None):
+    unknown = {'path': str(path) if path else None, 'size_bytes': 'unknown',
+               'sha256': 'unknown', 'preview': '', 'preview_base64': '',
+               'preview_truncated': True, 'complete': False}
+    if stream is None:
+        return unknown
+    try:
+        stream.flush()
+        size = os.fstat(stream.fileno()).st_size
+        stream.seek(0)
+        preview = stream.read(64 * 1024)
+        stream.seek(0)
+        digest = hashlib.sha256()
+        while True:
+            chunk = stream.read(1024 * 1024)
+            if not chunk:
+                break
+            digest.update(chunk)
+        stream.seek(0, os.SEEK_END)
+        return {'path': str(path) if path else None, 'size_bytes': size,
+                'sha256': digest.hexdigest(),
+                'preview': preview.decode('utf-8', errors='replace'),
+                'preview_base64': base64.b64encode(preview).decode('ascii'),
+                'preview_truncated': size > len(preview), 'complete': True}
+    except (OSError, ValueError) as error:
+        return {**unknown, 'error': str(error)}
+
+def _pump_client_output(source, destination, console, errors):
+    try:
+        while True:
+            chunk = os.read(source.fileno(), 64 * 1024)
+            if not chunk:
+                return
+            destination.write(chunk)
+            destination.flush()
+            if console is not None:
+                try:
+                    output = getattr(console, 'buffer', console)
+                    try:
+                        output.write(chunk)
+                    except TypeError:
+                        console.write(chunk.decode('utf-8', errors='replace'))
+                    console.flush()
+                except (BrokenPipeError, OSError):
+                    console = None
+    except (OSError, ValueError) as error:
+        errors.append(str(error))
+    finally:
+        try:
+            destination.flush()
+        except OSError as error:
+            errors.append(str(error))
+        try:
+            source.close()
+        except OSError as error:
+            errors.append(str(error))
+
+
+def _normalized_cgroup(value):
+    if not isinstance(value, str) or not value or '\x00' in value:
+        raise RuntimeError('The causal capture cgroup identity is missing or invalid.')
+    raw = Path(value)
+    root = Path('/sys/fs/cgroup')
+    if raw.is_absolute() and (raw == root or root in raw.parents):
+        relative = raw.relative_to(root)
+    elif raw.is_absolute():
+        relative = Path(value.lstrip('/'))
+    else:
+        relative = raw
+    if not relative.parts or any(part in ('', '.', '..') for part in relative.parts):
+        raise RuntimeError('The causal capture cgroup identity is unsafe or empty.')
+    return '/' + relative.as_posix()
+
+
+class CausalCapture:
+    def __init__(self, run_dir, unit_name, identity, profile_name, runtime_seconds,
+                 privileged_kernel=False, until_stopped=False, pipeline_dispatch=False,
+                 wait_idle_backoff=False):
+        self.run_dir = Path(run_dir)
+        self.unit_name = unit_name
+        self.identity = identity
+        self.profile_name = profile_name
+        self.runtime_seconds = runtime_seconds
+        self.until_stopped = until_stopped
+        self.pipeline_dispatch = pipeline_dispatch
+        self.wait_idle_backoff = wait_idle_backoff
+        self.stop_margin_seconds = causal_stop_margin_seconds(runtime_seconds)
+        self.target_timeout_seconds = min(
+            CAUSAL_TARGET_TIMEOUT_SECONDS, max(1, runtime_seconds - self.stop_margin_seconds - 1))
+        self.privileged_kernel_requested = privileged_kernel
+        self.privileged_kernel_policy = (
+            privileged_kernel_window(runtime_seconds) if privileged_kernel else None)
+        self.privileged_kernel_capture = None
+        self.privileged_kernel_ready_deadline_monotonic_ns = None
+        self.privileged_kernel_due_monotonic_ns = None
+        self.privileged_kernel_shutdown_before_due = False
+        self.privileged_kernel_stop_attempted = False
+        self.privileged_kernel_start_attempted = False
+        self.sampling = _sampling_configuration(self.run_dir, runtime_seconds)
+        self.started = time.monotonic()
+        self.last_target_scan = 0.0
+        self.last_refresh = 0.0
+        self.observer = None
+        self.observer_pidfd = None
+        self.observer_stdout = None
+        self.observer_stderr = None
+        self.observer_status = None
+        self.sample_window = None
+        self.stop_request_path = self.run_dir / 'causal-stop-request.json'
+        self.stop_result_path = self.run_dir / 'causal-stop-result.json'
+        self.orderly_stop = None
+        kernel_route = ('privileged-helper' if privileged_kernel else 'observer-kernel-session')
+        self.record = {
+            'version': 1,
+            'state': 'awaiting_target',
+            'unit': unit_name,
+            'profile': profile_name,
+            'runtime_seconds': runtime_seconds,
+            'until_stopped': until_stopped,
+            'pipeline_dispatch': pipeline_dispatch,
+            'runtime_stop_policy': {
+                'status': 'manual_stop_only' if until_stopped else 'pending',
+                'hard_runtime_seconds': None if until_stopped else runtime_seconds,
+                'margin_seconds': self.stop_margin_seconds,
+            },
+            'sampling_configuration': self.sampling,
+            'target': {'status': 'pending'},
+            'observer': {'status': 'not_started'},
+            'activation': {'status': 'not_started'},
+            'sample': {'status': 'not_started', 'data_valid': False,
+                       'usable_cpu_samples': False, 'coverage_status': 'unavailable'},
+            'kernel_evidence_route': kernel_route,
+            'kernel_trace': ({'status': 'external', 'route': kernel_route}
+                             if privileged_kernel else {'status': 'not_started'}),
+            'privileged_kernel_window': (
+                {'status': 'awaiting_target', **self.privileged_kernel_policy}
+                if privileged_kernel else {'status': 'not_requested'}),
+            'privileged_kernel_capture': (
+                {'status': 'not_started',
+                 'max_seconds': self.privileged_kernel_policy['max_seconds'],
+                 'window': {
+                     'status': 'awaiting_target',
+                     **self.privileged_kernel_policy,
+                 }}
+                if privileged_kernel else {'status': 'not_requested'}),
+            'finalization': {'status': 'not_attempted'},
+            'shutdown': {'status': 'pending'},
+            'teardown': {'status': 'pending'},
+            'usable_cpu_samples': False,
+            'outcome': 'pending',
+            'started_at': time.time(),
+        }
+        self._persist()
+    def _persist(self):
+        _atomic_json(self.run_dir / 'causal-capture-status.json', self.record)
+
+    def _revalidate_privileged_kernel_target(self):
+        target = self.record['target']
+        if target.get('status') != 'verified':
+            raise RuntimeError('Privileged attachment has no verified pinned target.')
+        unit = _unit_snapshot(shutil.which('systemctl'), self.unit_name)
+        properties = unit.get('properties') or {}
+        control_group = properties.get('ControlGroup')
+        if (unit.get('query') != 'ok' or properties.get('ActiveState') != 'active'
+                or not isinstance(control_group, str) or not control_group
+                or _normalized_cgroup(control_group)
+                != _normalized_cgroup(target.get('cgroup'))):
+            raise RuntimeError('Owned unit or exact cgroup changed before privileged attachment.')
+        current = _candidate_in_cgroup(self.identity, control_group)
+        if (current is None
+                or current.get('pid') != target.get('pid')
+                or current.get('starttime_ticks') != target.get('starttime_ticks')
+                or _normalized_cgroup(current.get('cgroup'))
+                != _normalized_cgroup(target.get('cgroup'))):
+            raise RuntimeError('Pinned target PID, start time, or cgroup changed before privileged attachment.')
+        return current
+
+    def _start_privileged_kernel(self, target):
+        if not self.privileged_kernel_requested:
+            return
+        if self.privileged_kernel_capture is not None:
+            raise RuntimeError('Privileged kernel attachment was already started.')
+        try:
+            from privileged_kernel_capture import PrivilegedKernelCapture
+            max_seconds = self.privileged_kernel_policy['max_seconds']
+            self.privileged_kernel_capture = PrivilegedKernelCapture(
+                self.run_dir, target, self.identity, max_seconds)
+            attached_at = {
+                'monotonic_ns': time.monotonic_ns(),
+                'wall_time_ns': time.time_ns(),
+            }
+            ready_timeout = min(
+                PRIVILEGED_KERNEL_READY_TIMEOUT_SECONDS,
+                max(1, self.runtime_seconds - self.stop_margin_seconds - 1))
+            self.privileged_kernel_ready_deadline_monotonic_ns = (
+                attached_at['monotonic_ns'] + ready_timeout * 1_000_000_000)
+            window = self.record['privileged_kernel_window']
+            window.update({
+                'status': 'attachment_started',
+                'attached_at': attached_at,
+                'authentication_deadline_at': {
+                    'monotonic_ns': self.privileged_kernel_ready_deadline_monotonic_ns,
+                    'wall_time_ns': (
+                        attached_at['wall_time_ns'] + ready_timeout * 1_000_000_000),
+                },
+                'authentication_ready_timeout_seconds': ready_timeout,
+            })
+            self.privileged_kernel_start_attempted = True
+            self.record['privileged_kernel_capture'] = {
+                'status': 'starting', 'max_seconds': max_seconds,
+                'window': dict(window),
+            }
+            self._persist()
+            report = self.privileged_kernel_capture.start()
+            if not isinstance(report, dict):
+                raise RuntimeError('Privileged helper start did not return its status report.')
+            window['status'] = 'attached'
+            self._record_privileged_kernel_report(report)
+            if report.get('status') in ('failed', 'partial', 'stopped'):
+                raise RuntimeError(
+                    f"Privileged helper started in unacceptable state {report.get('status')!r}.")
+            self._poll_privileged_kernel()
+        except Exception as error:
+            window = self.record['privileged_kernel_window']
+            window['status'] = 'failed'
+            window['failure'] = {'type': type(error).__name__, 'detail': str(error)}
+            current = self.record['privileged_kernel_capture']
+            if isinstance(current, dict) and current.get('status') in ('partial', 'failed'):
+                current['initialization_failure'] = {
+                    'type': type(error).__name__, 'detail': str(error),
+                }
+                current['window'] = dict(window)
+            else:
+                self.record['privileged_kernel_capture'] = {
+                    'status': 'failed',
+                    'max_seconds': self.privileged_kernel_policy['max_seconds'],
+                    'window': dict(window),
+                    'failure': {'type': type(error).__name__, 'detail': str(error)},
+                }
+                self.record['kernel_trace'] = {
+                    'status': 'failed', 'route': 'privileged-helper',
+                    'reason': 'initialization_failed',
+                }
+            self._persist()
+            raise RuntimeError(f'Explicit privileged kernel capture could not initialize: {error}') from error
+
+    def _bounded_kernel_window_finalized(self, report):
+        if (self.runtime_seconds != 180 or not isinstance(report, dict)
+                or report.get('status') != 'incomplete' or report.get('error') is not None):
+            return False
+        final = report.get('final')
+        files = report.get('files')
+        teardown = report.get('teardown')
+        if not all(isinstance(value, dict) for value in (final, files, teardown)):
+            return False
+        recorder = final.get('recorder')
+        finalization = final.get('finalization')
+        transport = final.get('transport')
+        artifact = files.get('kernel.perf.data')
+        if not all(isinstance(value, dict) for value in
+                   (recorder, finalization, transport, artifact)):
+            return False
+        validation = recorder.get('validation')
+        if not isinstance(validation, dict):
+            return False
+        size = artifact.get('bytes')
+        digest = artifact.get('sha256')
+        return (
+            final.get('status') == 'incomplete'
+            and finalization.get('status') == 'finalized'
+            and finalization.get('reason') == 'deadline_reached'
+            and finalization.get('signal') == 'SIGINT'
+            and type(finalization.get('returncode')) is int
+            and finalization['returncode'] in (0, -signal.SIGINT)
+            and finalization.get('identity_verified') is True
+            and teardown.get('verified') is True
+            and artifact.get('verified') is True
+            and type(size) is int and 0 < size <= 32 * 1024 * 1024
+            and isinstance(digest, str) and re.fullmatch(r'[0-9a-f]{64}', digest) is not None
+            and transport.get('availability') == 'available'
+            and transport.get('bytes') == size and transport.get('sha256') == digest
+            and not recorder.get('recording_soft_limit_reached')
+            and not recorder.get('output_cap_reached')
+            and not recorder.get('output_cap_exceeded')
+            and validation.get('availability') == 'available'
+            and validation.get('output_stream_complete') is True
+            and validation.get('lost_events') == 0
+            and validation.get('unrecognized_target_state_records') == 0
+            and not validation.get('partial_callchain_sample')
+            and not validation.get('output_limit_reached')
+            and not validation.get('timed_out')
+        )
+
+    def _parser_limited_kernel_capture(self, report):
+        if (not isinstance(report, dict) or report.get('status') != 'incomplete'
+                or report.get('error') is not None):
+            return False
+        final = report.get('final')
+        files = report.get('files')
+        teardown = report.get('teardown')
+        if not all(isinstance(value, dict) for value in (final, files, teardown)):
+            return False
+        recorder = final.get('recorder')
+        finalization = final.get('finalization')
+        transport = final.get('transport')
+        artifact = files.get('kernel.perf.data')
+        if not all(isinstance(value, dict) for value in
+                   (recorder, finalization, transport, artifact)):
+            return False
+        validation = recorder.get('validation')
+        if not isinstance(validation, dict):
+            return False
+        size = artifact.get('bytes')
+        digest = artifact.get('sha256')
+        parser_limited = (
+            validation.get('availability') == 'incomplete'
+            and validation.get('reason') == 'perf_script_output_or_time_limit'
+            and ((validation.get('output_limit_reached') is True
+                  and validation.get('output_limit_reason') in
+                  ('stdout_byte_limit', 'line_length_limit', 'callchain_depth_limit'))
+                 or validation.get('timed_out') is True)
+            and validation.get('exit_status') in (0, -signal.SIGKILL)
+            and validation.get('output_after_stop_unmeasured') is True
+            and validation.get('reader_error') is None
+            and validation.get('incomplete_output') is False
+            and validation.get('lost_events') == 0
+            and validation.get('unrecognized_target_state_records') == 0)
+        return (
+            final.get('status') == 'incomplete'
+            and finalization.get('status') == 'finalized'
+            and finalization.get('reason') in
+            ('requested', 'approved_stop', 'approved_early_stop',
+             'probe_duration_elapsed', 'deadline_reached')
+            and finalization.get('identity_verified') is True
+            and type(finalization.get('returncode')) is int
+            and finalization.get('returncode') in (0, -signal.SIGINT)
+            and (finalization.get('returncode') != -signal.SIGINT
+                 or finalization.get('signal') == 'SIGINT')
+            and teardown.get('verified') is True
+            and artifact.get('verified') is True
+            and type(size) is int and size > 0
+            and isinstance(digest, str)
+            and re.fullmatch(r'[0-9a-f]{64}', digest) is not None
+            and transport.get('availability') == 'available'
+            and transport.get('bytes') == size
+            and transport.get('sha256') == digest
+            and recorder.get('output_availability') == 'available'
+            and recorder.get('output_nonempty') is True
+            and not recorder.get('recording_soft_limit_reached')
+            and not recorder.get('output_cap_reached')
+            and not recorder.get('output_cap_exceeded')
+            and final.get('target', {}).get('verified') is True
+            and recorder.get('output_bytes') == size
+            and parser_limited)
+
+    def _record_privileged_kernel_report(self, report):
+        if not isinstance(report, dict):
+            raise RuntimeError('Privileged helper status must be an object.')
+        status = report.get('status')
+        if status not in ('awaiting_auth', 'recording', 'validated', 'no_target_events',
+                          'no_callchains', 'no_kernel_callchains', 'partial', 'incomplete',
+                          'empty', 'validation_unavailable', 'failed', 'stopped'):
+            raise RuntimeError(f'Privileged helper returned an unknown state: {status!r}.')
+        self.record['privileged_kernel_capture'] = {
+            **report,
+            'window': dict(self.record['privileged_kernel_window']),
+        }
+        transient = status in ('awaiting_auth', 'recording')
+        self.record['kernel_trace'] = {
+            'status': status, 'route': 'privileged-helper',
+            'raw_status': report.get('raw_status', status),
+            'diagnostic_status': report.get('diagnostic_status', status),
+            'raw_reason': report.get('raw_reason'),
+            'finalization_reason': report.get('finalization_reason'),
+            'recording_health': (
+                'armed' if status == 'recording' else
+                'unproven' if status == 'awaiting_auth' else
+                report.get('recording_health', 'healthy' if status == 'validated' else 'unproven')),
+            'diagnostic_sufficiency': (
+                'not_assessed' if transient else
+                report.get('diagnostic_sufficiency',
+                           'not_assessed' if status == 'validated' else 'unknown')),
+            'diagnostic_reason': report.get('diagnostic_reason'),
+            'root_cause_coverage_complete': False,
+        }
+        self._persist()
+
+    def _privileged_kernel_report_evidence(self, report):
+        from privileged_kernel_capture import _report_recording_evidence
+        return _report_recording_evidence(report)
+
+    def _mark_privileged_kernel_recording_healthy(self, report):
+        status = report.get('diagnostic_status', report.get('status'))
+        diagnostic_reason = report.get('diagnostic_reason')
+        if status == 'validated':
+            diagnostic_sufficiency = 'not_assessed'
+            diagnostic_reason = (
+                diagnostic_reason or
+                'target_kernel_callchains_present_causal_join_not_assessed')
+        else:
+            diagnostic_sufficiency = 'insufficient'
+        self.record['kernel_trace'].update({
+            'recording_health': 'healthy',
+            'diagnostic_status': status,
+            'diagnostic_sufficiency': diagnostic_sufficiency,
+            'diagnostic_reason': diagnostic_reason,
+            'root_cause_coverage_complete': False,
+        })
+        self._persist()
+
+    def _poll_privileged_kernel(self):
+        if not self.privileged_kernel_requested or self.privileged_kernel_stop_attempted:
+            return
+        if self.privileged_kernel_capture is None:
+            due_ns = self.privileged_kernel_due_monotonic_ns
+            if due_ns is None or time.monotonic_ns() < due_ns:
+                return
+            window = self.record['privileged_kernel_window']
+            window['status'] = 'revalidating_target'
+            self._persist()
+            try:
+                target = self._revalidate_privileged_kernel_target()
+                self._start_privileged_kernel(target)
+            except Exception as error:
+                if window.get('status') != 'failed':
+                    window['status'] = 'failed'
+                    window['failure'] = {
+                        'type': type(error).__name__, 'detail': str(error),
+                    }
+                    self.record['privileged_kernel_capture'] = {
+                        'status': 'failed',
+                        'max_seconds': self.privileged_kernel_policy['max_seconds'],
+                        'window': dict(window),
+                        'failure': window['failure'],
+                    }
+                    self.record['kernel_trace'] = {
+                        'status': 'failed', 'route': 'privileged-helper',
+                        'reason': 'target_revalidation_failed',
+                    }
+                    self._persist()
+                raise
+            return
+        report = self.privileged_kernel_capture.poll()
+        self._record_privileged_kernel_report(report)
+        status = report['status']
+        if status in ('validated', 'no_target_events', 'no_callchains', 'no_kernel_callchains'):
+            intact, detail = self._privileged_kernel_report_evidence(report)
+            if not intact:
+                raise RuntimeError(
+                    f'Privileged kernel capture is not finalized with intact recording evidence: {detail}.')
+            self._mark_privileged_kernel_recording_healthy(report)
+            return
+        if status == 'incomplete':
+            if self._parser_limited_kernel_capture(report):
+                self.privileged_kernel_stop_attempted = True
+                self.record['privileged_kernel_window']['status'] = 'parser_limited'
+                self.record['kernel_trace']['coverage_status'] = 'parser_limited'
+                self.record['kernel_trace']['bounded_window_evidence_usable'] = False
+                self.record['kernel_trace']['diagnostic_sufficiency'] = 'insufficient'
+                self.record['kernel_trace']['diagnostic_reason'] = 'parser_limit_reached'
+                self._persist()
+                return
+            if not self._bounded_kernel_window_finalized(report):
+                raise RuntimeError('Privileged kernel window lacks clean bounded finalization and intact evidence.')
+            self.privileged_kernel_stop_attempted = True
+            self.record['privileged_kernel_window']['status'] = 'finalized_bounded'
+            self.record['kernel_trace']['bounded_window_evidence_usable'] = True
+            self.record['kernel_trace']['coverage_status'] = 'bounded_partial'
+            self._persist()
+            return
+        if status in ('failed', 'empty', 'validation_unavailable'):
+            error = report.get('error') or report.get('failure') or report.get('reason') or status
+            raise RuntimeError(f'Privileged kernel capture is unusable ({status}): {error}.')
+        if status == 'partial':
+            raise RuntimeError(
+                'Privileged kernel capture finalized partial evidence; stopping the run rather than continuing without kernel recording.')
+        if status == 'stopped':
+            raise RuntimeError('Privileged kernel capture stopped before controller finalization.')
+        if (status == 'awaiting_auth'
+                and time.monotonic_ns() >= self.privileged_kernel_ready_deadline_monotonic_ns):
+            raise RuntimeError('Privileged kernel capture authentication did not complete before its bounded readiness deadline.')
+
+    def _stop_privileged_kernel(self, reason):
+        if not self.privileged_kernel_requested:
+            return self.record['privileged_kernel_capture']
+        if self.privileged_kernel_capture is None:
+            window = self.record['privileged_kernel_window']
+            due_ns = self.privileged_kernel_due_monotonic_ns
+            if (due_ns is not None and time.monotonic_ns() < due_ns
+                    and window.get('status') in ('waiting', 'due')):
+                window['status'] = 'not_started_before_due'
+                window['shutdown_at'] = {
+                    'monotonic_ns': time.monotonic_ns(),
+                    'wall_time_ns': time.time_ns(),
+                }
+                self.privileged_kernel_shutdown_before_due = True
+                self.privileged_kernel_stop_attempted = True
+                self.record['privileged_kernel_capture'] = {
+                    'status': 'not_started',
+                    'max_seconds': self.privileged_kernel_policy['max_seconds'],
+                    'window': dict(window),
+                }
+                self._persist()
+            elif (due_ns is not None and time.monotonic_ns() >= due_ns
+                  and window.get('status') not in ('not_started_before_due', 'failed')):
+                window['status'] = 'failed'
+                window['failure'] = {
+                    'type': 'RuntimeError',
+                    'detail': 'Scheduled privileged attachment was not started before shutdown.',
+                }
+                self.record['privileged_kernel_capture'] = {
+                    'status': 'failed',
+                    'max_seconds': self.privileged_kernel_policy['max_seconds'],
+                    'window': dict(window),
+                    'failure': window['failure'],
+                }
+                self.record['kernel_trace'] = {
+                    'status': 'failed', 'route': 'privileged-helper',
+                    'reason': 'scheduled_attachment_not_started',
+                }
+                self._persist()
+            return self.record['privileged_kernel_capture']
+        if self.privileged_kernel_stop_attempted:
+            return self.record['privileged_kernel_capture']
+        self.privileged_kernel_stop_attempted = True
+        try:
+            report = self.privileged_kernel_capture.stop(reason)
+            if not isinstance(report, dict):
+                raise RuntimeError('Privileged helper stop did not return its finalized report.')
+            self._record_privileged_kernel_report(report)
+            if report.get('status') in (
+                    'validated', 'no_target_events', 'no_callchains', 'no_kernel_callchains'):
+                intact, detail = self._privileged_kernel_report_evidence(report)
+                if not intact:
+                    failed = {
+                        **report, 'status': 'failed',
+                        'reported_status': report.get('status'),
+                        'window': dict(self.record['privileged_kernel_window']),
+                        'failure': detail,
+                    }
+                    self.record['privileged_kernel_capture'] = failed
+                    self.record['kernel_trace'] = {
+                        'status': 'failed', 'route': 'privileged-helper',
+                        'raw_status': report.get('raw_status', report.get('status')),
+                        'raw_reason': report.get('raw_reason'),
+                        'recording_health': 'failed',
+                        'diagnostic_sufficiency': report.get('diagnostic_sufficiency', 'unknown'),
+                        'reason': 'finalized_recording_unverified',
+                        'root_cause_coverage_complete': False,
+                    }
+                    self._persist()
+                else:
+                    self._mark_privileged_kernel_recording_healthy(report)
+            return self.record['privileged_kernel_capture']
+        except BaseException as error:
+            previous = self.record['privileged_kernel_capture']
+            self.record['privileged_kernel_capture'] = {
+                'status': 'failed', 'last_report': previous,
+                'window': dict(self.record['privileged_kernel_window']),
+                'failure': {'type': type(error).__name__, 'detail': str(error)},
+            }
+            self.record['kernel_trace'] = {
+                'status': 'failed', 'route': 'privileged-helper',
+                'reason': 'stop_or_finalization_failed',
+            }
+            self._persist()
+            return self.record['privileged_kernel_capture']
+
+    def _fail(self, stage, error):
+        item = {'stage': stage, 'type': type(error).__name__,
+                'detail': str(error), 'at': time.time()}
+        self.record.setdefault('failures', []).append(item)
+        if stage == 'target_discovery' and self.record['target'].get('status') == 'pending':
+            self.record['target'] = {'status': 'failed', 'failure': item}
+            self.record['activation'] = {
+                'status': 'not_attempted', 'reason': 'pinned target identity was not verified'}
+        elif stage == 'activation_or_sampling':
+            if self.record['activation'].get('status') != 'acknowledged':
+                self.record['activation'] = {'status': 'failed', 'failure': item}
+            if self.record['sample'].get('status') not in (
+                    'verified_partial', 'verified_complete'):
+                self.record['sample']['status'] = 'failed'
+                self.record['sample']['failure'] = item
+        elif stage in ('shutdown_finalization', 'observer_teardown'):
+            if self.record['finalization'].get('status') != 'finalized':
+                self.record['finalization'] = {'status': 'failed', 'failure': item}
+        self.record['state'] = 'failed'
+        self.record['outcome'] = 'failed'
+        self.record['shutdown'] = {'status': 'failed', 'failure': item}
+        self._persist()
