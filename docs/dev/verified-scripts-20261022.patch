+def main():
+    parser = argparse.ArgumentParser(description='Run the bounded no-game causal perf fixture.')
+    mode = parser.add_mutually_exclusive_group()
+    mode.add_argument('--timer-failure', action='store_true',
+                      help='Inject a deterministic timer MemoryError and verify owned-unit teardown.')
+    mode.add_argument('--target-discovery-regression', action='store_true',
+                      help='Exercise owned-service target discovery with no game or perf sampling.')
