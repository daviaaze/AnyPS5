+def _cgroup_state(control_group):
+    root = Path('/sys/fs/cgroup')
+    if not control_group:
+        return {'path': None, 'exists': False, 'populated': None, 'error': 'control group unknown'}
+    raw = str(control_group)
+    if raw == str(root) or raw.startswith(str(root) + '/'):
+        path = Path(raw)
+        relative = path.relative_to(root)
+    else:
+        relative = Path(raw.lstrip('/'))
+        if '..' in relative.parts:
+            return {'path': raw, 'exists': None, 'populated': None,
+                    'error': 'unsafe control-group path'}
+        path = root / relative
+    if '..' in relative.parts:
+        return {'path': raw, 'exists': None, 'populated': None,
+                'error': 'unsafe control-group path'}
+    try:
+        path.stat()
+    except FileNotFoundError:
+        return {'path': str(path), 'exists': False, 'populated': False}
+    except OSError as error:
+        return {'path': str(path), 'exists': None, 'populated': None, 'error': str(error)}
+    try:
+        events = (path / 'cgroup.events').read_text().splitlines()
+        populated = next((line.split()[1] for line in events if line.startswith('populated ')), None)
+        if populated not in ('0', '1'):
+            raise ValueError('cgroup.events has no typed populated field')
+        return {'path': str(path), 'exists': True, 'populated': populated == '1'}
+    except (OSError, ValueError) as error:
+        return {'path': str(path), 'exists': None, 'populated': None, 'error': str(error)}
+
+
+def _opaque_candidate_evidence(pid, identity):
+    process = Path('/proc') / str(pid)
+    candidate = Path(identity['elf']['path'])
+    evidence = []
+    try:
+        raw_cmdline = (process / 'cmdline').read_bytes()
+    except OSError:
+        raw_cmdline = b''
+    command = os.fsdecode(raw_cmdline.split(b'\0', 1)[0])
+    if command:
+        normalized = command.removesuffix(' (deleted)')
+        path = Path(normalized)
+        if normalized == str(candidate) or path.name == candidate.name:
+            evidence.append(f'argv0 identifies candidate path/name: {command}')
+        if path.is_absolute():
+            try:
+                resolved = path.resolve(strict=True)
+                info = resolved.stat()
+            except OSError:
+                pass
+            else:
+                if (resolved == candidate
+                        or (info.st_dev == identity['elf']['device']
+                            and info.st_ino == identity['elf']['inode'])):
+                    evidence.append(f'argv0 resolves to pinned candidate: {resolved}')
+    try:
+        comm = (process / 'comm').read_text().strip()
+        if comm == candidate.name:
+            evidence.append(f'comm matches candidate: {comm}')
+    except OSError:
+        pass
+    try:
+        cwd = Path(os.readlink(process / 'cwd')).resolve(strict=True)
+        if cwd == candidate.parent or candidate.parent in cwd.parents:
+            evidence.append(f'cwd is inside candidate runtime: {cwd}')
+    except OSError:
+        pass
+    try:
+        cgroups = [line.split(':', 2)[2] for line in (process / 'cgroup').read_text().splitlines()
+                   if line.startswith('0::')]
+        if len(cgroups) == 1 and any(part.startswith('anyps5-') for part in Path(cgroups[0]).parts):
+            evidence.append(f'cgroup is owned by a native launcher: {cgroups[0]}')
+    except OSError:
+        pass
+    return evidence
+
+
+def candidate_processes(identity):
+    # The shared lock and recorded unit/cgroup drain are authoritative for cooperating launchers.
+    # This scan is best-effort for manual/noncooperating processes, not an adversarial sandbox.
+    expected_path = identity['elf']['path']
+    expected_device = identity['elf']['device']
+    expected_inode = identity['elf']['inode']
+    current_uids = {os.getuid(), os.geteuid()}
+    matches = []
+    try:
+        entries = list(os.scandir('/proc'))
+    except OSError as error:
+        raise RuntimeError(f'Cannot enumerate processes to exclude an existing candidate; refusing launch: {error}') from error
+    for entry in entries:
+        if not entry.name.isdigit():
+            continue
+        status_path = Path('/proc') / entry.name / 'status'
+        try:
+            status = status_path.read_text().splitlines()
+        except (FileNotFoundError, ProcessLookupError):
+            continue
+        except PermissionError as error:
+            raise RuntimeError(f'Cannot determine process {entry.name} owner; refusing ambiguous launch: {error}') from error
+        except OSError as error:
+            if error.errno in (2, 3):
+                continue
+            raise RuntimeError(f'Cannot determine process {entry.name} owner; refusing ambiguous launch: {error}') from error
+        uid_row = next((line.split() for line in status if line.startswith('Uid:')), None)
+        try:
+            if uid_row is None or len(uid_row) != 5:
+                raise ValueError('missing or malformed Uid field')
+            process_uids = {int(value) for value in uid_row[1:]}
+        except ValueError as error:
+            raise RuntimeError(f'Cannot verify process {entry.name} owner; refusing ambiguous launch.') from error
+        if not process_uids & current_uids:
+            continue
+        executable = f'/proc/{entry.name}/exe'
+        try:
+            target = os.readlink(executable)
+        except (FileNotFoundError, ProcessLookupError):
+            continue
+        except PermissionError:
+            evidence = _opaque_candidate_evidence(entry.name, identity)
+            if evidence:
+                raise RuntimeError(f'Inaccessible process {entry.name} is candidate-like: {evidence}; refusing launch.')
+            continue
+        except OSError as error:
+            if error.errno in (2, 3):
+                continue
+            raise RuntimeError(f'Cannot identify same-UID process {entry.name} executable; refusing ambiguous launch: {error}') from error
+        target_path = target.removesuffix(' (deleted)')
+        if target_path == expected_path:
+            matches.append({'pid': int(entry.name), 'uids': sorted(process_uids), 'exe': target,
+                            'device': None, 'inode': None})
+            continue
+        try:
+            info = os.stat(executable)
+        except (FileNotFoundError, ProcessLookupError):
+            continue
+        except PermissionError:
+            evidence = _opaque_candidate_evidence(entry.name, identity)
+            if evidence:
+                raise RuntimeError(f'Inaccessible process {entry.name} is candidate-like: {evidence}; refusing launch.')
+            continue
+        except OSError as error:
+            if error.errno in (2, 3):
+                continue
+            raise RuntimeError(f'Cannot identify same-UID process {entry.name} executable; refusing ambiguous launch: {error}') from error
+        if info.st_dev == expected_device and info.st_ino == expected_inode:
+            matches.append({'pid': int(entry.name), 'uids': sorted(process_uids), 'exe': target,
+                            'device': info.st_dev, 'inode': info.st_ino})
+    return matches
+
+
+def _proc_starttime_ticks(pid):
+    line = (Path('/proc') / str(pid) / 'stat').read_text()
+    close = line.rfind(')')
+    if close <= 0:
+        raise RuntimeError(f'Cannot parse process identity for PID {pid}.')
+    fields = line[close + 1:].split()
+    if len(fields) <= 19:
+        raise RuntimeError(f'Process identity for PID {pid} is truncated.')
+    return int(fields[19])
+
+
+def _proc_cgroup_path(pid):
+    entries = [line[3:] for line in (Path('/proc') / str(pid) / 'cgroup').read_text().splitlines()
+               if line.startswith('0::')]
+    if len(entries) != 1 or not entries[0] or '..' in Path(entries[0]).parts:
+        raise RuntimeError(f'PID {pid} has no unique, safe cgroup-v2 identity.')
+    return '/' + entries[0].lstrip('/')
+
+
+def _cgroup_subtree_processes(group):
+    root = Path('/sys/fs/cgroup')
+    group_path = root / group.lstrip('/')
+    process_ids = set()
+    pending = [group_path]
+    while pending:
+        directory = pending.pop()
+        try:
+            info = directory.lstat()
+            if not stat.S_ISDIR(info.st_mode):
+                raise RuntimeError(f'Owned cgroup path is not a directory: {directory}')
+            with os.scandir(directory) as entries:
+                children = [entry.path for entry in entries
+                            if entry.is_dir(follow_symlinks=False)]
+        except FileNotFoundError as error:
+            if directory != group_path:
+                continue
+            raise RuntimeError(f'Owned service cgroup disappeared during target discovery: {directory}') from error
+        except OSError as error:
+            raise RuntimeError(f'Cannot enumerate owned service cgroup {directory}: {error}') from error
+        try:
+            members = (directory / 'cgroup.procs').read_text().split()
+        except FileNotFoundError as error:
+            if directory != group_path:
+                continue
+            raise RuntimeError(f'Owned service cgroup has no readable cgroup.procs: {directory}') from error
+        except OSError as error:
+            raise RuntimeError(f'Cannot read owned service cgroup membership {directory}: {error}') from error
+        for member in members:
+            if not member.isdecimal() or int(member) <= 0:
+                raise RuntimeError(f'Owned cgroup has malformed cgroup.procs membership: {member!r}')
+            process_ids.add(int(member))
+        pending.extend(children)
+    return process_ids
+
+
+def _candidate_in_cgroup(identity, control_group):
+    group = str(control_group)
+    root = '/sys/fs/cgroup'
+    if group == root or group.startswith(root + '/'):
+        group = group[len(root):]
+    if (not group.startswith('/') or group == '/'
+            or any(part in ('', '.', '..') for part in group.split('/')[1:])):
+        raise RuntimeError('The active service has no safe cgroup identity.')
+    expected = identity['elf']
+    matches = []
+    for pid in sorted(_cgroup_subtree_processes(group)):
+        process = Path('/proc') / str(pid)
+        try:
+            executable = os.readlink(process / 'exe')
+            executable_info = os.stat(process / 'exe')
+        except (FileNotFoundError, ProcessLookupError):
+            continue
+        except PermissionError:
+            # Startup helpers may be same-UID but nondumpable. They are not
+            # candidate matches; keep polling for a verifiable executable.
+            continue
+        except OSError as error:
+            if error.errno in (2, 3):
+                continue
+            raise RuntimeError(f'Cannot inspect owned service process {pid}: {error}') from error
+        if (executable.removesuffix(' (deleted)') != expected['path']
+                and (executable_info.st_dev, executable_info.st_ino)
+                != (expected['device'], expected['inode'])):
+            continue
+        try:
+            starttime = _proc_starttime_ticks(pid)
+        except (FileNotFoundError, ProcessLookupError):
+            continue
+        except PermissionError:
+            continue
+        except OSError as error:
+            if error.errno in (2, 3):
+                continue
+            raise RuntimeError(f'Cannot verify owned service process {pid} start time: {error}') from error
+        matches.append({'pid': pid, 'starttime': starttime})
+    if len(matches) > 1:
+        raise RuntimeError(f'Multiple pinned candidate processes appeared during causal capture: {matches}')
+    if not matches:
+        return None
+    pid = matches[0]['pid']
+    starttime = matches[0]['starttime']
+    process = Path('/proc') / str(pid)
+    try:
+        cgroup = _proc_cgroup_path(pid)
+        status = (process / 'status').read_text().splitlines()
+        uid_line = next(line.split() for line in status if line.startswith('Uid:'))
+        if len(uid_line) != 5:
+            raise ValueError('malformed Uid field')
+        effective_uid = int(uid_line[2])
+        executable = os.readlink(process / 'exe')
+        executable_info = os.stat(process / 'exe')
+        current_starttime = _proc_starttime_ticks(pid)
+        current_cgroup = _proc_cgroup_path(pid)
+    except (FileNotFoundError, ProcessLookupError):
+        return None
+    except PermissionError:
+        # A process that cannot be verified is never selected. A later scan
+        # may observe its exec transition or its exit within the startup bound.
+        return None
+    except (OSError, StopIteration, ValueError, IndexError) as error:
+        raise RuntimeError(f'Cannot verify pinned causal target PID {pid}: {error}') from error
+    if starttime != current_starttime or cgroup != current_cgroup:
+        raise RuntimeError(f'Pinned causal target PID {pid} changed identity during discovery.')
+    if cgroup != group:
+        raise RuntimeError(f'Pinned candidate PID {pid} is outside the exact owned service cgroup.')
+    if (effective_uid != os.geteuid() or executable.endswith(' (deleted)')
+            or executable != expected['path']
+            or (executable_info.st_dev, executable_info.st_ino)
+            != (expected['device'], expected['inode'])
+            or not stat.S_ISREG(executable_info.st_mode)):
+        raise RuntimeError(f'Pinned causal target PID {pid} executable or owner differs from launch identity.')
+    return {'pid': pid, 'starttime_ticks': starttime, 'cgroup': cgroup,
+            'executable': executable, 'device': executable_info.st_dev,
+            'inode': executable_info.st_ino, 'effective_uid': effective_uid}
+def _owner_cgroup(owner):
+    group = owner.get('cgroup')
+    if isinstance(group, str) and group.strip():
+        return group
+    for name in ('active_unit_snapshot', 'last_unit_snapshot'):
+        snapshot = owner.get(name)
+        if not isinstance(snapshot, dict):
+            continue
+        properties = snapshot.get('properties')
+        group = properties.get('ControlGroup') if isinstance(properties, dict) else None
+        if isinstance(group, str) and group.strip():
+            return group
+        raw = snapshot.get('stdout')
+        if isinstance(raw, str):
+            for line in raw.splitlines():
+                field, separator, value = line.partition('=')
+                if separator and field == 'ControlGroup' and value.strip():
+                    return value.strip()
+    return None
+
+
+def _existing_owner_is_drained(owner, identity, systemctl):
+    unit_name = owner.get('unit')
+    if not unit_name:
+        if owner.get('state') not in ('reserved', 'prepared', 'completed', 'failed'):
+            raise RuntimeError('Previous owner has no unit identity and an ambiguous state; refusing launch.')
+        unit = {'query': 'not_found', 'properties': {}}
+    else:
+        unit = _unit_snapshot(systemctl, unit_name)
+        if unit['query'] == 'error':
+            raise RuntimeError(f'Cannot determine whether prior unit {unit_name} is still alive; refusing launch.')
+        properties = unit.get('properties', {})
+        active_state = properties.get('ActiveState', 'unknown')
+        if unit['query'] == 'ok' and active_state not in ('inactive', 'failed'):
+            raise RuntimeError(f'Prior unit {unit_name} is still {active_state}; refusing another native launch.')
+    properties = unit.get('properties', {})
+    group = properties.get('ControlGroup') or _owner_cgroup(owner)
+    if group:
+        cgroup = _cgroup_state(group)
+    elif (unit['query'] == 'not_found' and owner.get('state') == 'reserved'):
+        cgroup = {'path': None, 'exists': False, 'populated': False,
+                  'condition': 'previous lease had not requested a systemd unit'}
+    elif (owner.get('state') == 'completed'
+          and (owner.get('teardown') or {}).get('confirmed') is True):
+        cgroup = {'path': None, 'exists': False, 'populated': False,
+                  'condition': 'previous owner recorded a verified unit/cgroup drain'}
+    else:
+        cgroup = {'path': None, 'exists': None, 'populated': None,
+                  'error': 'previous unit has no retained nonempty cgroup identity'}
+    if cgroup['populated'] is not False:
+        raise RuntimeError(f'Prior unit/cgroup drain is ambiguous or still populated: {cgroup}; refusing launch.')
+    matches = candidate_processes(identity)
+    if matches:
+        raise RuntimeError(f'Pinned candidate processes remain after prior unit state: {matches}; refusing launch.')
+    return {'unit': unit, 'cgroup': cgroup, 'candidate_processes': matches}
+
+
+class LaunchLease:
+    def __init__(self, fd, record):
+        self.fd = fd
+        self.record = record
+
+    def update(self, **values):
+        self.record.update(values)
+        _atomic_json(OWNER_PATH, self.record)
+
+    def finish(self, teardown):
+        self.update(state='completed' if teardown.get('confirmed') else 'undrained',
+                    teardown=teardown, finished_at=time.time(),
+                    token_sha256=None if teardown.get('confirmed') else self.record.get('token_sha256'))
+
+    def close(self):
+        if self.fd is not None:
+            fcntl.flock(self.fd, fcntl.LOCK_UN)
+            os.close(self.fd)
+            self.fd = None
+
+
+def acquire_launch(kind, unit_name, identity, output_dir=None, causal_trace=False,
+                  extra_environment=None, *, profile_name, runtime_seconds,
+                  privileged_kernel=False, until_stopped=False, pipeline_dispatch=False,
+                  wait_idle_backoff=False):
+    LOCK_PATH.parent.mkdir(parents=True, exist_ok=True)
+    try:
+        fd = os.open(LOCK_PATH, os.O_RDWR | os.O_CREAT | os.O_CLOEXEC, 0o600)
+        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+    except BlockingIOError as error:
+        if 'fd' in locals():
+            os.close(fd)
+        raise RuntimeError('Another cooperating native game/probe launcher owns the exclusive run lock.') from error
+    except OSError as error:
+        if 'fd' in locals():
+            os.close(fd)
+        raise RuntimeError(f'Cannot acquire the shared native launch lock: {error}') from error
+    try:
+        systemctl = shutil.which('systemctl')
+        if systemctl is None:
+            raise RuntimeError('User systemd is required to reconcile launch ownership safely.')
+        previous = _read_owner()
+        if previous is not None:
+            drained = _existing_owner_is_drained(previous, identity, systemctl)
+        else:
+            drained = {'unit': {'query': 'not_found', 'properties': {}},
+                       'cgroup': {'exists': False, 'populated': False},
+                       'candidate_processes': []}
+        matches = candidate_processes(identity)
+        if matches:
+            raise RuntimeError(f'The exact pinned candidate is already running: {matches}; refusing overlap.')
+        token = secrets.token_urlsafe(32)
+        record = {
+            'version': 1, 'state': 'reserved', 'kind': kind, 'unit': unit_name,
+            'token_sha256': hashlib.sha256(token.encode()).hexdigest(),
+            'parent_pid': os.getpid(), 'started_at': time.time(),
+            'profile_name': profile_name, 'runtime_seconds': runtime_seconds,
+            'privileged_kernel': privileged_kernel, 'causal_trace': causal_trace,
+            'until_stopped': until_stopped,
+            'pipeline_dispatch': pipeline_dispatch,
+            'wait_idle_backoff': wait_idle_backoff,
+            'identity': identity, 'output_dir': str(Path(output_dir).resolve()) if output_dir else None,
+            'trace_environment': _trace_values(extra_environment, causal_trace),
+            'previous_owner_drain': drained,
+        }
+        _atomic_json(OWNER_PATH, record)
+        lease = LaunchLease(fd, record)
+        lease.token = token
+        return lease
+    except Exception:
+        fcntl.flock(fd, fcntl.LOCK_UN)
+        os.close(fd)
+        raise
+
+def authorize_worker(kind, unit_name, profile_name, runtime_seconds, identity,
+                     causal_trace=False, privileged_kernel=False, until_stopped=False,
+                     pipeline_dispatch=False, wait_idle_backoff=False):
+    token = os.environ.get('ANYPS5_LAUNCH_TOKEN')
+    owner = _read_owner()
+    if (not token or not owner or owner.get('token_sha256') != hashlib.sha256(token.encode()).hexdigest()
+            or owner.get('unit') != unit_name or owner.get('kind') != kind
+            or os.environ.get('ANYPS5_LAUNCH_UNIT') != unit_name
+            or os.environ.get('ANYPS5_LAUNCH_KIND') != kind):
+        raise RuntimeError('Private worker entry requires an authenticated parent launch lease; refusing bypass.')
+    if (owner.get('profile_name') != profile_name
+            or owner.get('runtime_seconds') != runtime_seconds
+            or type(privileged_kernel) is not bool
+            or owner.get('privileged_kernel') is not privileged_kernel
+            or owner.get('until_stopped', False) is not until_stopped
+            or type(pipeline_dispatch) is not bool
+            or owner.get('pipeline_dispatch', False) is not pipeline_dispatch
+            or type(wait_idle_backoff) is not bool
+            or owner.get('wait_idle_backoff', False) is not wait_idle_backoff):
+        raise RuntimeError('Worker profile, duration policy, or privileged-kernel request differs from parent admission.')
+    if (type(causal_trace) is not bool
+            or owner.get('causal_trace', False) is not causal_trace):
+        raise RuntimeError('Worker causal-trace request differs from the authenticated parent lease.')
+    if type(wait_idle_backoff) is not bool or wait_idle_backoff != (
+            identity.get('wait_idle_preload') is not None):
+        raise RuntimeError('Worker wait-idle request differs from its authenticated treatment identity.')
+    if profile_name == 'normal' and not (
+            type(runtime_seconds) is int and runtime_seconds > 0
+            and (until_stopped or runtime_seconds <= 360)):
+        raise RuntimeError('Normal profile requires a positive sample duration and bounded mode is limited to 360 seconds.')
+    if profile_name == 'bounded' and not (
+            type(runtime_seconds) is int and 0 < runtime_seconds <= 180 and not until_stopped):
+        raise RuntimeError('Bounded profile requires a positive duration no greater than 180 seconds.')
+    if profile_name == 'capture24' and runtime_seconds != 900:
+        raise RuntimeError('capture24 profile runtime must be exactly 900 seconds.')
+    if privileged_kernel:
+        if (kind != 'game' or not causal_trace or profile_name != 'normal'
+                or until_stopped):
+            raise RuntimeError('Privileged kernel capture requires a bounded normal game causal trace.')
+        privileged_kernel_window(runtime_seconds)
+    if causal_trace and (kind != 'game' or profile_name not in ('capture24', 'normal', 'bounded')):
+        raise RuntimeError('Causal tracing is restricted to capture24, normal, or bounded game profiles.')
+    trace_environment = owner.get('trace_environment', {})
+    if causal_trace:
+        actual_environment = {name: os.environ.get(name, '')
+                             for name in CAUSAL_TRACE_ENVIRONMENT}
+        if actual_environment != trace_environment:
+            raise RuntimeError('Causal-trace environment differs from the authenticated parent configuration.')
+    if identity.get('wait_idle_preload') is not None and kind != 'game':
+        raise RuntimeError('Wait-idle preload is restricted to authenticated game workers.')
+    current_identity = launch_identity(
+        identity['elf']['path'], identity.get('preload') is not None,
+        identity.get('wait_idle_preload') is not None)
+    if current_identity != owner.get('identity') or current_identity != identity:
+        raise RuntimeError('Worker candidate or optional treatment identity differs from the admitted parent identity.')
+    limits = kernel_limits(profile_name, runtime_seconds, unit_name, until_stopped)
+    limits['pipeline_dispatch'] = pipeline_dispatch
+    output_dir = os.environ.get('ANYPS5_LAUNCH_OUTPUT')
+    if output_dir and owner.get('output_dir') != str(Path(output_dir).resolve()):
+        raise RuntimeError('Worker output identity differs from the parent-owned run directory.')
+    return {'kind': kind, 'unit': unit_name, 'identity': current_identity,
+            'profile': limits, 'output_dir': output_dir,
+            'until_stopped': until_stopped,
+            'pipeline_dispatch': pipeline_dispatch,
+            'owner_parent_pid': owner.get('parent_pid'),
+            'wait_idle_backoff': wait_idle_backoff,
+            'trace_environment': trace_environment,
+            'condition': 'authenticated parent lease; exact candidate and systemd/cgroup policies verified'}
+
+def _trace_values(extra_environment=None, causal_trace=False):
+    if causal_trace:
+        supplied = extra_environment or {}
+        return {name: supplied.get(name, '') for name in CAUSAL_TRACE_ENVIRONMENT}
+    return {name: os.environ[name] for name in TRACE_ENVIRONMENT if name in os.environ}
+
+
+def _systemd_environment(token, kind, unit, output_dir, extra_environment,
+                         causal_trace=False):
+    values = {'LD_PRELOAD': '', 'DS_DEPENDENCY_PRELOAD': '',
+              'ANYPS5_LAUNCH_TOKEN': token, 'ANYPS5_LAUNCH_KIND': kind,
+              'ANYPS5_LAUNCH_UNIT': unit}
+    if output_dir:
+        values['ANYPS5_LAUNCH_OUTPUT'] = str(Path(output_dir).resolve())
+    for name in DISPLAY_ENVIRONMENT:
+        if name in os.environ:
+            values[name] = os.environ[name]
+    values.update({name: '' for name in CAUSAL_TRACE_ENVIRONMENT
+                   if name not in TRACE_ENVIRONMENT})
+    values.update({name: '' if causal_trace else os.environ.get(name, '')
+                   for name in TRACE_ENVIRONMENT})
+    values.update(extra_environment or {})
+    return values
+
