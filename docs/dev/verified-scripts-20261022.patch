+        'uid_line': _diagnostic_value(
+            lambda: next((line for line in (process / 'status').read_text().splitlines()
+                          if line.startswith('Uid:')), None)),
+        'exe_readlink': _diagnostic_value(lambda: os.readlink(process / 'exe')),
+    }
+
+    def executable_stat():
+        info = os.stat(process / 'exe')
+        return {'device': info.st_dev, 'inode': info.st_ino,
+                'mode': stat.filemode(info.st_mode), 'regular': stat.S_ISREG(info.st_mode)}
+
+    record['exe_stat'] = _diagnostic_value(executable_stat)
+    return record
+
+
+def _discovery_failure_diagnostics(identity, state, target_pid, wrapper_pid):
+    try:
+        pids = sorted(launch_guard._cgroup_subtree_processes(state['cgroup']))
+        subtree = [_proc_discovery_diagnostics(pid) for pid in pids]
+    except Exception as error:
+        subtree = {'error': f'{type(error).__name__}: {error}'}
+
+    def read_log(name):
+        try:
+            return (state['run_dir'] / name).read_text(errors='replace')
+        except OSError as error:
+            return {'error': f'{type(error).__name__}: {error}'}
+
+    return {
+        'unit': state['unit'],
+        'owned_cgroup': state['cgroup'],
+        'expected_executable': identity['elf'],
+        'target_pid': target_pid,
+        'target_proc': _proc_discovery_diagnostics(target_pid),
+        'wrapper_pid': wrapper_pid,
+        'wrapper_proc': _proc_discovery_diagnostics(wrapper_pid),
+        'owned_subtree_processes': subtree,
+        'service_stdout': read_log('service.stdout'),
+        'service_stderr': read_log('service.stderr'),
+    }
+
+
+def _raise_target_discovery_failure(identity, state, target_pid, wrapper_pid, detail):
+    diagnostics = _discovery_failure_diagnostics(identity, state, target_pid, wrapper_pid)
+    raise RuntimeError(f'{detail}; diagnostic={json.dumps(diagnostics, sort_keys=True)}')
+
+
+
+def _stop_discovery_service(state):
+    if state['stopped']:
+        return
+    try:
+        stop_owned_children(state['run_dir'], state['unit'], state['process'],
+                            None, None, state['unit_started'], state['cgroup'])
+        if state['cgroup']:
+            state['teardown'] = verify_service_drain(state['unit'], state['cgroup'])
+        state['stopped'] = True
+    finally:
+        state['stdout'].close()
+        state['stderr'].close()
+
+
+def _verify_missing_target_timeout(identity, state, run_dir):
+    capture_dir = run_dir / 'missing-capture'
+    capture_dir.mkdir()
+    capture = launch_guard.CausalCapture(capture_dir, state['unit'], identity,
+                                         'normal', 25)
+    capture.started = time.monotonic() - launch_guard.CAUSAL_TARGET_TIMEOUT_SECONDS - 1
+    service_limits = {name: 'fixture' for name in launch_guard.SERVICE_PROPERTIES}
+    service_limits['ControlGroup'] = state['cgroup']
+    kernel_limits = {name: 'fixture' for name in
+                     ('cpu.max', 'memory.high', 'memory.max', 'memory.swap.max', 'pids.max')}
+    worker = {
+        'identity': identity,
+        'condition': 'authenticated parent lease; exact candidate and systemd/cgroup policies verified',
+        'privileged_kernel_requested': False,
+        'until_stopped': False,
+        'pipeline_dispatch': False,
+        'wait_idle_backoff': False,
+        'sampling': capture.sampling,
+        'profile': {'profile': 'normal', 'runtime_seconds': 25, 'until_stopped': False,
+                    'pipeline_dispatch': False, 'cgroup': state['cgroup'],
+                    'wait_idle_backoff': False,
+                    'kernel_limits': kernel_limits, 'service_limits': service_limits},
+    }
+    try:
+        capture.start_if_ready(worker, state['snapshot'])
+    except RuntimeError as error:
+        if 'Pinned candidate target was not discovered before the bounded startup deadline.' in str(error):
+            return
+        raise
+    raise RuntimeError('missing target did not refuse discovery at the bounded startup deadline')
+
+
+def run_target_discovery_regression():
+    if not FIXTURE_DIR.is_dir() or not WORKLOAD.is_file():
+        raise RuntimeError('canonical no-game discovery workload is missing')
+    identity = _discovery_identity()
+    with tempfile.TemporaryDirectory(prefix='target-discovery-', dir=FIXTURE_DIR) as temporary:
+        run_dir = Path(temporary)
+        services = []
+        outside_process = None
+        try:
+            single = _start_discovery_service('single', run_dir / 'single')
+            services.append(single)
+            _wait_for_discovery_service(single)
+            wrapper_pid = _wait_for_protected_wrapper(single)
+            if launch_guard._proc_cgroup_path(wrapper_pid) != single['cgroup']:
+                raise RuntimeError('protected wrapper is not in the exact owned service cgroup')
+            if launch_guard._candidate_in_cgroup(identity, single['cgroup']) is not None:
+                raise RuntimeError('protected wrapper was mistaken for the pinned target')
+            try:
+                launch_guard.candidate_processes(identity)
+            except RuntimeError as error:
+                if 'Inaccessible process' not in str(error):
+                    raise
+            else:
+                raise RuntimeError('global prelaunch candidate exclusion no longer rejects the opaque owned helper')
+            (single['run_dir'] / 'launch-target').touch()
+            target_pid = _wait_for_discovery_targets(single, 1)[0]
+            try:
+                target = launch_guard._candidate_in_cgroup(identity, single['cgroup'])
+            except (OSError, RuntimeError, ValueError) as error:
+                _raise_target_discovery_failure(
+                    identity, single, target_pid, wrapper_pid,
+                    f'active discovery raised {type(error).__name__}: {error}')
+            if target is None or target['pid'] != target_pid:
+                _raise_target_discovery_failure(
+                    identity, single, target_pid, wrapper_pid,
+                    'active discovery did not select the real pinned no-game workload')
+            original_proc_cgroup_path = launch_guard._proc_cgroup_path
+            changed_reads = 0
+
+            def moved_target_cgroup(pid):
+                nonlocal changed_reads
+                current = original_proc_cgroup_path(pid)
+                if pid == target_pid:
+                    changed_reads += 1
+                    if changed_reads == 2:
+                        return current + '/moved'
+                return current
+
+            launch_guard._proc_cgroup_path = moved_target_cgroup
+            try:
+                try:
+                    launch_guard._candidate_in_cgroup(identity, single['cgroup'])
+                except RuntimeError as error:
+                    if 'changed identity during discovery' not in str(error):
+                        raise
+                else:
+                    raise RuntimeError('target moved between cgroup reads was not rejected')
+            finally:
+                launch_guard._proc_cgroup_path = original_proc_cgroup_path
+            _stop_discovery_service(single)
+
+            multiple = _start_discovery_service('multiple', run_dir / 'multiple')
+            services.append(multiple)
+            _wait_for_discovery_service(multiple)
+            if launch_guard._candidate_in_cgroup(identity, multiple['cgroup']) is not None:
+                raise RuntimeError('protected wrapper was mistaken for a target before launch')
+            (multiple['run_dir'] / 'launch-target').touch()
+            target_pids = _wait_for_discovery_targets(multiple, 2)
+            try:
+                launch_guard._candidate_in_cgroup(identity, multiple['cgroup'])
+            except RuntimeError as error:
+                if 'Multiple pinned candidate processes' not in str(error):
+                    raise
+            else:
+                raise RuntimeError(f'multiple pinned targets {target_pids} were not rejected')
+            _stop_discovery_service(multiple)
+
+            outside_pid_path = run_dir / 'outside.pid'
+            outside_process = subprocess.Popen(
+                [str(WORKLOAD.resolve()), '--seconds', '8', '--pid-file', str(outside_pid_path)],
+                cwd=FIXTURE_DIR, stdin=subprocess.DEVNULL,
+                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, close_fds=True)
+            outside_pid = wait_for_target_pid(outside_pid_path, outside_process,
+                                              time.monotonic() + 5)
+            global_matches = launch_guard.candidate_processes(identity)
+            if not any(match['pid'] == outside_pid for match in global_matches):
+                raise RuntimeError('global prelaunch scan failed to identify a pinned outside-group process')
+            missing = _start_discovery_service('missing', run_dir / 'missing')
+            services.append(missing)
+            _wait_for_discovery_service(missing)
+            _wait_for_protected_wrapper(missing)
+            if launch_guard._proc_cgroup_path(outside_pid) == missing['cgroup']:
+                raise RuntimeError('outside fixture target unexpectedly joined the owned service cgroup')
+            if launch_guard._candidate_in_cgroup(identity, missing['cgroup']) is not None:
+                raise RuntimeError('active discovery selected a pinned process outside the owned cgroup')
+            _verify_missing_target_timeout(identity, missing, run_dir)
+            _stop_discovery_service(missing)
+            return {
+                'fixture': 'no_game_owned_target_discovery',
+                'protected_wrapper': 'ignored until the pinned workload appeared',
+                'global_opaque_helper_exclusion': 'still refused',
+                'target': {'status': 'verified', 'pid': target_pid},
+                'multiple_targets': 'refused',
+                'moved_target': 'refused',
+                'outside_target': 'not selected; missing-target timeout refused capture',
+                'service_teardown': [state.get('teardown') for state in services],
+                'outcome': 'success',
+            }
+        finally:
+            if outside_process is not None and outside_process.poll() is None:
+                outside_process.terminate()
+                try:
+                    outside_process.wait(timeout=3)
+                except subprocess.TimeoutExpired:
+                    outside_process.kill()
+                    outside_process.wait(timeout=3)
+            for state in reversed(services):
+                _stop_discovery_service(state)
+
+
+def run_sample_finalization_race_regression():
+    with tempfile.TemporaryDirectory(
+            prefix='sample-finalization-', dir=FIXTURE_DIR) as temporary:
