+def service_limits(group, runtime_seconds, unit_name, until_stopped=False):
+    busctl = shutil.which('busctl')
+    if busctl is None or not unit_name.endswith('.service'):
+        raise RuntimeError('A verifiable user-service deadline policy is required; refusing worker execution.')
+    try:
+        unit_path = _busctl_call(busctl, 'org.freedesktop.systemd1', '/org/freedesktop/systemd1',
+                                 'org.freedesktop.systemd1.Manager', 'GetUnit', 's', unit_name)
+        properties = _busctl_call(busctl, 'org.freedesktop.systemd1', unit_path,
+                                 'org.freedesktop.DBus.Properties', 'GetAll', 's',
+                                 'org.freedesktop.systemd1.Service')
+        values = {name: properties[name]['data'] for name in SERVICE_PROPERTIES}
+    except (subprocess.SubprocessError, OSError, ValueError, KeyError, TypeError, IndexError) as error:
+        detail = getattr(error, 'stderr', None) or str(error)
+        raise RuntimeError(f'Cannot verify the worker service deadline and teardown policy; refusing execution: {detail}') from error
+    expected_runtime = (2**64 - 1 if until_stopped
+                        else int(round(runtime_seconds * 1_000_000)))
+    control_group = values['ControlGroup']
+    group_from_unit = Path('/sys/fs/cgroup') / control_group.lstrip('/')
+    valid = (
+        type(values['RuntimeMaxUSec']) is int and values['RuntimeMaxUSec'] == expected_runtime
+        and values['RuntimeRandomizedExtraUSec'] == 0
+        and type(values['TimeoutStopUSec']) is int and values['TimeoutStopUSec'] == STOP_SECONDS * 1_000_000
+        and type(values['TimeoutAbortUSec']) is int and values['TimeoutAbortUSec'] == STOP_SECONDS * 1_000_000
+        and values['Type'] == 'exec' and group_from_unit == group
+        and values['TimeoutStopFailureMode'] == 'terminate'
+        and values['KillMode'] == 'control-group' and values['KillSignal'] == 15
+        and values['FinalKillSignal'] == 9 and values['SendSIGKILL'] is True
+        and values['Restart'] == 'no' and values['NotifyAccess'] == 'none'
+        and values['WatchdogUSec'] == 0 and values['ExecStop'] == [] and values['ExecStopPost'] == []
+        and values['OOMPolicy'] == 'kill' and values['LimitCORE'] == 0
+    )
+    if not valid:
+        raise RuntimeError('The unit lacks the exact requested runtime/teardown policy; refusing execution.')
+    return values
+
+
+def kernel_limits(profile_name, runtime_seconds, unit_name, until_stopped=False):
+    if profile_name not in CPU_PERCENT:
+        raise RuntimeError(f'Unknown resource profile {profile_name!r}.')
+    group = current_cgroup()
+    names = ('cpu.max', 'memory.high', 'memory.max', 'memory.swap.max', 'pids.max')
+    try:
+        values = {name: (group / name).read_text().strip() for name in names}
+        quota_text, period_text = values['cpu.max'].split()
+        period = int(period_text)
+        quota = None if quota_text == 'max' else int(quota_text)
+    except (OSError, ValueError) as error:
+        raise RuntimeError('Cannot verify the service cgroup-v2 resource controls; refusing execution.') from error
+    expected_quota = (None if CPU_PERCENT[profile_name] is None
+                      else CPU_PERCENT[profile_name] * CPU_PERIOD_USEC // 100)
+    expected_quota_text = 'max' if expected_quota is None else str(expected_quota)
+    expected = {'cpu.max': f'{expected_quota_text} {CPU_PERIOD_USEC}',
+                'memory.high': str(MEMORY_HIGH[profile_name]), 'memory.max': str(MEMORY_MAX[profile_name]),
+                'memory.swap.max': MEMORY_SWAP_MAX[profile_name], 'pids.max': str(TASKS_MAX)}
+    if values != expected or period != CPU_PERIOD_USEC or quota != expected_quota:
+        raise RuntimeError(f'The service cgroup does not enforce the exact {profile_name} resource policy: {values}')
+    policy = service_limits(group, runtime_seconds, unit_name, until_stopped)
+    return {'profile': profile_name, 'runtime_seconds': runtime_seconds,
+            'until_stopped': until_stopped, 'cgroup': str(group),
+            'kernel_limits': values, 'affinity': affinity_limits(profile_name),
+            'service_limits': policy}
+
+
+def systemd_properties(profile_name, runtime_seconds, cpus=None, until_stopped=False):
+    if profile_name not in CPU_PERCENT or type(runtime_seconds) is not int or runtime_seconds <= 0:
+        raise RuntimeError('Invalid service profile or sample duration.')
+    if until_stopped and profile_name != 'normal':
+        raise RuntimeError('Manual-stop service lifetime is restricted to the normal profile.')
+    normal = profile_name == 'normal'
+    properties = {
+        'TasksMax': str(TASKS_MAX),
+        'RuntimeMaxSec': 'infinity' if until_stopped else f'{runtime_seconds:g}s',
+        'TimeoutStopSec': f'{STOP_SECONDS}s',
+        'TimeoutAbortSec': f'{STOP_SECONDS}s', 'TimeoutStopFailureMode': 'terminate',
+        'KillMode': 'control-group', 'KillSignal': 'SIGTERM',
+        'FinalKillSignal': 'SIGKILL', 'SendSIGKILL': 'yes', 'Restart': 'no',
+        'NotifyAccess': 'none', 'WatchdogSec': '0', 'OOMPolicy': 'kill', 'LimitCORE': '0',
+    }
+    if not normal:
+        properties.update({
+            'CPUQuota': f'{CPU_PERCENT[profile_name]}%', 'CPUQuotaPeriodSec': '100ms',
+            'MemoryHigh': str(MEMORY_HIGH[profile_name]),
+            'MemoryMax': str(MEMORY_MAX[profile_name]),
+            'MemorySwapMax': MEMORY_SWAP_MAX[profile_name],
+        })
+    if cpus is not None:
+        properties['CPUAffinity'] = ' '.join(map(str, cpus))
+    return properties
+
