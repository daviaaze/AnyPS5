+CAUSAL_TRACE_MAX_SECONDS = 120
+CAUSAL_UNTIL_STOPPED_SECONDS = 240
+CAUSAL_TRACE_SUMMARY_EVERY = '30'
+CAUSAL_TRACE_EVENTS = '1048576'
