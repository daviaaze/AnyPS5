+                or capture.record['state'] != 'sample_verified'):
+            raise RuntimeError('finalized full-window CPU evidence was not accepted')
+        return {
+            'scenario': 'disable_ack_before_perf_finalization',
+            'provisional_ack': 'deferred_without_controller_failure',
+            'completed_window': 'accepted_after_finalized_split_and_parse',
+            'outcome': 'success',
+        }
+
