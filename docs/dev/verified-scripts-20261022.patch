+
+def write_result(path, record):
+    launch_guard._atomic_json(path, record)
+
+
+def read_json(path):
+    info = path.lstat()
+    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid():
+        raise RuntimeError(f'{path} is not a regular file owned by this user')
+    value = json.loads(path.read_text())
+    if not isinstance(value, dict):
+        raise RuntimeError(f'{path} is not a JSON object')
+    return value
+
+
+def read_sample(run_dir):
+    path = run_dir / 'sample-window.json'
+    try:
+        return read_json(path)
+    except FileNotFoundError:
+        return None
+
+
+def read_observer_status(run_dir):
+    path = run_dir / 'causal-observer-status.json'
+    try:
+        return read_json(path)
+    except FileNotFoundError:
+        return None
+
+
+def wait_for_target_pid(pid_file, service_process, deadline):
+    while time.monotonic() < deadline:
+        if service_process.poll() is not None:
+            raise RuntimeError(f'fixture service exited before workload PID publication: {service_process.returncode}')
+        try:
+            info = pid_file.lstat()
+        except FileNotFoundError:
+            time.sleep(0.05)
+            continue
+        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid():
+            raise RuntimeError('fixture workload PID provenance is not an owned regular file')
+        value = pid_file.read_text().strip()
+        if not value.isdigit():
+            raise RuntimeError('fixture workload PID provenance is malformed')
+        pid = int(value)
+        if pid <= 1:
+            raise RuntimeError('fixture workload PID is unsafe')
+        return pid
+    raise RuntimeError('fixture workload PID was not published before the bounded startup deadline')
