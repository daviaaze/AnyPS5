+        contents = path.read_text().strip()
+        if contents != str(pid):
+            raise ObserverError('fixture PID provenance file differs from manifest PID')
+
+    def _verify_process_executable(self):
+        try:
+            actual = os.readlink(Path('/proc') / str(self.pid) / 'exe')
+        except PermissionError as error:
+            return {'method': 'manifest+pid-file', 'proc_exe': 'unavailable',
+                    'error': f'PermissionError: {error}'}
+        except FileNotFoundError as error:
+            raise ObserverError(f'fixture process executable identity disappeared: {error}') from error
+        if actual.endswith(' (deleted)') or Path(actual).resolve(strict=True) != self.executable_path:
+            raise ObserverError('fixture PID executable does not match its pinned known workload binary')
+        return {'method': 'proc-exe+manifest+pid-file', 'proc_exe': actual}
+
+    def _validate_limits(self):
+        group_path = CGROUP_ROOT / self.cgroup.lstrip('/')
+        expected = {
+            'cpu.max': FIXTURE_CPU_MAX,
+            'memory.high': '15032385536' if self.fixture_profile == 'bounded' else FIXTURE_MEMORY_HIGH,
+            'memory.max': '17179869184' if self.fixture_profile == 'bounded' else FIXTURE_MEMORY_MAX,
+            'memory.swap.max': '0',
+        }
+        for name, value in expected.items():
+            try:
+                actual = (group_path / name).read_text().strip()
+            except OSError as error:
+                raise ObserverError(f'cannot verify fixture cgroup control {name}: {error}') from error
+            if actual != value:
+                raise ObserverError(f'fixture cgroup control {name} is {actual!r}, expected {value!r}')
+
+    def _validate_unit_props(self, props, *, require_active):
+        if normalize_cgroup(props.get('ControlGroup')) != self.cgroup:
+            raise ObserverError('actual fixture unit ControlGroup differs from manifest cgroup')
+        if require_active and props.get('ActiveState') != 'active':
+            raise ObserverError(f"fixture unit is not active: {props.get('ActiveState')}")
+        if (props.get('Type') != 'exec' or props.get('Restart') != 'no'
+                or props.get('KillMode') != 'control-group'
+                or props.get('KillSignal') != 15 or props.get('FinalKillSignal') != 9
+                or props.get('SendSIGKILL') is not True
+                or props.get('TimeoutStopFailureMode') != 'terminate'
+                or props.get('OOMPolicy') != 'kill'):
+            raise ObserverError('actual fixture unit stop/restart policy is not group-bounded')
+        runtime_us = props.get('RuntimeMaxUSec')
+        timeout_us = props.get('TimeoutStopUSec')
+        abort_us = props.get('TimeoutAbortUSec')
+        randomized_us = props.get('RuntimeRandomizedExtraUSec')
+        if any(type(value) is not int for value in
+               (runtime_us, timeout_us, abort_us, randomized_us)):
+            raise ObserverError('actual fixture deadline properties are not typed integers')
+        if (runtime_us != self.runtime_seconds * 1000000 or runtime_us > 60000000
+                or timeout_us <= 0 or timeout_us > STOP_GRACE_SECONDS * 1000000
+                or abort_us != timeout_us or randomized_us != 0):
+            raise ObserverError('fixture unit does not have the exact <=60s runtime and bounded stop grace')
+        self._validate_limits()
+
+    def verify_process(self):
+        info = proc_stat(self.pid)
+        if info['starttime_ticks'] != self.starttime_ticks:
+            raise ObserverError('fixture PID was reused; refusing to profile or stop it')
+        if proc_cgroup(self.pid) != self.cgroup:
+            raise ObserverError('fixture PID left the exact manifest cgroup; refusing to profile or stop it')
+        self._verify_pid_file(self.pid, self.pid_file)
+        return info
+
+    def verify_owned_unit(self, *, require_active=True, allow_process_gone=False):
+        manifest = read_json_regular(self.manifest_path)
+        if manifest != self.manifest:
+            raise ObserverError('fixture manifest changed; refusing unit action')
+        if not allow_process_gone:
+            self.verify_process()
+        props = read_properties(self.unit)
+        self._validate_unit_props(props, require_active=require_active)
+        return props
+
+    def verify_unit(self, *, require_active):
+        props = read_properties(self.unit)
+        self._validate_unit_props(props, require_active=require_active)
+        return props
+
+
+def safe_read(path):
+    try:
+        return {'availability': 'available', 'raw': Path(path).read_text()}
+    except OSError as error:
+        return {'availability': 'unavailable', 'error': f'{type(error).__name__}: {error}'}
+
+
+def parse_key_values(raw):
+    values = {}
+    for line in raw.splitlines():
+        parts = line.split()
+        if len(parts) >= 2:
+            values[parts[0]] = parts[1:]
+    return values
+
+
+def namespace_ids(status):
+    try:
+        raw = status.read_text()
+    except OSError as error:
+        return {'availability': 'unavailable', 'error': f'{type(error).__name__}: {error}'}
+    result = {}
+    for name in ('NSpid', 'NStgid'):
+        line = next((item for item in raw.splitlines() if item.startswith(name + ':')), None)
+        if line is None:
+            return {'availability': 'unavailable', 'error': f'{name} missing from proc status'}
+        try:
+            result[name] = [int(value) for value in line.split(':', 1)[1].split()]
+        except ValueError as error:
+            return {'availability': 'unavailable', 'error': f'invalid {name}: {error}'}
+    return {'availability': 'available', 'ids': result}
+
+
+def cpu_tick_hz():
+    try:
+        return {'availability': 'available', 'value': os.sysconf('SC_CLK_TCK')}
+    except (OSError, ValueError) as error:
+        return {'availability': 'unavailable', 'error': f'{type(error).__name__}: {error}'}
+
+
+def read_thread(tid, pid):
+    path = Path('/proc') / str(pid) / 'task' / str(tid)
+    try:
+        raw = (path / 'stat').read_text()
+        parsed = parse_stat_line(raw, tid)
+    except OSError as error:
+        return {'tid': tid, 'availability': 'unavailable',
+                'error': f'{type(error).__name__}: {error}', 'disappeared_or_inaccessible': True,
+                'namespace_ids': namespace_ids(path / 'status')}
+    except (ObserverError, ValueError) as error:
+        return {'tid': tid, 'availability': 'unavailable', 'error': str(error),
+                'namespace_ids': namespace_ids(path / 'status')}
+    result = {'tid': tid, 'availability': 'available', 'comm': parsed['comm'],
+              'state': parsed['state'], 'utime_ticks': parsed['utime_ticks'],
+              'stime_ticks': parsed['stime_ticks'], 'starttime_ticks': parsed['starttime_ticks'],
+              'cpu_tick_hz': cpu_tick_hz(),
+              'namespace_ids': namespace_ids(path / 'status')}
+    try:
+        result['wchan'] = {'availability': 'available', 'raw': (path / 'wchan').read_text().strip()}
+    except OSError as error:
+        result['wchan'] = {'availability': 'unavailable', 'error': f'{type(error).__name__}: {error}'}
+    return result
+
+
+def snapshot(identity, previous_threads):
+    started = clock_pair()
+    cgroup_path = CGROUP_ROOT / identity.cgroup.lstrip('/')
+    cgroup = {}
+    for name in ('cpu.stat', 'memory.current', 'memory.peak', 'memory.events',
+                 'memory.pressure', 'io.stat'):
+        cgroup[name] = safe_read(cgroup_path / name)
+        if cgroup[name]['availability'] == 'available' and name in ('cpu.stat', 'memory.events', 'io.stat'):
+            cgroup[name]['fields'] = parse_key_values(cgroup[name]['raw'])
+    process_io = safe_read(Path('/proc') / str(identity.pid) / 'io')
+    if process_io['availability'] == 'available':
+        process_io['fields'] = parse_key_values(process_io['raw'])
+    process_status = namespace_ids(Path('/proc') / str(identity.pid) / 'status')
+    time_namespace_offsets = safe_read(Path('/proc') / str(identity.pid) / 'timens_offsets')
+    try:
+        listed = sorted(int(entry.name) for entry in (Path('/proc') / str(identity.pid) / 'task').iterdir()
+                        if entry.name.isdigit())
+        task_list_error = None
+    except OSError as error:
+        listed = []
+        task_list_error = f'{type(error).__name__}: {error}'
+    threads = [read_thread(tid, identity.pid) for tid in listed]
+    current_threads = {item['tid']: item.get('starttime_ticks') for item in threads
+                       if item.get('availability') == 'available'}
+    listed_tids = set(listed)
+    if task_list_error:
+        vanished = []
+        unreadable_previous = [{'tid': tid, 'starttime_ticks': start,
+                                'reason': 'task inventory unavailable'}
+                               for tid, start in previous_threads.items()]
+    else:
+        vanished = [{'tid': tid, 'starttime_ticks': start}
+                    for tid, start in previous_threads.items() if tid not in listed_tids]
+        unreadable_previous = [{'tid': tid, 'starttime_ticks': start,
+                                'reason': 'listed but stat was inaccessible or thread disappeared during read'}
+                               for tid, start in previous_threads.items()
+                               if tid in listed_tids and tid not in current_threads]
+    reused = [{'tid': tid, 'previous_starttime_ticks': previous_threads[tid],
+               'current_starttime_ticks': current_threads[tid]}
+              for tid in current_threads if tid in previous_threads
+              and current_threads[tid] != previous_threads[tid]]
+    try:
+        proc_identity = identity.verify_process()
+        process_check = {'availability': 'available', 'comm': proc_identity['comm'],
+                         'state': proc_identity['state'], 'starttime_ticks': proc_identity['starttime_ticks']}
+    except (OSError, ObserverError, ValueError) as error:
+        process_check = {'availability': 'unavailable', 'error': f'{type(error).__name__}: {error}'}
+    ended = clock_pair()
+    return ({'snapshot_start': started, 'snapshot_end': ended, 'pid': identity.pid,
+             'pid_identity': process_check, 'process_namespace_ids': process_status,
+             'time_namespace_offsets': time_namespace_offsets,
+             'cgroup': {'path': str(cgroup_path), 'files': cgroup},
+             'process_io': process_io,
+             'threads': {'availability': 'unavailable' if task_list_error else 'available',
+                         'error': task_list_error, 'cpu_tick_hz': cpu_tick_hz(),
+                         'items': threads, 'vanished_since_previous': vanished,
+                         'unreadable_since_previous': unreadable_previous, 'tid_reused': reused}},
+            current_threads)
+
+
+def snapshot_after_process_exit(identity, previous_threads):
+    started = clock_pair()
+    cgroup_path = CGROUP_ROOT / identity.cgroup.lstrip('/')
+    cgroup = {}
+    for name in ('cpu.stat', 'memory.current', 'memory.peak', 'memory.events',
+                 'memory.pressure', 'io.stat'):
+        cgroup[name] = safe_read(cgroup_path / name)
+        if cgroup[name]['availability'] == 'available' and name in ('cpu.stat', 'memory.events', 'io.stat'):
+            cgroup[name]['fields'] = parse_key_values(cgroup[name]['raw'])
+    ended = clock_pair()
+    return ({'snapshot_start': started, 'snapshot_end': ended, 'pid': identity.pid,
+             'availability': 'unavailable_process_exited',
+             'pid_identity': {'availability': 'unavailable_process_exited'},
+             'process_namespace_ids': {'availability': 'unavailable_process_exited'},
+             'time_namespace_offsets': {'availability': 'unavailable_process_exited'},
+             'cgroup': {'path': str(cgroup_path), 'files': cgroup},
+             'process_io': {'availability': 'unavailable_process_exited'},
+             'threads': {'availability': 'unavailable_process_exited',
+                         'items': [], 'vanished_since_previous': [],
+                         'unreadable_since_previous': [], 'tid_reused': []}},
+            {})
+
+
+def create_jsonl(path):
+    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | getattr(os, 'O_NOFOLLOW', 0), 0o600)
+    return fd
+
+
+class Monitor:
+    def __init__(self, run_dir, pid, sample_seconds, *, fixture=False,
+                 expected_starttime_ticks=None, fixture_timer_failure=False,
+                 external_kernel=False):
+        self.run_dir = run_dir
+        self.fixture = fixture
+        if fixture_timer_failure and not fixture:
+            raise ObserverError('fixture timer failure injection is available only in fixture mode')
+        if type(external_kernel) is not bool or fixture and external_kernel:
+            raise ObserverError('external privileged-kernel routing is unavailable in CPU fixtures')
+        self.fixture_timer_failure = fixture_timer_failure
+        self.identity = (FixtureIdentity(run_dir, pid) if fixture else
+                         Identity(run_dir, pid, expected_starttime_ticks))
+        admitted_external = getattr(self.identity, 'privileged_kernel_requested', False)
+        if external_kernel is not admitted_external:
+            raise ObserverError('external-kernel request differs from the authenticated worker admission')
+        self.external_kernel = external_kernel
+        self.sample_seconds = sample_seconds
+        if type(sample_seconds) is not int or not 1 <= sample_seconds <= MAX_SAMPLE_SECONDS:
+            raise ObserverError(f'sample duration must be 1..{MAX_SAMPLE_SECONDS} seconds')
+        if sample_seconds != self.identity.sampling.get('sample_seconds'):
+            raise ObserverError('monitor sample duration differs from the authenticated worker/fixture sampling policy')
+        for name in ('causal-observer-status.json', 'sample-window.json',
+                     'resources.jsonl', 'causal-observer-errors.jsonl', 'markers',
+                     '.causal-observer.sock'):
+            if (run_dir / name).exists():
+                raise ObserverError(f'refusing to overwrite existing observer output: {run_dir / name}')
+
+        self.lock_fd = None
+        self._lock_acquired = False
+        self.resource_fd = None
+        self.error_fd = None
+        self.ack_fd = None
+        self.control_fd = None
+        self.server = None
+        self.socket_path = run_dir / '.causal-observer.sock'
+        self._socket_created = False
+        self._owned_paths = set()
+        self._owned_dirs = set()
+        self._constructing = True
+        self.window = None
+        self.window_used = False
+        self.disable_attempted = False
+        self.perf_signal_attempted = False
+        self.window_lock = threading.Lock()
+        self.disable_timer = None
+        self.timer_failure = None
+        self.timer_failure_event = threading.Event()
+        self.previous_threads = {}
+        self.snapshot_number = 0
+        self.errors = []
+        self.started = clock_pair()
+        self.monitor_starttime_ticks = proc_stat(os.getpid())['starttime_ticks']
+        self.stop_request = None
+        self.kernel_trace = None
+        self.kernel_trace_status = (
+            {'schema': 'causal-kernel-trace/v1', 'status': 'external',
+             'route': 'privileged-helper', 'reason': 'external_privileged_collector_selected',
+             'root_cause_coverage_complete': False}
+            if self.external_kernel else
+            {'schema': 'causal-kernel-trace/v1', 'status': 'unavailable',
+             'reason': 'helper_unavailable' if causal_kernel_trace is None else 'not_started',
+             'root_cause_coverage_complete': False})
+        self.kernel_stack_cursor = 0
+        if not self.external_kernel and causal_kernel_trace is not None:
+            try:
+                self.kernel_trace = causal_kernel_trace.KernelTraceSession(
+                    pid=self.identity.pid,
+                    starttime_ticks=self.identity.starttime_ticks,
+                    cgroup=self.identity.cgroup,
+                    run_dir=self.run_dir,
+                    perf_path=self.run_dir / 'kernel-perf.data',
+                    max_seconds=self.sample_seconds,
+                )
+            except Exception as error:
+                self.kernel_trace_status = {
+                    'schema': 'causal-kernel-trace/v1', 'status': 'unavailable',
+                    'reason': 'session_construction_failed',
+                    'error': f'{type(error).__name__}: {error}',
+                    'root_cause_coverage_complete': False,
+                }
+        try:
+            self.lock_fd = os.open(run_dir / '.causal-observer.lock',
+                                   os.O_RDWR | os.O_CREAT | os.O_CLOEXEC | getattr(os, 'O_NOFOLLOW', 0),
+                                   0o600)
+            try:
+                fcntl.flock(self.lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+                self._lock_acquired = True
+            except OSError as error:
+                raise ObserverError(f'another monitor owns this run directory: {error}') from error
+
+            resource_path = run_dir / 'resources.jsonl'
+            self.resource_fd = create_jsonl(resource_path)
+            self._owned_paths.add(resource_path)
+            error_path = run_dir / 'causal-observer-errors.jsonl'
+            self.error_fd = create_jsonl(error_path)
+            self._owned_paths.add(error_path)
+            marker_path = run_dir / 'markers'
+            marker_path.mkdir(mode=0o700)
+            self._owned_dirs.add(marker_path)
+
+            self.server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+            self.server.setblocking(False)
+            self.server.bind(str(self.socket_path))
+            self._socket_created = True
+            self._owned_paths.add(self.socket_path)
+            os.chmod(self.socket_path, 0o600)
+            self.server.listen(4)
+            try:
+                self.ack_fd = os.open(self.identity.paths['ack_fifo'],
+                                      os.O_RDWR | os.O_NONBLOCK | os.O_CLOEXEC)
+            except OSError as error:
+                try:
+                    self.log_error('sampler_setup', error)
+                except OSError as persist_error:
+                    print(f'causal-observer: unable to persist sampler setup error: {persist_error}',
+                          file=sys.stderr, flush=True)
+                outcome = self.stop_owned_unit(f'sampler ACK FIFO open failed: {error}')
+                try:
+                    self.write_status('failed', str(error), stop_unit=outcome)
+                except OSError as persist_error:
+                    print(f'causal-observer: unable to persist failed setup status: {persist_error}',
+                          file=sys.stderr, flush=True)
+                raise ObserverError(f'cannot open sampler ACK FIFO: {error}') from error
+            self.write_status('starting', 'worker, PID, unit, FIFO and monitor socket validated; sampler remains disabled')
+            self._constructing = False
+        except BaseException:
+            self._cleanup_initialization()
+            raise
+
+    def _cleanup_initialization(self):
+        self.close()
+        for path in tuple(self._owned_paths):
+            try:
+                path.unlink()
+            except FileNotFoundError:
+                pass
+            except OSError as error:
+                print(f'causal-observer: unable to remove owned partial output {path}: {error}',
+                      file=sys.stderr, flush=True)
+        self._owned_paths.clear()
+        for path in tuple(self._owned_dirs):
+            try:
+                path.rmdir()
+            except FileNotFoundError:
+                pass
+            except OSError as error:
+                print(f'causal-observer: unable to remove owned empty directory {path}: {error}',
+                      file=sys.stderr, flush=True)
+        self._owned_dirs.clear()
+
+    def write_status(self, state, detail, **extra):
+        path = self.run_dir / 'causal-observer-status.json'
+        replace = self.snapshot_number > 0 or path.exists()
+        on_create = self._owned_paths.add if self._constructing and not replace else None
+        atomic_json(path,
+                    {'state': state, 'detail': detail, 'pid': self.identity.pid,
+                     'unit': self.identity.unit, 'cgroup': self.identity.cgroup,
+                     'monitor_pid': os.getpid(),
+                     'monitor_starttime_ticks': self.monitor_starttime_ticks,
+                     'mode': 'cpu_fixture' if self.fixture else 'capture24_game',
+                     'identity_verification': (getattr(self.identity, 'verification', None)
+                                               or getattr(self.identity, 'process_identity_verification', None)),
+                     'started': self.started, 'updated': clock_pair(), 'error_count': len(self.errors),
+                     'kernel_trace': self.kernel_trace_status,
+                     'kernel_evidence_route': (
+                         'privileged-helper' if self.external_kernel
+                         else 'observer-kernel-session'),
+                     **extra}, replace=replace, on_create=on_create)
+
+    def log_error(self, stage, error):
+        item = {'stage': stage, 'error': f'{type(error).__name__}: {error}', 'time': clock_pair()}
+        self.errors.append(item)
+        write_all(self.error_fd, (json.dumps(item, sort_keys=True, separators=(',', ':')) + '\n').encode())
+        os.fsync(self.error_fd)
+        self.write_status('error', item['error'], last_error=item)
+
+    def sample_record(self, state, **fields):
+        value = {'state': state, 'pid': self.identity.pid, 'unit': self.identity.unit,
+                 'cgroup': self.identity.cgroup, 'updated': clock_pair(), **fields}
+        atomic_json(self.run_dir / 'sample-window.json', value, replace=True)
+
+    def _drain_ack(self):
+        try:
+            data = os.read(self.ack_fd, 4096)
+        except BlockingIOError:
+            return
+        if data:
+            raise ObserverError(f'stale/unexpected sampler ACK before command: {data!r}')
+
+    def _verify_control_identity(self, allow_process_gone):
+        if allow_process_gone:
+            self.identity.verify_owned_unit(require_active=False, allow_process_gone=True)
+        else:
+            self.identity.verify_process()
+
+    def _open_control(self, deadline, allow_process_gone=False):
+        if self.control_fd is not None:
+            return
+        path = self.identity.paths['control_fifo']
+        while time.monotonic() < deadline:
+            try:
+                self.control_fd = os.open(path, os.O_WRONLY | os.O_NONBLOCK | os.O_CLOEXEC)
+                return
+            except OSError as error:
+                if error.errno not in (errno.ENXIO, errno.ENOENT):
+                    raise
+                self._verify_control_identity(allow_process_gone)
+                time.sleep(min(0.1, max(0.0, deadline - time.monotonic())))
+        raise ObserverError('perf control FIFO has no reader before ACK timeout')
+
+    def command(self, verb, timeout=ACK_TIMEOUT_SECONDS, *, allow_process_gone=False):
+        if verb not in ('enable', 'disable'):
+            raise ObserverError('internal invalid perf control verb')
+        self._verify_control_identity(allow_process_gone)
+        self._drain_ack()
+        deadline = time.monotonic() + timeout
+        self._open_control(deadline, allow_process_gone)
+        request = clock_pair()
+        payload = (verb + '\n').encode('ascii')
+        try:
+            count = os.write(self.control_fd, payload)
+        except OSError as error:
+            raise ObserverError(f'perf control FIFO write failed for {verb}: {error}') from error
+        wrote = clock_pair()
+        if count != len(payload):
+            raise ObserverError(f'short perf control FIFO write for {verb}: {count}/{len(payload)}')
+        buffer = bytearray()
+        while time.monotonic() < deadline:
+            self._verify_control_identity(allow_process_gone)
+            remaining = deadline - time.monotonic()
+            readable, _, _ = select.select([self.ack_fd], [], [], min(0.1, max(0.0, remaining)))
+            if not readable:
+                continue
+            try:
+                data = os.read(self.ack_fd, 4096)
+            except BlockingIOError:
+                continue
+            if not data:
+                continue
+            buffer.extend(data)
+            if len(buffer) > 4096:
+                raise ObserverError('perf ACK exceeded the bounded response size')
+            if b'\n' not in buffer:
+                continue
+            line, _, trailing = buffer.partition(b'\n')
+            if trailing not in (b'', b'\0'):
+                raise ObserverError(f'unexpected extra bytes after perf ACK: {bytes(trailing)!r}')
+            observed = clock_pair()
+            if line.strip() != b'ack':
+                raise ObserverError(f'unexpected perf ACK line for {verb}: {bytes(line)!r}')
+            return {'command': verb, 'request': request, 'write_returned': wrote,
+                    'ack_observed': observed, 'ack_line': line.decode('ascii'),
+                    'ack_raw_hex': bytes(buffer).hex(),
+                    'ack_protocol_terminator': 'nul' if trailing else 'none'}
+        raise ObserverError(f'perf {verb} ACK timed out after {timeout:.3f}s')
+
+    def start_sample(self, request, observer_received):
+        with self.window_lock:
+            if self.fixture != (request.get('fixture') is True):
+                raise ObserverError('fixture-mode request does not match this monitor')
+            if self.window_used:
+                raise ObserverError('the one permitted sampling window has already been used')
+            requested_seconds = request.get('seconds', self.sample_seconds)
+            if type(requested_seconds) is not int or not (1 <= requested_seconds <= self.sample_seconds <= MAX_SAMPLE_SECONDS):
+                raise ObserverError(f'sample seconds must be an integer in 1..{self.sample_seconds}')
+            if not self.fixture and requested_seconds != self.sample_seconds:
+                raise ObserverError('native sampling duration is fixed by its authenticated bounded service runtime')
+            self.identity.verify_owned_unit(require_active=True)
+            self.window_used = True
+            self.sample_record('enable_pending', requested=request.get('emitted'),
+                               observer_received=observer_received, requested_seconds=requested_seconds)
+            enable = self.command('enable')
+            self.window = {'requested': request.get('emitted'), 'observer_received': observer_received,
+                           'requested_seconds': requested_seconds, 'enable': enable,
+                           'disable_deadline_monotonic_ns': enable['ack_observed']['monotonic_ns'] + requested_seconds * 1000000000,
+                           'disable': None, 'state': 'enabled'}
+            self.sample_record('enabled', window=self.window)
+            remaining = max(0.0, requested_seconds
+                            - (time.monotonic_ns() - enable['ack_observed']['monotonic_ns']) / 1_000_000_000)
+            self.disable_timer = threading.Timer(remaining, self._timed_disable)
+            self.disable_timer.daemon = True
+            self.disable_timer.start()
+            return {'ready': True, 'sample_window': self.window}
