+#!/usr/bin/env python3
+"""Inspect a pinned capture or send one visually gated button; ACKs never prove menu state."""
+
+import argparse
+import json
+import os
+from pathlib import Path
+import re
+import stat
+import subprocess
+import sys
+import time
+
+import native_launch_guard as guard
+
+BASE = Path(__file__).resolve().parent
+EVIDENCE = BASE / 'evidence'
+PAD_HELPER = BASE / 'AnyPS5-candidate' / 'tools' / 'pad_input.py'
+CAPTURE_HELPER = BASE / 'capture-owned-window.py'
+PAD_ACK_TIMEOUT_SECONDS = 90
+CAPTURE_MAX_AGE_NS = 60 * 1_000_000_000
+ACK_POLL_SECONDS = 0.05
+ACK_STOP_RESERVE_NS = 1_000_000_000
+
+
+def run(command, timeout=10):
+    result = subprocess.run(command, capture_output=True, text=True, check=True, timeout=timeout)
+    return result.stdout.strip()
+
+
+def focus_game(pid):
+    clients = json.loads(run(['hyprctl', 'clients', '-j']))
+    matches = [window for window in clients if window.get('pid') == pid]
+    if len(matches) != 1 or not matches[0].get('mapped') or matches[0].get('hidden'):
+        raise RuntimeError('Pinned game does not have one mapped Hyprland window')
+    window = matches[0]
+    workspace = window.get('workspace', {}).get('id')
+    if type(workspace) is not int:
+        raise RuntimeError('Pinned game window has no numeric workspace')
+    active = json.loads(run(['hyprctl', 'activeworkspace', '-j']))
+    if active.get('id') != workspace:
+        run(['hyprctl', 'dispatch', 'workspace', str(workspace)])
+        time.sleep(0.2)
+    run(['hyprctl', 'dispatch', 'focuswindow', f"address:{window['address']}"])
+    time.sleep(0.2)
+    active_window = json.loads(run(['hyprctl', 'activewindow', '-j']))
+    if active_window.get('pid') != pid:
+        raise RuntimeError('Could not focus the pinned game window')
+
+
+def capture(run_dir, pid, starttime):
+    result = subprocess.run(
+        [sys.executable, str(CAPTURE_HELPER), '--run-dir', str(run_dir),
+         '--expected-pid', str(pid), '--expected-starttime', str(starttime)],
+        capture_output=True, text=True, check=True, timeout=15)
+    record = json.loads(result.stdout)
+    if (record.get('status') != 'captured' or record.get('pid') != pid
+            or record.get('starttime_ticks') != starttime
+            or type(record.get('started_monotonic_ns')) is not int):
+        raise RuntimeError(f"Pinned game screenshot unavailable: {record.get('status')}")
+    return {
+        'image': record['image'],
+        'started_monotonic_ns': record['started_monotonic_ns'],
+        'receipt_id': str(record['started_monotonic_ns']),
+        'capture_record': str(run_dir / f"scene-observation-{record['started_monotonic_ns']}.json"),
+    }
+
+
+def input_release_ack(ack_file, sequence):
+    deadline = time.monotonic() + PAD_ACK_TIMEOUT_SECONDS
+    while True:
+        try:
+            fields = ack_file.read_text().split()
+        except FileNotFoundError:
+            fields = []
+        if len(fields) == 2:
+            try:
+                acknowledged_sequence = int(fields[0])
+            except ValueError:
+                acknowledged_sequence = 0
+            if acknowledged_sequence == sequence and fields[1] == 'released':
+                return
+            if acknowledged_sequence > sequence:
+                raise RuntimeError(
+                    f'Controller input sequence {sequence} was replaced by {acknowledged_sequence}'
+                )
+        if time.monotonic() >= deadline:
+            raise TimeoutError(
+                f'Game did not consume and release controller input sequence {sequence} '
+                f'within {PAD_ACK_TIMEOUT_SECONDS}s'
+            )
+        time.sleep(ACK_POLL_SECONDS)
+
+
+def read_json_object(path, max_bytes=16 * 1024 * 1024):
+    info = path.lstat()
+    if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid()
+            or info.st_size > max_bytes):
+        raise RuntimeError(f'Owned evidence record is not a bounded regular file: {path.name}')
+    value = json.loads(path.read_text())
+    if not isinstance(value, dict):
+        raise RuntimeError(f'Evidence record is not a JSON object: {path.name}')
+    return value
+
+
+def load_run_context(raw_run_dir, pid, starttime):
+    raw = Path(raw_run_dir)
+    run_dir = raw.resolve(strict=True)
+    if (raw != run_dir or run_dir.parent != EVIDENCE
+            or re.fullmatch(r'native-game-[0-9a-f]{12}', run_dir.name) is None
+            or run_dir.stat().st_uid != os.geteuid() or os.geteuid() != 1000):
+        raise RuntimeError('Navigation requires a canonical desktop-user game evidence directory')
+    capture_state = read_json_object(run_dir / 'causal-capture-status.json')
+    worker = read_json_object(run_dir / 'worker-result.json')
+    target = capture_state.get('target', {})
+    if (target.get('status') != 'verified' or target.get('pid') != pid
+            or target.get('starttime_ticks') != starttime):
+        raise RuntimeError('Navigation request differs from the pinned controller target')
+    identity = (worker.get('identity') or {}).get('elf') or {}
+    if (identity.get('path') != str(guard.CANDIDATE.resolve(strict=True))
+            or identity.get('sha256') != guard.EXPECTED_ELF_SHA256):
+        raise RuntimeError('Worker does not identify the canonical game executable')
+    return run_dir, {'capture_state': capture_state, 'target': target,
+                     'worker': worker, 'identity': identity}
+
+
+def check_run_state(run_dir, context, minimum_remaining_ns=0):
+    status = read_json_object(run_dir / 'causal-capture-status.json')
+    target = status.get('target', {})
+    expected = context['target']
+    if (target.get('status') != 'verified' or target.get('pid') != expected.get('pid')
+            or target.get('starttime_ticks') != expected.get('starttime_ticks')
+            or target.get('cgroup') != expected.get('cgroup')):
+        raise RuntimeError('Pinned capture target changed during navigation')
+    policy = status.get('runtime_stop_policy') or {}
+    if (status.get('state') != 'sampling'
+            or (status.get('sample') or {}).get('status') != 'active'
+            or (status.get('shutdown') or {}).get('status') != 'pending'
+            or (status.get('finalization') or {}).get('status') != 'not_attempted'
+            or status.get('outcome') != 'pending'):
+        raise RuntimeError('Navigation refuses a stopped or finalizing capture run')
+    if ((run_dir / 'causal-stop-request.json').exists()
+            or (run_dir / 'causal-stop-result.json').exists()):
+        raise RuntimeError('Navigation refuses a run with an ordered-stop request or result')
+    stop_status = policy.get('status')
+    if stop_status == 'manual_stop_only':
+        deadline_ns = None
+    elif stop_status == 'controller_deadline_armed':
+        deadline_ns = policy.get('stop_deadline_monotonic_ns')
+        if type(deadline_ns) is not int:
+            raise RuntimeError('Active capture has no verified ordered-stop deadline')
+    else:
+        raise RuntimeError(f'Navigation refuses capture stop state {stop_status!r}')
+    now_ns = time.monotonic_ns()
+    if deadline_ns is not None and now_ns + minimum_remaining_ns >= deadline_ns:
+        raise RuntimeError('Ordered-stop deadline leaves insufficient time for this navigation step')
+    return deadline_ns
+
+
+def check_run_active(run_dir, context, minimum_remaining_ns=0):
+    deadline_ns = check_run_state(run_dir, context, minimum_remaining_ns)
+    target = context['target']
+    owner = guard._read_owner()
+    if (not isinstance(owner, dict) or owner.get('state') != 'running'
+            or owner.get('kind') != 'game' or owner.get('unit') != context['capture_state'].get('unit')
+            or owner.get('output_dir') != str(run_dir)
+            or guard._normalized_cgroup(owner.get('cgroup'))
+            != guard._normalized_cgroup(target.get('cgroup'))):
+        raise RuntimeError('Navigation requires the matching active native-game launch lease')
+    owner_elf = (owner.get('identity') or {}).get('elf') or {}
+    if (owner_elf.get('path') != context['identity']['path']
+            or owner_elf.get('sha256') != context['identity']['sha256']):
+        raise RuntimeError('Active launch lease does not identify the pinned executable')
+    systemctl = guard.shutil.which('systemctl')
+    if systemctl is None:
+        raise RuntimeError('Navigation cannot verify the owned game systemd unit')
+    unit = guard._unit_snapshot(systemctl, owner['unit'])
+    properties = unit.get('properties') or {}
+    if (unit.get('query') != 'ok' or properties.get('ActiveState') != 'active'
+            or guard._normalized_cgroup(properties.get('ControlGroup'))
+            != guard._normalized_cgroup(target.get('cgroup'))):
+        raise RuntimeError('Owned game systemd unit is not active in the pinned cgroup')
+    current = guard._candidate_in_cgroup({'elf': context['identity']}, target['cgroup'])
+    if (current is None or current.get('pid') != target['pid']
+            or current.get('starttime_ticks') != target['starttime_ticks']
+            or current.get('cgroup') != target['cgroup']):
+        raise RuntimeError('Pinned target PID, start time, or cgroup is no longer live')
+    return deadline_ns
+
+
+def validate_capture_receipt(run_dir, receipt_id, pid, starttime):
+    if re.fullmatch(r'[1-9][0-9]*', receipt_id or '') is None:
+        raise RuntimeError('Capture receipt must be the exact positive receipt_id from inspect output')
+    receipt_ns = int(receipt_id)
+    matches = []
+    for path in run_dir.glob('scene-observation-*.json'):
+        match = re.fullmatch(r'scene-observation-([0-9]+)\.json', path.name)
+        if match is None:
+            continue
+        record = read_json_object(path, 1024 * 1024)
+        started_ns = record.get('started_monotonic_ns')
+        finished_ns = record.get('finished_monotonic_ns')
+        if (type(started_ns) is not int or str(started_ns) != match.group(1)
+                or type(finished_ns) is not int or finished_ns < started_ns):
+            raise RuntimeError('A scene observation has invalid monotonic receipt timestamps')
+        matches.append((record, path))
+    if not matches:
+        raise RuntimeError('No screenshot receipt exists in this run')
+    record, path = max(matches, key=lambda item: item[0]['started_monotonic_ns'])
+    if record.get('started_monotonic_ns') != receipt_ns:
+        raise RuntimeError('Capture receipt is stale; inspect again and confirm the latest capture')
+    finished_ns = record.get('finished_monotonic_ns')
+    if (record.get('status') != 'captured' or record.get('pid') != pid
+            or record.get('starttime_ticks') != starttime
+            or type(finished_ns) is not int or finished_ns < receipt_ns
+            or time.monotonic_ns() < finished_ns
+            or time.monotonic_ns() - finished_ns > CAPTURE_MAX_AGE_NS
+            or record.get('capture_returncode') != 0):
+        raise RuntimeError('Capture receipt is invalid, stale, or belongs to another pinned target')
+    image = Path(record.get('image', ''))
+    expected_image = run_dir / f'scene-{receipt_ns}.png'
+    if image != expected_image or image.is_symlink():
+        raise RuntimeError('Capture receipt image path is not the expected file in this run')
+    image_info = image.lstat()
+    if not stat.S_ISREG(image_info.st_mode) or image_info.st_uid != os.geteuid() or image_info.st_size <= 0:
+        raise RuntimeError('Capture receipt image is missing or invalid')
+    windows = record.get('windows_after_focus')
+    focused = record.get('focused_window') or {}
+    active = record.get('active_window_after_capture') or {}
+    if (not isinstance(windows, list) or len(windows) != 1
+            or windows[0].get('pid') != pid or not windows[0].get('mapped')
+            or not windows[0].get('visible') or windows[0].get('hidden')
+            or focused.get('pid') != pid or active.get('pid') != pid
+            or not focused.get('address') or focused.get('address') != windows[0].get('address')
+            or active.get('address') != focused.get('address')):
+        raise RuntimeError('Capture receipt does not prove the pinned target retained focus')
+    return {
+        'receipt_id': receipt_id,
+        'image': str(image),
+        'capture_record': str(path),
+        'started_monotonic_ns': receipt_ns,
+        'finished_monotonic_ns': finished_ns,
+        'focused_window_address': focused['address'],
+    }
+
+
+def require_current_focus(pid, address):
+    windows = json.loads(run(['hyprctl', 'clients', '-j']))
+    matches = [window for window in windows if window.get('pid') == pid]
+    if (len(matches) != 1 or matches[0].get('address') != address
+            or not matches[0].get('mapped') or not matches[0].get('visible')
+            or matches[0].get('hidden')):
+        raise RuntimeError('Pinned game window changed or lost focus after the confirmed capture')
+    active = json.loads(run(['hyprctl', 'activewindow', '-j']))
+    if active.get('pid') != pid or active.get('address') != address:
+        raise RuntimeError('Pinned game window is no longer the active focused window')
+
+
+def wait_for_input_ack(run_dir, context, ack_file, sequence, deadline_ns):
+    timeout_ns = time.monotonic_ns() + PAD_ACK_TIMEOUT_SECONDS * 1_000_000_000
+    if deadline_ns is not None:
+        timeout_ns = min(timeout_ns, deadline_ns - ACK_STOP_RESERVE_NS)
+    accepted_seen = False
+    accepted_at_ns = None
+    while True:
+        check_run_state(run_dir, context)
+        now_ns = time.monotonic_ns()
+        if now_ns >= timeout_ns:
+            raise TimeoutError(
+                f'Controller sequence {sequence} was not released before its bounded ACK deadline')
+        try:
+            fields = ack_file.read_text().split()
+        except FileNotFoundError:
+            fields = []
+        if len(fields) == 2:
+            try:
+                acknowledged_sequence = int(fields[0])
+            except ValueError:
+                acknowledged_sequence = 0
+            if acknowledged_sequence > sequence:
+                raise RuntimeError(
+                    f'Controller input sequence {sequence} was replaced by {acknowledged_sequence}')
+            if acknowledged_sequence == sequence:
+                if fields[1] == 'accepted':
+                    accepted_seen = True
+                    accepted_at_ns = accepted_at_ns or now_ns
+                elif fields[1] == 'released':
+                    return {
+                        'sequence': sequence,
+                        'accepted_observed': accepted_seen,
+                        'accepted_observed_monotonic_ns': accepted_at_ns,
+                        'released_observed': True,
+                        'released_observed_monotonic_ns': now_ns,
+                    }
+        remaining_ns = timeout_ns - time.monotonic_ns()
+        if remaining_ns <= 0:
+            raise TimeoutError(
+                f'Controller sequence {sequence} was not released before its bounded ACK deadline')
+        time.sleep(min(ACK_POLL_SECONDS, remaining_ns / 1_000_000_000))
+
+
+def wait_for_settle(run_dir, context, settle_ms):
+    finish = time.monotonic() + settle_ms / 1000
+    while True:
+        check_run_state(run_dir, context)
+        remaining = finish - time.monotonic()
+        if remaining <= 0:
+            return
+        deadline_ns = (context['capture_state'].get('runtime_stop_policy') or {}).get(
+            'stop_deadline_monotonic_ns')
+        if type(deadline_ns) is int:
+            remaining_deadline = (
+                deadline_ns - ACK_STOP_RESERVE_NS - time.monotonic_ns()
+            ) / 1_000_000_000
+            if remaining_deadline <= 0:
+                raise RuntimeError('Ordered-stop safety reserve reached during post-input settle')
+            remaining = min(remaining, remaining_deadline)
+        time.sleep(min(ACK_POLL_SECONDS, remaining))
+
+
+def safe_one_step(args, parser):
+    if args.mode == 'inspect':
+        if args.button is not None or args.confirm_capture is not None or args.confirm_visual:
+            parser.error('--mode inspect accepts no button or confirmation flags')
+    else:
+        if args.button is None or args.confirm_capture is None or not args.confirm_visual:
+            parser.error('--mode step requires --button, --confirm-capture RECEIPT, and --confirm-visual')
+    run_dir, context = load_run_context(args.run_dir, args.expected_pid, args.expected_starttime)
+    deadline_ns = check_run_active(run_dir, context)
+    if args.mode == 'inspect':
+        result = capture(run_dir, args.expected_pid, args.expected_starttime)
+        check_run_state(run_dir, context)
+        receipt = validate_capture_receipt(
+            run_dir, result['receipt_id'], args.expected_pid, args.expected_starttime)
+        print(json.dumps({
+            'mode': 'inspect',
+            'status': 'capture_ready_for_operator_review',
+            **receipt,
+            'input_sent': False,
+            'visual_scene_verified': False,
+            'menu_state_verified': False,
+        }, sort_keys=True))
+        return 0
+
+    if context['worker'].get('pad_input_ack_enabled') is not True:
+        raise RuntimeError('Single-step input requires the pad input ACK file protocol')
+    pad_file = run_dir / 'pad_input'
+    if not pad_file.is_file():
+        raise RuntimeError('Pinned run input file is missing')
+    pre = validate_capture_receipt(
+        run_dir, args.confirm_capture, args.expected_pid, args.expected_starttime)
+    require_current_focus(args.expected_pid, pre['focused_window_address'])
+    hold_ns = args.hold_ms * 1_000_000
+    deadline_ns = check_run_active(run_dir, context, hold_ns + ACK_STOP_RESERVE_NS)
+    pre = validate_capture_receipt(
+        run_dir, args.confirm_capture, args.expected_pid, args.expected_starttime)
+    require_current_focus(args.expected_pid, pre['focused_window_address'])
+    if (deadline_ns is not None
+            and time.monotonic_ns() + hold_ns + ACK_STOP_RESERVE_NS >= deadline_ns):
+        raise RuntimeError('Ordered-stop deadline is too close to queue this controller hold')
+    output = run_dir / f'navigation-step-{args.confirm_capture}.json'
+    result = {
+        'mode': 'single_button',
+        'status': 'input_pending',
+        'pid': args.expected_pid,
+        'starttime_ticks': args.expected_starttime,
+        'button': args.button,
+        'hold_ms': args.hold_ms,
+        'operator_visual_confirmation': {
+            'confirmed': True,
+            'capture_receipt_id': args.confirm_capture,
+        },
+        'pre_capture': pre,
+        'pad_input_sequence': None,
+        'input_ack': {
+            'status': 'not_submitted',
+            'accepted_observed': False,
+            'released_observed': False,
+        },
+        'menu_state_verified': False,
+        'visual_scene_verified': False,
+    }
+    guard._atomic_json(output, result, replace=False)
+    submitted = False
+    submission_attempted = False
+    sequence = None
+    try:
+        check_run_active(run_dir, context, hold_ns + ACK_STOP_RESERVE_NS)
+        latest = validate_capture_receipt(
+            run_dir, args.confirm_capture, args.expected_pid, args.expected_starttime)
+        require_current_focus(args.expected_pid, latest['focused_window_address'])
+        helper_argv = [
+            sys.executable, str(PAD_HELPER), str(pad_file), args.button,
+            '--hold-ms', str(args.hold_ms),
+        ]
+        refreshed_deadline_ns = check_run_state(run_dir, context)
+        if deadline_ns is None:
+            dispatch_deadline_ns = refreshed_deadline_ns
+        elif refreshed_deadline_ns is None:
+            dispatch_deadline_ns = deadline_ns
+        else:
+            dispatch_deadline_ns = min(deadline_ns, refreshed_deadline_ns)
+        now_ns = time.monotonic_ns()
+        dispatch_budget_ns = None
+        if dispatch_deadline_ns is not None:
+            dispatch_budget_ns = (
+                dispatch_deadline_ns - now_ns - hold_ns - ACK_STOP_RESERVE_NS
+            )
+            if dispatch_budget_ns <= 0:
+                raise RuntimeError(
+                    'Ordered-stop deadline leaves insufficient time for this navigation step')
+        # The final monotonic check minimizes, but cannot eliminate, OS scheduling delay before dispatch.
+        helper_timeout = 10 if dispatch_budget_ns is None else min(
+            10, dispatch_budget_ns / 1_000_000_000)
+        submission_attempted = True
+        run(helper_argv, timeout=helper_timeout)
+        submitted = True
+        result['input_ack'] = {
+            'status': 'awaiting_sequence_read',
+            'accepted_observed': False,
+            'released_observed': False,
+        }
+        guard._atomic_json(output, result)
+        fields = pad_file.read_text().split()
+        if len(fields) not in (3, 7):
+            raise RuntimeError('Controller helper did not write a valid sequenced command')
+        try:
+            sequence = int(fields[0])
+        except ValueError as error:
+            raise RuntimeError('Controller command sequence is invalid') from error
+        if sequence <= 0:
+            raise RuntimeError('Controller command sequence is not positive')
+        result['pad_input_sequence'] = sequence
+        result['input_ack'] = {
+            'status': 'waiting',
+            'sequence': sequence,
+            'accepted_observed': False,
+            'released_observed': False,
+        }
+        guard._atomic_json(output, result)
+        ack = wait_for_input_ack(
+            run_dir, context, run_dir / 'pad_input_ack', sequence, dispatch_deadline_ns)
+        result['input_ack'] = {'status': 'released', **ack}
+        guard._atomic_json(output, result)
+        wait_for_settle(run_dir, context, args.settle_ms)
+        result['post_capture'] = capture(
+            run_dir, args.expected_pid, args.expected_starttime)
+        check_run_state(run_dir, context)
+        result['status'] = 'input_sequence_complete_unverified'
+        guard._atomic_json(output, result)
+    except Exception as error:
+        if submission_attempted and not submitted:
+            result['input_ack'] = {'status': 'submission_outcome_unknown'}
+        elif submitted and result['input_ack'].get('status') == 'waiting':
+            try:
+                fields = (run_dir / 'pad_input_ack').read_text().split()
+            except FileNotFoundError:
+                fields = []
+            if len(fields) == 2 and fields[0].isdigit() and int(fields[0]) == sequence:
+                result['input_ack'] = {
+                    'status': fields[1] if fields[1] in ('accepted', 'released') else 'unrecognized',
+                    'sequence': sequence,
+                    'accepted_observed': fields[1] in ('accepted', 'released'),
+                    'released_observed': fields[1] == 'released',
+                }
+            else:
+                result['input_ack'] = {
+                    'status': 'not_observed_or_replaced',
+                    'sequence': sequence,
+                    'accepted_observed': False,
+                    'released_observed': False,
+                }
+        result['status'] = (
+            'input_ack_or_capture_failed' if submitted else
+            'input_submission_unknown' if submission_attempted else
+            'refused_before_input')
+        result['failure'] = {'error': type(error).__name__ + ': ' + str(error)}
+        guard._atomic_json(output, result)
+        raise
+    print(json.dumps({**result, 'manifest': str(output)}, sort_keys=True))
+    return 0
+
+
+def press_and_capture(run_dir, pad_file, pid, starttime, button, label, settle_ms):
+    run([sys.executable, str(PAD_HELPER), str(pad_file), button, '--hold-ms', '100'])
+    fields = pad_file.read_text().split()
+    if len(fields) not in (3, 7):
+        raise RuntimeError('Controller helper did not write a valid sequenced command')
+    try:
+        sequence = int(fields[0])
+    except ValueError as error:
+        raise RuntimeError('Controller command sequence is invalid') from error
+    input_release_ack(run_dir / 'pad_input_ack', sequence)
+    time.sleep(settle_ms / 1000)
+    return {
+        'label': label,
+        'button': button,
+        'pad_input_sequence': sequence,
+        'pad_input_ack': 'released',
+        **capture(run_dir, pid, starttime),
+    }
+
+
+def main():
+    parser = argparse.ArgumentParser(
+        description='Inspect one pinned game capture or explicitly confirm and issue one button; ACKs never verify menu state.')
+    parser.add_argument('--mode', choices=('inspect', 'step', 'route'), default='inspect',
+                        help='inspect is input-free and default; step sends at most one gated button; route is legacy fixed-route mode.')
+    parser.add_argument('--run-dir', required=True)
+    parser.add_argument('--expected-pid', type=int, required=True)
+    parser.add_argument('--expected-starttime', type=int, required=True)
+    parser.add_argument('--button',
+                        choices=('l3', 'r3', 'options', 'up', 'right', 'down', 'left',
+                                 'l2', 'r2', 'l1', 'r1', 'triangle', 'circle',
+                                 'cross', 'square', 'touchpad', 'touch-left',
+                                 'touch-right', 'release'),
+                        help='Single button for --mode step.')
+    parser.add_argument('--confirm-capture',
+                        help='Exact receipt_id from the immediately preceding inspect capture.')
+    parser.add_argument('--confirm-visual', action='store_true',
+                        help='Explicitly confirm that you just visually reviewed --confirm-capture for this target.')
+    parser.add_argument('--hold-ms', type=int, default=100,
+                        help='Single-step hold duration (1..5000; default 100 ms).')
+    parser.add_argument('--tutorial', choices=('1', '2', '3'), default='3')
+    parser.add_argument('--destination', choices=('tutorial', 'title'), default='tutorial',
+                        help='Legacy route target: direct tutorial map or game Title entry.')
+    parser.add_argument('--start-state', choices=('black', 'root'), default='black',
+                        help='Legacy route startup: black screen or visible debug-menu selection.')
+    parser.add_argument('--root-row', type=int, choices=range(5), default=4,
+                        help='Legacy route current root-menu row when --start-state=root (0..4).')
+    parser.add_argument('--settle-ms', type=int, default=2500,
+                        help='Settle after ACK before the next capture (1..10000).')
+    parser.add_argument('--confirm-cross-count', type=int, choices=(1, 2), default=1,
+                        help='Legacy route screenshot-separated Cross confirmations.')
+    parser.add_argument('--post-launch-wait-ms', type=int, default=30000,
+                        help='Legacy route wait after the final Cross (0..60000).')
+    parser.add_argument('--startup-wait-ms', type=int, default=0,
+                        help='Legacy route startup wait before initial menu capture (0..120000).')
+    parser.add_argument('--stop-before-confirmation', action='store_true',
+                        help='Legacy route: stop at selected T-1 map before Cross.')
+    parser.add_argument('--confirm-selected-map', action='store_true',
+                        help='Legacy route: resume an awaiting-confirmation T-1 manifest.')
+    args = parser.parse_args()
+    if not 1 <= args.settle_ms <= 10000:
+        parser.error('--settle-ms must be between 1 and 10000.')
+    if not 1 <= args.hold_ms <= 5000:
+        parser.error('--hold-ms must be between 1 and 5000.')
+    if args.mode in ('inspect', 'step'):
+        if args.mode == 'inspect' and args.hold_ms != 100:
+            parser.error('--hold-ms only applies to --mode step.')
+        return safe_one_step(args, parser)
+    if args.hold_ms != 100:
+        parser.error('--hold-ms only applies to --mode step.')
+    if args.button is not None or args.confirm_capture is not None or args.confirm_visual:
+        parser.error('--button and screenshot confirmations are only valid in --mode step')
+    if not 0 <= args.post_launch_wait_ms <= 60000:
+        parser.error('--post-launch-wait-ms must be between 0 and 60000.')
+    if not 0 <= args.startup_wait_ms <= 120000:
+        parser.error('--startup-wait-ms must be between 0 and 120000.')
+    if args.destination == 'title' and args.start_state != 'root':
+        parser.error('--destination title requires --start-state root.')
+    if args.stop_before_confirmation and args.confirm_selected_map:
+        parser.error('--stop-before-confirmation and --confirm-selected-map are mutually exclusive.')
+    if args.stop_before_confirmation or args.confirm_selected_map:
+        if (args.destination != 'tutorial' or args.tutorial != '1'
+                or args.start_state != 'root' or args.root_row != 0
+                or args.confirm_cross_count != 2):
+            parser.error('T-1 confirmation phases require tutorial1, root row00, and exactly two Cross presses.')
+
+    run_dir, context = load_run_context(args.run_dir, args.expected_pid, args.expected_starttime)
+    worker = context['worker']
+    if worker.get('mangohud') is not True:
+        raise RuntimeError('This navigation run must have MangoHud enabled')
+    if worker.get('pad_input_ack_enabled') is not True:
+        raise RuntimeError('This navigation run requires the pad input ACK file protocol')
+
+    pad_file = run_dir / 'pad_input'
+    if not pad_file.is_file():
+        raise RuntimeError('Pinned run input file is missing')
+
+    output = run_dir / 'navigation-sequence.json'
+    if args.confirm_selected_map:
+        if not output.is_file():
+            raise RuntimeError('T-1 confirmation requires an existing selection manifest')
+        result = json.loads(output.read_text())
+        if not isinstance(result, dict):
+            raise RuntimeError('Existing navigation manifest is not an object')
+        steps = result.get('steps')
+        if (result.get('status') != 'awaiting_confirmation'
+                or result.get('route') != 'T-1'
+                or result.get('destination') != 'tutorial'
+                or result.get('pid') != args.expected_pid
+                or result.get('starttime_ticks') != args.expected_starttime
+                or result.get('root_row') != 0
+                or result.get('input_ack_enabled') is not True
+                or not isinstance(steps, list) or not steps
+                or steps[-1].get('label') != 'map_selection_ready'):
+            raise RuntimeError('Existing navigation manifest is not a matching T-1 selection')
+        result['status'] = 'confirming'
+        result['confirmation_started_monotonic_ns'] = time.monotonic_ns()
+        guard._atomic_json(output, result)
+    else:
+        if output.exists():
+            raise RuntimeError('Navigation manifest already exists; refusing to overwrite')
+        result = {
+            'destination': args.destination,
+            'route': f'T-{args.tutorial}' if args.destination == 'tutorial' else 'title',
+            'start_state': args.start_state,
+            'root_row': args.root_row if args.start_state == 'root' else None,
+            'settle_ms': args.settle_ms,
+            'confirm_cross_count': args.confirm_cross_count,
+            'post_launch_wait_ms': args.post_launch_wait_ms,
+            'input_ack_enabled': True,
+            'input_ack_timeout_seconds': PAD_ACK_TIMEOUT_SECONDS,
+            'stop_before_confirmation': args.stop_before_confirmation,
+            'startup_wait_ms': args.startup_wait_ms,
+            'pid': args.expected_pid,
+            'starttime_ticks': args.expected_starttime,
+            'mangohud': True,
+            'status': 'running',
+            'steps': [],
+        }
+        guard._atomic_json(output, result, replace=False)
+
+    def record_step(label, button=None):
+        try:
+            step = (
+                {'label': label, **capture(run_dir, args.expected_pid, args.expected_starttime)}
+                if button is None else
+                press_and_capture(run_dir, pad_file, args.expected_pid,
+                                 args.expected_starttime, button, label, args.settle_ms)
+            )
+        except Exception as error:
+            result['status'] = 'step_failed'
+            result['failure'] = {
+                'label': label,
+                'button': button,
+                'error': type(error).__name__ + ': ' + str(error),
+            }
+            guard._atomic_json(output, result)
+            raise
+        result['steps'].append(step)
+        guard._atomic_json(output, result)
+
+    try:
+        focus_game(args.expected_pid)
+        if args.confirm_selected_map:
+            record_step('pre_confirmation')
+            for confirmation in range(args.confirm_cross_count):
+                label = 'launch_tutorial_1' if confirmation == 0 else f'confirm_tutorial_1_{confirmation + 1}'
+                record_step(label, 'cross')
+        else:
+            if args.startup_wait_ms:
+                time.sleep(args.startup_wait_ms / 1000)
+            record_step('startup')
+            if args.destination == 'title':
+                target_row = 1
+                if args.root_row < target_row:
+                    for row in range(args.root_row + 1, target_row + 1):
+                        record_step(f'root_row_{row:02d}', 'down')
+                else:
+                    for row in range(args.root_row - 1, target_row - 1, -1):
+                        record_step(f'root_row_{row:02d}', 'up')
+                for confirmation in range(args.confirm_cross_count):
+                    label = 'launch_title' if confirmation == 0 else f'confirm_title_{confirmation + 1}'
+                    record_step(label, 'cross')
+            else:
+                startup = (
+                    [('up', 'focus_walkthrough'), ('cross', 'open_walkthrough'),
+                     ('cross', 'open_map_page_01')]
+                    if args.start_state == 'black'
+                    else [('up', f'root_row_{row:02d}')
+                          for row in range(args.root_row - 1, -1, -1)]
+                         + [('cross', 'open_map_page_01')]
+                )
+                for button, label in startup:
+                    record_step(label, button)
+                for page in range(2, 8):
+                    record_step(f'page_{page:02d}', 'right')
+                if args.stop_before_confirmation:
+                    record_step('map_selection_ready')
+                    result['status'] = 'awaiting_confirmation'
+                    guard._atomic_json(output, result)
+                    print(json.dumps({'route': result['route'], 'status': result['status'],
+                                      'steps': result['steps'], 'manifest': str(output)},
+                                     sort_keys=True))
+                    return 0
+                for row in range(2, int(args.tutorial) + 1):
+                    record_step(f'tutorial_row_{row}', 'down')
+                for confirmation in range(args.confirm_cross_count):
+                    label = (f'launch_tutorial_{args.tutorial}' if confirmation == 0
+                             else f'confirm_tutorial_{args.tutorial}_{confirmation + 1}')
+                    record_step(label, 'cross')
+        time.sleep(args.post_launch_wait_ms / 1000)
+        record_step('post_launch')
+    except Exception as error:
+        if result['status'] in ('running', 'confirming'):
+            result['status'] = 'failed'
+            result['failure'] = {'error': type(error).__name__ + ': ' + str(error)}
+            guard._atomic_json(output, result)
+        raise
+
+    result['status'] = 'input_sequence_complete_unverified'
+    result['visual_scene_verified'] = False
+    guard._atomic_json(output, result)
+    print(json.dumps({'route': result['route'], 'status': result['status'],
+                      'visual_scene_verified': False, 'steps': result['steps'],
+                      'manifest': str(output)}, sort_keys=True))
+    return 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
