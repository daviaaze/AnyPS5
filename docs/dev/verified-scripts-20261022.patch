+#!/usr/bin/env python3
+"""Send one explicitly visually confirmed headless button; ACKs never prove scene state."""
+import argparse
+import fcntl
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+import stat
+import signal
+import subprocess
+import sys
+import time
+import uuid
+
+BASE = Path(__file__).resolve().parent
+spec = importlib.util.spec_from_file_location('headless_navigator', BASE / 'navigate-tutorial.py')
+nav = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(nav)
+guard = nav.guard
+BUTTONS = {'cross': 0x4000, 'right': 0x20, 'down': 0x40, 'up': 0x10,
+           'left': 0x80, 'circle': 0x2000, 'release': 0}
+
+
+def owned_path(raw, directory=False):
+    path = Path(raw)
+    if path != path.resolve(strict=True):
+        raise RuntimeError(f'Noncanonical or symlink path refused: {path}')
+    info = path.lstat()
+    if info.st_uid != os.geteuid() or not (
+            stat.S_ISDIR(info.st_mode) if directory else stat.S_ISREG(info.st_mode)):
+        raise RuntimeError(f'Expected owned regular {"directory" if directory else "file"}: {path}')
+    return path
+
+
+def compositor_identity(pid):
+    root = Path('/proc') / str(pid)
+    fields = (root / 'stat').read_text().rsplit(')', 1)[1].split()
+    if fields[0] in ('Z', 'X'):
+        raise RuntimeError('Compositor is no longer running')
+    return {'pid': pid, 'exe': os.readlink(root / 'exe'), 'starttime_ticks': int(fields[19])}
+
+
+def request_screenshot(identity):
+    """Request only; the capture helper's copied log receipt proves an image exists."""
+    fd = os.pidfd_open(identity['pid'])
+    try:
+        if compositor_identity(identity['pid']) != identity:
+            raise RuntimeError('Compositor identity changed before screenshot request')
+        requested = time.monotonic_ns()
+        signal.pidfd_send_signal(fd, signal.SIGUSR2)
+        return {'status': 'signal_returned', 'requested_monotonic_ns': requested,
+                'returned_monotonic_ns': time.monotonic_ns(), 'identity': identity}
+    finally:
+        os.close(fd)
+
+
+def validate_headless(args, previous_release):
+    evidence = owned_path(args.headless_evidence, directory=True)
+    if not evidence.is_relative_to(nav.EVIDENCE) or evidence == nav.EVIDENCE:
+        raise RuntimeError('Headless evidence must be inside the workbench evidence directory')
+    manifest = owned_path(evidence / 'launch.json')
+    launch = nav.read_json_object(manifest)
+    identity = launch.get('identity') or {}
+    pid = identity.get('pid')
+    if type(pid) is not int or pid <= 0 or compositor_identity(pid) != identity:
+        raise RuntimeError('Exact pinned compositor identity is not live')
+    if not launch.get('desktop_unit'):
+        raise RuntimeError('Headless launch lacks an initial-namespace controller bridge')
+    ready = launch.get('ready') or {}
+    tokens = ready.get('notification', '').split()
+    if len(tokens) != 2 or not tokens[1].startswith('gamescope-'):
+        raise RuntimeError('Compositor readiness does not identify a Wayland display')
+    entries = (Path('/proc') / str(args.expected_pid) / 'environ').read_bytes().split(b'\0')
+    env = {}
+    for entry in entries:
+        if b'=' in entry:
+            key, value = entry.split(b'=', 1)
+            if key in env:
+                raise RuntimeError('Duplicate target environment entry')
+            env[key] = value
+    if env.get(b'WAYLAND_DISPLAY') != tokens[1].encode() or env.get(b'DISPLAY') != b'':
+        raise RuntimeError('Target is not attached exclusively to this headless Wayland display')
+    frame = owned_path(args.frame)
+    if frame.parent != owned_path(evidence / 'screenshots', directory=True) or frame.suffix != '.avif':
+        raise RuntimeError('Frame must be an exact AVIF in this launch screenshot directory')
+    matches = [r for r in launch.get('screenshot_log_receipts', [])
+               if isinstance(r, dict) and r.get('evidence_path') == str(frame)]
+    if len(matches) != 1:
+        raise RuntimeError('Frame lacks exactly one compositor receipt')
+    receipt = matches[0]
+    observed = (receipt.get('observed') or {}).get('monotonic_ns')
+    now = time.monotonic_ns()
+    if (receipt.get('ownership') != 'exact own-compositor receipt in required PrivateTmp namespace'
+            or type(observed) is not int or not 0 <= now - observed <= nav.CAPTURE_MAX_AGE_NS
+            or observed <= previous_release or type(ready.get('monotonic_ns')) is not int
+            or observed < ready['monotonic_ns'] or receipt.get('copy_error')):
+        raise RuntimeError('Frame receipt is stale, reused, or not exclusively owned')
+    with frame.open('rb') as source:
+        info = os.fstat(source.fileno())
+        if info.st_size <= 0 or info.st_size != receipt.get('size_bytes'):
+            raise RuntimeError('Frame size differs from compositor receipt')
+        digest = hashlib.file_digest(source, 'sha256').hexdigest()
+    return {'path': str(frame), 'sha256': digest, 'receipt': receipt,
+            'headless_evidence': str(evidence), 'compositor_identity': identity,
+            'wayland_display': tokens[1]}
+
+
+def execute(args):
+    run_dir, context = nav.load_run_context(args.run_dir, args.expected_pid, args.expected_starttime)
+    # A directory-scoped advisory lock serializes this helper without a global lock or new lock file.
+    fd = os.open(run_dir, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
+    try:
+        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        return locked_step(args, run_dir, context)
+    finally:
+        os.close(fd)
+
+
+def locked_step(args, run_dir, context):
+    hold_ns = args.hold_ms * 1_000_000
+    reserve = hold_ns + nav.ACK_STOP_RESERVE_NS
+    nav.check_run_active(run_dir, context, reserve)
+    if context['worker'].get('pad_input_ack_enabled') is not True:
+        raise RuntimeError('Pinned run does not enable real pad input ACKs')
+    pad = owned_path(run_dir / 'pad_input')
+    ack_file = run_dir / 'pad_input_ack'
+    if ack_file.exists() or ack_file.is_symlink():
+        owned_path(ack_file)
+    last_path = run_dir / 'headless-last-input.json'
+    previous_release = 0
+    if last_path.exists() or last_path.is_symlink():
+        owned_path(last_path)
+        previous = nav.read_json_object(last_path)
+        ack = previous.get('input_ack') or {}
+        previous_release = ack.get('released_observed_monotonic_ns')
+        if (previous.get('status') != 'released' or ack.get('status') != 'released'
+                or ack.get('released_observed') is not True
+                or type(previous_release) is not int or previous_release <= 0):
+            raise RuntimeError('Previous headless input has no proven released outcome')
+        if previous.get('target') != context['target']:
+            raise RuntimeError('Previous headless input target differs')
+    frame = validate_headless(args, previous_release)
+    before = pad.read_text()
+    output = run_dir / f'headless-input-step-{time.monotonic_ns()}-{uuid.uuid4().hex}.json'
+    result = {'schema': 1, 'status': 'waiting', 'target': context['target'],
+              'button': args.button, 'hold_ms': args.hold_ms, 'frame': frame,
+              'visual_confirmation_supplied': True, 'visual_scene_verified': False,
+              'started_monotonic_ns': time.monotonic_ns(), 'manifest': str(output),
+              'input_ack': {'status': 'waiting', 'released_observed': False}}
+
+    def save(initial=False):
+        guard._atomic_json(output, result, replace=not initial)
+        guard._atomic_json(last_path, result)
+
+    attempted = False
+    save(initial=True)
+    try:
+        deadline = nav.check_run_active(run_dir, context, reserve)
+        latest = validate_headless(args, previous_release)
+        if latest != frame or owned_path(pad).read_text() != before:
+            raise RuntimeError('Frame or controller command changed before dispatch')
+        now = time.monotonic_ns()
+        budget = 10 if deadline is None else min(10, (deadline - now - reserve) / 1e9)
+        if budget <= 0:
+            raise RuntimeError('Insufficient ordered-stop reserve before dispatch')
+        attempted = True
+        completed = subprocess.run([sys.executable, str(nav.PAD_HELPER), str(pad), args.button,
+                                    '--hold-ms', str(args.hold_ms)],
+                                   capture_output=True, text=True, timeout=budget)
+        result['helper'] = {'returncode': completed.returncode, 'stdout': completed.stdout,
+                            'stderr': completed.stderr}
+        completed.check_returncode()
+        fields = owned_path(pad).read_text().split()
+        if (len(fields) != 3 or not all(s.isdecimal() for s in fields)
+                or int(fields[0]) <= 0 or int(fields[1]) != BUTTONS[args.button]
+                or int(fields[2]) != args.hold_ms or pad.read_text() == before):
+            raise RuntimeError('Helper did not write the exact requested sequenced button')
+        sequence = int(fields[0])
+        result['input_ack'] = {'status': 'waiting', 'sequence': sequence, 'released_observed': False}
+        save()
+        ack = nav.wait_for_input_ack(run_dir, context, ack_file, sequence, deadline)
+        result['input_ack'] = {'status': 'released', **ack}
+        result['status'] = 'released'
+        save()
+    except Exception as error:
+        result['status'] = 'unknown' if attempted else 'not_dispatched'
+        result['input_ack']['status'] = 'unknown' if attempted else 'not_dispatched'
+        result['failure'] = {'error': type(error).__name__, 'reason': str(error),
+                             'observed_monotonic_ns': time.monotonic_ns()}
+        save()
+        raise
+    if args.capture_after_release:
+        try:
+            result['screenshot_request'] = request_screenshot(frame['compositor_identity'])
+        except (OSError, RuntimeError) as error:
+            # Screenshot failure must not turn a proven released input into an unknown outcome.
+            result['screenshot_request'] = {
+                'status': 'failed', 'error': type(error).__name__, 'reason': str(error),
+                'observed_monotonic_ns': time.monotonic_ns()}
+        save()
+    return result
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--run-dir', required=True)
+    parser.add_argument('--expected-pid', type=int, required=True)
+    parser.add_argument('--expected-starttime', type=int, required=True)
+    parser.add_argument('--headless-evidence', required=True)
+    parser.add_argument('--frame', required=True)
+    parser.add_argument('--button', choices=BUTTONS, required=True)
+    parser.add_argument('--hold-ms', type=int, default=100)
+    parser.add_argument('--capture-after-release', action='store_true',
+                        help='Request an owned-compositor screenshot after ACK release; '
+                             'inspect a fresh copied receipt separately')
+    parser.add_argument('--confirm-visual', action='store_true', required=True,
+                        help='Confirm the exact fresh frame was visually inspected externally')
+    args = parser.parse_args()
+    if not 1 <= args.hold_ms <= 5000:
+        parser.error('--hold-ms must be between 1 and 5000')
+    try:
+        result = execute(args)
+    except Exception as error:
+        print(json.dumps({'status': 'refused_or_failed', 'error': type(error).__name__,
+                          'reason': str(error), 'observed_monotonic_ns': time.monotonic_ns()}), file=sys.stderr)
+        return 1
+    print(json.dumps(result, sort_keys=True))
+    return 1 if result.get('screenshot_request', {}).get('status') == 'failed' else 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
