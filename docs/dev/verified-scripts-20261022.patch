+DISCOVERY_WORKER = """\
+import ctypes
+import os
+from pathlib import Path
+import sys
+import time
+
+mode, workload, run_dir = sys.argv[1:]
+libc = ctypes.CDLL(None, use_errno=True)
+if libc.prctl(4, 0, 0, 0, 0) != 0:
+    raise OSError(ctypes.get_errno(), 'PR_SET_DUMPABLE failed')
+Path(run_dir, 'wrapper.pid').write_text(str(os.getpid()))
+if mode in ('single', 'multiple'):
+    while not Path(run_dir, 'launch-target').exists():
+        time.sleep(0.05)
+children = []
+if mode in ('single', 'multiple'):
+    for index in range(1 if mode == 'single' else 2):
+        child = os.fork()
+        if child == 0:
+            # Keep the wrapper opaque; only the fixture target is inspectable.
+            if libc.prctl(4, 1, 0, 0, 0) != 0:
+                os._exit(126)
+            arguments = [workload, '--seconds', '8', '--pid-file',
+                         str(Path(run_dir, f'target-{index}.pid'))]
+            os.execv(workload, arguments)
+            os._exit(127)
+        children.append(child)
+for child in children:
+    _, status = os.waitpid(child, 0)
+    if os.waitstatus_to_exitcode(status) != 0:
+        raise RuntimeError(f'fixture workload child {child} exited unsuccessfully')
+if mode == 'missing':
+    time.sleep(20)
+"""
