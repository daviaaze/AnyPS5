+        cwd=WORKBENCH, stdin=subprocess.DEVNULL,
+        capture_output=True, text=True, timeout=5, check=False)
+    if result.returncode != 0:
+        raise RuntimeError(result.stderr.strip() or 'deterministic perf parser regression failed')
+    try:
+        value = json.loads(result.stdout)
+    except ValueError as error:
+        raise RuntimeError(f'perf parser regression returned invalid JSON: {error}') from error
+    if not isinstance(value, dict) or value.get('passed') is not True:
+        raise RuntimeError('perf parser regression did not return a passing machine-readable result')
+    return value
