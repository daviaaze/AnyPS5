+def main():
+    parser = argparse.ArgumentParser(description='Bound candidate diagnostics with explicit host-resource profiles. PS5-like means initial eight-core/sixteen-thread affinity, not Zen 2 or unified-memory emulation. GPU use is not bounded. No arguments starts nothing.')
+    mode = parser.add_mutually_exclusive_group(required=True)
+    mode.add_argument('--check', action='store_true', help='Verify real kernel limits with a harmless process; never starts the game.')
+    mode.add_argument('--game', action='store_true', help='Explicitly launch the prepared candidate under the verified limits.')
+    mode.add_argument('--capture-null-list', action='store_true', help='Capture the pinned null-list call and stop before its invalid read.')
+    mode.add_argument('--worker', choices=('check', 'game', 'capture'), help=argparse.SUPPRESS)
+    mode.add_argument('--stop-capture', metavar='RUN_DIR',
+                      help='Request identity-verified orderly stop of an active causal game capture.')
+    parser.add_argument('--profile', choices=PROFILES, default='safe',
+                        help='safe: 4 CPU equivalents, 12/16 GiB, 5 minutes; balanced: 4 CPU equivalents, 14/16 GiB, 15 minutes; ps5-like: initial 8C/16T affinity, 16 CPU equivalents, 14/16 GiB, 15 minutes; capture24: 4 CPU equivalents, 20/24 GiB, 15 minutes; bounded: 4 CPU equivalents, 14/16 GiB, swap 0, 3 minutes; normal: no CPU, memory, swap, or affinity restriction.')
+    duration_options = parser.add_mutually_exclusive_group()
+    duration_options.add_argument('--minutes', type=int, choices=(3, 5, 15),
+                                  help='Override profile duration where allowed; normal and bounded modes accept only three minutes here (use --seconds for shorter bounded runs).')
+    duration_options.add_argument('--seconds', type=int,
+                                  help='Set runtime in seconds: bounded 1..180; normal 1..360 (both default to 180).')
+    parser.add_argument('--until-stopped', action='store_true',
+                        help='Run the normal causal game capture without a wall-clock stop; stop only by --stop-capture or controller interruption.')
+    parser.add_argument('--pipeline-dispatch', action='store_true',
+                        help='Enable the tested APS5_PIPELINE_DISPATCH=1 driver path for a normal or bounded-profile game.')
+    parser.add_argument('--mangohud', action='store_true',
+                        help='Wrap the candidate in MangoHud inside steam-run; only with --game.')
+    parser.add_argument('--debug-segv', action='store_true',
+                        help='Capture SIGSEGV registers and backtraces under GDB; requires a normal or bounded causal game run.')
+    parser.add_argument('--drain-fills', action='store_true',
+                        help='Use synchronous buffer fills to diagnose tutorial loading stalls; requires normal or bounded causal game mode.')
+    parser.add_argument('--submit-outside-gpu-mutex', action='store_true',
+                        help='Set APS5_SUBMIT_OUTSIDE_GPU_MUTEX=1 for a normal-profile game.')
+    parser.add_argument('--no-lazy-shader-prepare', action='store_true',
+                        help='Unset APS5_LAZY_SHADER_PREPARE and use registration-time shader preparation; requires a normal or bounded causal game run.')
+    parser.add_argument('--dump-submits', action='store_true',
+                        help='Capture accepted AGC command streams for offline WAIT_REG_MEM analysis; writes per-submission files and requires a normal or bounded causal game run.')
+    parser.add_argument('--job-backoff', action='store_true', help='Opt in to the pinned guest failed-scan backoff experiment; only with --game. No on-disk game patch.')
+    parser.add_argument('--wait-idle-backoff', action='store_true', help='Opt in to the separately verified WaitForJobs idle-backoff experiment; only with --game.')
+    parser.add_argument('--causal-trace', action='store_true', help='Capture a disabled-until-triggered bounded perf sample; only with --game --profile capture24, normal, or bounded.')
+    parser.add_argument('--privileged-kernel', action='store_true',
+                        help='Opt in to target-only root kernel evidence for bounded normal causal games: immediate for 2..60 seconds, or a 60-second maximum window delayed30 seconds for an exact180-second game.')
+    parser.add_argument('--trace-waits', action='store_true',
+                        help='Enable verbose GPU and late-label diagnostics; requires --causal-trace and adds logging overhead.')
+    parser.add_argument('--trace-label', type=trace_label_address,
+                        help='Trace packet writes and waits within 0x100 of this guest address; requires --causal-trace.')
+    args = parser.parse_args()
+    if args.stop_capture is not None:
+        if (args.job_backoff or args.wait_idle_backoff or args.mangohud or args.causal_trace or args.privileged_kernel
+                or args.debug_segv or args.drain_fills or args.no_lazy_shader_prepare
+                or args.dump_submits or args.trace_waits or args.trace_label is not None or args.seconds is not None
+                or args.minutes is not None or args.until_stopped or args.pipeline_dispatch):
+            parser.error('--stop-capture cannot be combined with launch or trace options.')
+        result = launch_guard.request_causal_stop(args.stop_capture)
+        print(json.dumps(result, sort_keys=True), flush=True)
+        return 0
+    if args.job_backoff and not (args.game or args.worker == 'game'):
+        parser.error('--job-backoff is available only for explicit game mode.')
+    if args.wait_idle_backoff and not (args.game or args.worker == 'game'):
+        parser.error('--wait-idle-backoff is available only for explicit game mode.')
+    if args.mangohud and not (args.game or args.worker == 'game'):
+        parser.error('--mangohud is available only for explicit game mode.')
+    if args.pipeline_dispatch and not (
+            args.profile in ('normal', 'bounded') and (args.game or args.worker == 'game')):
+        parser.error('--pipeline-dispatch requires a normal or bounded-profile game.')
+    if args.until_stopped and not (
+            args.profile == 'normal' and (args.game or args.worker == 'game')
+            and args.causal_trace and args.seconds is None and args.minutes is None):
+        parser.error('--until-stopped requires --game --profile normal --causal-trace and no duration option.')
+    if args.debug_segv and not (
+            args.profile in ('normal', 'bounded') and args.causal_trace
+            and (args.game or args.worker == 'game')):
+        parser.error('--debug-segv requires --game --profile normal or bounded --causal-trace.')
+    if args.debug_segv and args.job_backoff:
+        parser.error('--debug-segv cannot be combined with --job-backoff because both require LD_PRELOAD.')
+    if args.debug_segv and args.wait_idle_backoff:
+        parser.error('--debug-segv cannot be combined with --wait-idle-backoff because both require LD_PRELOAD.')
+    if args.drain_fills and not (
+            args.profile in ('normal', 'bounded') and args.causal_trace
+            and (args.game or args.worker == 'game')):
+        parser.error('--drain-fills requires --game --profile normal or bounded --causal-trace.')
+    if args.no_lazy_shader_prepare and not (
+            args.profile in ('normal', 'bounded') and args.causal_trace
+            and (args.game or args.worker == 'game')):
+        parser.error('--no-lazy-shader-prepare requires --game --profile normal or bounded --causal-trace.')
+    if args.dump_submits and not (
+            args.profile in ('normal', 'bounded') and args.causal_trace
+            and (args.game or args.worker == 'game')):
+        parser.error('--dump-submits requires --game --profile normal or bounded --causal-trace.')
+    if args.seconds is not None:
+        if args.profile not in ('normal', 'bounded'):
+            parser.error('--seconds is available only with --profile normal or bounded.')
+        maximum_seconds = 180 if args.profile == 'bounded' else 360
+        if not 1 <= args.seconds <= maximum_seconds:
+            parser.error(f'--seconds must be between 1 and {maximum_seconds} for profile {args.profile}.')
+    profile = PROFILES[args.profile]
+    if args.minutes is None:
+        args.minutes = profile['minutes']
+    if not args.until_stopped and args.profile == 'normal' and args.seconds is None and args.minutes != profile['minutes']:
+        parser.error('Normal profile bounded mode remains capped at three minutes.')
+    if args.profile == 'bounded' and args.minutes != profile['minutes']:
+        parser.error('Bounded profile remains capped at three minutes; use --seconds for a shorter run.')
+    if args.profile == 'safe' and args.minutes != profile['minutes'] and not (args.capture_null_list or args.worker == 'capture'):
+        parser.error('An extended safe-profile deadline is available only for explicit capture mode.')
+    duration_seconds = (
+        CAUSAL_UNTIL_STOPPED_SECONDS if args.until_stopped
+        else args.seconds if args.seconds is not None else args.minutes * 60
+    )
+    if args.causal_trace and not (
+            args.profile in ('capture24', 'normal', 'bounded') and (args.game or args.worker == 'game')):
+        parser.error('--causal-trace requires explicit --game with --profile capture24, normal, or bounded.')
+    if args.causal_trace and args.profile == 'capture24' and duration_seconds != 900:
+        parser.error('--causal-trace with --profile capture24 requires the fifteen-minute deadline.')
