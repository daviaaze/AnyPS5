+                            'baseline_pending_counters': len(report['baseline_pending']),
+                            'final_pending_counters': len(report['final_pending']),
+                            'cpu_writes_captured': len(report['cpu_writes']),
+                            'snapshot_span_ms': report['snapshot_span_ms'],
