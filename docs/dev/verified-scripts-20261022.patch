+    def _verify_candidate_process(self):
+        expected = self.record['identity'].get('elf')
+        if not isinstance(expected, dict) or not isinstance(expected.get('path'), str):
+            raise ObserverError('worker result candidate identity is unreadable')
+        candidate = Path(expected['path'])
+        process = Path('/proc') / str(self.pid)
+        try:
+            pinned_path = candidate.resolve(strict=True)
+            pinned = pinned_path.stat()
+            if (pinned.st_dev, pinned.st_ino) != (expected.get('device'), expected.get('inode')):
+                raise ObserverError('worker result candidate path differs from its pinned device/inode')
+            actual_path = Path(os.readlink(process / 'exe'))
+            actual = os.stat(process / 'exe')
+            if (actual.st_dev, actual.st_ino) != (pinned.st_dev, pinned.st_ino):
+                raise ObserverError('requested PID executable differs from the pinned native candidate')
+            if actual_path.resolve(strict=True) != pinned_path:
+                raise ObserverError('requested PID executable path differs from the pinned native candidate')
+            return {'method': 'proc-exe+path+device-inode', 'path': str(actual_path),
+                    'device': actual.st_dev, 'inode': actual.st_ino}
+        except PermissionError:
+            pass
+        except OSError as error:
+            raise ObserverError(f'cannot verify requested PID executable identity: {error}') from error
+        try:
+            argv0 = os.fsdecode((process / 'cmdline').read_bytes().split(b'\0', 1)[0])
+            comm = (process / 'comm').read_text().strip()
+            status = (process / 'status').read_text().splitlines()
+            uid_line = next(line for line in status if line.startswith('Uid:'))
+            effective_uid = int(uid_line.split()[2])
+        except (OSError, StopIteration, ValueError) as error:
+            raise ObserverError(f'cannot corroborate requested PID candidate identity: {error}') from error
+        cwd = None
+        cwd_error = None
+        try:
+            cwd = Path(os.readlink(process / 'cwd')).resolve(strict=True)
+        except PermissionError as error:
+            cwd_error = f'PermissionError: {error}'
+        except OSError as error:
+            raise ObserverError(f'cannot corroborate requested PID working directory: {error}') from error
+        if (effective_uid != os.geteuid()
+                or not (argv0 == str(candidate) or argv0 == './app.elf')
+                or comm != 'app.elf'
+                or (cwd is not None and cwd != candidate.parent)):
+            raise ObserverError('requested PID is not the pinned native candidate executable')
+        return {'method': 'cmdline+comm+effective-uid+owned-cgroup+starttime',
+                'argv0': argv0, 'comm': comm, 'effective_uid': effective_uid,
+                'cwd': str(cwd) if cwd is not None else 'unavailable',
+                'cwd_error': cwd_error}
+
+    def _validate_unit_props(self, props, *, require_active):
+        if normalize_cgroup(props.get('ControlGroup')) != self.cgroup:
+            raise ObserverError('actual systemd ControlGroup differs from worker-result cgroup')
+        if require_active and props.get('ActiveState') != 'active':
+            raise ObserverError(f"owned unit is not active: {props.get('ActiveState')}")
+        if (props.get('Type') != 'exec' or props.get('Restart') != 'no'
+                or props.get('KillMode') != 'control-group'
+                or props.get('KillSignal') != 15 or props.get('FinalKillSignal') != 9
+                or props.get('SendSIGKILL') is not True
+                or props.get('TimeoutStopFailureMode') != 'terminate'
+                or props.get('OOMPolicy') != 'kill'):
+            raise ObserverError('actual systemd unit stop/restart policy differs from worker result')
+        runtime_us = props.get('RuntimeMaxUSec')
+        timeout_us = props.get('TimeoutStopUSec')
+        abort_us = props.get('TimeoutAbortUSec')
+        randomized_us = props.get('RuntimeRandomizedExtraUSec')
+        if any(type(value) is not int for value in
+               (runtime_us, timeout_us, abort_us, randomized_us)):
+            raise ObserverError('actual worker unit deadline properties are not typed integers')
+        if (runtime_us != self.expected_runtime_us or timeout_us != STOP_GRACE_SECONDS * 1000000
+                or abort_us != timeout_us or randomized_us != 0):
+            raise ObserverError('actual worker unit deadline/stop grace differs from the verified profile policy')
+
+    def verify_process(self):
+        info = proc_stat(self.pid)
+        if info['starttime_ticks'] != self.starttime_ticks:
+            raise ObserverError('requested PID was reused; refusing to profile or stop it')
+        group = proc_cgroup(self.pid)
+        if group != self.cgroup:
+            raise ObserverError('requested PID left the worker-result cgroup; refusing to profile or stop it')
+        return info
+
+    def verify_owned_unit(self, *, require_active=True, allow_process_gone=False):
+        # Re-read both persisted ownership records before every action affecting the service.
+        record = read_json_regular(self.record_path)
+        owner = read_json_regular(self.owner_path)
+        profile = record.get('profile') if isinstance(record, dict) else None
+        if (record.get('sampling') != self.record.get('sampling')
+                or record.get('debug_segv', False) is not self.debug_segv
+                or record.get('pipeline_drain_fills', False) is not self.pipeline_drain_fills
+                or record.get('no_lazy_shader_prepare', False) is not self.no_lazy_shader_prepare
+                or record.get('until_stopped') is not self.until_stopped
+                or record.get('pad_input_ack_enabled', False) is not self.pad_input_ack_enabled
+                or record.get('dump_submits_enabled', False) is not self.dump_submits_enabled
+                or not isinstance(profile, dict)
+                or profile.get('profile') != self.profile_name
+                or profile.get('runtime_seconds') != self.runtime_seconds
+                or profile.get('until_stopped') is not self.until_stopped
+                or profile.get('pipeline_dispatch') is not self.pipeline_dispatch
+                or profile.get('kernel_limits') != self.expected_kernel_limits
+                or normalize_cgroup(profile.get('cgroup')) != self.cgroup
+                or owner.get('unit') != self.unit or owner.get('state') != 'running'
+                or owner.get('kind') != 'game' or owner.get('output_dir') != str(self.run_dir)
+                or owner.get('until_stopped', False) is not self.until_stopped
+                or owner.get('pipeline_dispatch', False) is not self.pipeline_dispatch
+                or normalize_cgroup(owner.get('cgroup')) != self.cgroup):
+            raise ObserverError('worker-result or launch lease changed; refusing unit action')
+        if not allow_process_gone:
+            self.verify_process()
+        props = read_properties(self.unit)
+        self._validate_unit_props(props, require_active=require_active)
+        return props
+
+
+    def verify_unit(self, *, require_active):
+        props = read_properties(self.unit)
+        self._validate_unit_props(props, require_active=require_active)
+        return props
