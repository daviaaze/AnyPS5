+        if not args.check_layout or args.worker:
+            parser.error('--fixture is restricted to read-only --check-layout; native probing requires the pinned game ELF.')
+        layout = elf_layout(program, fixture=True)
+        print(json.dumps({'program': str(program), 'layout_verified': False, 'layout': layout}))
+        return 0
+    if not 1 <= args.timeout_seconds <= 90:
+        parser.error('--timeout-seconds must be between 1 and 90.')
+    preload_requested = require_reviewed_preload(args.preload)
+    identity = launch_guard.launch_identity(program, preload_requested)
+    if args.worker:
+        return worker(args)
+    if args.check_layout:
+        kind = 'check'
+        worker_mode = 'check'
