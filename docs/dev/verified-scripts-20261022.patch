+def verify_window(run_dir, target, phases, sample_seconds):
+    sample = read_sample(run_dir)
+    if sample is None or sample.get('pid') != target:
+        raise RuntimeError('fixture sample window is missing or names a different target')
+    window = sample.get('window')
+    if not isinstance(window, dict):
+        raise RuntimeError('fixture sample window has no lifecycle record')
+    enable = window.get('enable')
+    disable = window.get('disable')
+    finalization = window.get('perf_finalization')
+    verification = finalization.get('sample_data_verification') if isinstance(finalization, dict) else None
+    if (window.get('requested_seconds') != sample_seconds
+            or window.get('disabled_reason') != 'approved_stop'
+            or window.get('coverage_status') != 'partial'
+            or not isinstance(enable, dict) or enable.get('command') != 'enable'
+            or enable.get('ack_line') != 'ack'
+            or not isinstance(disable, dict) or disable.get('command') != 'disable'
+            or disable.get('ack_line') != 'ack'):
+        raise RuntimeError('fixture is missing its real bounded enable/disable ACKs or truthful partial-stop state')
+    start = (enable.get('ack_observed') or {}).get('monotonic_ns')
+    end = (disable.get('ack_observed') or {}).get('monotonic_ns')
+    actual_duration = end - start if type(start) is int and type(end) is int else None
+    if (actual_duration is None or actual_duration < (INITIAL_WINDOW_SECONDS + 2) * 1_000_000_000
+            or actual_duration >= sample_seconds * 1_000_000_000
+            or actual_duration != window.get('actual_duration_ns')):
+        raise RuntimeError('fixture did not retain a bounded partial ACK interval beyond the former 3-second window')
+    if (not isinstance(finalization, dict) or finalization.get('state') != 'finalized'
+            or not isinstance(verification, dict)
+            or verification.get('usable_cpu_samples') is not True
+            or verification.get('coverage_status') != 'partial'
+            or verification.get('target_sample_records_in_window', 0) <= 0):
+        raise RuntimeError('fixture has no parsed nonzero target CPU samples and finalized perf output')
+    blocked_time = phases['phases'][1]['monotonic_ns']
+    late_time = phases['phases'][2]['monotonic_ns']
+    worker_samples = verification.get('target_thread_samples', {}).get(
+        str(phases['worker_tid']))
+    worker_times = (worker_samples.get('window_monotonic_ns')
+                    if isinstance(worker_samples, dict) else None)
+    worker_minimum = worker_times.get('minimum') if isinstance(worker_times, dict) else None
+    worker_maximum = worker_times.get('maximum') if isinstance(worker_times, dict) else None
+    periods = verification.get('observed_period_ns')
+    if (not isinstance(worker_samples, dict)
+            or worker_samples.get('window_records', 0) <= 0
+            or type(worker_minimum) is not int or worker_minimum >= blocked_time
+            or type(worker_maximum) is not int
+            or worker_maximum < late_time + 500_000_000
+            or worker_maximum <= start + INITIAL_WINDOW_SECONDS * 1_000_000_000
+            or not isinstance(periods, dict)
+            or any(type(periods.get(key)) is not int or periods[key] <= 0
+                   for key in ('minimum', 'maximum', 'mean'))
+            or periods['minimum'] > periods['maximum']):
+        raise RuntimeError('actual parsed samples do not prove this worker CPU/block/late-CPU phases or retain measured periods')
+    return sample
+
+def verify_timer_failure_capture(run_dir, target, observer_process, unit, cgroup):
+    status = read_observer_status(run_dir)
+    if (observer_process.returncode != 1 or not status or status.get('state') != 'failed'
+            or 'MemoryError: deterministic fixture timer callback failure'
+            not in status.get('detail', '')):
+        raise RuntimeError('timer callback exception did not become a failed observer outcome')
+    stop_unit = status.get('stop_unit')
+    if (not isinstance(stop_unit, dict) or stop_unit.get('verified') is not True
+            or stop_unit.get('requested') is not True or stop_unit.get('returncode') != 0):
+        raise RuntimeError('timer callback failure did not stop the verified owned fixture unit')
+    error_path = run_dir / 'causal-observer-errors.jsonl'
+    try:
+        errors = [json.loads(line) for line in error_path.read_text().splitlines() if line]
+    except (OSError, ValueError) as error:
+        raise RuntimeError(f'cannot inspect timer failure monitor evidence: {error}') from error
+    if not any(item.get('stage') == 'monitor'
+               and 'MemoryError: deterministic fixture timer callback failure'
+               in item.get('error', '') for item in errors if isinstance(item, dict)):
+        raise RuntimeError('timer callback failure was not persisted as a monitor-visible error')
+    sample = read_sample(run_dir)
+    window = sample.get('window') if isinstance(sample, dict) else None
+    if not isinstance(window, dict) or sample.get('pid') != target:
+        raise RuntimeError('timer callback failure did not retain the pinned sample-window identity')
+    enable = window.get('enable')
+    if (not isinstance(enable, dict) or enable.get('command') != 'enable'
+            or enable.get('ack_line') != 'ack'):
+        raise RuntimeError('timer failure fixture did not reach the perf enable ACK before injection')
+    if window.get('disable') is not None or window.get('perf_finalization') is not None:
+        raise RuntimeError('timer callback failure retried perf instead of failing closed to owned-service stop')
+    finalization = window.get('perf_finalization')
+    verification = (finalization.get('sample_data_verification')
+                    if isinstance(finalization, dict) else None)
+    if (isinstance(finalization, dict) and finalization.get('state') == 'finalized'
+            and isinstance(verification, dict)
+            and verification.get('usable_cpu_samples') is True):
+        raise RuntimeError('timer failure fixture incorrectly reported usable CPU samples')
+    teardown = verify_service_drain(unit, cgroup)
+    return {'status': 'expected_failure_handled', 'observer': status,
+            'stop_unit': stop_unit, 'errors': errors, 'sample_window': sample,
+            'teardown': teardown}
