+        partial_stop = stop_reason in {
+            'approved_stop', 'controller_deadline', 'controller_timeout',
+            'controller_failure', 'controller_shutdown', 'shutdown_interrupt',
+        }
+        if ((not self.fixture and requested_seconds != self.sample_seconds)
+                or (not full_window and not partial_stop)
+                or type(start) is not int or type(ack_start) is not int or type(end) is not int
+                or end <= start or actual_duration_ns <= 0
+                or actual_duration_ns > requested_seconds * 1_000_000_000 + 100_000_000):
