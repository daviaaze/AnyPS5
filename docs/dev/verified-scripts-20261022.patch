+def causal_trace_seconds(runtime_seconds, profile_name, until_stopped=False):
+    if until_stopped:
+        return f'0:{runtime_seconds}'
+    margin = launch_guard.causal_stop_margin_seconds(runtime_seconds)
+    if profile_name == 'normal' and runtime_seconds > 180:
+        return f'0:{min(240, runtime_seconds - margin - 30)}'
+    # Present-driven traces must close early enough to survive later loading stalls.
+    if profile_name == 'bounded':
+        maximum_end = 130
+    elif profile_name == 'normal':
+        maximum_end = 140
+    else:
+        maximum_end = CAUSAL_TRACE_MAX_SECONDS
+    end = max(1, min(maximum_end, runtime_seconds - margin - 10))
+    start = 60 if profile_name == 'normal' and end > 60 else 0
+    length = end - start
+    return f'{start}:{length}'
+
+
+def trace_label_address(value):
+    try:
+        address = int(value, 16)
+    except ValueError as error:
+        raise argparse.ArgumentTypeError('must be a hexadecimal guest address') from error
+    if not (0 < address <= 0xffffffffffffffff):
+        raise argparse.ArgumentTypeError('must be a nonzero 64-bit guest address')
+    return f'{address:x}'
+
+
+def causal_sampling(output_dir, trace_environment, trace_waits, trace_label, sample_seconds, profile_name,
+                    until_stopped=False):
+    if not output_dir:
+        raise RuntimeError('Causal sampling requires a parent-owned native-game output directory.')
+    run_dir = Path(output_dir).resolve(strict=True)
+    if not run_dir.name.startswith('native-game-'):
+        raise RuntimeError('Causal sampling output is not a fresh native-game run directory.')
+    expected_environment = {
+        'APS5_TRACE_SECONDS': causal_trace_seconds(sample_seconds, profile_name, until_stopped),
+        'APS5_TRACE_DIR': str(run_dir / 'aps5-trace'),
+        'APS5_TRACE_SUMMARY_EVERY': CAUSAL_TRACE_SUMMARY_EVERY,
+        'APS5_TRACE_EVENTS': CAUSAL_TRACE_EVENTS,
+        'APS5_PROFILE_GPU': '1',
+        'APS5_PROFILE_DRAW': '1',
+    }
+    expected_environment.update({
+        name: '1' if trace_waits else ''
+        for name in launch_guard.TRACE_WAIT_ENVIRONMENT
+    })
+    expected_environment['APS5_TRACE_LABEL'] = trace_label or ''
+    expected_environment['APS5_TRACE_SLOW_VULKAN_CALLS'] = '1'
+    expected_environment['APS5_TRACE_SLOW_IMAGE_LOOKUPS'] = '1'
+    expected_environment['APS5_TRACE_CAUSAL'] = '1'
+    if trace_environment != expected_environment:
+        raise RuntimeError('Causal-trace settings differ from the fixed, parent-owned profile.')
+    trace_dir = Path(trace_environment['APS5_TRACE_DIR']).resolve(strict=True)
+    if trace_dir != run_dir / 'aps5-trace' or not trace_dir.is_dir():
+        raise RuntimeError('Causal trace output directory is missing or outside the native-game run.')
+    control_fifo = run_dir / 'perf-control.fifo'
+    ack_fifo = run_dir / 'perf-ack.fifo'
+    for path in (control_fifo, ack_fifo):
+        try:
+            metadata = path.lstat()
+        except FileNotFoundError as error:
+            raise RuntimeError(f'Required perf control FIFO is missing: {path}') from error
+        if (not stat.S_ISFIFO(metadata.st_mode)
+                or stat.S_IMODE(metadata.st_mode) & 0o600 != 0o600
+                or stat.S_IMODE(metadata.st_mode) & 0o077):
+            raise RuntimeError(f'Perf control path is not a private, readable FIFO: {path}')
+    perf_data = run_dir / 'perf.data'
+    if os.path.lexists(perf_data):
+        raise RuntimeError(f'Perf output already exists; refusing to overwrite: {perf_data}')
+    return launch_guard._sampling_configuration(run_dir, sample_seconds)
+
+
+def write_supervisor_receipt(path, identifier, argv):
+    receipt = {
+        'schema': 'short-run-supervisor/v1',
+        'attempt': int(identifier, 16),
+        'scope': 'native game',
+        'argv': [str(item) for item in argv],
+    }
+    receipt_path = path / 'supervisor-receipt.json'
+    receipt_fd = os.open(
+        receipt_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+    with os.fdopen(receipt_fd, 'w', encoding='utf-8') as receipt_file:
+        json.dump(receipt, receipt_file, sort_keys=True)
+        receipt_file.write('\n')
+        receipt_file.flush()
+        os.fsync(receipt_file.fileno())
+
+
+def worker(mode, runtime_seconds, profile_name, job_backoff, wait_idle_backoff, causal_trace, trace_waits,
+           trace_label, privileged_kernel, until_stopped, pipeline_dispatch, mangohud,
+           debug_segv, pipeline_drain_fills, no_lazy_shader_prepare, dump_submits,
