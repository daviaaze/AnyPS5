+#pragma once
+#include <cstdint>
+
+// Opt-in pinned-title experiment; actual guest producer contracts remain unproven.
+struct IdleState {
+    IdleState* previous{};
+    void* object{};
+    std::uint32_t attempts{};
+    bool rescan_pending{};
+};
+extern thread_local __attribute__((tls_model("initial-exec"))) IdleState* active_idle_state;
+// 0: replay original pause/load/time path; 1: rescan work once; 2: stop==1.
+extern "C" unsigned idle_delay(void* object) noexcept;
