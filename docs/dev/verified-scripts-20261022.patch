+def stop_owned_children(run_dir, unit, service_process, observer_process, observer_pidfd,
+                        unit_started, cgroup, orderly_reason='controller_failure'):
+    unit_stop = {'requested': False}
+    cleanup_error = None
+    finish = {'requested': False, 'reason': 'observer absent or already exited'}
+    if observer_process is not None and observer_process.poll() is None:
+        try:
+            finish = {
+                'requested': True,
+                'response': request_observer(
+                    'orderly-stop', run_dir, reason=orderly_reason, timeout=35),
+            }
+        except (OSError, RuntimeError, subprocess.SubprocessError) as error:
+            finish = {'requested': True, 'error': str(error)}
+    if observer_process is not None and observer_process.poll() is None:
+        try:
+            observer_process.wait(timeout=STOP_SECONDS + 3)
+        except subprocess.TimeoutExpired:
+            try:
+                if observer_pidfd is not None:
+                    signal.pidfd_send_signal(observer_pidfd, signal.SIGTERM, None, 0)
+                else:
+                    observer_process.send_signal(signal.SIGTERM)
+            except OSError:
+                if observer_process.poll() is None:
+                    observer_process.send_signal(signal.SIGTERM)
+            try:
+                observer_process.wait(timeout=3)
+            except subprocess.TimeoutExpired:
+                try:
+                    if observer_pidfd is not None:
+                        signal.pidfd_send_signal(observer_pidfd, signal.SIGKILL, None, 0)
+                    else:
+                        observer_process.kill()
+                except OSError:
+                    observer_process.kill()
+                observer_process.wait(timeout=3)
+    observer_exited = observer_process is None or observer_process.poll() is not None
+    if unit_started:
+        systemctl = shutil.which('systemctl')
+        if systemctl is not None:
+            snapshot = launch_guard._unit_snapshot(systemctl, unit)
+            actual_group = (snapshot.get('properties') or {}).get('ControlGroup')
+            if actual_group and cgroup and actual_group != cgroup:
+                cleanup_error = RuntimeError('fixture unit cgroup identity changed; refusing a mismatched unit stop')
+            elif not observer_exited:
+                cleanup_error = RuntimeError('fixture observer did not exit before owned-unit stop')
+            else:
+                try:
+                    requested_at = time.monotonic_ns()
+                    result = subprocess.run(
+                        [systemctl, '--user', 'stop', unit], stdin=subprocess.DEVNULL,
+                        capture_output=True, text=True, timeout=STOP_SECONDS + 3, check=False)
+                    unit_stop = {
+                        'requested': True, 'requested_at_monotonic_ns': requested_at,
+                        'returncode': result.returncode, 'stdout': result.stdout,
+                        'stderr': result.stderr,
+                    }
+                    if result.returncode != 0:
+                        cleanup_error = RuntimeError(f'fixture unit stop returned {result.returncode}: {result.stderr.strip()}')
+                except (OSError, subprocess.SubprocessError) as error:
+                    unit_stop = {'requested': True, 'error': str(error)}
+                    cleanup_error = RuntimeError(f'fixture unit stop failed: {error}')
+        else:
+            cleanup_error = RuntimeError('systemctl disappeared before fixture teardown')
+    if service_process is not None and service_process.poll() is None:
+        try:
+            service_process.wait(timeout=STOP_SECONDS + 3)
+        except subprocess.TimeoutExpired:
+            service_process.kill()
+            service_process.wait()
+    if cleanup_error is not None:
+        raise cleanup_error
+    return {'finish': finish, 'observer_exited_before_unit_stop': observer_exited,
+            'unit_stop': unit_stop}
