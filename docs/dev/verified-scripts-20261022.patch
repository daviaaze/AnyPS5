+#!/usr/bin/env python3
+"""Offline same-window causal evidence analyzer. Never executes artifacts."""
+import argparse
+import importlib.util
+import hashlib
+import gzip
+import json
+import os
+from pathlib import Path
+import shutil
+import stat
+import subprocess
+import sys
+from decimal import Decimal, InvalidOperation
+
+MAX_FILE = 128 * 1024 * 1024
+MAX_PERF_OUTPUT = 64 * 1024 * 1024
+MAX_PERF_DATA = 512 * 1024 * 1024
+
+class AnalysisError(RuntimeError):
+    pass
+
+def _json(path, limit=MAX_FILE):
+    p = Path(path)
+    info = p.lstat()
+    if not stat.S_ISREG(info.st_mode) or info.st_size > limit:
+        raise AnalysisError(f'not a bounded regular file: {p}')
+    opener = gzip.open if p.suffix == '.gz' else open
+    try:
+        with opener(p, 'rb') as f:
+            raw = f.read(limit + 1)
+    except (OSError, EOFError) as e:
+        raise AnalysisError(f'cannot read bounded JSON artifact {p}: {e}')
+    if len(raw) > limit:
+        raise AnalysisError(f'decompressed JSON artifact exceeds {limit} byte limit: {p}')
+    try:
+        return json.loads(raw.decode('utf-8'),parse_float=Decimal)
+    except (UnicodeError, json.JSONDecodeError) as e:
+        raise AnalysisError(f'invalid UTF-8 JSON artifact {p}: {e}')
+
+def _sha(path):
+    h = hashlib.sha256()
+    with open(path, 'rb') as f:
+        for chunk in iter(lambda: f.read(1024 * 1024), b''):
+            h.update(chunk)
+    return h.hexdigest()
+
+def _observer():
+    name='causal_observer_for_analyzer'
+    if name in sys.modules:
+        return sys.modules[name]
+    path = Path(__file__).with_name('causal-observer.py')
+    spec = importlib.util.spec_from_file_location(name, path)
+    if spec is None or spec.loader is None:
+        raise AnalysisError('cannot load adjacent causal observer parser')
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name]=module
+    try:
+        spec.loader.exec_module(module)
+    except Exception:
+        sys.modules.pop(name,None)
+        raise
+    return module
+
+def _perf_data(run_dir, sample):
+    window = sample.get('window', {})
+    fin = window.get('perf_finalization', {})
+    paths = fin.get('new_finalized_paths')
+    if fin.get('state') != 'finalized' or not isinstance(paths, list) or len(paths) != 1:
+        raise AnalysisError('capture lacks exactly one finalized perf split; sample coverage unavailable')
+    row = paths[0]
+    name = row.get('path') if isinstance(row, dict) else None
+    if not isinstance(name, str):
+        raise AnalysisError('finalized perf split path missing')
+    p = Path(name)
+    root = Path(run_dir).resolve(strict=True)
+    if not p.is_absolute() or p.parent.resolve(strict=True) != root:
+        raise AnalysisError('finalized perf split is not directly inside run_dir')
+    info = p.lstat()
+    verify = fin.get('sample_data_verification', {})
+    expected_hash = row.get('sha256')
+    if (not stat.S_ISREG(info.st_mode) or info.st_size <= 0 or info.st_size > MAX_PERF_DATA
+            or info.st_size != row.get('size_bytes')
+            or not isinstance(expected_hash, str) or _sha(p) != expected_hash
+            or verify.get('perf_data_path') != str(p)
+            or verify.get('perf_data_sha256') != expected_hash):
+        raise AnalysisError('finalized perf split size/hash identity does not match receipt')
+    return p
+
+def _select_trace(run_dir, explicit):
+    root = Path(run_dir).resolve(strict=True)
+    directory = root / 'aps5-trace'
+    try:
+        directory_info = directory.lstat()
+    except OSError as e:
+        raise AnalysisError(f'canonical aps5-trace directory is missing: {e}')
+    if not stat.S_ISDIR(directory_info.st_mode) or directory.resolve(strict=True) != root / 'aps5-trace':
+        raise AnalysisError('aps5-trace must be a real directory directly inside run_dir')
+    summary = directory / 'aps5-summary.jsonl'
+    try:
+        info = summary.lstat()
+        if not stat.S_ISREG(info.st_mode) or info.st_size > 64 * 1024 * 1024:
+            raise AnalysisError('aps5-summary.jsonl is not a bounded regular file')
+        rows = [json.loads(line) for line in summary.read_text(encoding='utf-8').splitlines() if line.strip()]
+    except FileNotFoundError:
+        raise AnalysisError('aps5-summary.jsonl missing; cannot establish a recorded completed trace')
+    names = set()
+    for row in rows:
+        if not isinstance(row, dict) or 'trace' not in row:
+            continue
+        name=row['trace']
+        window=row.get('window')
+        spec=window.get('spec') if isinstance(window,dict) else None
+        fields=spec.split() if isinstance(spec,str) else []
+        if (name == '' and len(fields)==2 and fields[0]=='summary_every'
+                and fields[1].isdigit() and int(fields[1]) > 0):
+            continue
+        if (not isinstance(name,str) or not name or Path(name).name != name
+                or name in ('.','..')):
+            raise AnalysisError('summary contains an invalid trace filename')
+        names.add(name)
+    if len(names) != 1:
+        raise AnalysisError(f'expected exactly one distinct recorded trace filename; found {len(names)}; no guessing')
+    name = next(iter(names))
+    recorded = directory / name
+    try:
+        file_info = recorded.lstat()
+    except OSError as e:
+        raise AnalysisError(f'recorded trace is missing/incomplete: {e}')
+    if not stat.S_ISREG(file_info.st_mode) or file_info.st_size <= 0:
+        raise AnalysisError('recorded trace is not a completed regular file')
+    canonical = recorded.resolve(strict=True)
+    if canonical.parent != directory.resolve(strict=True):
+        raise AnalysisError('recorded trace escapes canonical aps5-trace directory')
+    if explicit is not None:
+        requested=Path(explicit)
+        if not requested.is_absolute():
+            requested=(directory/requested if requested.parent==Path('.')
+                       else root/requested)
+        try:
+            requested_info=requested.lstat()
+            requested_canonical=requested.resolve(strict=True)
+        except OSError as e:
+            raise AnalysisError(f'explicit trace is missing or inaccessible: {e}')
+        if (not stat.S_ISREG(requested_info.st_mode)
+                or requested_info.st_dev != file_info.st_dev
+                or requested_info.st_ino != file_info.st_ino
+                or requested_canonical.parent != directory.resolve(strict=True)):
+            raise AnalysisError('explicit trace does not match the summary-recorded file')
+    matching_rows=[row for row in rows if isinstance(row,dict) and row.get('trace')==name]
+    coverage_known=bool(matching_rows) and all(type(row.get('trace_dropped')) is bool for row in matching_rows)
+    dropped_threads={}
+    for row in matching_rows:
+        per_thread=row.get('trace_dropped_threads',{})
+        if isinstance(per_thread,dict):
+            for thread_id, detail in per_thread.items():
+                if isinstance(detail,dict):
+                    entry=dropped_threads.setdefault(thread_id,{'causal_events_lost':0})
+                    count=detail.get('causal_events_lost',0)
+                    if type(count) is int and count > entry['causal_events_lost']:
+                        entry['causal_events_lost']=count
+    summary_coverage={'known':coverage_known,
+                      'trace_dropped':any(row.get('trace_dropped') is True for row in matching_rows),
+                      'trace_dropped_threads':dropped_threads}
+    return canonical, summary_coverage
+
+def _decode_perf(run_dir, sample, perf, start, end):
+    p = _perf_data(run_dir, sample)
+    initial=p.lstat()
+    initial_digest=_sha(p)
+    expected_digest=sample['window']['perf_finalization']['sample_data_verification']['perf_data_sha256']
+    if initial_digest != expected_digest:
+        raise AnalysisError('finalized perf split changed after receipt hash verification')
+    exe = perf or shutil.which('perf')
+    if not exe:
+        raise AnalysisError('no --perf provided and perf is not available on PATH')
+    exe = os.path.realpath(exe)
+    try:
+        st = os.stat(exe)
+    except OSError as e:
+        raise AnalysisError(f'cannot stat trusted perf executable: {e}')
+    if not stat.S_ISREG(st.st_mode) or not os.access(exe, os.X_OK):
+        raise AnalysisError('trusted perf path is not an executable regular file')
+    pid = sample.get('pid')
+    if type(pid) is not int or pid <= 1:
+        raise AnalysisError('sample-window has no valid matching target PID')
+    argv = [exe, 'script', '--ns', '-F', 'pid,tid,time,event,period,ip,sym,dso', '-i', str(p)]
+    try:
+        # Drain both pipes incrementally and fail closed before buffering exceeds limits.
+        import selectors
+        import time
+        proc = subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+        selector = selectors.DefaultSelector()
+        selector.register(proc.stdout, selectors.EVENT_READ, 'out')
+        selector.register(proc.stderr, selectors.EVENT_READ, 'err')
+        stdout_parts, stderr_parts = [], []
+        stdout_size = stderr_size = 0
+        deadline = time.monotonic() + 15
+        while selector.get_map():
+            remaining = deadline - time.monotonic()
+            if remaining <= 0:
+                proc.kill()
+                proc.wait()
+                raise AnalysisError('trusted perf decoder exceeded 15 second bound')
+            for key, _ in selector.select(min(remaining, 0.25)):
+                data = os.read(key.fileobj.fileno(), 65536)
+                if not data:
+                    selector.unregister(key.fileobj)
+                elif key.data == 'out':
+                    stdout_size += len(data)
+                    if stdout_size > MAX_PERF_OUTPUT:
+                        proc.kill()
+                        proc.wait()
+                        raise AnalysisError('perf decoder output exceeds 64 MiB')
+                    stdout_parts.append(data)
+                else:
+                    stderr_size += len(data)
+                    if stderr_size <= 65536:
+                        stderr_parts.append(data)
+        try:
+            proc.wait(timeout=max(0.01, deadline-time.monotonic()))
+        except subprocess.TimeoutExpired:
+            proc.kill()
+            proc.wait()
+            raise AnalysisError('trusted perf decoder exceeded 15 second bound')
+        stdout = b''.join(stdout_parts).decode('utf-8', errors='replace')
+        stderr = b''.join(stderr_parts).decode('utf-8', errors='replace')
+        selector.close()
+    except (OSError, subprocess.SubprocessError) as e:
+        raise AnalysisError(f'cannot execute trusted perf decoder: {e}')
+    observer = _observer()
+    lines = stdout.splitlines()
+    samples = observer.parse_perf_sample_lines(lines, pid, start, end)
+    # Preserve only target PID samples strictly inside the requested interval, with callchains.
+    regex = observer.PERF_SAMPLE_RE
+    records = []
+    current = None
+    for line in lines:
+        m = regex.match(line)
+        if m:
+            if current is not None: records.append(current)
+            try: stamp = int(Decimal(m.group(3)) * Decimal(1_000_000_000))
+            except (InvalidOperation, ValueError): continue
+            current = {'pid': int(m.group(1)), 'tid': int(m.group(2)), 'monotonic_ns': stamp,
+                       'period': int(m.group(4)), 'frames': []}
+        elif current is not None and line[:1].isspace() and line.strip():
+            current['frames'].append(line.strip())
+    if current is not None: records.append(current)
+    selected = [r for r in records if r['pid'] == pid and start < r['monotonic_ns'] < end]
+    if not selected:
+        raise AnalysisError('decoded sample stream has no target samples strictly inside interval')
+    for record in selected:
+        record['stack_availability'] = {
+            'user': 'available' if record['frames'] else 'unavailable_or_empty',
+            'kernel': 'not_sampled_by_cpu-clock:u',
+        }
+    final=p.lstat()
+    if ((final.st_dev,final.st_ino,final.st_size,final.st_mtime_ns)
+            != (initial.st_dev,initial.st_ino,initial.st_size,initial.st_mtime_ns)
+            or not stat.S_ISREG(final.st_mode) or _sha(p)!=initial_digest):
+        raise AnalysisError('finalized perf split changed while being decoded')
+    return {'trusted_perf': exe, 'returncode': proc.returncode, 'stderr': stderr[-2048:],
+            'verified_parser': samples,'sample_period_semantics':'perf sample period; not wall-clock spacing or duration',
+            'samples': selected, 'perf_data_path': str(p),
+            'perf_data_sha256': initial_digest}
+
+def _time_alignment(resources):
+    if not resources:
+        return {'status':'unproven','reason':'no resource snapshots establish time-namespace offsets'}
+    for snapshot in resources:
+        entry=snapshot.get('time_namespace_offsets',{})
+        raw=entry.get('raw') if isinstance(entry,dict) else None
+        if not isinstance(entry,dict) or entry.get('availability')!='available' or not isinstance(raw,str):
+            return {'status':'unproven','reason':'time-namespace offsets unavailable'}
+        lines=[line.split() for line in raw.splitlines() if line.strip()]
+        if not lines or any(len(line)!=3 for line in lines):
+            return {'status':'unproven','reason':'time-namespace offset format unknown'}
+        try:
+            if any(int(value)!=0 for line in lines for value in line[1:]):
+                return {'status':'unproven','reason':'nonzero time-namespace offset without verified mapping'}
+        except ValueError:
+            return {'status':'unproven','reason':'time-namespace offset format unknown'}
+    return {'status':'aligned_zero_offsets','reason':None}
+
+def _lane_map(trace, resources, alignment):
+    lanes = {}
+    for ev in trace.get('traceEvents', []):
+        if ev.get('ph') != 'M' or ev.get('name') != 'thread_name':
+            continue
+        args = ev.get('args', {})
+        trace_pid = ev.get('pid') if type(ev.get('pid')) is int else None
+        trace_tid = ev.get('tid') if type(ev.get('tid')) is int else None
+        raw_tid = args.get('native_tid')
+        native_tid = raw_tid if type(raw_tid) is int and raw_tid > 0 else None
+        raw_birth = args.get('native_starttime_ticks')
+        birth = raw_birth if native_tid is not None and type(raw_birth) is int and raw_birth >= 0 else None
+        lanes.setdefault((trace_pid, trace_tid), set()).add((native_tid, birth))
+    known = {}
+    for snapshot in resources:
+        for thread in snapshot.get('threads', {}).get('items', []):
+            birth = thread.get('starttime_ticks')
+            namespace = thread.get('namespace_ids', {})
+            ids = namespace.get('ids', {}) if isinstance(namespace, dict) and namespace.get('availability') == 'available' else {}
+            nspids = ids.get('NSpid', []) if isinstance(ids, dict) else []
+            if type(birth) is int and birth >= 0 and isinstance(nspids, list):
+                host_tid = thread.get('tid')
+                if type(host_tid) is int and host_tid > 0:
+                    for namespace_tid in set(x for x in nspids if type(x) is int and x > 0):
+                        known.setdefault(namespace_tid, set()).add((host_tid, birth))
+    out = []
+    for (trace_pid, trace_tid), identities in lanes.items():
+        for native_tid, birth in identities:
+            candidates = known.get(native_tid, set()) if native_tid is not None else set()
+            matching = [pair for pair in candidates if pair[1] == birth] if birth is not None else []
+            verified = (alignment.get('status') == 'aligned_zero_offsets'
+                        and type(trace_pid) is int and type(trace_tid) is int
+                        and native_tid is not None and birth is not None and len(matching) == 1)
+            out.append({
+                'trace_pid': trace_pid,
+                'trace_tid': trace_tid,
+                'native_tid': native_tid,
+                'native_starttime_ticks': birth,
+                'resource_candidates': [
+                    {'tid': host_tid, 'starttime_ticks': start}
+                    for host_tid, start in sorted(candidates)
+                ],
+                'join': 'verified' if verified else 'unproven',
+                'reason': None if verified else (
+                    'clock alignment unproven' if alignment.get('status') != 'aligned_zero_offsets'
+                    else 'TID namespace/birth match absent or ambiguous'),
+            })
+    return out
+
+def _thread_identity(event):
+    if event is None:
+        return {
+            'trace_pid': None, 'trace_tid': None, 'native_tid': None,
+            'native_starttime_ticks': None, 'os_lane_join': 'unproven',
+            'os_lane_join_reason': 'trace participant event unavailable',
+        }
+    return {
+        'trace_pid': event.get('trace_pid'),
+        'trace_tid': event.get('trace_tid'),
+        'native_tid': event.get('native_tid'),
+        'native_starttime_ticks': event.get('native_starttime_ticks'),
+        'os_lane_join': event.get('os_lane_join', 'unproven'),
+        'os_lane_join_reason': event.get('os_lane_join_reason'),
+    }
+
+def _cpu_deltas(resources, start, end):
+    rows = []
+    grouped = {}
+    for s in resources:
+        a = s.get('snapshot_start', {}).get('monotonic_ns')
+        b = s.get('snapshot_end', {}).get('monotonic_ns')
+        if type(a) is not int or type(b) is not int or a < start or b > end or b < a: continue
+        for t in s.get('threads', {}).get('items', []):
+            tid, birth = t.get('tid'), t.get('starttime_ticks')
+            hz = t.get('cpu_tick_hz', {})
+            if (type(tid) is not int or tid <= 0 or type(birth) is not int or birth < 0
+                    or hz.get('availability') != 'available' or type(hz.get('value')) is not int
+                    or hz['value'] <= 0): continue
+            grouped.setdefault((tid, birth, hz['value']), []).append((a,b,t))
+    for (tid,birth,hz), obs in grouped.items():
+        obs.sort(key=lambda x:(x[0],x[1]))
+        for left,right in zip(obs,obs[1:]):
+            a,b,x=left; c,d,y=right
+            if b > c or a == c: continue
+            u0,s0=x.get('utime_ticks'),x.get('stime_ticks'); u1,s1=y.get('utime_ticks'),y.get('stime_ticks')
+            if any(type(v) is not int for v in (u0,s0,u1,s1)): continue
+            if u1 < u0 or s1 < s0: continue
+            rows.append({'tid':tid,'starttime_ticks':birth,'hz':hz,
+                         'snapshot_brackets_ns':[[a,b],[c,d]],'unobserved_gap_ns':[b,c],
+                         'utime_delta_ticks':u1-u0,'stime_delta_ticks':s1-s0,
+                         'thread_cpu_ns':((u1-u0+s1-s0)*1_000_000_000)//hz,
+                         'states':[x.get('state'),y.get('state')],
+                         'wchan':[x.get('wchan'),y.get('wchan')]})
+    return rows
+
+def _resource_observations(resources, start, end):
+    rows=[]
+    for s in resources:
+        a=s.get('snapshot_start',{}).get('monotonic_ns')
+        b=s.get('snapshot_end',{}).get('monotonic_ns')
+        if type(a) is not int or type(b) is not int or a < start or b > end or b < a: continue
+        for t in s.get('threads',{}).get('items',[]):
+            hz=t.get('cpu_tick_hz',{})
+            rows.append({'tid':t.get('tid'),'starttime_ticks':t.get('starttime_ticks'),
+                         'snapshot_bracket_ns':[a,b],
+                         'utime_ticks':t.get('utime_ticks'),'stime_ticks':t.get('stime_ticks'),
+                         'cpu_tick_hz':hz.get('value') if hz.get('availability')=='available' else None,
+                         'state':t.get('state'),'wchan':t.get('wchan')})
+    return rows
+
+def analyze_trace(trace, resources, start, end):
+    if not isinstance(trace,dict) or not isinstance(trace.get('traceEvents'),list):
+        raise AnalysisError('trace JSON lacks a traceEvents array')
+    for index,ev in enumerate(trace['traceEvents']):
+        if not isinstance(ev,dict) or not isinstance(ev.get('args',{}),dict):
+            raise AnalysisError(f'trace event {index} is not an object with object args')
+    if not isinstance(resources,list):
+        raise AnalysisError('resources data is not a JSONL snapshot list')
+    for index,snapshot in enumerate(resources):
+        if (not isinstance(snapshot,dict)
+                or not isinstance(snapshot.get('threads',{}),dict)
+                or not isinstance(snapshot.get('threads',{}).get('items',[]),list)
+                or not isinstance(snapshot.get('time_namespace_offsets',{}),dict)):
+            raise AnalysisError(f'resource snapshot {index} has invalid structure')
+        if any(not isinstance(t,dict) for t in snapshot.get('threads',{}).get('items',[])):
+            raise AnalysisError(f'resource snapshot {index} has a non-object thread')
+        if any(key in snapshot and not isinstance(snapshot[key],dict)
+               for key in ('snapshot_start','snapshot_end')):
+            raise AnalysisError(f'resource snapshot {index} has invalid clock pairs')
+        for thread in snapshot.get('threads',{}).get('items',[]):
+            if any(key in thread and not isinstance(thread[key],dict)
+                   for key in ('cpu_tick_hz','namespace_ids','wchan')):
+                raise AnalysisError(f'resource snapshot {index} has invalid thread metadata')
+    if not isinstance(trace.get('clock',{}),dict):
+        raise AnalysisError('trace clock is not an object')
+    origin = trace.get('clock', {}).get('origin_ns')
+    if type(origin) is not int: raise AnalysisError('trace clock.origin_ns must be integer monotonic ns')
+    selected=[]
+    for e in trace.get('traceEvents',[]):
+        ts=e.get('ts'); dur=e.get('dur',0)
+        if type(ts) not in (int,float,Decimal) or type(dur) not in (int,float,Decimal): continue
+        # Chrome trace ts/dur are microseconds; Decimal avoids an intermediate float conversion.
+        begin=origin+int(Decimal(str(ts))*1000)
+        finish=begin+int(Decimal(str(dur))*1000)
+        if finish < start or begin > end: continue
+        contained=begin >= start and finish <= end
+        overlap=max(0,min(finish,end)-max(begin,start))
+        complete_span=e.get('ph')=='X' and finish > begin
+        item={'name':e.get('name'),'cat':e.get('cat'),'ph':e.get('ph'),
+              'trace_pid':e.get('pid') if type(e.get('pid')) is int else None,
+              'trace_tid':e.get('tid') if type(e.get('tid')) is int else None,
+              'begin_ns':begin,'end_ns':finish,'wall_ns':finish-begin,
+              'overlap_wall_ns':overlap,'fully_contained':contained,
+              'complete_span':complete_span,'args':e.get('args',{})}
