+        executable_info = None
+        proc_exe_status = 'unavailable-permission'
+        try:
+            observed_exe = os.readlink(process / 'exe')
+            observed_info = os.stat(process / 'exe')
+            observed_resolved = Path(observed_exe).resolve(strict=True)
+        except PermissionError:
+            pass
+        except OSError as error:
+            raise ObserverError(f'cannot verify direct perf parent executable: {error}') from error
+        else:
+            wrapper_path = Path(wrapper['perf_wrapper_path'])
+            if (observed_exe.endswith(' (deleted)') or observed_resolved != wrapper_path
+                    or (observed_info.st_dev, observed_info.st_ino)
+                    != (wrapper['perf_wrapper_device'], wrapper['perf_wrapper_inode'])):
+                raise ObserverError(f'direct parent PID {pid} /proc/exe is not the pinned perf wrapper ELF')
+            executable_path, executable_info = observed_exe, observed_info
+            proc_exe_status = 'wrapper-verified'
+        return {
+            'pid': pid, 'ppid': current['ppid'], 'starttime_ticks': current['starttime_ticks'],
+            'cgroup': current_cgroup, 'effective_uid': effective_uid, 'comm': comm,
+            'proc_exe_status': proc_exe_status,
+            'executable_path': executable_path,
+            'proc_exe': executable_path if executable_path is not None else 'unavailable',
+            'executable_device': executable_info.st_dev if executable_info else None,
+            'executable_inode': executable_info.st_ino if executable_info else None,
+            'argv': argv, 'argv_sha256': hashlib.sha256(raw_cmdline).hexdigest(),
+            **wrapper,
+        }
