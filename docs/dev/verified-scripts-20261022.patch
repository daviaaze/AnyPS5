new file mode 100755
index 000000000..21837b619
--- /dev/null
+++ b/overnight-validation.py
@@ -0,0 +1,292 @@
+#!/usr/bin/env python3
+"""Run bounded, no-game Vulkan regression cycles until an explicit deadline."""
+
+import argparse
+import datetime as dt
+import hashlib
+import json
+import math
+import os
+from pathlib import Path
+import re
+import signal
+import subprocess
+import sys
+import threading
+import time
+
+
+FOCUSED = r"^(agc_pipeline_cache|agc_pipeline_cache_file|agc_pipeline_library|agc_pipeline_library_off|agc_pipeline_journal|agc_pipeline_library_clear_waits_for_build|agc_pipeline_store_lazy_buffer_pool|agc_pipeline_store_concurrent_same_key|agc_submit_outside_gpu_mutex)$"
+STRESS = r"^agc_pipeline_store_concurrent_same_key$"
+DIAGNOSTICS = re.compile(
+    r"VUID-|(?:validation layer|VK_LAYER_KHRONOS_validation).{0,160}"
+    r"(?:not found|missing|unavailable|failed|cannot|could not)|"
+    r"(?:not found|missing|unavailable|failed|cannot|could not).{0,160}"
+    r"(?:validation layer|VK_LAYER_KHRONOS_validation)|"
+    r"VK_ERROR_LAYER_NOT_PRESENT|Couldn't find validation layer|"
+    r"loader_validate_layers:.*does not exist",
+    re.IGNORECASE,
+)
+
+
+def timestamp():
+    return dt.datetime.now(dt.timezone.utc).isoformat()
+
+
+def atomic_json(path, value):
+    temporary = path.with_name(path.name + '.tmp')
+    with temporary.open('w', encoding='utf-8') as stream:
+        json.dump(value, stream, indent=2, sort_keys=True)
+        stream.write('\n')
+        stream.flush()
+        os.fsync(stream.fileno())
+    os.replace(temporary, path)
+
+
+def deadline_arg(value):
+    try:
+        parsed = dt.datetime.fromisoformat(value)
+    except ValueError as error:
+        raise argparse.ArgumentTypeError('deadline must be ISO 8601 with an offset') from error
+    if parsed.utcoffset() is None:
+        raise argparse.ArgumentTypeError('deadline must include a timezone offset')
+    return parsed
+
+
+def positive_seconds(value):
+    try:
+        seconds = float(value)
+    except ValueError as error:
+        raise argparse.ArgumentTypeError('interval must be a positive number') from error
+    if not math.isfinite(seconds) or seconds <= 0:
+        raise argparse.ArgumentTypeError('interval must be a positive finite number')
+    return seconds
+
+
+class Controller:
+    def __init__(self, args):
+        self.args = args
+        self.wake = threading.Event()
+        self.stopping = None
+        self.started = timestamp()
+        self.end_wall = args.deadline.timestamp()
+        self.end_mono = time.monotonic() + self.end_wall - time.time()
+        self.state = {
+            'started': self.started, 'deadline': args.deadline.isoformat(),
+            'cycles_started': 0, 'cycles_completed': 0, 'tests': [],
+            'status': 'initialized', 'build': str(args.build),
+        }
+
+    def remaining(self):
+        return min(self.end_mono - time.monotonic(), self.end_wall - time.time())
+
+    def received_signal(self, number, _frame):
+        self.stopping = number
+        self.wake.set()
+
+    def save(self):
+        self.state['updated'] = timestamp()
+        atomic_json(self.args.evidence / 'state.json', self.state)
+
+    def halt_reason(self):
+        if self.stopping is not None:
+            return 'signal'
+        if self.remaining() <= 0:
+            return 'deadline'
+        return None
+
+    def pause(self):
+        receipt = self.args.evidence / 'paused.json'
+        while (self.args.evidence / 'pause').exists():
+            if not receipt.exists():
+                self.state['status'] = 'paused'
+                self.save()
+                atomic_json(receipt, {
+                    'paused': timestamp(), 'pid': os.getpid(),
+                    'cycles_completed': self.state['cycles_completed'],
+                    'child_running': False,
+                })
+                print('OVERNIGHT_PAUSED', flush=True)
+            if self.halt_reason():
+                return False
+            self.wake.wait(min(30, max(0, self.remaining())))
+        if receipt.exists():
+            receipt.unlink()
+            self.state['status'] = 'running'
+            self.save()
+            print('OVERNIGHT_RESUMED', flush=True)
+        return not self.halt_reason()
+
+    def fingerprint(self):
+        entries = []
+        for name in ('agc_driver_recorder_tests', 'agc_driver_graphics_tests',
+                     'agc_submit_outside_gpu_mutex_tests'):
+            path = self.args.build / 'tests' / name
+            if not path.is_file():
+                raise RuntimeError('required test executable missing: ' + str(path))
+            stat = path.stat()
+            entries.append({
+                'path': str(path.relative_to(self.args.build)),
+                'size': stat.st_size, 'mtime_ns': stat.st_mtime_ns,
+                'ctime_ns': stat.st_ctime_ns, 'inode': stat.st_ino,
+                'device': stat.st_dev,
+            })
+        return {
+            'method': 'required-test-executable-stat-metadata', 'captured': timestamp(),
+            'sha256': hashlib.sha256(json.dumps(entries, sort_keys=True).encode()).hexdigest(),
+            'executables': entries,
+        }
+
+    @staticmethod
+    def stop_child(child):
+        try:
+            os.killpg(child.pid, signal.SIGTERM)
+        except ProcessLookupError:
+            pass
+        until = time.monotonic() + 2
+        while time.monotonic() < until:
+            try:
+                os.killpg(child.pid, 0)
+            except ProcessLookupError:
+                break
+            time.sleep(min(0.05, max(0, until - time.monotonic())))
+        try:
+            os.killpg(child.pid, signal.SIGKILL)
+        except ProcessLookupError:
+            pass
+        child.wait()
+
+    def run_test(self, name, regex, repeat=False):
+        if not self.pause():
+            return self.halt_reason()
+        cycle = self.state['cycles_started']
+        logfile = self.args.evidence / f'cycle-{cycle:04d}-{name}.log'
+        limit = min(120.0, self.remaining())
+        if limit <= 0:
+            return 'deadline'
+        command = ['ctest', '--test-dir', str(self.args.build), '-j', '1',
+                   '--output-on-failure', '--verbose', '--no-tests=error',
+                   '--timeout', str(limit), '-R', regex]
+        if repeat:
+            command.extend(['--repeat', 'until-fail:100'])
+        record = {'name': name, 'cycle': cycle, 'command': command,
+                  'started': timestamp(), 'status': 'running', 'output': str(logfile),
+                  'timeout_seconds': limit}
+        self.state['tests'].append(record)
+        self.state['status'] = 'running'
+        self.save()
+        environment = os.environ.copy()
+        environment.update(DISABLE_LSFGVK='1', ANYPS5_REQUIRE_VULKAN='1',
+                           ANYPS5_NO_SHADER_CACHE='1',
+                           VK_INSTANCE_LAYERS='VK_LAYER_KHRONOS_validation')
+        reason = None
+        print(f'OVERNIGHT_TEST cycle={cycle} name={name}', flush=True)
+        with logfile.open('wb') as output:
+            child = subprocess.Popen(command, stdout=output, stderr=subprocess.STDOUT,
+                                     env=environment, start_new_session=True)
+            expires = time.monotonic() + limit
+            try:
+                while child.poll() is None:
+                    reason = self.halt_reason()
+                    if reason or time.monotonic() >= expires:
+                        reason = reason or 'test_timeout'
+                        self.stop_child(child)
+                        break
+                    self.wake.wait(min(0.2, max(0, expires - time.monotonic()),
+                                       max(0, self.remaining())))
+            finally:
+                if child.poll() is None:
+                    self.stop_child(child)
+            record['exit'] = child.returncode
+        matches = []
+        with logfile.open(encoding='utf-8', errors='replace') as output:
+            for number, line in enumerate(output, 1):
+                if DIAGNOSTICS.search(line):
+                    matches.append({'line': number, 'text': line.rstrip('\n')})
+        record.update(ended=timestamp(), diagnostics=matches)
+        if reason is None and child.returncode != 0:
+            reason = 'test_failure'
+        if reason is None and matches:
+            reason = 'validation_diagnostic'
+        record['status'] = reason or 'passed'
+        self.save()
+        print(f'OVERNIGHT_RESULT cycle={cycle} name={name} exit={child.returncode} status={record["status"]}', flush=True)
+        return reason
+
+    def run(self):
+        reason = 'internal_error'
+        exit_code = 1
+        try:
+            self.save()
+            print('OVERNIGHT_READY', flush=True)
+            while not self.halt_reason():
+                if not self.pause():
+                    break
+                self.state['cycles_started'] += 1
+                cycle = self.state['cycles_started']
+                fingerprint = self.fingerprint()
+                atomic_json(self.args.evidence / f'cycle-{cycle:04d}-binaries.json', fingerprint)
+                self.state['binary_generation'] = fingerprint['sha256']
+                self.save()
+                reason = self.run_test('focused', FOCUSED)
+                if not reason:
+                    reason = self.run_test('concurrency-stress', STRESS, repeat=True)
+                if reason:
+                    break
+                self.state['cycles_completed'] += 1
+                self.state['status'] = 'waiting'
+                self.save()
+                if self.args.once:
+                    reason = 'once_complete'
+                    break
+                next_cycle = time.monotonic() + self.args.interval_seconds
+                while time.monotonic() < next_cycle and not self.halt_reason():
+                    if not self.pause():
+                        break
+                    self.wake.wait(min(30, max(0, next_cycle - time.monotonic()),
+                                       max(0, self.remaining())))
+            reason = self.halt_reason() or reason
+            exit_code = (128 + self.stopping if self.stopping else
+                         0 if reason in ('deadline', 'once_complete') else 1)
+        except Exception as error:
+            self.state['error'] = f'{type(error).__name__}: {error}'
+            print(self.state['error'], file=sys.stderr, flush=True)
+        finally:
+            self.state.update(status='finished', reason=reason, exit=exit_code)
+            self.save()
+            atomic_json(self.args.evidence / 'finish.json', {
+                'started': self.started, 'ended': timestamp(),
+                'deadline': self.args.deadline.isoformat(), 'exit': exit_code,
+                'reason': reason, 'signal': self.stopping,
+                'cycles_started': self.state['cycles_started'],
+                'cycles_completed': self.state['cycles_completed'],
+                'tests': self.state['tests'], 'error': self.state.get('error'),
+            })
+            print(f'OVERNIGHT_FINISHED reason={reason} exit={exit_code}', flush=True)
+        return exit_code
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--deadline', required=True, type=deadline_arg)
+    parser.add_argument('--build', required=True, type=Path)
+    parser.add_argument('--evidence', required=True, type=Path)
+    parser.add_argument('--interval-seconds', type=positive_seconds, default=1200)
+    parser.add_argument('--once', action='store_true')
+    args = parser.parse_args()
+    args.build = args.build.resolve()
+    args.evidence = args.evidence.resolve()
+    if not args.build.is_dir():
+        parser.error('--build must be an existing directory')
+    try:
+        args.evidence.mkdir(parents=True, exist_ok=False)
+    except FileExistsError:
+        parser.error('--evidence must be a new unique directory')
+    controller = Controller(args)
+    signal.signal(signal.SIGTERM, controller.received_signal)
+    signal.signal(signal.SIGINT, controller.received_signal)
+    return controller.run()
+
+
+if __name__ == '__main__':
+    sys.exit(main())
