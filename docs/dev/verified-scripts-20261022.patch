+def _wait_for_discovery_service(state):
+    systemctl = shutil.which('systemctl')
+    if systemctl is None:
+        raise RuntimeError('systemctl is required for discovery fixture identity verification')
+    deadline = time.monotonic() + 5
+    while time.monotonic() < deadline:
+        snapshot = launch_guard._unit_snapshot(systemctl, state['unit'])
+        properties = snapshot.get('properties') or {}
+        if (snapshot.get('query') == 'ok' and properties.get('ActiveState') == 'active'
+                and isinstance(properties.get('ControlGroup'), str)
+                and properties['ControlGroup']):
+            state['snapshot'] = snapshot
+            state['cgroup'] = properties['ControlGroup']
+            return snapshot
+        if state['process'].poll() is not None:
+            detail = (state['run_dir'] / 'service.stderr').read_text()
+            raise RuntimeError(f'discovery service exited before becoming active: {detail}')
+        time.sleep(0.05)
+    raise RuntimeError('discovery service did not become active before its startup deadline')
+
