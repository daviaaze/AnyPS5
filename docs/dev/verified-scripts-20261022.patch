+def verify_fixture_target(pid, cgroup, workload_info, workload_sha256):
+    process = Path('/proc') / str(pid)
+    expected_path = WORKLOAD.resolve(strict=True)
+    try:
+        start_before = launch_guard._proc_starttime_ticks(pid)
+        cgroup_before = launch_guard._proc_cgroup_path(pid)
+        try:
+            executable_link = os.readlink(process / 'exe')
+        except PermissionError:
+            executable_link = None
+        status = (process / 'status').read_text().splitlines()
+        uid_line = next(line for line in status if line.startswith('Uid:'))
+        effective_uid = int(uid_line.split()[2])
+        comm = (process / 'comm').read_text().strip()
+        argv0 = os.fsdecode((process / 'cmdline').read_bytes().split(b'\0', 1)[0])
+        start_after = launch_guard._proc_starttime_ticks(pid)
+        cgroup_after = launch_guard._proc_cgroup_path(pid)
+    except (OSError, RuntimeError, StopIteration, ValueError, IndexError) as error:
+        raise RuntimeError(f'Cannot corroborate fixture workload PID {pid}: {error}') from error
+    expected_cgroup = '/' + cgroup.lstrip('/')
+    if (start_before != start_after or cgroup_before != expected_cgroup
+            or cgroup_after != expected_cgroup or effective_uid != os.geteuid()
+            or comm != WORKLOAD.name or argv0 != str(expected_path)):
+        raise RuntimeError('fixture workload PID/starttime/cgroup/UID/comm/argv0 differs from its pinned launch')
+    if (executable_link is not None
+            and (executable_link.endswith(' (deleted)')
+                 or Path(executable_link).resolve(strict=True) != expected_path)):
+        raise RuntimeError('fixture process executable path differs from its pinned workload')
+    try:
+        current_info = WORKLOAD.lstat()
+        current_sha256 = launch_guard.sha256_file(WORKLOAD)
+    except OSError as error:
+        raise RuntimeError(f'Cannot reverify canonical fixture workload: {error}') from error
+    if ((current_info.st_dev, current_info.st_ino, current_info.st_size)
+            != (workload_info.st_dev, workload_info.st_ino, workload_info.st_size)
+            or current_sha256 != workload_sha256):
+        raise RuntimeError('canonical fixture workload changed after the pinned target was launched')
+    return {
+        'method': ('proc-exe-path+cmdline+comm+uid+manifest-hash+pidfile+cgroup+starttime'
+                   if executable_link is not None else
+                   'cmdline+comm+uid+manifest-hash+pidfile+cgroup+starttime-exe-unavailable'),
+        'proc_exe': executable_link or 'unavailable',
+        'path': str(expected_path),
+        'device': workload_info.st_dev,
+        'inode': workload_info.st_ino,
+        'size': workload_info.st_size,
+        'sha256': workload_sha256,
+        'pid': pid,
+        'starttime_ticks': start_after,
+        'cgroup': cgroup_after,
+        'effective_uid': effective_uid,
+        'comm': comm,
+        'argv0': argv0,
+    }
