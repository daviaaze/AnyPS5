+    def _verify_nix_perf_script(self, argv0, pid):
+        argv0_path = Path(argv0)
+        if not argv0_path.is_absolute() or argv0_path.name != 'perf':
+            raise ObserverError(f'direct parent PID {pid} argv0 is not an absolute perf path')
+        try:
+            script_path = argv0_path.resolve(strict=True)
+            script_info = script_path.stat()
+            script_bytes = script_path.read_bytes()
+        except OSError as error:
+            raise ObserverError(f'direct parent PID {pid} perf script is unavailable: {error}') from error
+        canonical_perf = shutil.which('perf')
+        canonical_path = None
+        if canonical_perf is not None:
+            try:
+                canonical_path = Path(canonical_perf).resolve(strict=True)
+            except OSError:
+                pass
+        in_nix_store = Path('/nix/store') in script_path.parents and script_path.parent.name == 'bin'
+        if (not stat.S_ISREG(script_info.st_mode) or not os.access(script_path, os.X_OK)
+                or not (in_nix_store or script_path == canonical_path)):
+            raise ObserverError(f'direct parent PID {pid} argv0 is not a canonical perf script')
+        try:
+            lines = script_bytes.decode('utf-8').splitlines()
+        except UnicodeDecodeError as error:
+            raise ObserverError(f'direct parent PID {pid} perf script is not UTF-8: {error}') from error
+        if len(lines) != 14 or not script_bytes.endswith(bytes((10,))):
+            raise ObserverError(f'direct parent PID {pid} perf wrapper body differs from the trusted 14-line script')
+        shebang = lines[0]
+        if not shebang.startswith('#! '):
+            raise ObserverError(f'direct parent PID {pid} perf wrapper has no pinned Bash shebang')
+        shebang_parts = shebang[3:].split()
+        if len(shebang_parts) != 2 or shebang_parts[1] != '-e':
+            raise ObserverError(f'direct parent PID {pid} perf shebang arguments differ from the trusted wrapper')
+        interpreter_path = Path(shebang_parts[0])
+        if not interpreter_path.is_absolute() or interpreter_path.name != 'bash':
+            raise ObserverError(f'direct parent PID {pid} perf shebang does not name absolute Bash')
+        store_bin_pattern = re.compile(r'/nix/store/[a-z0-9]{32}-[A-Za-z0-9+._?=-]+/bin\Z')
+
+        def store_bin_from_assignment(line):
+            prefix, suffix = "PATH='", "'$PATH"
+            if not line.startswith(prefix) or not line.endswith(suffix):
+                raise ObserverError(f'direct parent PID {pid} perf wrapper has an unexpected PATH assignment')
+            value = line[len(prefix):-len(suffix)]
+            if store_bin_pattern.fullmatch(value) is None:
+                raise ObserverError(f'direct parent PID {pid} perf wrapper has a non-store PATH directory')
+            path = Path(value)
+            if path.resolve(strict=True) != path or not path.is_dir():
+                raise ObserverError(f'direct parent PID {pid} perf wrapper PATH directory is not canonical')
+            return value
+
+        python_bin = store_bin_from_assignment(lines[3])
+        binutils_bin = store_bin_from_assignment(lines[9])
+        try:
+            interpreter_resolved = interpreter_path.resolve(strict=True)
+            interpreter_info = interpreter_resolved.stat()
+            wrapper_path = script_path.with_name('.perf-wrapped')
+            wrapper_resolved = wrapper_path.resolve(strict=True)
+            wrapper_info = wrapper_resolved.stat()
+        except OSError as error:
+            raise ObserverError(f'direct parent PID {pid} perf wrapper dependency is unavailable: {error}') from error
+        if (interpreter_resolved.parent.name != 'bin'
+                or Path('/nix/store') not in interpreter_resolved.parents
+                or not stat.S_ISREG(interpreter_info.st_mode)
+                or not os.access(interpreter_resolved, os.X_OK)
+                or wrapper_resolved != wrapper_path
+                or Path('/nix/store') not in wrapper_resolved.parents
+                or wrapper_resolved.parent != script_path.parent
+                or not stat.S_ISREG(wrapper_info.st_mode)
+                or not os.access(wrapper_resolved, os.X_OK)):
+            raise ObserverError(f'direct parent PID {pid} perf shebang/wrapper target is not canonical')
+        expected_lines = [
+            '#! ' + shebang_parts[0] + ' -e',
+            "PATH=${PATH:+':'$PATH':'}",
+            "PATH=${PATH/':''" + python_bin + "'':'/':'}",
+            "PATH='" + python_bin + "'$PATH",
+            "PATH=${PATH#':'}",
+            "PATH=${PATH%':'}",
+            'export PATH',
+            "PATH=${PATH:+':'$PATH':'}",
+            "PATH=${PATH/':''" + binutils_bin + "'':'/':'}",
+            "PATH='" + binutils_bin + "'$PATH",
+            "PATH=${PATH#':'}",
+            "PATH=${PATH%':'}",
+            'export PATH',
+            'exec -a "$0" "' + str(wrapper_resolved) + '"  "$@" ',
+        ]
+        if lines != expected_lines or script_bytes != ('\n'.join(expected_lines) + '\n').encode():
+            raise ObserverError(f'direct parent PID {pid} perf wrapper body is not the trusted PATH-plus-exec form')
+        return {
+            'argv0': argv0, 'argv0_resolved_path': str(script_path),
+            'argv0_device': script_info.st_dev, 'argv0_inode': script_info.st_ino,
+            'perf_script_path': str(script_path),
+            'perf_script_sha256': hashlib.sha256(script_bytes).hexdigest(),
+            'perf_script_device': script_info.st_dev, 'perf_script_inode': script_info.st_ino,
+            'perf_shebang': shebang,
+            'perf_interpreter_path': str(interpreter_resolved),
+            'perf_interpreter_sha256': sha256_file(interpreter_resolved),
+            'perf_interpreter_device': interpreter_info.st_dev,
+            'perf_interpreter_inode': interpreter_info.st_ino,
+            'perf_wrapper_path': str(wrapper_resolved),
+            'perf_wrapper_sha256': sha256_file(wrapper_resolved),
+            'perf_wrapper_device': wrapper_info.st_dev, 'perf_wrapper_inode': wrapper_info.st_ino,
+        }
+
