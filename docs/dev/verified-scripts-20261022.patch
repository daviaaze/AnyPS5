+def verify_workload_phases(run_dir, target):
+    path = run_dir / 'workload-phases.jsonl'
+    info = path.lstat()
+    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or info.st_size > 4096:
+        raise RuntimeError('workload phase evidence is not a bounded owned regular file')
+    events = []
+    for line in path.read_text().splitlines():
+        fields = line.split()
+        if len(fields) != 3:
+            raise RuntimeError('workload phase event is malformed')
+        name, tid_text, time_text = fields
+        if name not in ('initial_cpu', 'blocked', 'late_cpu'):
+            raise RuntimeError(f'unknown workload phase: {name}')
+        events.append({'phase': name, 'tid': int(tid_text), 'monotonic_ns': int(time_text)})
+    if [event['phase'] for event in events] != ['initial_cpu', 'blocked', 'late_cpu']:
+        raise RuntimeError('workload did not record the required ordered CPU/block/late-CPU phases')
+    tids = {event['tid'] for event in events}
+    times = [event['monotonic_ns'] for event in events]
+    if len(tids) != 1 or next(iter(tids)) <= 0 or times != sorted(times) or len(set(times)) != 3:
+        raise RuntimeError('workload phases do not have one stable worker TID and ordered monotonic timestamps')
+    worker_tid = next(iter(tids))
+    resources_path = run_dir / 'resources.jsonl'
+    resource_info = resources_path.lstat()
+    if (not stat.S_ISREG(resource_info.st_mode) or resource_info.st_uid != os.geteuid()
+            or resource_info.st_size > 8 * 1024 * 1024):
+        raise RuntimeError('resource snapshots exceed the bounded owned fixture evidence limit')
+    blocked_observations = []
+    for line in resources_path.read_text().splitlines():
+        snapshot = json.loads(line)
+        if snapshot.get('pid') != target:
+            raise RuntimeError('resource snapshot names a different fixture target')
+        pair = snapshot.get('snapshot_start')
+        stamp = pair.get('monotonic_ns') if isinstance(pair, dict) else None
+        if type(stamp) is not int or not times[1] <= stamp <= times[2]:
+            continue
+        threads = snapshot.get('threads', {}).get('items', [])
+        for thread in threads:
+            wchan = thread.get('wchan')
+            if (thread.get('tid') == worker_tid and thread.get('availability') == 'available'
+                    and thread.get('state') in ('S', 'D')
+                    and isinstance(wchan, dict) and wchan.get('availability') == 'available'
+                    and isinstance(wchan.get('raw'), str) and wchan['raw'] not in ('', '0')):
+                blocked_observations.append({
+                    'snapshot_monotonic_ns': stamp,
+                    'tid': worker_tid,
+                    'starttime_ticks': thread.get('starttime_ticks'),
+                    'state': thread.get('state'),
+                    'wchan': wchan['raw'],
+                })
+    if not blocked_observations:
+        raise RuntimeError('no 1-second resource snapshot saw the phase worker blocked with a readable wchan')
+    return {
+        'source': str(path), 'phases': events, 'worker_tid': worker_tid,
+        'blocked_interval_observations': blocked_observations,
+    }
+
