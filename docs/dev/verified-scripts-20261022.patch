+    *TRACE_LABEL_ENVIRONMENT, *TRACE_SLOW_IMAGE_ENVIRONMENT, *TRACE_SLOW_VULKAN_ENVIRONMENT,
+    *TRACE_CAUSAL_ENVIRONMENT,
+)
+TASKS_MAX = 256
