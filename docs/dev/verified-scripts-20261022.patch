+def wait_idle_treatment_identity(requested=False):
+    if not requested:
+        return None
+    try:
+        library_path = WAIT_IDLE_LIBRARY.resolve(strict=True)
+        if library_path != WAIT_IDLE_LIBRARY.resolve():
+            raise RuntimeError('Wait-idle preload must use its canonical reviewed library path.')
+        manifest_path = WAIT_IDLE_VERIFIED_BUILD.resolve(strict=True)
+        source_paths = {path.name: path.resolve(strict=True) for path in WAIT_IDLE_SOURCES}
+        if any(source_paths[path.name] != path.resolve() for path in WAIT_IDLE_SOURCES):
+            raise RuntimeError('Wait-idle preload must use canonical reviewed source paths.')
+        manifest = json.loads(manifest_path.read_text())
+        library_sha256 = sha256_file(library_path)
+        source_sha256 = {name: sha256_file(path) for name, path in source_paths.items()}
+        elf_sha256 = candidate_identity()['sha256']
+    except (OSError, ValueError, KeyError, TypeError) as error:
+        raise RuntimeError(f'Wait-idle preload has no valid verified-build manifest; refusing treatment: {error}') from error
+    expected = {
+        'elf_sha256': elf_sha256,
+        'library_sha256': library_sha256,
+        'source_sha256': source_sha256,
+    }
+    if (not isinstance(manifest, dict)
+            or manifest.get('native_fixture_verified') is not True
+            or any(manifest.get(key) != value for key, value in expected.items())):
+        raise RuntimeError('Wait-idle preload library/source/ELF lacks matching native proof; refusing treatment.')
+    return {'library_path': str(library_path), 'library_sha256': library_sha256,
+            'source_path': {name: str(path) for name, path in source_paths.items()},
+            'source_sha256': source_sha256, 'manifest_path': str(manifest_path),
+            'elf_sha256': elf_sha256}
