+def _busctl_call(busctl, *arguments):
+    result = subprocess.run([busctl, '--user', '--json=short', 'call', *arguments],
+                            check=True, capture_output=True, text=True, timeout=5)
+    return json.loads(result.stdout)['data'][0]
