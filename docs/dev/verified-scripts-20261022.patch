+def verify_service_drain(unit, cgroup):
+    systemctl = shutil.which('systemctl')
+    if systemctl is None:
+        raise RuntimeError('systemctl is unavailable for fixture teardown verification')
+    snapshot = launch_guard._unit_snapshot(systemctl, unit)
+    properties = snapshot.get('properties') or {}
+    inactive = (snapshot.get('query') == 'not_found'
+                or properties.get('ActiveState') in ('inactive', 'failed'))
+    group = properties.get('ControlGroup') or cgroup
+    if not isinstance(group, str) or not group:
+        raise RuntimeError('fixture teardown has no verified service cgroup')
+    group_path = Path('/sys/fs/cgroup') / group.lstrip('/')
+    try:
+        events = (group_path / 'cgroup.events').read_text()
+    except FileNotFoundError:
+        populated = not group_path.exists()
+    else:
+        fields = {parts[0]: parts[1] for line in events.splitlines()
+                  if len(parts := line.split()) >= 2}
+        if fields.get('populated') not in ('0', '1'):
+            raise RuntimeError('fixture cgroup.events has no unambiguous populated state')
+        populated = fields['populated'] == '0'
+    if not inactive or not populated:
+        raise RuntimeError('fixture unit or cgroup remained active/populated after workload exit')
+    return {'confirmed': True, 'unit_active': False, 'cgroup_populated': False,
+            'control_group': group}
