+#include "IdleDelay.hpp"
+#include <climits>
+#include <sys/syscall.h>
+
+// Compile this TU with -mgeneral-regs-only -mno-red-zone -fno-stack-protector
+// -fno-exceptions: no SIMD/FP state or libc cancellation/errno path is used.
+thread_local __attribute__((tls_model("initial-exec"))) IdleState* active_idle_state = nullptr;
+
+extern "C" __attribute__((noinline)) unsigned idle_delay(void* object) noexcept {
+    IdleState* state = active_idle_state;
+    if (!state || state->object != object) return 0;
+    const auto* stop = static_cast<const volatile unsigned char*>(object);
+    if (*stop == 1) return 2;
+    // A sleep triggers a complete original scan. At the next empty boundary,
+    // do NOT sleep again: execute the original timestamp/deadlock path once.
+    // Otherwise every sleep would permanently suppress the watchdog.
+    if (state->rescan_pending) {
+        state->rescan_pending = false;
+        return 0;
+    }
+    if (state->attempts != UINT_MAX) ++state->attempts;
+    if (state->attempts <= 32) return 0;
+    struct Duration { long seconds; long nanoseconds; } duration{
+        0, state->attempts <= 64 ? 25000L : state->attempts <= 128 ? 50000L : 100000L};
+    long result = SYS_nanosleep;
+    asm volatile("syscall"
+        : "+a"(result)
+        : "D"(&duration), "S"(nullptr)
+        : "rcx", "r11", "memory");
+    // EINTR is never retried: always return to the original scan/stop checks.
+    state->rescan_pending = true;
+    return *stop == 1 ? 2U : 1U;
+}
