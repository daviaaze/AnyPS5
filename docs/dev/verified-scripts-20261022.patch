+    for line in lines:
+        match = PERF_SAMPLE_RE.match(line)
+        if match is None:
+            continue
+        try:
+            pid, tid = int(match.group(1)), int(match.group(2))
+            timestamp_ns = int(Decimal(match.group(3)) * Decimal(1_000_000_000))
+            period = int(match.group(4))
+        except (InvalidOperation, ValueError) as error:
+            raise ObserverError(f'perf script emitted an invalid sample record: {error}') from error
+        if pid <= 1 or tid <= 0 or period <= 0:
+            raise ObserverError('perf script emitted an unsafe PID/TID or nonpositive CPU-clock period')
+        records += 1
+        period_min = period if period_min is None else min(period_min, period)
+        period_max = period if period_max is None else max(period_max, period)
+        period_sum += period
+        target_record = pid == target_pid
+        if target_record:
+            target_records += 1
+            target_time_min = timestamp_ns if target_time_min is None else min(target_time_min, timestamp_ns)
+            target_time_max = timestamp_ns if target_time_max is None else max(target_time_max, timestamp_ns)
+            thread_summary = target_thread_samples.setdefault(
+                str(tid), {'records': 0, 'window_records': 0,
+                           'monotonic_ns': {'minimum': None, 'maximum': None},
+                           'window_monotonic_ns': {'minimum': None, 'maximum': None}})
+            thread_summary['records'] += 1
+            times = thread_summary['monotonic_ns']
+            times['minimum'] = timestamp_ns if times['minimum'] is None else min(times['minimum'], timestamp_ns)
+            times['maximum'] = timestamp_ns if times['maximum'] is None else max(times['maximum'], timestamp_ns)
+        if start_ns <= timestamp_ns <= end_ns:
+            in_window += 1
+            if target_record:
+                target_in_window += 1
+                target_window_time_min = (timestamp_ns if target_window_time_min is None
+                                          else min(target_window_time_min, timestamp_ns))
+                target_window_time_max = (timestamp_ns if target_window_time_max is None
+                                          else max(target_window_time_max, timestamp_ns))
+                thread_summary['window_records'] += 1
+                times = thread_summary['window_monotonic_ns']
+                times['minimum'] = timestamp_ns if times['minimum'] is None else min(times['minimum'], timestamp_ns)
+                times['maximum'] = timestamp_ns if times['maximum'] is None else max(times['maximum'], timestamp_ns)
+    return {
+        'state': 'verified' if target_in_window > 0 else 'invalid',
+        'usable_cpu_samples': target_in_window > 0,
+        'cpu_clock_sample_records': records,
