+def wait_for_observer_ready(process, run_dir, target, unit, cgroup):
+    deadline = time.monotonic() + 10
+    while time.monotonic() < deadline:
+        if process.poll() is not None:
+            raise RuntimeError(f'fixture observer exited before READY: {process.returncode}')
+        status = read_observer_status(run_dir)
+        if status and status.get('state') == 'ready':
+            if (status.get('pid') != target or status.get('unit') != unit
+                    or status.get('cgroup') != cgroup):
+                raise RuntimeError('fixture observer READY identity differs from the pinned target')
+            return status
+        if status and status.get('state') in ('failed', 'error'):
+            raise RuntimeError(f"fixture observer startup failed: {status.get('detail')}")
+        time.sleep(0.05)
+    raise RuntimeError('fixture observer did not publish READY before the bounded startup deadline')
