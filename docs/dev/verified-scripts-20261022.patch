new file mode 100755
index 000000000..c20149560
--- /dev/null
+++ b/stage-runtime-libraries.py
@@ -0,0 +1,220 @@
+#!/usr/bin/env python3
+"""Publish a verified local library snapshot without launching a game."""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import stat
+import sys
+import tempfile
+import time
+import uuid
+
+import native_launch_guard as guard
+
+ROOT = Path(__file__).resolve().parent
+
+
+def digest(path):
+    h = hashlib.sha256()
+    with path.open('rb') as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b''):
+            h.update(block)
+    return h.hexdigest()
+
+
+def snapshot(root):
+    result = {}
+    for directory, dirs, files in os.walk(root, followlinks=False):
+        for name in sorted(dirs + files):
+            path = Path(directory) / name
+            mode = path.lstat().st_mode
+            if stat.S_ISLNK(mode):
+                raise RuntimeError(f'Symlinks are not accepted in library snapshots: {path}')
+            if stat.S_ISDIR(mode):
+                continue
+            if not stat.S_ISREG(mode):
+                raise RuntimeError(f'Nonregular library entry: {path}')
+            rel = path.relative_to(root).as_posix()
+            if rel == 'SHA256SUMS':
+                continue
+            if any(c in rel for c in '\n\r\\'):
+                raise RuntimeError(f'Unsupported checksum filename: {rel!r}')
+            before = path.stat()
+            value = digest(path)
+            after = path.stat()
+            if (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns,
+                    before.st_ctime_ns) != (after.st_dev, after.st_ino, after.st_size,
+                                           after.st_mtime_ns, after.st_ctime_ns):
+                raise RuntimeError(f'Source changed while hashing: {path}')
+            result[rel] = {'sha256': value, 'mode': stat.S_IMODE(mode),
+                           'size': after.st_size}
+    if not result:
+        raise RuntimeError(f'Empty library tree: {root}')
+    return dict(sorted(result.items()))
+
+
+def sums_bytes(files):
+    return ''.join(f'{item["sha256"]}  {name}\n' for name, item in files.items()).encode()
+
+
+def verify_package(package, files, sums, content_hash):
+    if package.is_symlink() or not package.is_dir():
+        raise RuntimeError(f'Unsafe package directory: {package}')
+    libs = package / 'libs'
+    if libs.is_symlink() or snapshot(libs) != files:
+        raise RuntimeError(f'Package library snapshot mismatch: {package}')
+    checksum = libs / 'SHA256SUMS'
+    manifest_path = package / 'manifest.json'
+    if checksum.is_symlink() or manifest_path.is_symlink():
+        raise RuntimeError('Package metadata must not be symlinks')
+    if checksum.read_bytes() != sums:
+        raise RuntimeError('Package checksum list mismatch')
+    manifest = json.loads(manifest_path.read_text())
+    for key, value in {'schema': 'anyps5-runtime-library-set/v1',
+                       'content_sha256': content_hash, 'file_count': len(files),
+                       'sha256sums_sha256': hashlib.sha256(sums).hexdigest()}.items():
+        if manifest.get(key) != value:
+            raise RuntimeError(f'Package manifest mismatch: {key}')
+    if not isinstance(manifest.get('source'), str) or not isinstance(manifest.get('rollback_target'), str):
+        raise RuntimeError('Package provenance missing')
+    return manifest
+
+
+def save_receipt(path, record):
+    temporary = path.with_name(path.name + '.tmp-' + uuid.uuid4().hex)
+    with temporary.open('x') as stream:
+        json.dump(record, stream, indent=2, sort_keys=True)
+        stream.write('\n')
+        stream.flush()
+        os.fsync(stream.fileno())
+    os.replace(temporary, path)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--source', type=Path, default=ROOT / 'AnyPS5-pad-ack/build-padack/core/libs/libs')
+    parser.add_argument('--runtime', type=Path, default=ROOT / 'DemonSouls-candidate')
+    parser.add_argument('--evidence', type=Path, required=True, help='New JSON receipt path (never overwrite an existing receipt)')
+    args = parser.parse_args()
+    evidence = args.evidence.absolute()
+    evidence.parent.mkdir(parents=True, exist_ok=True)
+    # Reserve only a new receipt, so a failure cannot overwrite prior evidence.
+    with evidence.open('x') as stream:
+        stream.write('{}\n')
+    record = {'schema': 'anyps5-runtime-library-stage/v1', 'status': 'started',
+              'started_at': time.time(), 'activated': False}
+    lease = None
+    identity = None
+    failed = False
+    try:
+        source = args.source.resolve(strict=True)
+        runtime = args.runtime.resolve(strict=True)
+        if not source.is_dir() or not runtime.is_dir():
+            raise RuntimeError('Source and runtime must be directories')
+        link = runtime / 'libs'
+        if not link.is_symlink():
+            raise RuntimeError('Runtime libs must already be a symlink')
+        previous_raw = os.readlink(link)
+        previous = link.resolve(strict=True)
+        if not previous.is_dir():
+            raise RuntimeError('Previous runtime libraries are not a directory')
+        record.update(source=str(source), runtime=str(runtime),
+                      previous_raw_target=previous_raw, previous_resolved_target=str(previous))
+        identity = guard.launch_identity(runtime / 'app.elf', False)
+        record['identity'] = identity
+        lease = guard.acquire_launch('deployment', '', identity, profile_name='bounded', runtime_seconds=1)
+        record['previous_owner_drain'] = lease.record['previous_owner_drain']
+        files = snapshot(source)
+        sums = sums_bytes(files)
+        content_hash = hashlib.sha256(sums).hexdigest()
+        record.update(files=files, content_sha256=content_hash,
+                      sha256sums_sha256=hashlib.sha256(sums).hexdigest(), file_count=len(files))
+        packages = ROOT / 'runtime-libraries'
+        if packages.is_symlink():
+            raise RuntimeError('Package root must not be a symlink')
+        packages.mkdir(exist_ok=True)
+        package = packages / ('overnight-' + content_hash[:20])
+        stage = Path(tempfile.mkdtemp(prefix='.stage-overnight-', dir=packages))
+        record.update(staging_path=str(stage), package=str(package))
+        libs = stage / 'libs'
+        libs.mkdir()
+        for rel, entry in files.items():
+            origin = source / rel
+            destination = libs / rel
+            destination.parent.mkdir(parents=True, exist_ok=True)
+            # O_NOFOLLOW also rejects a file swapped to a symlink after inventory.
+            fd = os.open(origin, os.O_RDONLY | os.O_NOFOLLOW)
+            with os.fdopen(fd, 'rb') as src, destination.open('xb') as dst:
+                if not stat.S_ISREG(os.fstat(src.fileno()).st_mode):
+                    raise RuntimeError(f'Source ceased being regular: {origin}')
+                for block in iter(lambda: src.read(1024 * 1024), b''):
+                    dst.write(block)
+                dst.flush()
+                os.fsync(dst.fileno())
+                os.fchmod(dst.fileno(), entry['mode'])
+        (libs / 'SHA256SUMS').write_bytes(sums)
+        manifest = {'schema': 'anyps5-runtime-library-set/v1', 'content_sha256': content_hash,
+                    'source': str(source), 'rollback_target': str(previous),
+                    'file_count': len(files), 'sha256sums_sha256': hashlib.sha256(sums).hexdigest()}
+        (stage / 'manifest.json').write_text(json.dumps(manifest, sort_keys=True) + '\n')
+        verify_package(stage, files, sums, content_hash)
+        if snapshot(source) != files:
+            raise RuntimeError('Source changed during staging')
+        if os.path.lexists(package):
+            record['reused_existing_package'] = True
+            record['package_manifest'] = verify_package(package, files, sums, content_hash)
+        else:
+            # All cooperating publishers hold the same exclusive guard lease.
+            os.rename(stage, package)
+            record['reused_existing_package'] = False
+            record['package_manifest'] = manifest
+        record['package_verified_at'] = time.time()
+        if guard.launch_identity(runtime / 'app.elf', False) != identity:
+            raise RuntimeError('Candidate identity changed during staging')
+        if snapshot(source) != files:
+            raise RuntimeError('Source changed before activation')
+        if not link.is_symlink() or os.readlink(link) != previous_raw or link.resolve(strict=True) != previous:
+            raise RuntimeError('Runtime library target changed during staging')
+        record['pre_publish_candidate_processes'] = guard.candidate_processes(identity)
+        if record['pre_publish_candidate_processes']:
+            raise RuntimeError('Candidate process appeared before activation')
+        save_receipt(evidence, record)
+        temporary_link = runtime / ('.libs-stage-' + uuid.uuid4().hex)
+        temporary_link.symlink_to(os.path.relpath(package / 'libs', runtime), target_is_directory=True)
+        os.replace(temporary_link, link)
+        record.update(activated=True, activated_at=time.time(), activated_target=str(package / 'libs'))
+        if not link.is_symlink() or link.resolve(strict=True) != package / 'libs':
+            raise RuntimeError('Activated target verification failed')
+        verify_package(package, files, sums, content_hash)
+        record.update(status='complete', verified_at=time.time())
+    except Exception as error:
+        failed = True
+        record.update(status='failed', error=f'{type(error).__name__}: {error}')
+    finally:
+        if lease is not None:
+            try:
+                matches = guard.candidate_processes(identity)
+                teardown = {'confirmed': not matches, 'candidate_processes': matches,
+                            'reason': 'deployment helper complete; no game launched',
+                            'unit': {'query': 'not_found', 'properties': {}},
+                            'cgroup': {'exists': False, 'populated': False}}
+                record['teardown'] = teardown
+                lease.finish(teardown)
+                if matches:
+                    failed = True
+                    record.update(status='failed', teardown_error='Candidate process exists after deployment')
+            except Exception as error:
+                failed = True
+                record.update(status='failed', teardown_error=f'{type(error).__name__}: {error}')
+            finally:
+                lease.close()
+        record['finished_at'] = time.time()
+        save_receipt(evidence, record)
+    print(json.dumps({'status': record['status'], 'receipt': str(evidence), 'activated': record['activated']}))
+    return 1 if failed else 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
