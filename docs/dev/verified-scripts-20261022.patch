+            raise ObserverError('perf script output exceeds the bounded 64 MiB verification limit')
+        try:
+            final_info = split_path.lstat()
+            final_digest = sha256_file(split_path)
+            confirmed_info = split_path.lstat()
+        except OSError as error:
+            raise ObserverError(f'cannot reverify finalized perf split after parsing: {error}') from error
+        if ((final_info.st_dev, final_info.st_ino, final_info.st_size, final_info.st_mtime_ns)
+                != (initial_info.st_dev, initial_info.st_ino,
+                    initial_info.st_size, initial_info.st_mtime_ns)
+                or (confirmed_info.st_dev, confirmed_info.st_ino,
+                    confirmed_info.st_size, confirmed_info.st_mtime_ns)
+                != (initial_info.st_dev, initial_info.st_ino,
+                    initial_info.st_size, initial_info.st_mtime_ns)
+                or final_digest != initial_digest):
+            raise ObserverError('finalized perf split changed while its sample records were parsed')
+        sample_counts = parse_perf_sample_lines(
+            result.stdout.splitlines(), self.identity.pid, start, end)
+        verification = {
+            'state': sample_counts['state'],
+            'usable_cpu_samples': sample_counts['usable_cpu_samples'],
+            'coverage_status': self.window['coverage_status'],
+            'requested_seconds': requested_seconds,
+            'actual_duration_ns': actual_duration_ns,
+            'disabled_reason': self.window.get('disabled_reason'),
+            'enable_disable_ack_interval_ns': end - ack_start,
+            'parser': 'perf script',
+            'parser_format': '--ns -F pid,tid,time,event,period',
+            'perf_cli_path': perf_cli,
+            'perf_data_path': split['path'],
+            'perf_data_sha256': split.get('sha256'),
+            'perf_script_returncode': result.returncode,
+            'cpu_clock_sample_records': sample_counts['cpu_clock_sample_records'],
+            'target_cpu_clock_sample_records': sample_counts['target_cpu_clock_sample_records'],
+            'sample_records_in_window': sample_counts['sample_records_in_window'],
+            'target_sample_records_in_window': sample_counts['target_sample_records_in_window'],
+            'target_sample_monotonic_ns': sample_counts['target_sample_monotonic_ns'],
+            'target_sample_in_window_monotonic_ns':
+                sample_counts['target_sample_in_window_monotonic_ns'],
+            'target_thread_samples': sample_counts['target_thread_samples'],
+            'observed_period_ns': sample_counts['observed_period_ns'],
+            'window_start_monotonic_ns': start,
+            'window_end_monotonic_ns': end,
+            'stderr': result.stderr[-4096:],
+            'verified_at': clock_pair(),
+        }
+        if not verification['usable_cpu_samples']:
+            raise ObserverError('parsed perf output contains no nonzero target CPU samples inside the enabled window')
+        return verification
+
+    def _verify_sample_target_executable(self):
+        process = Path('/proc') / str(self.identity.pid)
+        if self.fixture:
+            startup = self.identity.verification
+            expected_path = self.identity.executable_path.resolve(strict=True)
+            expected_info = expected_path.stat()
+            expected_device, expected_inode = expected_info.st_dev, expected_info.st_ino
+            expected_argv0 = (str(expected_path),)
+            expected_comm = expected_path.name
+            startup_methods = {'manifest+pid-file', 'proc-exe+manifest+pid-file'}
+            manifest_hash = self.identity.manifest['workload']['sha256']
+        else:
+            startup = self.identity.process_identity_verification
+            expected = self.identity.record['identity'].get('elf')
+            if not isinstance(expected, dict) or not isinstance(expected.get('path'), str):
+                raise ObserverError('worker result has no pinned candidate ELF identity')
+            expected_path = Path(expected['path']).resolve(strict=True)
+            expected_device, expected_inode = expected.get('device'), expected.get('inode')
+            expected_argv0 = (str(Path(expected['path'])), './app.elf')
+            expected_comm = 'app.elf'
+            startup_methods = {
+                'proc-exe+path+device-inode',
+                'cmdline+comm+effective-uid+owned-cgroup+starttime',
+            }
+            manifest_hash = None
+        try:
+            executable_path = os.readlink(process / 'exe')
+            executable_info = os.stat(process / 'exe')
+            resolved_path = Path(executable_path).resolve(strict=True)
+        except PermissionError:
+            if not isinstance(startup, dict) or startup.get('method') not in startup_methods:
+                raise ObserverError('startup executable verification cannot support /proc/exe fallback')
+            self.identity.verify_process()
+            try:
+                status = (process / 'status').read_text().splitlines()
+                uid_line = next(line for line in status if line.startswith('Uid:'))
+                effective_uid = int(uid_line.split()[2])
+                comm = (process / 'comm').read_text().strip()
+                raw_cmdline = (process / 'cmdline').read_bytes()
+            except (OSError, StopIteration, ValueError, IndexError) as error:
+                raise ObserverError(f'cannot corroborate nondumpable sampled target: {error}') from error
+            argv0 = os.fsdecode(raw_cmdline.split(bytes(1), 1)[0])
+            current = self.identity.verify_process()
+            if (effective_uid != os.geteuid() or comm != expected_comm or argv0 not in expected_argv0
+                    or current['starttime_ticks'] != self.identity.starttime_ticks):
+                raise ObserverError('current proc evidence differs from the pinned sampled target identity')
+            method = ('manifest+pidfile+current-proc-evidence/exe-unavailable'
+                      if self.fixture else 'worker-elf+current-proc-evidence/exe-unavailable')
+            return {'method': method, 'proc_exe': 'unavailable',
+                    'startup_verification': startup, 'pid': self.identity.pid,
+                    'starttime_ticks': current['starttime_ticks'], 'cgroup': self.identity.cgroup,
+                    'effective_uid': effective_uid, 'comm': comm, 'argv0': argv0}
+        except OSError as error:
+            raise ObserverError(f'cannot verify sampled target executable identity: {error}') from error
+        if (executable_path.endswith(' (deleted)') or resolved_path != expected_path
+                or (executable_info.st_dev, executable_info.st_ino)
+                != (expected_device, expected_inode)):
+            raise ObserverError('sampled target executable differs from its pinned native/fixture identity')
+        method = ('proc-exe+manifest+pid-file' if self.fixture
+                  else 'proc-exe+path+device-inode')
+        return {'method': method, 'path': executable_path, 'device': executable_info.st_dev,
+                'inode': executable_info.st_ino, 'manifest_sha256': manifest_hash}
+
+    def _finalize_perf_output(self, finalization):
+        if self.perf_signal_attempted:
+            raise ObserverError('SIGUSR2 perf finalization was already attempted for this sample')
+        self.perf_signal_attempted = True
+        if not hasattr(os, 'pidfd_open') or not hasattr(signal, 'pidfd_send_signal'):
+            raise ObserverError('safe pidfd SIGUSR2 support is unavailable; refusing a PID signal')
+        self.identity.verify_owned_unit(require_active=True)
+        candidate = self.identity.verify_process()
+        target_executable = self._verify_sample_target_executable()
+        candidate = self.identity.verify_process()
+        finalization['target_executable'] = target_executable
+        debugger = None
+        if self.identity.debug_segv:
+            debugger = self._read_debugger_parent(candidate['ppid'])
+            perf_pid = debugger['ppid']
+            finalization['debugger_parent'] = debugger
+        else:
+            perf_pid = candidate['ppid']
+        if perf_pid <= 1:
+            raise ObserverError('candidate has no safe controlled perf-record ancestry')
+        finalization['perf_pid'] = perf_pid
+        existing_names = {path.name for path in self.run_dir.iterdir()
+                          if path.name.startswith(self.identity.paths['perf_data'].name + '.')}
+        if existing_names:
+            raise ObserverError('perf split output exists before the one permitted SIGUSR2 switch')
+        try:
+            pidfd = os.pidfd_open(perf_pid, 0)
+        except OSError as error:
+            raise ObserverError(f'cannot pin direct perf parent PID {perf_pid}: {error}') from error
+        try:
+            candidate = self.identity.verify_process()
+            if self.identity.debug_segv:
+                current_debugger = self._read_debugger_parent(candidate['ppid'])
+                if (candidate['ppid'] != debugger['pid']
+                        or current_debugger['starttime_ticks'] != debugger['starttime_ticks']
+                        or current_debugger['ppid'] != perf_pid):
+                    raise ObserverError('candidate GDB→perf parent chain changed before perf SIGUSR2')
+            elif candidate['ppid'] != perf_pid:
+                raise ObserverError('candidate direct parent changed before perf SIGUSR2')
+            perf = self._read_perf_parent(perf_pid)
+            candidate = self.identity.verify_process()
+            current = proc_stat(perf_pid)
+            if self.identity.debug_segv:
+                current_debugger = self._read_debugger_parent(candidate['ppid'])
+                parent_chain_valid = (
+                    candidate['ppid'] == debugger['pid']
+                    and current_debugger['starttime_ticks'] == debugger['starttime_ticks']
+                    and current_debugger['ppid'] == perf_pid
+                )
+            else:
+                parent_chain_valid = candidate['ppid'] == perf_pid
+            if (not parent_chain_valid or current['starttime_ticks'] != perf['starttime_ticks']
+                    or proc_cgroup(perf_pid) != self.identity.cgroup):
+                raise ObserverError('controlled perf parent or debugger chain changed before SIGUSR2')
+            finalization.update({
+                'perf_starttime_ticks': perf['starttime_ticks'],
+                'perf_executable_path': perf['executable_path'],
+                'perf_executable_device': perf['executable_device'],
+                'perf_executable_inode': perf['executable_inode'],
+                'perf_proc_exe': perf['proc_exe'],
+                'perf_proc_exe_status': perf['proc_exe_status'],
+                'perf_argv0': perf['argv0'],
+                'perf_argv0_resolved_path': perf['argv0_resolved_path'],
+                'perf_argv0_device': perf['argv0_device'],
+                'perf_argv0_inode': perf['argv0_inode'],
+                'perf_script_path': perf['perf_script_path'],
+                'perf_script_sha256': perf['perf_script_sha256'],
+                'perf_script_device': perf['perf_script_device'],
+                'perf_script_inode': perf['perf_script_inode'],
+                'perf_shebang': perf['perf_shebang'],
+                'perf_interpreter_path': perf['perf_interpreter_path'],
+                'perf_interpreter_sha256': perf['perf_interpreter_sha256'],
+                'perf_interpreter_device': perf['perf_interpreter_device'],
+                'perf_interpreter_inode': perf['perf_interpreter_inode'],
+                'perf_wrapper_path': perf['perf_wrapper_path'],
+                'perf_wrapper_sha256': perf['perf_wrapper_sha256'],
+                'perf_wrapper_device': perf['perf_wrapper_device'],
+                'perf_wrapper_inode': perf['perf_wrapper_inode'],
+                'perf_effective_uid': perf['effective_uid'], 'perf_comm': perf['comm'],
+                'perf_argv': perf['argv'], 'perf_argv_sha256': perf['argv_sha256'],
+                'perf_cgroup': perf['cgroup'], 'process_proof': perf,
+                'final_perf_cli_path': perf['perf_script_path'],
+                'final_perf_cli_path_status': (
+                    'argv0-script+wrapper-ELF+proc-exe-verified'
+                    if perf['proc_exe_status'] == 'wrapper-verified'
+                    else 'argv0-script+wrapper-hash;proc-exe-unavailable'),
+            })
+            finalization['signal_intent'] = {
+                'signal': 'SIGUSR2', 'target_pid': perf_pid,
+                'target_starttime_ticks': perf['starttime_ticks'],
+                'target_executable_path': perf['executable_path'],
+                'target_argv0': perf['argv0'],
+                'target_argv0_resolved_path': perf['argv0_resolved_path'],
+                'target_perf_script_path': perf['perf_script_path'],
+                'target_perf_script_sha256': perf['perf_script_sha256'],
+                'target_interpreter_path': perf['perf_interpreter_path'],
+                'target_interpreter_sha256': perf['perf_interpreter_sha256'],
+                'target_wrapper_path': perf['perf_wrapper_path'],
+                'target_wrapper_sha256': perf['perf_wrapper_sha256'],
+                'target_argv_sha256': perf['argv_sha256'], 'requested_at': clock_pair()}
+            finalization['state'] = 'signal_pending'
+            self.sample_record('perf_signal_intent', window=self.window)
+            self.write_status('perf_signal_intent',
+                              'verified controlled perf-record ancestry; sending one SIGUSR2',
+                              sample_window=self.window)
+            try:
+                signal.pidfd_send_signal(pidfd, signal.SIGUSR2, None, 0)
+            except OSError as error:
+                finalization['signal_ack_status'] = 'syscall_failed'
+                raise ObserverError(f'SIGUSR2 to verified perf parent PID {perf_pid} failed: {error}') from error
+            finalization['signal_ack_status'] = (
+                'pidfd_send_signal_returned; kernel delivery ACK unavailable')
+            finalization['signal_sent_at'] = clock_pair()
+        finally:
+            os.close(pidfd)
+        try:
+            self.identity.verify_process()
+            finalization['workload_active_after_signal'] = True
+        except FileNotFoundError:
+            finalization['workload_active_after_signal'] = False
+        finalization['state'] = 'waiting_for_split'
+        self.sample_record('perf_signal_sent', window=self.window)
+        self.write_status('perf_signal_sent',
+                          'SIGUSR2 syscall returned; waiting for the finalized perf split',
+                          sample_window=self.window)
+        finalization['new_finalized_paths'] = [self._wait_for_perf_split(existing_names)]
+        finalization['state'] = 'finalized'
+        try:
+            self.identity.verify_process()
+            finalization['workload_active_after_finalization'] = True
+        except FileNotFoundError:
+            finalization['workload_active_after_finalization'] = False
+
+    def disable_sample(self, reason, *, allow_process_gone=False):
+        if not self.window or self.window.get('disable') is not None or self.disable_attempted:
+            return None
+        self.disable_attempted = True
+        disable = self.command('disable', allow_process_gone=allow_process_gone)
+        self.window['disable'] = disable
+        self.window['disabled_reason'] = reason
+        finalization = {
+            'state': 'disable_acknowledged', 'target_pid': self.identity.pid,
+            'target_starttime_ticks': self.identity.starttime_ticks,
+            'target_executable': None, 'perf_pid': None, 'perf_starttime_ticks': None,
+            'perf_executable_path': None, 'perf_executable_device': None,
+            'perf_executable_inode': None, 'perf_proc_exe': 'unknown',
+            'perf_proc_exe_status': 'unknown', 'perf_argv0': None,
+            'perf_argv0_resolved_path': None, 'perf_argv0_device': None,
+            'perf_argv0_inode': None, 'perf_script_path': None,
+            'perf_script_sha256': None, 'perf_script_device': None,
+            'perf_script_inode': None, 'perf_shebang': None,
+            'perf_interpreter_path': None, 'perf_interpreter_sha256': None,
+            'perf_interpreter_device': None, 'perf_interpreter_inode': None,
+            'perf_wrapper_path': None, 'perf_wrapper_sha256': None,
+            'perf_wrapper_device': None, 'perf_wrapper_inode': None,
+            'perf_argv_sha256': None, 'final_perf_cli_path': None,
+            'final_perf_cli_path_status': 'unknown', 'signal_intent': None,
+            'signal_ack_status': 'not_sent', 'new_finalized_paths': [],
+        }
+        self.window['perf_finalization'] = finalization
+        self.window['state'] = 'disabled_pending_finalization'
+        self.sample_record('disable_acknowledged', reason=reason, window=self.window)
+        self.write_status('disable_acknowledged',
+                          'real perf disable ACK observed; verifying its direct recorder parent',
+                          sample_window=self.window)
+        try:
+            self._finalize_perf_output(finalization)
+            finalization['sample_data_verification'] = self._verify_perf_samples(finalization)
+        except (OSError, ObserverError, ValueError) as error:
+            finalization['state'] = 'incomplete'
+            finalization['failure'] = {
+                'type': type(error).__name__, 'detail': str(error), 'time': clock_pair()}
+            self.window['state'] = 'incomplete'
+            self.sample_record('perf_finalization_incomplete', reason=reason, window=self.window)
+            self.write_status('perf_finalization_incomplete', str(error), sample_window=self.window)
+            raise
+        self.window['state'] = 'disabled'
+        self.sample_record('disabled', reason=reason, window=self.window)
+        self.write_status('sample_finalized',
+                          'perf split finalized and parsed with nonzero target CPU samples inside the requested window',
+                          sample_window=self.window)
+        return disable
+
+    def finish_sample(self, reason='controller_shutdown'):
+        with self.window_lock:
+            if self.window is None:
+                raise ObserverError('no activated perf window exists to finish')
+            if self.window.get('disable') is None:
+                self.disable_sample(reason)
+            finalization = self.window.get('perf_finalization')
+            verification = finalization.get('sample_data_verification') if isinstance(finalization, dict) else None
+            if (not isinstance(finalization, dict) or finalization.get('state') != 'finalized'
+                    or not isinstance(verification, dict)
+                    or verification.get('usable_cpu_samples') is not True):
+                raise ObserverError('perf disable/finalization did not produce verified nonzero target CPU samples')
+            return {'ready': True, 'sample_window': self.window}
+
+
+    def handle_marker(self, request, observer_received):
+        if self.fixture:
+            raise ObserverError('scene markers are disabled in fixture mode; use workload phase events')
+        label = request.get('name')
+        if not isinstance(label, str) or label not in SCENE_MARKERS:
+            raise ObserverError(f'marker name must be one of {", ".join(sorted(SCENE_MARKERS))}')
+        self.identity.verify_process()
+        marker = {
+            'name': label,
+            'emitted': request.get('emitted'),
+            'observer_received': observer_received,
+            'source': 'operator_cli',
+            'pid': self.identity.pid,
+            'starttime_ticks': self.identity.starttime_ticks,
+            'unit': self.identity.unit,
+            'cgroup': self.identity.cgroup,
+            'claim_scope': 'caller label only; observer receipt does not verify scene visibility',
+        }
+        atomic_json(self.run_dir / 'markers' / f'{label}.json', marker, replace=False)
+        return {'recorded': True, 'marker': marker}
+
+    def orderly_stop(self, request, observer_received):
+        if self.fixture != (request.get('fixture') is True):
+            raise ObserverError('fixture-mode request does not match this monitor')
+        reason = request.get('reason')
+        if reason not in ('approved_early_stop', 'controller_deadline',
+                          'controller_timeout', 'controller_failure',
+                          'shutdown_interrupt', 'fixture_early_stop'):
+            raise ObserverError('orderly-stop reason is not an authorized bounded stop')
+        self.identity.verify_owned_unit(require_active=True)
+        disable_reason = 'approved_stop' if reason in ('approved_early_stop', 'fixture_early_stop') else reason
+        sample = self.finish_sample(disable_reason)
+        self.stop_request = {
+            'reason': reason,
+            'request': request.get('emitted'),
+            'observer_received': observer_received,
+            'target': {'pid': self.identity.pid,
+                       'starttime_ticks': self.identity.starttime_ticks,
+                       'unit': self.identity.unit, 'cgroup': self.identity.cgroup},
+        }
+        return {'ready': True, 'stop_request': self.stop_request,
+                'sample_window': sample['sample_window'], 'observer_will_exit': True}
+
+    def _attach_kernel_evidence(self, snapshot_record):
+        threads = snapshot_record.get('threads', {}).get('items', [])
+        prerequisites = ((self.kernel_trace_status.get('capability') or {})
+                         .get('additional_prerequisites', []))
+        reason = (self.kernel_trace_status.get('reason')
+                  or self.kernel_trace_status.get('error')
+                  or self.kernel_trace_status.get('status'))
+        blocked = [thread for thread in threads
+                   if thread.get('availability') == 'available'
+                   and thread.get('state') in ('D', 'S')]
+        cursor = self.kernel_stack_cursor
+
+        def priority(thread):
+            wchan = thread.get('wchan', {}).get('raw', '')
+            urgent = (thread['state'] == 'D'
+                      or wchan.startswith(('amdgpu', 'drm_', 'dma_fence', 'folio_wait')))
+            return (not urgent, thread['tid'] <= cursor, thread['tid'])
+
+        for thread in sorted(blocked, key=priority):
+            if self.external_kernel:
+                thread['kernel_evidence'] = {
+                    'tid': thread.get('tid'),
+                    'expected_starttime_ticks': thread.get('starttime_ticks'),
+                    'observed_state': thread.get('state'),
+                    'availability': 'not_collected_by_observer',
+                    'route': 'privileged-helper',
+                }
+                continue
+            if self.kernel_trace is None:
+                thread['kernel_evidence'] = {
+                    'tid': thread.get('tid'),
+                    'expected_starttime_ticks': thread.get('starttime_ticks'),
+                    'observed_state': thread.get('state'),
+                    'availability': 'unavailable',
+                    'reason': reason,
+                    'additional_prerequisites': prerequisites,
+                }
+                continue
+            try:
+                thread['kernel_evidence'] = self.kernel_trace.sample_thread(
+                    thread['tid'], thread['starttime_ticks'], thread['state'])
+            except Exception as error:
+                thread['kernel_evidence'] = {
+                    'tid': thread.get('tid'),
+                    'expected_starttime_ticks': thread.get('starttime_ticks'),
+                    'availability': 'unavailable',
+                    'error': f'{type(error).__name__}: {error}',
+                }
+            reservation = thread['kernel_evidence'].get('budget', {}).get('reservation', {})
+            if reservation.get('availability') == 'available':
+                self.kernel_stack_cursor = thread['tid']
+        snapshot_record['kernel_trace'] = {
+            'schema': self.kernel_trace_status.get('schema'),
+            'status': self.kernel_trace_status.get('status'),
+            'reason': reason,
+            'route': 'privileged-helper' if self.external_kernel else 'observer-kernel-session',
+            'root_cause_coverage_complete': False,
+        }
+
+    def serve_one(self):
+        readable, _, _ = select.select([self.server], [], [], 0)
+        if not readable:
+            return
+        conn, _ = self.server.accept()
+        with conn:
+            conn.settimeout(2)
+            chunks = bytearray()
+            while b'\n' not in chunks and len(chunks) <= 4096:
+                part = conn.recv(4096)
+                if not part:
+                    break
+                chunks.extend(part)
+            if len(chunks) > 4096:
+                raise ObserverError('observer control request exceeded 4096 bytes')
+            line, sep, trailing = bytes(chunks).partition(b'\n')
+            if not sep or trailing.strip():
+                raise ObserverError('malformed observer control request')
+            try:
+                request = json.loads(line)
+            except json.JSONDecodeError as error:
+                raise ObserverError(f'malformed observer control JSON: {error}') from error
+            if not isinstance(request, dict):
+                raise ObserverError('observer control request must be an object')
+            received = clock_pair()
+            if request.get('fixture', False) is not self.fixture:
+                raise ObserverError('request fixture mode does not match the monitor mode')
+            if request.get('command') == 'start-sample':
+                result = self.start_sample(request, received)
+            elif request.get('command') == 'orderly-stop':
+                result = self.orderly_stop(request, received)
+            elif request.get('command') == 'mark':
+                result = self.handle_marker(request, received)
+            else:
+                raise ObserverError('unknown observer control request')
+            conn.sendall((json.dumps({'ok': True, 'observer_received': received, **result},
+                                     sort_keys=True, separators=(',', ':')) + '\n').encode())
+
+    def stop_owned_unit(self, reason):
+        # Never signal a PID directly. Only stop the exact still-owned unit after
+        # re-reading worker/lease records and proving the same live PID remains in its cgroup.
+        outcome = {'reason': reason, 'requested': False, 'verified': False, 'time': clock_pair()}
+        try:
+            self.identity.verify_owned_unit(require_active=True)
+        except (OSError, ObserverError, ValueError) as error:
+            outcome['verification_error'] = f'{type(error).__name__}: {error}'
+            return outcome
+        outcome['verified'] = True
+        outcome['requested'] = True
+        try:
+            result = subprocess.run(['systemctl', '--user', 'stop', self.identity.unit],
+                                    capture_output=True, text=True, timeout=STOP_GRACE_SECONDS + 3,
+                                    check=False)
+            outcome.update({'returncode': result.returncode, 'stdout': result.stdout,
+                            'stderr': result.stderr, 'completed': clock_pair()})
+        except (OSError, subprocess.SubprocessError) as error:
+            outcome.update({'command_error': f'{type(error).__name__}: {error}', 'completed': clock_pair()})
+        return outcome
+
+    def _unit_active(self):
+        props = self.identity.verify_unit(require_active=False)
+        return props.get('ActiveState') == 'active'
+
+    def _verify_terminal_unit_after_process_exit(self):
+        if self.fixture:
+            if read_json_regular(self.identity.manifest_path) != self.identity.manifest:
+                raise ObserverError('fixture manifest changed after pinned process exit')
+        else:
+            record = read_json_regular(self.identity.record_path)
+            owner = read_json_regular(self.identity.owner_path)
+            profile = record.get('profile') if isinstance(record, dict) else None
+            if (record.get('identity') != self.identity.record.get('identity')
+                    or not isinstance(profile, dict)
+                    or normalize_cgroup(profile.get('cgroup')) != self.identity.cgroup
+                    or owner.get('unit') != self.identity.unit
+                    or owner.get('kind') != 'game'
+                    or owner.get('output_dir') != str(self.run_dir)
+                    or owner.get('identity') != self.identity.record.get('identity')
+                    or normalize_cgroup(owner.get('cgroup')) != self.identity.cgroup):
+                raise ObserverError('worker result or launch lease changed after pinned process exit')
+        group_path = CGROUP_ROOT / normalize_cgroup(self.identity.cgroup).lstrip('/')
+
+        try:
+            events = (group_path / 'cgroup.events').read_text()
+        except FileNotFoundError as error:
+            try:
+                group_path.stat()
+            except FileNotFoundError:
+                drained = True
+            else:
+                raise ObserverError('recorded cgroup exists but cgroup.events is unavailable') from error
+        except OSError as error:
+            raise ObserverError(f'cannot verify terminal cgroup state: {error}') from error
+        else:
+            fields = parse_key_values(events)
+            populated = fields.get('populated')
+            if populated not in (['0'], ['1']):
+                raise ObserverError('terminal cgroup.events has no unambiguous populated state')
+            drained = populated == ['0']
+
+        try:
+            props = read_properties(self.identity.unit)
+        except ObserverError as error:
+            missing_unit = f'Call failed: Unit {self.identity.unit} not loaded'
+            if missing_unit not in str(error) or not drained:
+                raise
+            try:
+                proc_stat(self.identity.pid)
+            except FileNotFoundError:
+                return {'ActiveState': 'not-found'}
+            raise ObserverError('pinned PID reappeared after its systemd unit was collected')
+        control_group = props.get('ControlGroup', '')
+        if control_group:
+            if normalize_cgroup(control_group) != self.identity.cgroup:
+                raise ObserverError('terminal systemd ControlGroup differs from the recorded cgroup')
+        elif not drained:
+            raise ObserverError('terminal systemd unit has empty ControlGroup while its recorded cgroup is populated')
+        active = props.get('ActiveState')
+        if active == 'active':
+            if not control_group or drained:
+                raise ObserverError('active terminal unit has no populated matching cgroup')
+        elif active != 'inactive' or not drained:
+            raise ObserverError('terminal unit state or cgroup drain is ambiguous')
+        return props
+
+    def run(self):
+        next_snapshot = time.monotonic()
+        next_unit_check = 0.0
+        failure = None
+        terminal_status = None
+        try:
+            if self.kernel_trace is not None:
+                try:
+                    self.kernel_trace_status = self.kernel_trace.start()
+                except Exception as error:
+                    self.kernel_trace_status = {
+                        'schema': 'causal-kernel-trace/v1', 'status': 'unavailable',
+                        'reason': 'session_start_failed',
+                        'error': f'{type(error).__name__}: {error}',
+                        'root_cause_coverage_complete': False,
+                    }
+            ready_at = clock_pair()
+            self.write_status('ready', 'monitor loop is ready; sampler remains disabled',
+                              ready_at=ready_at)
+            print('CAUSAL_OBSERVER_READY=' + json.dumps(
+                {'pid': self.identity.pid, 'unit': self.identity.unit,
+                 'cgroup': self.identity.cgroup, 'run_dir': str(self.run_dir),
+                 'socket': str(self.socket_path),
+                 'monitor_pid': os.getpid(),
+                 'monitor_starttime_ticks': self.monitor_starttime_ticks,
+                 'status': str(self.run_dir / 'causal-observer-status.json'),
+                 'mode': 'cpu_fixture' if self.fixture else 'capture24_game',
+                 'ready_at': ready_at}, sort_keys=True), flush=True)
+            while True:
+                try:
+                    self._raise_timer_failure()
+                    try:
+                        self.identity.verify_process()
+                    except FileNotFoundError as process_error:
+                        try:
+                            proc_stat(self.identity.pid)
+                        except FileNotFoundError:
+                            pass
+                        else:
+                            raise process_error
+                        had_sample = bool(self.window)
+                        with self.window_lock:
+                            if self.window and self.window.get('disable') is None:
+                                self.disable_sample('unexpected_process_exit', allow_process_gone=True)
+                            sample_finalized = bool(
+                                self.window
+                                and self.window.get('perf_finalization', {}).get('state') == 'finalized')
+                            self._raise_timer_failure()
+                        props = self._verify_terminal_unit_after_process_exit()
+                        value, self.previous_threads = snapshot_after_process_exit(
+                            self.identity, self.previous_threads)
+                        value['snapshot_number'] = self.snapshot_number + 1
+                        write_all(self.resource_fd,
+                                  (json.dumps(value, sort_keys=True, separators=(',', ':')) + '\n').encode())
+                        os.fsync(self.resource_fd)
+                        self.snapshot_number += 1
+                        terminal_status = ('process_exited_after_sample' if sample_finalized
+                                           else 'process_exited_with_incomplete_sample' if had_sample
+                                           else 'process_exited_before_sample')
+                        if props.get('ActiveState') == 'active' and not sample_finalized:
+                            terminal_status = 'process_exited_owned_unit_active'
+                        break
+                    now = time.monotonic()
+                    if now >= next_unit_check:
+                        if not self._unit_active():
+                            raise ObserverError('owned systemd unit exited while monitor was active')
+                        next_unit_check = time.monotonic() + 1.0
+                    self.serve_one()
+                    if self.stop_request is not None:
+                        terminal_status = 'stopped_after_sample'
+                        break
+                    now = time.monotonic()
+                    if now >= next_snapshot:
+                        value, self.previous_threads = snapshot(self.identity, self.previous_threads)
+                        self._attach_kernel_evidence(value)
+                        value['snapshot_number'] = self.snapshot_number + 1
+                        write_all(self.resource_fd,
+                                  (json.dumps(value, sort_keys=True, separators=(',', ':')) + '\n').encode())
+                        os.fsync(self.resource_fd)
+                        self.snapshot_number += 1
+                        next_snapshot = time.monotonic() + 1.0
+                    timeout = min(0.1, max(0.0, min(next_snapshot, next_unit_check) - time.monotonic()))
+                    select.select([self.server], [], [], timeout)
+                except (OSError, ObserverError, ValueError, subprocess.SubprocessError) as error:
+                    failure = error
+                    try:
+                        self.log_error('monitor', error)
+                    except OSError as persist_error:
+                        print(f'causal-observer: unable to persist monitor error: {persist_error}',
+                              file=sys.stderr, flush=True)
+                    break
+        except KeyboardInterrupt as error:
+            failure = error
+            try:
+                self.log_error('interrupted', error)
+            except OSError as persist_error:
+                print(f'causal-observer: unable to persist interruption: {persist_error}',
+                      file=sys.stderr, flush=True)
+        except (OSError, ObserverError, ValueError, subprocess.SubprocessError) as error:
+            failure = error
+            try:
+                self.log_error('monitor_startup', error)
+            except OSError as persist_error:
+                print(f'causal-observer: unable to persist monitor startup error: {persist_error}',
+                      file=sys.stderr, flush=True)
+        finally:
+            try:
+                if self.disable_timer is not None:
+                    self.disable_timer.cancel()
+                    if self.disable_timer.is_alive():
+                        self.disable_timer.join()
+                if (self.window and self.window.get('disable') is None
+                        and not self.disable_attempted and not self.timer_failure_event.is_set()):
+                    try:
+                        with self.window_lock:
+                            self.disable_sample('monitor_shutdown')
+                    except (OSError, ObserverError, ValueError, subprocess.SubprocessError) as error:
+                        if failure is None:
+                            failure = error
+                        try:
+                            self.log_error('disable_during_shutdown', error)
+                        except OSError as persist_error:
+                            print(f'causal-observer: unable to persist disable error: {persist_error}',
+                                  file=sys.stderr, flush=True)
+                if self.kernel_trace is not None:
+                    try:
+                        self.kernel_trace_status = self.kernel_trace.stop(
+                            reason='monitor_failed' if failure is not None else
+                            'approved_stop' if self.stop_request is not None else
+                            terminal_status or 'monitor_finished')
+                    except Exception as error:
+                        self.kernel_trace_status = {
+                            'schema': 'causal-kernel-trace/v1', 'status': 'failed',
+                            'reason': 'session_stop_failed',
+                            'error': f'{type(error).__name__}: {error}',
+                            'root_cause_coverage_complete': False,
+                        }
+                if failure is not None:
+                    try:
+                        outcome = self.stop_owned_unit(f'{type(failure).__name__}: {failure}')
+                    except Exception as stop_error:
+                        outcome = {'requested': False, 'verified': False,
+                                   'error': f'{type(stop_error).__name__}: {stop_error}'}
+                    try:
+                        self.write_status('failed', str(failure), stop_unit=outcome,
+                                          stop_request=self.stop_request,
+                                          sample_window=self.window, snapshots=self.snapshot_number)
+                    except OSError as persist_error:
+                        print(f'causal-observer: unable to persist failure status: {persist_error}',
+                              file=sys.stderr, flush=True)
+                else:
+                    try:
+                        self.write_status(terminal_status or 'stopped',
+                                          'pinned process exited; cause unknown; observer closed without stopping its owned unit'
+                                          if terminal_status and self.stop_request is None
+                                          else 'approved bounded stop finalized perf and closed observer before owned-unit stop'
+                                          if self.stop_request is not None
+                                          else 'observer stopped without an internal error',
+                                          sample_window=self.window, stop_request=self.stop_request,
+                                          snapshots=self.snapshot_number,
+                                          process_exit_cause='unknown'
+                                          if terminal_status and self.stop_request is None else None)
+                    except OSError as persist_error:
+                        print(f'causal-observer: unable to persist final status: {persist_error}',
+                              file=sys.stderr, flush=True)
+            finally:
+                self.close()
+        if failure is not None:
+            raise ObserverError(str(failure)) from failure
+
+    def close(self):
+        for fd_name in ('control_fd', 'ack_fd', 'resource_fd', 'error_fd'):
+            fd = getattr(self, fd_name, None)
+            if fd is not None:
+                try:
+                    os.close(fd)
+                except OSError:
+                    pass
+                setattr(self, fd_name, None)
+        server = getattr(self, 'server', None)
+        if server is not None:
+            try:
+                server.close()
+            except OSError:
+                pass
+            self.server = None
+        if getattr(self, '_socket_created', False):
+            try:
+                self.socket_path.unlink()
+                fsync_directory(self.run_dir)
+            except (FileNotFoundError, OSError):
+                pass
+            self._socket_created = False
+            self._owned_paths.discard(self.socket_path)
+        if getattr(self, 'lock_fd', None) is not None:
+            if getattr(self, '_lock_acquired', False):
+                try:
+                    fcntl.flock(self.lock_fd, fcntl.LOCK_UN)
+                except OSError:
+                    pass
+            try:
+                os.close(self.lock_fd)
+            except OSError:
+                pass
+            self.lock_fd = None
+            self._lock_acquired = False
+
+
+def _timer_failure_fixture():
+    class FixtureIdentity:
+        def verify_process(self):
+            return {'starttime_ticks': 1}
+
+    monitor = Monitor.__new__(Monitor)
+    monitor.identity = FixtureIdentity()
+    monitor.window_lock = threading.Lock()
+    monitor.fixture_timer_failure = True
+    monitor.timer_failure = None
+    monitor.timer_failure_event = threading.Event()
+    monitor._timed_disable()
+    try:
+        monitor._raise_timer_failure()
+    except ObserverError as error:
+        if (not monitor.timer_failure_event.is_set()
+                or type(monitor.timer_failure) is not MemoryError
+                or 'deterministic fixture timer callback failure' not in str(error)):
+            raise ObserverError('timer callback exception did not propagate as a monitor-visible failure')
+        return {'passed': True, 'callback_exception': 'MemoryError',
+                'timer_failure_event': True, 'monitor_failure': str(error)}
+    raise ObserverError('timer callback exception did not fail the monitor loop')
+
+
+def resolve_run_dir(value):
+    raw = Path(value)
+    if not raw.is_absolute():
+        raw = Path.cwd() / raw
+    resolved = raw.resolve(strict=True)
+    evidence = EVIDENCE.resolve(strict=True)
+    if raw != resolved or resolved == evidence or evidence not in resolved.parents:
+        raise ObserverError('run directory must be a real, non-symlink child of the workbench evidence directory')
+    info = resolved.stat()
+    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid():
+        raise ObserverError('run directory must be owned by the current user')
+    return resolved
+
+
+def request_monitor(run_dir, request, *, fixture=False):
+    path = run_dir / '.causal-observer.sock'
+    emitted = clock_pair()
+    request['emitted'] = emitted
+    if fixture:
+        request['fixture'] = True
+    payload = (json.dumps(request, sort_keys=True, separators=(',', ':')) + '\n').encode()
+    if len(payload) > 4096:
+        raise ObserverError('observer control request exceeds 4096 bytes')
+    client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+    timeout = (ACK_TIMEOUT_SECONDS + PERF_FINALIZATION_TIMEOUT_SECONDS + 25
+               if request.get('command') == 'orderly-stop'
+               else ACK_TIMEOUT_SECONDS + 6)
+    client.settimeout(timeout)
+    try:
+        client.connect(str(path))
+        client.sendall(payload)
+        chunks = bytearray()
+        while b'\n' not in chunks and len(chunks) <= 1024 * 1024:
+            part = client.recv(65536)
+            if not part:
+                break
+            chunks.extend(part)
+    except (OSError, socket.timeout) as error:
+        raise ObserverError(f'cannot reach active causal observer or receive its ACK: {error}') from error
+    finally:
+        client.close()
+    if len(chunks) > 1024 * 1024:
+        raise ObserverError('observer response exceeded bounded size')
+    line, sep, _ = bytes(chunks).partition(b'\n')
+    if not sep:
+        raise ObserverError('observer closed without a readiness/marker response')
+    try:
+        result = json.loads(line)
+    except json.JSONDecodeError as error:
+        raise ObserverError(f'observer returned invalid response: {error}') from error
+    if not isinstance(result, dict) or result.get('ok') is not True:
+        raise ObserverError(f'observer refused request: {result}')
+    return result
+
+
+def request_shutdown(signum, _frame):
+    raise KeyboardInterrupt(f'signal {signum}')
+
+
+def cli():
+    parser = argparse.ArgumentParser(description='Capture bounded, owned-unit perf control ACKs and independent causal resource snapshots.')
+    commands = parser.add_subparsers(dest='command', required=True)
+    commands.add_parser('parser-fixture', help=argparse.SUPPRESS)
+    commands.add_parser('timer-failure-fixture', help=argparse.SUPPRESS)
+    monitor = commands.add_parser('monitor', help='Verify a live native PID/unit and own the single perf window.')
+    monitor.add_argument('--run-dir', required=True)
+    monitor.add_argument('--pid', required=True, type=int)
+    monitor.add_argument('--expected-starttime', type=int,
