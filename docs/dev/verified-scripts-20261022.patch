+def parse_perf_sample_lines(lines, target_pid, start_ns, end_ns):
+    if type(target_pid) is not int or target_pid <= 1 or type(start_ns) is not int or type(end_ns) is not int or end_ns < start_ns:
+        raise ObserverError('perf sample parser requires a pinned PID and ordered monotonic bounds')
+    records = 0
+    target_records = 0
+    in_window = 0
+    target_in_window = 0
+    period_min = None
+    period_max = None
+    period_sum = 0
+    target_time_min = None
+    target_time_max = None
+    target_window_time_min = None
+    target_window_time_max = None
