+def write_worker_result(record, output_dir=None):
+    if output_dir:
+        _atomic_json(Path(output_dir) / 'worker-result.json', record, replace=False)
+    print('NATIVE_WORKER_RESULT=' + json.dumps(record, sort_keys=True), flush=True)
