+    def _timed_disable(self):
+        try:
+            with self.window_lock:
+                try:
+                    self.identity.verify_process()
+                except FileNotFoundError:
+                    try:
+                        proc_stat(self.identity.pid)
+                    except FileNotFoundError:
+                        self.disable_sample('duration_elapsed', allow_process_gone=True)
+                        return
+                    raise
+                if self.fixture_timer_failure:
+                    self.fixture_timer_failure = False
+                    raise MemoryError('deterministic fixture timer callback failure')
+                self.disable_sample('duration_elapsed')
+        except Exception as error:
+            try:
+                self.timer_failure = error
+            finally:
+                self.timer_failure_event.set()
+    def _raise_timer_failure(self):
+        if self.timer_failure_event.is_set():
+            error_type = type(self.timer_failure).__name__
+            raise ObserverError(f'bounded sampling disable failed: {error_type}: {self.timer_failure}')
