+        'condition': authorization['condition'],
+        'trace_environment': authorization['trace_environment'],
+        'until_stopped': authorization['until_stopped'],
+        'pipeline_dispatch': authorization['pipeline_dispatch'],
+        'wait_idle_backoff': authorization['wait_idle_backoff'],
+        'privileged_kernel_requested': False,
