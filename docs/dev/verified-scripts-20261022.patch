+++ b/evidence/thread-dependency-investigation/run_probe.py
@@ -0,0 +1,210 @@
+import argparse
+import json
+import os
+import signal
+import subprocess
+import sys
+import time
+import uuid
+from pathlib import Path
+
+WORKBENCH = Path(__file__).resolve().parents[2]
+ROOT = Path(__file__).resolve().parent
+sys.path.insert(0, str(WORKBENCH))
+
+import native_launch_guard as launch_guard
+from probe_common import elf_layout
+
+
+def require_reviewed_preload(path):
+    if path is None:
+        return False
+    selected = path.resolve(strict=True)
+    canonical = launch_guard.BACKOFF_LIBRARY.resolve(strict=True)
+    if selected != canonical:
+        raise RuntimeError(f'Only the canonical reviewed preload is accepted: {canonical}')
+    return True
+
+
+def descendant(pid):
+    visited = set()
+    while pid > 1 and pid not in visited:
+        if pid == os.getpid():
+            return True
+        visited.add(pid)
+        status = Path(f'/proc/{pid}/status').read_text().splitlines()
+        pid = int(next(line.split()[1] for line in status if line.startswith('PPid:')))
+    return False
