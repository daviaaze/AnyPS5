foreach(required IN ITEMS FIXTURE REPLAY OUTPUT_ROOT)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef runId)
set(runDirectory "${OUTPUT_ROOT}/compute-capture-${runId}")
set(captureDirectory "${runDirectory}/captures")
file(MAKE_DIRECTORY "${runDirectory}")
execute_process(
        COMMAND "${CMAKE_COMMAND}" -E env "ANYPS5_NO_SHADER_CACHE=1" "APS5_PIPELINE_STATS=0" "APS5_DUMP_COMPUTE_PIPELINES=" "APS5_DUMP_COMPUTE_MIN_WORDS=0" "${FIXTURE}"
        WORKING_DIRECTORY "${runDirectory}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20
)
file(WRITE "${runDirectory}/normal.log" "${output}\n${error}")
if(error MATCHES "\\[compute-(capture-context|create-timing)\\]")
    message(FATAL_ERROR "Diagnostics ran with capture disabled: ${error}")
endif()
if(result STREQUAL "77" AND NOT DEFINED ENV{ANYPS5_REQUIRE_VULKAN})
    message(STATUS "compute pipeline capture run: skipped, no usable Vulkan device")
    file(REMOVE_RECURSE "${runDirectory}")
    return()
endif()
if(NOT result STREQUAL "0" OR NOT output MATCHES "branch past endpgm tests passed")
    message(FATAL_ERROR "Normal compute fixture failed: ${result}\n${output}\n${error}")
endif()
execute_process(
        COMMAND "${CMAKE_COMMAND}" -E env "ANYPS5_REQUIRE_VULKAN=1" "ANYPS5_NO_SHADER_CACHE=1" "APS5_PIPELINE_STATS=0" "APS5_DUMP_COMPUTE_PIPELINES=${captureDirectory}" "APS5_DUMP_COMPUTE_MIN_WORDS=0" "${FIXTURE}"
        WORKING_DIRECTORY "${runDirectory}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20
)
file(WRITE "${runDirectory}/capture.log" "${output}\n${error}")
if(NOT error MATCHES "\\[compute-capture-context\\]" OR NOT error MATCHES "\\[compute-create-timing\\]")
    message(FATAL_ERROR "Captured fixture omitted pipeline timing diagnostics: ${error}")
endif()
string(REGEX MATCHALL "\\[compute-capture-context\\] program=0x[0-9a-fA-F]+ words=[0-9]+ path=[^ ]+ capture_ms=[0-9]+\\.[0-9]+" contextRows "${error}")
string(REGEX MATCHALL "\\[compute-create-timing\\] program=0x[0-9a-fA-F]+ words=[0-9]+ path=[^ ]+ cache_wait_ms=[0-9]+\\.[0-9]+ vk_ms=[0-9]+\\.[0-9]+ total_ms=[0-9]+\\.[0-9]+" timingRows "${error}")
list(LENGTH contextRows contextCount)
list(LENGTH timingRows timingCount)
if(contextCount LESS 1 OR timingCount LESS 1)
    message(FATAL_ERROR "Malformed compute timing diagnostics: ${error}")
endif()
foreach(contextRow IN LISTS contextRows)
    string(REGEX MATCH "program=(0x[0-9a-fA-F]+) words=([0-9]+) path=([^ ]+) capture_ms=([0-9]+\\.[0-9]+)" matchedContext "${contextRow}")
    set(contextProgram "${CMAKE_MATCH_1}")
    set(contextWords "${CMAKE_MATCH_2}")
    set(contextPath "${CMAKE_MATCH_3}")
    list(APPEND contextPaths "${contextPath}")
    set(captureMilliseconds "${CMAKE_MATCH_4}")
    set(contextMatched FALSE)
    foreach(timingRow IN LISTS timingRows)
        string(REGEX MATCH "program=(0x[0-9a-fA-F]+) words=([0-9]+) path=([^ ]+) cache_wait_ms=([0-9]+\\.[0-9]+) vk_ms=([0-9]+\\.[0-9]+) total_ms=([0-9]+\\.[0-9]+)" matchedTiming "${timingRow}")
        if(CMAKE_MATCH_1 STREQUAL contextProgram AND CMAKE_MATCH_2 STREQUAL contextWords AND CMAKE_MATCH_3 STREQUAL contextPath)
            set(cacheWaitMilliseconds "${CMAKE_MATCH_4}")
            set(driverMilliseconds "${CMAKE_MATCH_5}")
            set(totalMilliseconds "${CMAKE_MATCH_6}")
            set(contextMatched TRUE)
            break()
        endif()
    endforeach()
    if(NOT contextMatched)
        message(FATAL_ERROR "Capture context has no matching creation timing: ${contextRow}\n${timingRows}")
    endif()
    if(NOT EXISTS "${contextPath}" OR NOT contextPath MATCHES "capture\\.aps5cp$")
        message(FATAL_ERROR "Capture diagnostic path does not resolve to a capture record: ${contextPath}")
    endif()
    foreach(value IN ITEMS captureMilliseconds cacheWaitMilliseconds driverMilliseconds totalMilliseconds)
        if(NOT "${${value}}" MATCHES "^[0-9]+\\.[0-9]+$")
            message(FATAL_ERROR "Invalid timing value ${value}=${${value}}")
        endif()
        string(REPLACE "." "" "${value}Micros" "${${value}}")
    endforeach()
    math(EXPR minimumTotalMicros "${captureMillisecondsMicros} + ${cacheWaitMillisecondsMicros} + ${driverMillisecondsMicros} - 10000")
    if(totalMillisecondsMicros LESS minimumTotalMicros)
        message(FATAL_ERROR "Creation total does not cover measured phases: ${contextRow}; ${timingRow}")
    endif()
endforeach()
foreach(timingRow IN LISTS timingRows)
    string(REGEX MATCH "program=(0x[0-9a-fA-F]+) words=([0-9]+) path=([^ ]+) cache_wait_ms=([0-9]+\\.[0-9]+) vk_ms=([0-9]+\\.[0-9]+) total_ms=([0-9]+\\.[0-9]+)" matchedTiming "${timingRow}")
    set(cacheWaitMicros "${CMAKE_MATCH_4}")
    set(driverMicros "${CMAKE_MATCH_5}")
    set(totalMicros "${CMAKE_MATCH_6}")
    string(REPLACE "." "" cacheWaitMicros "${cacheWaitMicros}")
    string(REPLACE "." "" driverMicros "${driverMicros}")
    string(REPLACE "." "" totalMicros "${totalMicros}")
    math(EXPR minimumTotalMicros "${cacheWaitMicros} + ${driverMicros} - 10000")
    if(totalMicros LESS minimumTotalMicros)
        message(FATAL_ERROR "Creation total does not cover its measured phases: ${timingRow}")
    endif()
endforeach()
 
if(NOT result STREQUAL "0" OR NOT output MATCHES "branch past endpgm tests passed")
    message(FATAL_ERROR "Captured compute fixture failed: ${result}\n${output}\n${error}")
endif()
file(GLOB captures "${captureDirectory}/compute-*/capture.aps5cp")
list(LENGTH captures count)
if(count LESS 1)
    message(FATAL_ERROR "Compute fixture produced no pipeline captures")
endif()
list(REMOVE_DUPLICATES contextPaths)
list(LENGTH contextPaths contextPathCount)
if(NOT contextPathCount EQUAL count)
    message(FATAL_ERROR "Capture diagnostics and replay records differ: ${contextPaths}; ${captures}")
endif()
foreach(contextPath IN LISTS contextPaths)
    if(NOT contextPath IN_LIST captures)
        message(FATAL_ERROR "Capture diagnostic path was not replayed: ${contextPath}")
    endif()
endforeach()
foreach(capture IN LISTS captures)
    get_filename_component(recordDirectory "${capture}" DIRECTORY)
    get_filename_component(recordName "${recordDirectory}" NAME)
    string(REPLACE "compute-" "" identity "${recordName}")
    set(report "${runDirectory}/${recordName}.json")
    execute_process(
            COMMAND "${CMAKE_COMMAND}" -E env "APS5_PIPELINE_STATS=0" "APS5_DUMP_COMPUTE_PIPELINES=" "${REPLAY}" "${capture}" --output "${report}"
            WORKING_DIRECTORY "${runDirectory}"
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20
    )
    file(WRITE "${runDirectory}/${recordName}.log" "${output}\n${error}")
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Captured pipeline replay failed: ${result}\n${output}\n${error}")
    endif()
    file(READ "${report}" reportJson)
    string(JSON reportIdentity GET "${reportJson}" capture_identity)
    string(JSON words GET "${reportJson}" spirv_words)
    string(JSON sets GET "${reportJson}" descriptor_sets)
    string(JSON ranges GET "${reportJson}" push_constant_ranges)
    string(JSON dispatches GET "${reportJson}" dispatch_count)
    string(JSON policy GET "${reportJson}" application_cache_policy)
    string(JSON capturedDevice GET "${reportJson}" captured_device device_id)
    string(JSON replayDevice GET "${reportJson}" replay_device device_id)
    string(JSON capturedDriver GET "${reportJson}" captured_device driver_version_raw)
    string(JSON replayDriver GET "${reportJson}" replay_device driver_version_raw)
    string(JSON specialization GET "${reportJson}" specialization_constants)
    string(JSON flags GET "${reportJson}" pipeline_flags)
    string(JSON stageFlags GET "${reportJson}" stage_flags)
    string(JSON subgroup GET "${reportJson}" required_subgroup_size)
    string(JSON uuid GET "${reportJson}" captured_device pipeline_cache_uuid)
    string(JSON replayUuid GET "${reportJson}" replay_device pipeline_cache_uuid)
    string(JSON capturedVendor GET "${reportJson}" captured_device vendor_id)
    string(JSON replayVendor GET "${reportJson}" replay_device vendor_id)
    if(NOT reportIdentity STREQUAL identity OR words LESS 54 OR sets LESS 1 OR ranges LESS 1 OR NOT dispatches EQUAL 0 OR NOT policy STREQUAL "fresh" OR NOT capturedDevice STREQUAL replayDevice OR NOT capturedDriver STREQUAL replayDriver OR NOT uuid STREQUAL replayUuid OR NOT capturedVendor STREQUAL replayVendor OR specialization LESS 1 OR flags LESS 0 OR stageFlags LESS 0 OR subgroup LESS 0)
        message(FATAL_ERROR "Captured pipeline metadata mismatch: ${reportJson}")
    endif()
    if(NOT EXISTS "${capture}" OR NOT reportIdentity STREQUAL identity)
        message(FATAL_ERROR "Replayed pipeline did not resolve the captured content identity: ${capture}")
    endif()
endforeach()
message(STATUS "Normal and captured compute output verified; ${count} captured pipelines replayed without dispatch and timing phases validated")
file(REMOVE_RECURSE "${runDirectory}")
