if(BUILD_TESTING)
    foreach(instanceInputMode IN ITEMS recipe late-fallback verify fallback-key uncached no-input-routes)
        string(REPLACE "-" "_" instanceInputSuffix "${instanceInputMode}")
        set(instanceInputTest agc_driver_gpu_indirect_instance_input_${instanceInputSuffix})
        add_test(NAME ${instanceInputTest} COMMAND agc_driver_gpu_indirect_instance_input_tests --${instanceInputMode})
        set_tests_properties(${instanceInputTest} PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_DRAW_CACHE_INDIRECT=1;APS5_DRAW_CACHE_PUSH_WORD=1" SKIP_RETURN_CODE 77 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}" TIMEOUT 30)
        if(WIN32)
            set_tests_properties(${instanceInputTest} PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
endif()
