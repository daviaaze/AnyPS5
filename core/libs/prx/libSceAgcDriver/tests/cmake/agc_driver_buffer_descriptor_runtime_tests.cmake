target_include_directories(agc_driver_buffer_descriptor_runtime_tests PRIVATE $<TARGET_PROPERTY:shader_recompiler_agc_driver,INTERFACE_INCLUDE_DIRECTORIES>)
if(BUILD_TESTING)
    foreach(prefetchMode IN ITEMS off on)
        if(prefetchMode STREQUAL "off")
            set(prefetchValue 0)
        else()
            set(prefetchValue 1)
        endif()
        set(prefetchTest agc_driver_buffer_descriptor_runtime_prefetch_${prefetchMode})
        add_test(NAME ${prefetchTest} COMMAND agc_driver_buffer_descriptor_runtime_tests)
        set_tests_properties(${prefetchTest} PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_PARALLEL_COMPUTE_COMPILE=${prefetchValue}"
            SKIP_RETURN_CODE 77 TIMEOUT 60 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
        if(WIN32)
            set_tests_properties(${prefetchTest} PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
endif()
